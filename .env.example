# ---------------------------------------------------------------------------
# Time Lag Gaming — environment variables
# Copy this file to ".env" for local dev, and add the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
# ---------------------------------------------------------------------------

# Email delivery for the "Sell Your Games" contact form.
# Create a free API key at https://resend.com (the free tier is plenty for a shop).
#
# Without this key the form still WORKS — submissions are logged to the server
# console so nothing is lost — but no email is actually sent. Set this key to
# have leads delivered to the inbox below.
RESEND_API_KEY=

# Where sell/trade lead emails are delivered (defaults to the shop inbox).
CONTACT_TO_EMAIL=timelaggaming@gmail.com

# The "from" address for outgoing lead emails.
# Until you verify your own domain inside Resend you can use their test sender
# (onboarding@resend.dev). After verifying timelag.co, switch this to
# something like "TimeLag Video Games <hello@timelag.co>".
CONTACT_FROM=TimeLag Video Games <onboarding@resend.dev>

# Resend Audience for the "Want Updates?" newsletter signups. Create an Audience
# at https://resend.com/audiences and paste its ID here. Without it, signups are
# logged to the server console instead of added to your mailing list.
RESEND_AUDIENCE_ID=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX. Create a GA4 property at
# https://analytics.google.com → Admin → Data Streams → your web stream. Left
# blank, no analytics loads. (This value is public — it ships in the client JS.)
PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# POS app — Supabase. Locally these come from `npx supabase status`; in
# production use your cloud project's Project URL + API keys (Vercel env vars).
# ---------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: PriceCharting API token. When set, the Pricing sync uses real
# market data; when blank, it simulates price movement for the review workflow.
PRICECHARTING_API_TOKEN=

# IGDB (via Twitch) — auto-enrich added products with cover art, description,
# trailer, and alternate names. Register an app at
# https://dev.twitch.tv/console/apps (Client ID + "New Secret"). Server-only —
# do NOT prefix with PUBLIC_. Leave blank to disable auto-enrichment.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# eBay Browse API — "Import from eBay" in the POS Add-Product flow (paste an
# item # / listing URL to auto-fill) and bulk store import. Production keyset
# from https://developer.ebay.com → Application Keysets → Production (App ID +
# Cert ID). Server-only — do NOT prefix with PUBLIC_. Leave blank to disable.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Your eBay seller USERNAME (the _ssn= value, e.g. "timelag") — NOT the store
# name. Used to pull your whole store for the bulk import.
EBAY_SELLER=

# Secret that guards the scheduled eBay stock sync (/api/cron/ebay-sync, run
# daily by the Vercel cron in vercel.json). Set the SAME random value here and
# in Vercel; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`. Generate
# one with e.g. `openssl rand -hex 32`. Without it the cron route returns 503.
CRON_SECRET=

# Cloudflare R2 — product & menu photo storage (10GB free, no bandwidth fees).
# All five set → new photos go to R2 and Settings → Danger zone can move the
# existing ones over. Any blank → photos stay in Supabase Storage. Server-only.
# R2_ACCOUNT_ID: Cloudflare dashboard → R2 → "Account ID" (right-hand side).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 → Manage API tokens → create
#   one with "Object Read & Write" on your bucket (secret is shown only once).
# R2_BUCKET: the bucket's name.
# R2_PUBLIC_URL: the bucket's public address, e.g. https://images.timelag.co
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
