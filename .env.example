# ---------------------------------------------------------------------------
# Time Lag Gaming — environment variables
# Copy this file to ".env" for local dev, and add the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
# ---------------------------------------------------------------------------

# Email delivery for the "Sell Your Games" contact form.
# Create a free API key at https://resend.com (the free tier is plenty for a shop).
#
# Without this key the form still WORKS — submissions are logged to the server
# console so nothing is lost — but no email is actually sent. Set this key to
# have leads delivered to the inbox below.
RESEND_API_KEY=

# Where sell/trade lead emails are delivered (defaults to the shop inbox).
CONTACT_TO_EMAIL=timelaggaming@gmail.com

# The "from" address for outgoing lead emails.
# Until you verify your own domain inside Resend you can use their test sender
# (onboarding@resend.dev). After verifying timelaggaming.com, switch this to
# something like "Time Lag Gaming <hello@timelaggaming.com>".
CONTACT_FROM=Time Lag Gaming <onboarding@resend.dev>
