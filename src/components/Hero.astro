---
import { SITE } from "../consts";
import Logo from "./Logo.astro";
---

<section class="hero">
  <div class="hero-pixels" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{SITE.location} · Buy · Sell · Chill</span>
      <h1>
        <span class="line line-1">Lose Track of Time,</span>
        <span class="line line-2">Find Your Third Place.</span>
      </h1>
      <p class="lead">
        TimeLag is Portland&rsquo;s premier inclusive hub to shop, play, eat, and
        connect. Discover Japanese imports, browse classic collectibles, or level
        up in our chill lounge. Whether you bring your own set up or try our
        massive library of games, there&rsquo;s always a seat for you here.
        Launching 2027 near PDX.
      </p>
      <div class="hero-cta">
        <a href="/#sell" class="tl-btn tl-btn--pink">Sell Your Games →</a>
        <a href="/#store" class="tl-btn tl-btn--teal">Browse Our Games</a>
      </div>
      <ul class="tl-badges hero-badges">
        <li>⏳ Curated Nostalgia</li>
        <li>🌐 Niche Imports</li>
        <li>⚡ Surprising Finds</li>
        <li>✅ Fair Offers</li>
        <li>🎮 Every Era</li>
      </ul>
    </div>

    <div class="hero-art" aria-hidden="true">
      <Logo size={360} class="hero-mark" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(1.5rem, 1rem + 4vw, 3rem);
    align-items: center;
  }
  @media (min-width: 940px) {
    .hero-grid {
      grid-template-columns: 1.25fr 0.75fr;
    }
  }

  .hero-copy h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.9rem, 1.4rem + 6vw, 5.4rem);
    line-height: 0.94;
    letter-spacing: 0.005em;
    margin: 0.4rem 0 1.3rem;
  }
  .line {
    display: block;
  }
  .line-1 {
    color: var(--cyan);
    text-shadow: 5px 6px 0 #b0512b;
  }
  .line-2 {
    color: #f4ead9;
    text-shadow: 5px 6px 0 #bd472a;
  }

  .hero-copy .lead {
    max-width: 56ch;
    color: #d8c7b8;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.9rem;
  }
  .hero-badges {
    margin-top: 1.9rem;
    color: #e9dccd;
    font-size: 0.98rem;
  }

  /* decorative 3D-ish mark */
  .hero-art {
    display: grid;
    place-items: center;
  }
  .hero-art :global(.hero-mark) {
    width: clamp(180px, 30vw, 360px);
    height: auto;
    color: #7a3a1c;
    filter: drop-shadow(8px 10px 0 rgba(0, 0, 0, 0.45))
      drop-shadow(0 0 40px rgba(214, 120, 60, 0.35));
    opacity: 0.92;
  }
  @media (max-width: 939px) {
    .hero-art {
      display: none;
    }
  }

  /* floating pixel particles */
  .hero-pixels {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero-pixels::before,
  .hero-pixels::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 1px;
    background: transparent;
  }
  .hero-pixels::before {
    box-shadow:
      120px 60px 0 #e6a3cd, 320px 140px 0 #9c6cf0, 540px 40px 0 #6fd0db,
      760px 180px 0 #e6a3cd, 980px 90px 0 #f0d9c6, 1180px 220px 0 #9c6cf0,
      200px 320px 0 #6fd0db, 60px 440px 0 #e6a3cd, 440px 520px 0 #f0d9c6,
      880px 420px 0 #9c6cf0, 1080px 500px 0 #6fd0db, 1280px 380px 0 #e6a3cd;
  }
  .hero-pixels::after {
    box-shadow:
      240px 200px 0 #f0d9c6, 600px 300px 0 #e6a3cd, 720px 80px 0 #9c6cf0,
      900px 260px 0 #6fd0db, 1140px 60px 0 #e6a3cd, 380px 120px 0 #6fd0db,
      100px 240px 0 #9c6cf0, 520px 460px 0 #f0d9c6, 980px 360px 0 #e6a3cd,
      1240px 200px 0 #9c6cf0, 160px 560px 0 #6fd0db, 700px 540px 0 #e6a3cd;
    opacity: 0.7;
  }
</style>
