---
// TimeLag isometric stacked-bar monogram.
// Drawn with currentColor so it works on the orange header (black) and the
// light footer gradient (espresso). Swap for the real logo asset when ready.
interface Props {
  size?: number;
  class?: string;
}
const { size = 34, class: className = "" } = Astro.props;
---

<svg
  class={`tl-logo ${className}`}
  width={size}
  height={size}
  viewBox="0 0 56 52"
  fill="none"
  role="img"
  aria-hidden="true"
>
  <!-- depth / 3D side face -->
  <g transform="skewX(-9) translate(3 3)" opacity="0.35">
    <rect x="3" y="4" width="22" height="6" fill="currentColor" />
    <rect x="9" y="10" width="7" height="34" fill="currentColor" />
    <rect x="30" y="4" width="7" height="40" fill="currentColor" />
    <rect x="37" y="4" width="13" height="6" fill="currentColor" />
    <rect x="37" y="20" width="11" height="6" fill="currentColor" />
    <rect x="37" y="38" width="14" height="6" fill="currentColor" />
  </g>
  <!-- front face: stylised "TE" stacked bars -->
  <g transform="skewX(-9)" fill="currentColor">
    <rect x="3" y="4" width="22" height="6" />
    <rect x="9" y="11" width="7" height="14" />
    <rect x="9" y="27" width="7" height="17" />
    <rect x="30" y="4" width="7" height="40" />
    <rect x="37" y="4" width="13" height="6" />
    <rect x="37" y="20" width="11" height="6" />
    <rect x="37" y="38" width="14" height="6" />
  </g>
</svg>

<style>
  .tl-logo {
    display: block;
    flex: none;
  }
</style>
