---
// No-flash theme bootstrap. Reads the store's default palette + sidebar accent
// once (server-side), then an inline <head> script applies the per-device
// overrides (localStorage 'tl-theme' / 'tl-sidebar') or those defaults BEFORE
// first paint. Exposes window.setTheme/getTheme + setSidebar/getSidebar.
//
// `scope`: "pos" for the POS AppLayout, "site" for the public Layout (marketing +
// shop). When the store's "POS only" toggle is on, the palette is suppressed on
// "site" pages so the public website keeps the brand default. The sidebar accent
// is POS-only by nature (no sidebar on the public site).
import { createSupabaseAdminClient } from "../lib/supabase";
import { themeSettings } from "../lib/themeSettings";

interface Props { scope?: "site" | "pos"; }
const { scope = "site" } = Astro.props;

let defaultTheme = "default";
let defaultSidebar = "default";
let posOnly = false;
try {
  const admin = createSupabaseAdminClient();
  const { data } = await admin.from("store_settings").select("settings").eq("id", 1).maybeSingle();
  const ts = themeSettings(data?.settings);
  defaultTheme = ts.defaultTheme;
  defaultSidebar = ts.defaultSidebar;
  posOnly = ts.themePosOnly;
} catch {
  // Settings unavailable (e.g. DB down) — fall back to the brand defaults.
}
// Whether the palette is allowed to render on THIS page.
const paletteActive = scope === "pos" || !posOnly;
---

<script is:inline set:html={`(function(){try{
  var DEF=${JSON.stringify(defaultTheme)}, SDEF=${JSON.stringify(defaultSidebar)}, ACTIVE=${paletteActive ? "true" : "false"}, el=document.documentElement;
  // Pixel fonts cost extra weight, so only load them when Game Boy mode is on.
  function pixelFont(t){ if(t!=='dmg'||document.getElementById('tl-pixel-font'))return; var l=document.createElement('link'); l.id='tl-pixel-font'; l.rel='stylesheet'; l.href='https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&family=Press+Start+2P&family=VT323&display=swap'; document.head.appendChild(l); }
  function applyTheme(t){ if(ACTIVE && t && t!=='default'){el.setAttribute('data-theme',t); pixelFont(t); if(t==='dmg'&&window.__tlWrapEmojis){window.__tlWrapEmojis();}} else {el.removeAttribute('data-theme');} }
  function applySidebar(s){ if(s&&s!=='default'){el.setAttribute('data-sidebar',s);} else {el.removeAttribute('data-sidebar');} }
  var st=null, ss=null; try{ st=localStorage.getItem('tl-theme'); ss=localStorage.getItem('tl-sidebar'); }catch(e){}
  applyTheme(st||DEF); applySidebar(ss||SDEF);
  window.__tlThemeDefault=DEF; window.__tlSidebarDefault=SDEF;
  window.getTheme=function(){ try{return localStorage.getItem('tl-theme')||DEF;}catch(e){return DEF;} };
  window.setTheme=function(t){ try{ if(!t||t==='default'){localStorage.removeItem('tl-theme');}else{localStorage.setItem('tl-theme',t);} }catch(e){} applyTheme(t); };
  window.getSidebar=function(){ try{return localStorage.getItem('tl-sidebar')||SDEF;}catch(e){return SDEF;} };
  window.setSidebar=function(s){ try{ if(!s||s==='default'){localStorage.removeItem('tl-sidebar');}else{localStorage.setItem('tl-sidebar',s);} }catch(e){} applySidebar(s); };
}catch(e){}})();`} />
