---
import { NAV, SITE, FIND_US_HREF } from "../consts";
import SocialLinks from "./SocialLinks.astro";

// A nav item is "active" when its href is a real route matching the current
// path (anchors like "/#sell" are in-page jumps and never get the active state).
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  !href.includes("#") && (href.replace(/\/$/, "") || "/") === path;
---

<header class="site-header">
  <div class="container navbar">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand-mark" aria-hidden="true">
        <img src="/logo-white.png" alt="" class="brand-logo" />
      </span>
      <span class="brand-text">TimeLag<span class="brand-text-2"> Video&nbsp;Games</span></span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Toggle navigation menu"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class={isActive(item.href) ? "is-active" : undefined}
              aria-current={isActive(item.href) ? "page" : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
      <SocialLinks class="nav-social" />
      <a href={FIND_US_HREF} class="btn nav-pin" aria-label="Find us in Portland">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"></path></svg>
        <span>Find&nbsp;Us</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .nav a.is-active { color: var(--cyan); }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.getElementById("primary-nav");
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      nav.dataset.open = String(open);
    };
    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
    const mq = window.matchMedia("(min-width: 961px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
