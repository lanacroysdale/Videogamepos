---
const timeline = [
  {
    when: "Jan 2026 – Dec 2026",
    title: "Investment & Inventory Expansion",
    body: "Deepening our curated catalog and building the import pipeline.",
    dot: "orange",
  },
  {
    when: "Dec 2026 – Mar 2027",
    title: "Saving & Preparation",
    body: "Locking in the space and the plan for the lounge experience.",
    dot: "tan",
  },
  {
    when: "Mar 2027 – May 2027",
    title: "Build-Out & Finalization",
    body: "Turning the double-sided retail + arcade lounge vision into a real room.",
    dot: "pink",
  },
  {
    when: "June 2027",
    title: "Grand Opening 🎉",
    body: "Doors open near PDX. Come hang out, play, eat, and shop.",
    dot: "cyan",
    last: true,
  },
];
---

<section class="section find" id="find">
  <div class="container">
    <span class="eyebrow">Eat · Play · Connect</span>
    <h2>Your Hangout Hub for All Things Nostalgia</h2>
    <div class="find-copy">
      <p>
        TimeLag is more than a store — it&rsquo;s a third place to land between home
        and work. We&rsquo;re building a double-sided space: a curated retro shop up
        front and a chill arcade lounge in back, where you can grab a bite, plug
        in a controller, and lose track of time.
      </p>
      <p>
        Bring your own setup or borrow from our massive library, pull up a seat at
        a tournament, or just hang out. We&rsquo;re designing every detail — seating,
        screens, snacks, and signage — to make showing up easy for visitors and
        locals alike. The goal: an inclusive community where every kind of gamer
        feels welcome. There will always be space for you here.
      </p>
    </div>

    <button
      class="tl-btn tl-btn--pink reveal"
      type="button"
      aria-expanded="false"
      aria-controls="opening-timeline"
    >
      <span class="reveal-ico">🔒</span>
      <span class="reveal-label">Reveal Our Secret Grand-Opening Timeline</span>
    </button>

    <ol class="timeline" id="opening-timeline" hidden>
      {
        timeline.map((t) => (
          <li class={`tl-step tl-step--${t.dot}${t.last ? " is-last" : ""}`}>
            <span class="tl-when">{t.when}</span>
            <h3 class={t.last ? "tl-grand" : ""}>{t.title}</h3>
            <p>{t.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .find h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.1rem);
    margin: 0.6rem 0 1.3rem;
    color: #f4ead9;
    max-width: 20ch;
  }
  .find-copy {
    max-width: 64ch;
  }
  .find-copy p {
    color: #cdbcae;
    margin-bottom: 1.1rem;
  }
  .reveal {
    margin-top: 0.8rem;
  }

  /* ---------- Timeline ---------- */
  .timeline {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    max-width: 60ch;
  }
  .timeline[hidden] {
    display: none;
  }
  .tl-step {
    position: relative;
    padding: 0 0 2rem 2.2rem;
  }
  .tl-step::before {
    /* dot */
    content: "";
    position: absolute;
    left: 0;
    top: 0.15rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.25);
  }
  .tl-step::after {
    /* connecting line */
    content: "";
    position: absolute;
    left: 7px;
    top: 1.4rem;
    bottom: 0.2rem;
    width: 2px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.04));
  }
  .tl-step.is-last::after {
    display: none;
  }
  .tl-step--orange::before { background: #d8703f; }
  .tl-step--tan::before { background: #cf9d5f; }
  .tl-step--pink::before { background: #e7a3cb; }
  .tl-step--cyan::before { background: #86d6e1; }

  .tl-when {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    color: #b6a596;
  }
  .tl-step h3 {
    font-family: var(--font-slab);
    font-size: 1.2rem;
    color: #f4ead9;
    margin: 0.35rem 0 0.4rem;
  }
  .tl-step h3.tl-grand {
    color: #86d6e1;
  }
  .tl-step p {
    color: #cdbcae;
    margin: 0;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".reveal");
  const panel = document.getElementById("opening-timeline");
  const ico = btn?.querySelector<HTMLElement>(".reveal-ico");
  const label = btn?.querySelector<HTMLElement>(".reveal-label");

  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    if (panel) panel.hidden = open;
    if (ico) ico.textContent = open ? "🔒" : "🔓";
    if (label) label.textContent = open ? "Reveal Our Secret Grand-Opening Timeline" : "Hide the Timeline";
  });
</script>
