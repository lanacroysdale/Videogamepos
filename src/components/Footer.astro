---
import { SITE, EBAY, NAV, YEAR } from "../consts";
---

<footer class="site-footer">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="foot-brand-row">
          <img src="/logo-dark.png" alt="" class="foot-logo" />
          <span class="brand-text">TimeLag<span class="brand-text-2"> Video Games</span></span>
        </div>
        <p class="foot-tagline">Buy. Sell. Chill.</p>
        <p>
          Portland&rsquo;s premier inclusive hub to shop, play, eat, and connect. Discover
          Japanese imports, browse classic collectibles, or level up in our chill lounge.
        </p>
        <p class="foot-launch">Launching 2027 near PDX.</p>
      </div>

      <div class="foot-col">
        <h3>Explore</h3>
        <ul>
          {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href={EBAY.storeUrl} target="_blank" rel="noopener">Shop on eBay ↗</a></li>
        </ul>
      </div>

      <div class="foot-col" id="contact">
        <h3>Get in Touch</h3>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>✉️ {SITE.email}</a></li>
          <li><a href={SITE.phoneHref}>☎️ {SITE.phoneDisplay}</a></li>
          <li class="loc">📍 {SITE.location}</li>
        </ul>
      </div>
    </div>

    <hr class="divider" />

    <div class="foot-bottom">
      <p>© {YEAR} {SITE.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
