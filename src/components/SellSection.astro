---
import { SITE } from "../consts";
// Sell — cash CTA with two mutually-exclusive inline panels (offer form + how-it-works).
---

<section class="section sell-cash" id="sell">
  <div class="container">
    <h2 class="sell-h2">Sell Your Video Games for <span class="grad-pb">Cash</span></h2>
    <p class="lead">
      Clearing out a closet, trading up or curating your own collection? TimeLag Video Games
      provides the best cash offers in the Pacific Northwest (compared to local retro game
      stores.) Here&rsquo;s how it works:
    </p>
    <div style="display:flex;gap:0.8rem;justify-content:center;flex-wrap:wrap;">
      <button id="offer-toggle" class="btn btn-magenta" type="button" aria-expanded="false" aria-controls="offer-inline">Sell my games →</button>
      <button id="how-toggle" class="btn btn-ghost" type="button" aria-expanded="false" aria-controls="how-inline">See how it works</button>
    </div>

    <div class="offer-reveal" id="offer-inline" data-open="false">
      <div class="offer-card" data-sent="false">
        <div class="modal-head">
          <span class="eyebrow">Free · No obligation</span>
          <h3 id="offer-title">Get Your Custom Cash Offer</h3>
        </div>
        <form class="modal-form" data-offer-form action="/api/contact" method="POST" novalidate>
          <input type="hidden" name="_redirect" value="/" />
          <div class="hp" aria-hidden="true"><label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
          <div class="form-row">
            <div class="field"><label for="of-first">First name <span class="req">*</span></label><input id="of-first" name="first" type="text" required placeholder="James" /></div>
            <div class="field"><label for="of-last">Last name <span class="req">*</span></label><input id="of-last" name="last" type="text" required placeholder="Bond" /></div>
          </div>
          <div class="field"><label for="of-email">Your best email address <span class="req">*</span></label><input id="of-email" name="email" type="email" required placeholder="you@email.com" /></div>
          <div class="field"><label for="of-phone">Phone number <span class="req">*</span></label><input id="of-phone" name="phone" type="tel" required placeholder="(503) 555-0100" /></div>
          <div class="field"><label for="of-items">What video game items do you have to sell? <span class="req">*</span></label>
            <textarea id="of-items" name="items" rows="4" required placeholder="List the games, consoles, and accessories you'd like to sell. Including titles, platforms, and rough quantities all help. For example: 'Super Mario 64 (N64, cart only), PS2 slim w/ 2 controllers, ~30 mixed GameCube games.'"></textarea></div>
          <div class="upload-row">
            <button type="button" class="upload-btn"><span class="ic">📄</span>Upload a spreadsheet!</button>
            <button type="button" class="upload-btn"><span class="ic">🖼️</span>Upload images!</button>
          </div>
          <p class="offer-warn" role="alert" aria-live="assertive"></p>
          <button type="submit" class="btn btn-magenta btn-block">Submit Your No Obligation Quote</button>
          <p class="offer-contact">
            Prefer to talk it through? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            or call <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>.
          </p>
          <p class="offer-sign">Keep Being You, Keep Being Awesome :)</p>
        </form>
        <div class="modal-success">
          <div class="check" aria-hidden="true">✓</div>
          <h3>Quote Request Sent!</h3>
          <p>Thanks! We&rsquo;ll review what you&rsquo;ve got and reply soon with your custom cash offer.</p>
        </div>
      </div>
    </div>

    <div class="how-reveal" id="how-inline" data-open="false">
      <div class="how-card">
        <h3 class="how-title">Here&rsquo;s How It Works</h3>
        <ol class="how-steps">
          <li class="how-step">
            <span class="how-num">1</span>
            <div>
              <h4>Tell us what you&rsquo;ve got</h4>
              <p>Whether you&rsquo;re in Portland, OR, Vancouver, WA or beyond, fill out the form to get a free cash offer on your games, accessories and collectibles.</p>
            </div>
          </li>
          <li class="how-step">
            <span class="how-num">2</span>
            <div>
              <h4>We&rsquo;ll reach out with an offer</h4>
              <p>In order to give you the fairest estimate we handle each trade request by hand. We check real market sales data and get back to you with a transparent offer within 24-48 hours.</p>
            </div>
          </li>
          <li class="how-step">
            <span class="how-num">3</span>
            <div>
              <h4>Get Paid Your Way</h4>
              <p>If you like our offer, accept and walk away with cash. We try to put our best foot forward, but if you aren&rsquo;t happy with your offer we can always crunch the numbers again.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .sell-cash .container { max-width: 860px; text-align: center; }
  .sell-h2 { font-size: clamp(2.6rem, 1.6rem + 4.4vw, 4.8rem); text-wrap: balance; }
  .sell-cash .lead { margin: 1rem auto 1.8rem; max-width: 60ch; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* "See how it works" steps — unfurls like the sell form */
  .how-reveal { overflow: hidden; max-height: 0; opacity: 0; transition: max-height 0.6s ease, opacity 0.5s ease, margin 0.5s ease; text-align: left; }
  .how-reveal[data-open="true"] { max-height: 1400px; opacity: 1; margin-top: 1.9rem; }
  .how-card {
    max-width: 760px; margin-inline: auto; background: linear-gradient(180deg, var(--panel), var(--bg-2));
    border: 0; border-radius: 0; clip-path: polygon(40px 0, 100% 0, calc(100% - 40px) 100%, 0 100%);
    filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.42)); padding: clamp(1.9rem, 1.2rem + 2vw, 2.8rem) clamp(2.75rem, 1.5rem + 4vw, 4.25rem);
  }
  .how-title { text-align: center; margin-bottom: 1.5rem; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); }
  .how-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.2rem; }
  .how-step { display: flex; gap: 1.1rem; align-items: flex-start; text-align: left; }
  .how-num { flex: none; width: 2.7rem; height: 2.7rem; display: grid; place-items: center; font-family: var(--font-mono); font-weight: 800; font-size: 1.15rem; color: var(--accent-ink); background: var(--cyan); clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); }
  .how-step:nth-child(2) .how-num { background: var(--magenta); }
  .how-step:nth-child(3) .how-num { background: var(--green); color: #fff; }
  .how-step h4 { font-family: var(--font-display); font-weight: 400; font-size: 1.3rem; margin-bottom: 0.2rem; color: var(--text); }
  .how-step p { color: var(--muted); font-size: 0.96rem; margin: 0; text-wrap: pretty; }

  /* Inline cash-offer form — unfurls like the timeline */
  .offer-reveal { overflow: hidden; max-height: 0; opacity: 0; transition: max-height 0.6s ease, opacity 0.5s ease, margin 0.5s ease; text-align: left; }
  .offer-reveal[data-open="true"] { max-height: 2200px; opacity: 1; margin-top: 1.9rem; }
  .offer-card {
    max-width: 640px; margin-inline: auto; background: linear-gradient(90deg, #df5e39 0%, #cd804c 100%);
    border: 0; border-radius: 0; clip-path: polygon(56px 0, 100% 0, calc(100% - 56px) 100%, 0 100%);
    filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.42)); padding: clamp(1.8rem, 1.2rem + 2vw, 2.6rem) clamp(3.75rem, 2rem + 5vw, 5rem);
  }
  .offer-card .modal-head { text-align: center; margin-bottom: 1.3rem; }
  .offer-card .modal-head .eyebrow { color: var(--accent-ink); justify-content: center; display: inline-flex; }
  .offer-card .modal-head .eyebrow::before { background: linear-gradient(90deg, var(--accent-ink), transparent); }
  .offer-card .modal-head h3 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); margin-bottom: 0.3rem; color: var(--accent-ink); }
  .offer-card label { color: var(--accent-ink); font-weight: 700; }
  .offer-card .req { color: #6e1226; }
  .offer-card input, .offer-card textarea { background: #fbf3ec; color: var(--accent-ink); border: 0; border-radius: 0; padding-inline: 1.3rem; clip-path: polygon(14px 0, 100% 0, calc(100% - 14px) 100%, 0 100%); }
  .offer-card input::placeholder, .offer-card textarea::placeholder { color: rgba(37, 19, 10, 0.5); }
  .offer-card input:focus, .offer-card textarea:focus { box-shadow: none; filter: drop-shadow(0 0 7px rgba(37, 19, 10, 0.5)); }
  .offer-card input.invalid, .offer-card textarea.invalid { box-shadow: inset 0 0 0 2px #7a1020; }

  .upload-row { display: grid; gap: 0.7rem; grid-template-columns: 1fr 1fr; margin-bottom: 1rem; }
  @media (max-width: 460px) { .upload-row { grid-template-columns: 1fr; } }
  .upload-btn { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; padding: 1rem 0.75rem; font-size: 0.85rem; font-weight: 600; text-align: center; cursor: pointer; }
  .upload-btn .ic { font-size: 1.4rem; }
  .offer-card .upload-btn { background: rgba(255, 255, 255, 0.62); border: 0; border-radius: 0; color: var(--accent-ink); padding-inline: 1rem; clip-path: polygon(14px 0, 100% 0, calc(100% - 14px) 100%, 0 100%); }
  .offer-card .upload-btn:hover { background: #ffffff; color: var(--accent-ink); }

  .offer-warn { color: #5e0f1e; background: rgba(255, 255, 255, 0.55); font-weight: 800; text-align: center; margin: 0 0 0.8rem; padding: 0.55rem 0.8rem; clip-path: polygon(12px 0, 100% 0, calc(100% - 12px) 100%, 0 100%); }
  .offer-warn:empty { display: none; }
  .offer-contact { color: var(--accent-ink); text-align: center; font-size: 0.9rem; margin-top: 0.9rem; }
  .offer-contact a { color: #2b1809; font-weight: 700; text-decoration: underline; }
  .offer-sign { color: var(--accent-ink); text-align: center; font-weight: 700; font-style: italic; margin-top: 0.5rem; }
  .offer-card .btn-magenta { background: linear-gradient(135deg, #2b1809, #160b03); color: #fbf3ec; filter: drop-shadow(0 5px 13px rgba(0, 0, 0, 0.4)); }
  .offer-card .btn-magenta:hover { filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.6)); }

  .modal-success { display: none; text-align: center; padding: 1rem 0.5rem; }
  .modal-success .check { width: 64px; height: 64px; margin: 0 auto 1rem; display: grid; place-items: center; border-radius: 50%; font-size: 2rem; font-weight: 800; color: var(--accent-ink); background: linear-gradient(135deg, var(--green), var(--cyan)); box-shadow: var(--glow-cyan); }
  .offer-card .modal-success h3, .offer-card .modal-success p { color: var(--accent-ink); }
  .offer-card[data-sent="true"] .modal-form, .offer-card[data-sent="true"] .modal-head { display: none; }
  .offer-card[data-sent="true"] .modal-success { display: block; }

  /* ---------- Mobile: stack CTAs, shallow slants, roomier card padding ---------- */
  @media (max-width: 600px) {
    #offer-toggle, #how-toggle { width: 100%; }
    .sell-h2 { font-size: clamp(2.2rem, 1.5rem + 4.5vw, 3.2rem); }
    .offer-card { clip-path: polygon(18px 0, 100% 0, calc(100% - 18px) 100%, 0 100%); padding: 2.25rem 1.85rem; }
    .how-card { clip-path: polygon(16px 0, 100% 0, calc(100% - 16px) 100%, 0 100%); padding: 2.25rem 1.85rem; }
    .offer-card .modal-head h3 { font-size: 1.7rem; }
    .how-title { font-size: 1.5rem; }
  }
</style>

<script>
  const offerWrap = document.getElementById("offer-inline");
  const offerToggle = document.getElementById("offer-toggle");
  const howWrap = document.getElementById("how-inline");
  const howToggle = document.getElementById("how-toggle");

  function closeOffer() {
    if (!offerWrap || !offerToggle) return;
    offerWrap.dataset.open = "false";
    offerToggle.setAttribute("aria-expanded", "false");
    offerToggle.innerHTML = "Sell my games →";
  }
  function closeHow() {
    if (!howWrap || !howToggle) return;
    howWrap.dataset.open = "false";
    howToggle.setAttribute("aria-expanded", "false");
    howToggle.textContent = "See how it works";
  }

  // "Sell my games" opens the offer form and hides "see how it works".
  offerToggle?.addEventListener("click", () => {
    const open = offerWrap?.dataset.open === "true";
    if (open) {
      closeOffer();
    } else {
      closeHow();
      if (offerWrap) offerWrap.dataset.open = "true";
      offerToggle.setAttribute("aria-expanded", "true");
      offerToggle.innerHTML = "Close form ✕";
    }
  });

  // "See how it works" opens the steps and hides the sell form.
  howToggle?.addEventListener("click", () => {
    const open = howWrap?.dataset.open === "true";
    if (open) {
      closeHow();
    } else {
      closeOffer();
      if (howWrap) howWrap.dataset.open = "true";
      howToggle.setAttribute("aria-expanded", "true");
      howToggle.textContent = "Hide steps";
    }
  });

  // Cash-offer form: Last name + Phone (and the rest) required, with live warnings.
  document.querySelectorAll<HTMLFormElement>("form[data-offer-form]").forEach((form) => {
    const card = form.closest<HTMLElement>(".offer-card");
    const warnEl = form.querySelector<HTMLParagraphElement>(".offer-warn");
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const get = (n: string) => form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${n}"]`);
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    let attempted = false;

    const val = (n: string) => (get(n)?.value || "").trim();
    function problem(): { msg: string; focus?: string } {
      const last = val("last");
      const phone = val("phone");
      if (!last && !phone) return { msg: "Phone number and last name required", focus: "last" };
      if (!last) return { msg: "Last name required", focus: "last" };
      if (!phone) return { msg: "Phone number required", focus: "phone" };
      if (!val("first")) return { msg: "First name required", focus: "first" };
      if (!emailRe.test(val("email"))) return { msg: "A valid email is required", focus: "email" };
      if (!val("items")) return { msg: "Please tell us what you have to sell", focus: "items" };
      return { msg: "" };
    }
    function refresh() {
      if (!attempted || !warnEl) return;
      const { msg } = problem();
      warnEl.textContent = msg;
      ["last", "phone", "first", "email", "items"].forEach((n) => {
        const el = get(n);
        if (el) el.classList.toggle("invalid", !val(n) && msg !== "");
      });
    }
    form.addEventListener("input", refresh);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const honey = form.querySelector<HTMLInputElement>('input[name="company"]');
      if (honey?.value) return;
      attempted = true;
      const { msg, focus } = problem();
      if (msg) {
        if (warnEl) warnEl.textContent = msg;
        refresh();
        if (focus) get(focus)?.focus();
        return;
      }
      if (warnEl) warnEl.textContent = "";

      const fd = new FormData(form);
      fd.set("name", `${val("first")} ${val("last")}`.trim());
      if (submit) { submit.disabled = true; submit.textContent = "Sending…"; }
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json", "X-Requested-With": "fetch" },
          body: fd,
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          (window as any).gtag?.("event", "generate_lead", { form_name: "cash_offer" });
          if (card) card.dataset.sent = "true";
          return;
        }
        throw new Error(data.error || "error");
      } catch {
        if (submit) { submit.disabled = false; submit.textContent = "Submit Your No Obligation Quote"; }
        if (warnEl) warnEl.textContent = "Something went wrong. Please try again or email timelaggaming@gmail.com.";
      }
    });
  });
</script>
