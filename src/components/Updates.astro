---
const joined = Astro.url.searchParams.get("club") === "1";
---

<section class="tl-band tl-band--angle-b updates" id="updates">
  <div class="tl-band-inner">
    <div class="container updates-inner">
      <h2>Want Updates?</h2>
      <p class="updates-sub">
        Get periodic updates about our progress — including videos from behind the
        scenes.
      </p>

      <form
        class="updates-form"
        data-club-form
        action="/api/contact"
        method="POST"
      >
        <input type="hidden" name="_redirect" value="/?club=1" />
        <input type="hidden" name="items" value="TimeLag Club newsletter signup" />
        <div class="hp" aria-hidden="true">
          <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="urow">
          <div class="tl-field">
            <label for="cf-first">First name <span class="tl-req">*</span></label>
            <input id="cf-first" class="tl-input" name="name" type="text" required placeholder="Jane" />
          </div>
          <div class="tl-field">
            <label for="cf-last">Last name</label>
            <input id="cf-last" class="tl-input" name="last" type="text" placeholder="Gamer" />
          </div>
        </div>

        <div class="urow">
          <div class="tl-field">
            <label for="cf-cemail">Email <span class="tl-req">*</span></label>
            <input id="cf-cemail" class="tl-input" name="email" type="email" required placeholder="you@email.com" />
          </div>
          <div class="tl-field">
            <label for="cf-cphone">Phone <span class="tl-opt">(optional)</span></label>
            <input id="cf-cphone" class="tl-input" name="phone" type="tel" placeholder="(503) 555-0100" />
          </div>
        </div>

        <div class="updates-actions">
          <button type="submit" class={`tl-btn tl-btn--dark join${joined ? " is-joined" : ""}`}>
            {joined ? "Joined ✓" : "Join the TimeLag Club →"}
          </button>
        </div>

        <p class="update-status" role="status" aria-live="polite">
          {joined ? "🎉 You're in! Watch your inbox for behind-the-scenes updates." : ""}
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .updates-inner {
    text-align: center;
    max-width: 920px;
  }
  .updates h2 {
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.4rem);
    color: var(--ink);
    margin-bottom: 0.6rem;
  }
  .updates-sub {
    color: #3c2012 !important;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    max-width: 46ch;
    margin: 0 auto 2.2rem;
  }

  .updates-form {
    text-align: left;
  }
  .urow {
    display: grid;
    gap: 1.1rem 1.6rem;
    margin-bottom: 1.2rem;
  }
  @media (min-width: 720px) {
    .urow {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .updates-actions {
    display: flex;
    justify-content: center;
    margin-top: 1.6rem;
  }
  .join.is-joined {
    cursor: default;
  }

  .update-status {
    text-align: center;
    margin-top: 1rem;
    min-height: 1.4em;
    font-weight: 700;
    color: #2b1710 !important; /* readable on orange */
  }
  .update-status:empty {
    margin: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-club-form]").forEach((form) => {
    const btn = form.querySelector<HTMLButtonElement>(".join");
    const status = form.querySelector<HTMLParagraphElement>(".update-status");

    form.addEventListener("submit", async (event) => {
      const honey = form.querySelector<HTMLInputElement>('input[name="company"]');
      if (honey?.value) {
        event.preventDefault();
        return;
      }
      if (!form.checkValidity()) return; // let the browser show validation
      event.preventDefault();

      if (btn) {
        btn.disabled = true;
        btn.textContent = "Joining…";
      }
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json", "X-Requested-With": "fetch" },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          if (btn) {
            btn.textContent = "Joined ✓";
            btn.classList.add("is-joined");
          }
          if (status) status.textContent = "🎉 You're in! Watch your inbox for behind-the-scenes updates.";
          return;
        }
        throw new Error(data.error || "error");
      } catch {
        if (btn) {
          btn.disabled = false;
          btn.textContent = "Join the TimeLag Club →";
        }
        if (status) status.textContent = "Hmm, that didn't go through — please try again.";
      }
    });
  });
</script>
