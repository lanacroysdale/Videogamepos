---
import "../styles/global.css";
import "../styles/app.css";
import ThemeInit from "../components/ThemeInit.astro";
import OwnerToggle from "../components/OwnerToggle.astro";
import GbFilter from "../components/GbFilter.astro";

interface Props {
  title: string;
  active?:
    | "dashboard" | "leads" | "checkout" | "tradein" | "inventory" | "returns"
    | "repairs" | "schedule" | "customers" | "reports" | "pricing" | "settings" | "todos" | "sops" | "menu" | "tabs" | "scan";
}
const { title, active } = Astro.props;

const profile = Astro.locals.profile;
const isManager = !!profile && ["owner", "manager"].includes(profile.role);

// F&B features (Menu builder + Tabs) gate on the Food & Beverage *department*
// being enabled (Settings → Departments) — the department list is the spine.
// Falls back to the legacy settings.menuEnabled flag until the departments
// migration runs. Off by default so a retail-only license shows neither.
let fnbEnabled = false;
let menuSections: { id: string; name: string }[] = [];
{
  const { data: dept } = await Astro.locals.supabase.from("store_departments").select("is_enabled").eq("key", "food_bev").maybeSingle();
  if (dept) {
    fnbEnabled = dept.is_enabled === true;
  } else {
    const { data: ss } = await Astro.locals.supabase.from("store_settings").select("settings").eq("id", 1).maybeSingle();
    fnbEnabled = (ss?.settings as any)?.menuEnabled === true;
  }
  if (isManager && fnbEnabled) {
    const { data: secs } = await Astro.locals.supabase.from("menu_sections").select("id, name").eq("is_active", true).order("sort_order").order("name");
    menuSections = secs ?? [];
  }
}

const nav = [
  { key: "dashboard", label: "Dashboard", href: "/dashboard", icon: "🏠" },
  { key: "leads", label: "Leads", href: "/leads", icon: "📥" },
  { key: "checkout", label: "Checkout", href: "/checkout", icon: "🧾" },
  ...(fnbEnabled ? [{ key: "tabs", label: "Tabs", href: "/tabs", icon: "🍻" }] : []),
  { key: "tradein", label: "Trade-In", href: "/trade-in", icon: "🔁" },
  { key: "returns", label: "Returns", href: "/returns", icon: "↩️" },
  { key: "inventory", label: "Inventory", href: "/inventory", icon: "📦" },
  { key: "repairs", label: "Repairs", href: "/repairs", icon: "🛠️" },
  { key: "customers", label: "Customers", href: "/customers", icon: "🧑" },
  { key: "schedule", label: "Schedule", href: "/schedule", icon: "📅" },
  { key: "todos", label: "To-dos", href: "/todos", icon: "✅" },
  { key: "sops", label: "SOPs", href: "/sops", icon: "📋" },
  { key: "scan", label: "Scan", href: "/scan", icon: "📱" },
  ...(isManager
    ? [
        { key: "reports", label: "Reports", href: "/reports", icon: "📊" },
        { key: "pricing", label: "Pricing", href: "/pricing", icon: "🏷️" },
      ]
    : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <ThemeInit scope="pos" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Time Lag POS</title>
  </head>
  <body class="app-body">
    <div class="app-shell">
      <aside class="app-side">
        <a href="/dashboard" class="app-brand"><span class="app-brand-ico">🎮</span> Time&nbsp;Lag <span>POS</span></a>
        <nav class="app-nav">
          {isManager && fnbEnabled && (
            <div class="nav-menu" id="nav-menu">
              <div class="nav-menu-head">
                <a href="/menu" class:list={["nav-menu-link", { active: active === "menu" }]}>
                  <span class="ico" aria-hidden="true">🍔</span><span class="label">Menu</span>
                </a>
                {menuSections.length > 0 && (
                  <button class="nav-menu-caret" id="nav-menu-caret" type="button" aria-label="Show menu sections">▾</button>
                )}
              </div>
              {menuSections.length > 0 && (
                <ul class="nav-subnav" id="nav-subnav">
                  {menuSections.map((s) => (
                    <li><a href={`/menu?s=${s.id}`}><span class="label">{s.name}</span></a></li>
                  ))}
                </ul>
              )}
            </div>
          )}
          {
            nav.map((item) => (
              <a href={item.href} class={active === item.key ? "active" : ""}>
                <span class="ico" aria-hidden="true">{item.icon}</span>
                <span class="label">{item.label}</span>
                {item.key === "leads" && <span class="nav-badge" id="leads-badge" hidden>0</span>}
                {item.key === "inventory" && <span class="nav-badge warn" id="inv-badge" title="Listings needing images or data" hidden>0</span>}
                {item.key === "todos" && <span class="nav-badge open" id="todos-badge" title="Open tasks" hidden>0</span>}
                {item.key === "sops" && <span class="nav-badge" id="sops-badge" title="SOPs pending your approval" hidden>0</span>}
              </a>
            ))
          }
        </nav>
        <script is:inline>
          // Menu sub-nav open state, per device. Default-open when this device has
          // Menu set as its primary mode (Settings → Food & Beverage); the caret
          // overrides + remembers. Runs inline to avoid a flash.
          (function () {
            var wrap = document.getElementById("nav-menu");
            var caret = document.getElementById("nav-menu-caret");
            if (!wrap || !caret) return;
            var g = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
            var s = function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} };
            var pref = g("tl-menu-open");
            var open = pref === null ? g("tl-menu-primary") === "1" : pref === "1";
            wrap.classList.toggle("open", open);
            caret.addEventListener("click", function () { open = !open; s("tl-menu-open", open ? "1" : "0"); wrap.classList.toggle("open", open); });
          })();
        </script>
        <div class="app-user">
          <div class="who">{profile?.full_name ?? "—"}</div>
          <div class="role">{profile?.role ?? ""}</div>
          <button id="alerts-btn" class="btn btn-ghost btn-sm" type="button" style="display:none">🔔 Enable alerts</button>
          <div class="app-user-actions">
            <form method="POST" action="/logout" class="logout-form">
              <button class="btn btn-ghost btn-sm" type="submit">Log out</button>
            </form>
            {isManager && (
              <a href="/settings" class:list={["btn", "btn-ghost", "btn-sm", "settings-icon", { active: active === "settings" }]} title="Settings" aria-label="Settings">⚙️</a>
            )}
          </div>
        </div>
      </aside>

      <main class="app-main">
        <header class="app-top">
          <h1>{title}</h1>
          <div class="top-actions"><slot name="actions" /></div>
        </header>
        <div class="app-content">
          <slot />
        </div>
      </main>
    </div>
    <OwnerToggle />
    <GbFilter />

    <style>
      .app-nav a { display: flex; align-items: center; }
      .nav-menu-head { display: flex; align-items: center; }
      .nav-menu-head .nav-menu-link { flex: 1; min-width: 0; }
      .nav-menu-caret { flex: none; background: none; border: none; color: var(--sb-ink-dim); cursor: pointer; padding: 0.5rem 0.7rem; font-size: 0.7rem; line-height: 1; transition: transform .15s; }
      .nav-menu.open .nav-menu-caret { transform: rotate(180deg); }
      .nav-subnav { list-style: none; margin: 0; padding: 0; max-height: 0; overflow: hidden; transition: max-height .22s ease; }
      .nav-menu.open .nav-subnav { max-height: 55vh; overflow-y: auto; margin-bottom: 0.25rem; }
      .nav-subnav a { padding: 0.28rem 0.7rem 0.28rem 2.6rem; font-size: 0.84rem; color: var(--sb-ink-dim); }
      .nav-subnav a:hover { color: var(--sb-ink); background: rgba(127,127,127,0.12); }
      .nav-badge {
        margin-left: auto;
        min-width: 1.5em;
        padding: 0 0.45em;
        border-radius: 999px;
        background: var(--magenta, #ff49d0);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 800;
        line-height: 1.55;
        text-align: center;
      }
      .nav-badge.warn { background: var(--yellow, #ffd23f); color: #3a2c00; }
      .nav-badge.open { background: var(--green, #5aa6b8); color: #04222a; }
      #alerts-btn { margin-bottom: 0.4rem; width: 100%; }
      .app-user-actions { display: flex; gap: 0.5rem; align-items: stretch; }
      .app-user-actions .logout-form { flex: 1; min-width: 0; }
      .app-user-actions .logout-form button { width: 100%; }
      .settings-icon { flex: none; }
    </style>

    <script is:inline>
      // In-app lead alerts: poll for new leads while the POS is open, update the
      // nav badge with the count of unworked ('new') leads, and fire a desktop
      // notification for each lead that arrived since this browser last checked.
      (function () {
        var KEY = "tl_leads_seen_id";
        var badge = document.getElementById("leads-badge");
        var alertsBtn = document.getElementById("alerts-btn");
        var seen = function () { return parseInt(localStorage.getItem(KEY) || "0", 10) || 0; };
        var setSeen = function (v) { localStorage.setItem(KEY, String(v)); };

        function syncBtn() {
          if (!alertsBtn) return;
          // Blocked or unsupported → hide it entirely (a dead "Alerts blocked"
          // button is pointless; the nav badges are the in-app inbox). Only show
          // it when it's actionable (Enable) or informative (On).
          if (!("Notification" in window) || Notification.permission === "denied") { alertsBtn.style.display = "none"; return; }
          alertsBtn.style.display = "";
          if (Notification.permission === "granted") { alertsBtn.textContent = "🔔 Alerts on"; alertsBtn.disabled = true; }
          else { alertsBtn.textContent = "🔔 Enable alerts"; alertsBtn.disabled = false; }
        }
        if (alertsBtn) {
          syncBtn();
          alertsBtn.addEventListener("click", function () {
            if (!("Notification" in window)) return;
            Notification.requestPermission().then(syncBtn);
          });
        }

        function notify(lead) {
          if (!("Notification" in window) || Notification.permission !== "granted") return;
          var who = ((lead.first_name || "") + " " + (lead.last_name || "")).trim() || "Someone";
          var kind = lead.type === "sell_request" ? "Sell request" : "Free Club signup";
          var n = new Notification("🎮 New " + kind, { body: who, tag: "tl-lead-" + lead.human_id });
          n.onclick = function () { window.focus(); window.location.href = "/leads"; n.close(); };
        }

        function paint(count) {
          if (!badge) return;
          if (count > 0) { badge.textContent = String(count); badge.hidden = false; }
          else { badge.hidden = true; }
        }

        var firstRun = seen() === 0; // don't replay the whole backlog as notifications

        var invBadge = document.getElementById("inv-badge");
        function pollInventoryHealth() {
          if (!invBadge) return;
          fetch("/api/pos/inventory-health", { headers: { "x-requested-with": "fetch" } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (j) {
              if (!j || !j.ok) return;
              if (j.count > 0) { invBadge.textContent = String(j.count); invBadge.hidden = false; }
              else { invBadge.hidden = true; }
            })
            .catch(function () {});
        }

        // Open-task badge + manager alerts on freshly-completed tasks.
        var todosBadge = document.getElementById("todos-badge");
        var TKEY = "tl_tasks_seen";
        function notifyTask(t) {
          if (!("Notification" in window) || Notification.permission !== "granted") return;
          var n = new Notification("✅ Task completed", { body: t.title, tag: "tl-task-" + t.id });
          n.onclick = function () { window.focus(); window.location.href = "/todos"; n.close(); };
        }
        function pollTasks() {
          var since = localStorage.getItem(TKEY) || "";
          fetch("/api/pos/task-stats" + (since ? "?since=" + encodeURIComponent(since) : ""), { headers: { "x-requested-with": "fetch" } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (j) {
              if (!j || !j.ok) return;
              if (todosBadge) {
                if (j.openCount > 0) { todosBadge.textContent = String(j.openCount); todosBadge.hidden = false; }
                else { todosBadge.hidden = true; }
              }
              (j.fresh || []).forEach(notifyTask); // server only returns these when notify is on + viewer is a manager
              localStorage.setItem(TKEY, new Date().toISOString());
            })
            .catch(function () {});
        }

        // SOPs awaiting the owner's approval (server returns 0 for non-owners).
        var sopsBadge = document.getElementById("sops-badge");
        function pollSops() {
          if (!sopsBadge) return;
          fetch("/api/pos/sops", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: "pending-count" }) })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (j) {
              if (!j || !j.ok) return;
              if (j.count > 0) { sopsBadge.textContent = String(j.count); sopsBadge.hidden = false; }
              else { sopsBadge.hidden = true; }
            })
            .catch(function () {});
        }

        function poll() {
          fetch("/api/pos/leads?since=" + seen(), { headers: { "x-requested-with": "fetch" } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (j) {
              if (!j || !j.ok) return;
              paint(j.newCount || 0);
              if (j.maxId > seen()) {
                if (!firstRun) (j.fresh || []).forEach(notify);
                setSeen(j.maxId);
              }
              firstRun = false;
            })
            .catch(function () {});
          pollInventoryHealth();
          pollTasks();
          pollSops();
        }

        poll();
        setInterval(poll, 30000);
      })();
    </script>
  </body>
</html>
