---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../consts";
import { fmt } from "../../lib/money";
import { createSupabaseAdminClient } from "../../lib/supabase";
import { listGallery } from "../../lib/storage";
import { ebayItemUrl } from "../../lib/ebay";

// Product detail page — the SEO surface. Server-rendered, indexable (no
// noindex), with a Product JSON-LD block + auto description/trailer. Currently
// gated behind login pre-launch (middleware gates /shop/*); the SEO machinery
// is baked in and goes crawlable the moment that gate is removed at launch.
const { slug } = Astro.params;
const admin = createSupabaseAdminClient();
const { data: product } = await admin
  .from("products")
  .select(
    "id, title, slug, platform, franchise, genre, description, image_url, trailer_url, tags, product_variants(id, condition, completeness_code, grade_code, price_cents, online_price_cents, quantity, online_visible)",
  )
  .eq("slug", slug)
  .maybeSingle();

if (!product) Astro.response.status = 404;

const variants = (product?.product_variants ?? [])
  .filter((v: any) => v.online_visible && v.quantity > 0)
  .map((v: any) => ({ ...v, displayCents: v.online_price_cents ?? v.price_cents }))
  .sort((a: any, b: any) => a.displayCents - b.displayCents);

const comp: Record<string, string> = {};
const grade: Record<string, string> = {};
if (product) {
  const [{ data: cl }, { data: cg }] = await Promise.all([
    admin.from("completeness_levels").select("code,label"),
    admin.from("condition_grades").select("code,label,icon"),
  ]);
  (cl ?? []).forEach((c: any) => (comp[c.code] = c.label));
  (cg ?? []).forEach((g: any) => (grade[g.code] = (g.icon ? g.icon + " " : "") + g.label));
}
const condLabel = (v: any) =>
  [comp[v.completeness_code], grade[v.grade_code]].filter(Boolean).join(" · ") || v.condition;

// Image gallery — stored as a per-product folder in Storage (eBay imports copy
// the full set there). Falls back to the single cover image.
const gallery = product ? await listGallery(admin, product.id) : [];
const images = gallery.length ? gallery : product?.image_url ? [product.image_url] : [];
const mainImage = images[0] || product?.image_url || null;

// "About this game" reads wrong for consoles/accessories — label by category.
const aboutHeading =
  product?.genre || product?.franchise ? "About this game" : "About this item";

// "View on eBay" — reconstruct the listing URL from the ebay:<id> tag.
const ebayId = product
  ? (product.tags ?? []).find((t: string) => t.startsWith("ebay:"))?.slice(5)
  : null;
const ebayUrl = ebayId ? ebayItemUrl(ebayId) : null;

function ytEmbed(url: string | null | undefined) {
  if (!url) return null;
  const m = url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : null;
}
const trailer = ytEmbed(product?.trailer_url);

const lowest = variants.length ? variants[0].displayCents : null;
const tags = product ? [product.platform, product.genre, product.franchise].filter(Boolean) : [];
const jsonLd = product
  ? {
      "@context": "https://schema.org",
      "@type": "Product",
      name: product.title,
      ...(product.image_url ? { image: product.image_url } : {}),
      ...(product.description ? { description: product.description } : {}),
      category: product.genre || "Video Games",
      ...(lowest != null
        ? {
            offers: {
              "@type": "Offer",
              price: (lowest / 100).toFixed(2),
              priceCurrency: "USD",
              availability: "https://schema.org/InStock",
              seller: { "@type": "Store", name: SITE.name },
            },
          }
        : {}),
    }
  : null;

const metaDesc = product?.description
  ? product.description.slice(0, 155)
  : product
    ? `${product.title}${product.platform ? ` for ${product.platform}` : ""} — in stock at ${SITE.name}, ${SITE.location}.`
    : "Not found";
---

{
  !product ? (
    <Layout title="Not found">
      <section class="section--tight">
        <div class="container narrow" style="text-align:center;padding:3rem 0;">
          <h1>We couldn’t find that item</h1>
          <p class="lead">It may have sold or the link is out of date.</p>
          <a href="/shop" class="btn btn-primary">Back to the shop</a>
        </div>
      </section>
    </Layout>
  ) : (
    <Layout title={product.title} description={metaDesc} image={product.image_url || undefined}>
      <section class="section--tight pdp">
        <div class="container">
          <a href="/shop" class="pdp-back">← All items</a>
          <div class="pdp-grid">
            <div class="pdp-media">
              {mainImage ? (
                <div class="pdp-frame">
                  <img class="pdp-cover-bg" id="pdp-main-bg" src={mainImage} alt="" aria-hidden="true" />
                  <img class="pdp-cover" id="pdp-main" src={mainImage} alt={product.title} />
                </div>
              ) : (
                <div class="pdp-frame pdp-ph" aria-hidden="true">🎮</div>
              )}
              {images.length > 1 && (
                <div class="pdp-thumbs">
                  {images.map((u, i) => (
                    <button class:list={["pdp-thumb", { active: i === 0 }]} data-full={u} aria-label={`Photo ${i + 1}`}>
                      <img src={u} alt="" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </div>

            <div class="pdp-info">
              {product.platform && <span class="eyebrow">{product.platform}</span>}
              <h1 class="pdp-title">{product.title}</h1>
              <div class="pdp-tags">
                {tags.map((t) => <span class="pdp-tag">{t}</span>)}
              </div>

              {variants.length > 0 ? (
                <div class="pdp-prices">
                  {variants.map((v) => (
                    <div class="pdp-price-row">
                      <span class="pdp-cond">{condLabel(v)}</span>
                      <span class="pdp-price">{fmt(v.displayCents)}</span>
                      <span class="pdp-stock">{v.quantity <= 3 ? "Only " + v.quantity + " left" : "In stock"}</span>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="muted">Not currently listed online — ask us about availability.</p>
              )}

              <div class="pdp-cta">
                <a href={SITE.phoneHref} class="btn btn-primary">Call to reserve · {SITE.phoneDisplay}</a>
                {ebayUrl && (
                  <a href={ebayUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">View on eBay ↗</a>
                )}
                <a href="/#journey" class="btn btn-ghost">Visit us in {SITE.location}</a>
              </div>
            </div>
          </div>

          {product.description && (
            <div class="pdp-section">
              <h2>{aboutHeading}</h2>
              <p class="pdp-desc">{product.description}</p>
            </div>
          )}

          {trailer && (
            <div class="pdp-section">
              <h2>Trailer</h2>
              <div class="pdp-video">
                <iframe
                  src={trailer}
                  title={product.title + " trailer"}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          )}
        </div>
      </section>

      {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    </Layout>
  )
}

<script>
  // Gallery: click a thumbnail to swap the main image (+ its blurred backdrop).
  const main = document.getElementById("pdp-main") as HTMLImageElement | null;
  const mainBg = document.getElementById("pdp-main-bg") as HTMLImageElement | null;
  if (main) {
    document.querySelectorAll<HTMLButtonElement>(".pdp-thumb").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!btn.dataset.full) return;
        main.src = btn.dataset.full;
        if (mainBg) mainBg.src = btn.dataset.full;
        document.querySelector(".pdp-thumb.active")?.classList.remove("active");
        btn.classList.add("active");
      });
    });
  }
</script>

<style>
  .pdp-back { display:inline-block; color:var(--muted); font-size:0.88rem; margin-bottom:1.2rem; }
  .pdp-back:hover { color:var(--cyan); }
  .pdp-grid { display:grid; gap:clamp(1.5rem,1rem+3vw,3rem); align-items:start; }
  @media (min-width:760px) { .pdp-grid { grid-template-columns:0.9fr 1.1fr; } }
  .pdp-media { display:flex; flex-direction:column; gap:0.7rem; }
  /* Blurred fill — whole cover (contain) over a soft blur of itself; no crop, no bars. */
  .pdp-frame { position:relative; aspect-ratio:1/1; overflow:hidden; border:1px solid var(--border); background:#0b0b14; }
  .pdp-cover-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:blur(26px) brightness(0.5) saturate(1.15); transform:scale(1.2); }
  .pdp-cover { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; z-index:1; }
  .pdp-ph { display:grid; place-items:center; font-size:4rem; opacity:0.5; }
  .pdp-thumbs { display:flex; flex-wrap:wrap; gap:0.45rem; }
  .pdp-thumb { width:62px; height:62px; padding:0; border:1px solid var(--border); background:#0b0b14; cursor:pointer; overflow:hidden; transition:border-color .15s; }
  .pdp-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
  .pdp-thumb:hover { border-color:var(--muted); }
  .pdp-thumb.active { border-color:var(--cyan); }
  .pdp-title { font-size:clamp(1.9rem,1.4rem+2.4vw,3rem); margin:0.5rem 0 0.7rem; text-wrap:balance; }
  .pdp-tags { display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom:1.3rem; }
  .pdp-tag { font-size:0.78rem; padding:0.15rem 0.6rem; border-radius:999px; background:rgba(255,255,255,.06); color:var(--muted); }
  .pdp-prices { display:grid; gap:0.5rem; margin-bottom:1.5rem; }
  .pdp-price-row { display:flex; align-items:baseline; gap:0.8rem; padding:0.6rem 0.9rem; border:1px solid var(--border); border-radius:10px; background:rgba(255,255,255,.02); }
  .pdp-cond { font-weight:600; }
  .pdp-price { margin-left:auto; font-family:var(--font-mono); font-weight:800; font-size:1.2rem; }
  .pdp-stock { color:var(--green); font-size:0.78rem; font-weight:700; }
  .pdp-cta { display:flex; flex-wrap:wrap; gap:0.7rem; }
  .pdp-section { margin-top:2.5rem; max-width:760px; }
  .pdp-section h2 { font-size:clamp(1.3rem,1.1rem+1vw,1.8rem); margin-bottom:0.8rem; }
  .pdp-desc { color:var(--muted); text-wrap:pretty; white-space:pre-line; line-height:1.65; }
  .pdp-video { position:relative; aspect-ratio:16/9; border-radius:var(--radius); overflow:hidden; border:1px solid var(--border); }
  .pdp-video iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }
  .narrow { max-width:680px; margin-inline:auto; }
</style>
