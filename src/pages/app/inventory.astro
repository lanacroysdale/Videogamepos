    const comp = compVal($("np-comp") as HTMLInputElement);
    const grade = ($("np-grade") as HTMLSelectElement).value;
    const condition = [completeness.find((c) => c.code === comp)?.label, grades.find((g) => g.code === grade)?.label].filter(Boolean).join(" ") || "Used";
    const body = {
      action: "addProduct",
      title: ($("np-title") as HTMLInputElement).value,
      platform: ($("np-platform") as HTMLInputElement).value,
      // Region select only exists when regions are on (else no key at all).
      regionCode: (document.getElementById("np-region") as HTMLSelectElement | null)?.value || undefined,
      categoryId: ($("np-cat") as HTMLSelectElement).value,
      condition, completenessCode: comp, gradeCode: grade,
      priceCents: Math.round(parseFloat(($("np-price") as HTMLInputElement).value) * 100) || 0,
      quantity: parseInt(($("np-qty") as HTMLInputElement).value) || (staged ? 1 : 0),
      unitCostCents: (() => { const c = ($("np-cost") as HTMLInputElement).value.trim(); return c === "" ? null : toCents(c); })(),
      barcode: ($("np-barcode") as HTMLInputElement).value || null,
      inventoryTypeId: (document.getElementById("np-invtype") as HTMLSelectElement | null)?.value || undefined,
      // In entry mode the qty is STAGED on the draft (variant starts at 0);
      // a quick add is recorded on the ⚡ Quick adds entry of this local day.
      ...(staged ? { stageEntryId: entryId } : { receivedOn: localDate() }),
    };
    if (!body.title || !body.categoryId) { alert("Title and category required"); return; }
    const saveBtn = $("np-save") as HTMLButtonElement;
    npBusy = true; saveBtn.disabled = true;
    if (staged) entBusyStep(1); // Finish waits for a line still saving
    let j: any;
    try { j = await api(body); }
    catch (e: any) { alert(e.message); return; }
    finally { npBusy = false; saveBtn.disabled = false; if (staged) entBusyStep(-1); }
    try {
      const cat = categories.find((c: any) => c.id === body.categoryId);
      // Title / platform / region as STORED (a "PAL …" platform prefix or a
      // typed "[JP]" tag becomes the region).
      const newItem: any = { id: j.productId, title: j.title ?? body.title, slug: j.slug || body.title.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, ""), platform: j.platform ?? body.platform, regionCode: j.regionCode ?? "", franchise: "", genre: "", description: "", imageUrl: "", altNames: [], categoryId: body.categoryId, categoryName: cat?.name ?? "", categoryColor: cat?.color ?? "#2ce6e0",
        variants: [{ id: j.variantId, condition, completeness: null, completenessCode: comp, gradeCode: grade, sku: null, internalCode: j.internalCode || "", labelCode: j.labelCode || "", priceCents: body.priceCents, onlinePriceCents: null, costCents: body.unitCostCents, quantity: body.quantity, onlineVisible: false, inventoryTypeId: body.inventoryTypeId || retailTypeId, locationId: "", barcodes: body.barcode ? [{ id: "primary:" + j.variantId, barcode: body.barcode, label: "Primary", primary: true }] : [] }] };
      items.push(newItem);
      if (staged && j.itemId) {
        // Staged: server created the variant at qty 0; the qty lands on Finish.
        newItem.variants[0].quantity = 0;
        entRows.push({
          itemId: j.itemId, variantId: j.variantId, qty: body.quantity || 1, costCents: body.unitCostCents,
          priceCents: body.priceCents, wasNew: true, supplier: null, title: newItem.title,
          platform: newItem.platform || newItem.categoryName || "", regionCode: newItem.regionCode, cond: condLabel(newItem.variants[0]),
          completenessCode: comp || "", gradeCode: grade || "", kind: "stock",
          inventoryTypeId: newItem.variants[0].inventoryTypeId || body.inventoryTypeId || retailTypeId,
        });
        // A listing made on the draft screen is hidden until the draft is finished.
        newItem.pendingEntryId = entryId;
        newItem.pendingVariants = newItem.variants.map((v: any) => ({ ...v, pendingEntryId: entryId }));
        newItem.variants = [];
        renderEnt();
        ($("ent-search") as HTMLInputElement).value = "";
      }
      // Ready for the next one: title, price, barcode and the eBay paste
      // clear; platform, region, category, condition and type stay.
      const pe = pendingEbay; // this product's eBay listing (attached below)
      const ps = pendingSource; // …or the shop page it came from (🔖 Send to TimeLag)
      clearProductFields();
      addSaved = true;
      setAddOpen(true);
      ($("inv-search") as HTMLInputElement).value = ""; state.q = ""; state.parsed = null; renderSmart();
      render();
      const focusNext = () => (document.getElementById("np-title") as HTMLInputElement | null)?.focus();
      const where = staged ? ` to Entry #${entryHuman}` : j.quickEntry ? ` · ⚡ Quick adds (Entry #${j.quickEntry.humanId})` : "";
      if (j.quickError) alert(`Added to stock, but it couldn't be recorded on today's ⚡ Quick adds entry:\n${j.quickError}`);
      // A quick add is in stock now → print its labels right away.
      const v0 = newItem.variants[0];
      if (!staged && body.quantity > 0 && v0) {
        await fillLabelCodes([v0]);
        openPrintDialog([{ item: labelItemOf(newItem, v0), defaultCopies: body.quantity, allCopies: body.quantity }], lblTemplates,
          { title: `Print · ${rgTitle(newItem)}`, onClose: focusNext });
      } else focusNext();
      if (pe) {
        // Sell Similar: the listing's cover photo + item specifics it doesn't
        // have (a reference tag — never synced). A game then also gets the
        // game database's description / trailer / names (empty fields only).
        toast(`✓ Added${where} — copying the eBay photo…`);
        try {
          const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" },
            body: JSON.stringify({ mode: "attach", productId: newItem.id, variantId: j.variantId, input: pe.input }) });
          const e = await r.json();
          if (r.ok && e.ok) {
            if (e.imageUrl) newItem.imageUrl = e.imageUrl;
            for (const k of ["franchise", "genre", "brand", "description"]) if (e.fields?.[k]) newItem[k] = e.fields[k];
            if (String(e.tag || "").startsWith("ebay:")) newItem.ebayId = String(e.tag).slice(5);
            else if (String(e.tag || "").startsWith("ebay-ref:")) newItem.ebayRefId = String(e.tag).slice(9);
            if (e.supplier) newItem.supplierLinks = [...(newItem.supplierLinks || []), e.supplier];
            render();
            toast(`${e.imageUrl ? "🛒 Added with the eBay photo" : "✓ Added from eBay"}${where}`);
          } else { toast(`✓ Added${where} (eBay photo failed: ${e.error || "?"})`); }
        } catch { toast(`✓ Added${where}`); }
        if (pe.group === "games") {
          try {
            // The description is the full eBay title — the game's summary goes under it.
            const g = await enrich({ productId: newItem.id, title: newItem.title, platform: newItem.platform, appendDescription: true });
            if (g.ok && g.found) {
              if (g.altNames?.length) newItem.altNames = g.altNames;
              if (g.description) newItem.description = newItem.description ? `${newItem.description}\n\n${g.description}` : g.description;
              render();
            }
          } catch { /* the eBay photo + details are already on */ }
        }
      } else {
        if (ps) {
          // 🔖 From another shop: its photo (copied to our storage, renamed) and
          // the page as a supplier link with the shop's title (managers only).
          // Before the game database fills the rest.
          toast(`✓ Added${where} — copying the photo…`);
          // PriceCharting's codes only if its prefilled barcode was kept (cleared / changed = not this item's).
          if ((body.barcode || "") !== (ps.codes?.[0] || "")) ps.codes = [];
          try {
            const r = await fetch("/api/pos/source-import", { method: "POST", headers: { "content-type": "application/json" },
              body: JSON.stringify({ mode: "attach", productId: newItem.id, source: ps, market: ps.market || undefined }) });
            const e = await r.json();
            if (r.ok && e.ok) {
              if (e.imageUrl) newItem.imageUrl = e.imageUrl;
              if (e.supplier) newItem.supplierLinks = [...(newItem.supplierLinks || []), e.supplier];
              if (e.market) newItem.marketPrices = e.market;
              // Every code PriceCharting lists is the listing's now.
              for (const a of e.codes?.added || []) if (!(newItem.upcs || []).some((u: any) => u.upc === a.upc)) newItem.upcs = [...(newItem.upcs || []), { ...a, evidence: "From PriceCharting" }];
              if (e.codes?.conflicts?.length) toast(`Some codes are already on other listings: ${e.codes.conflicts.slice(0, 2).join("; ")}`);
              if (e.marketError) alert(e.marketError);
              if (e.market?.id) newItem.pcId = e.market.id;
              render();
            }
          } catch { /* the listing is saved; the photo can be added by hand */ }
        }
        toast(`✓ Added${where} — fetching cover…`);
        // Auto-enrich from IGDB: cover art, description, trailer, alt-names.
        try {
          const e = await enrich({ productId: newItem.id, title: newItem.title, platform: newItem.platform });
          if (e.ok && e.found) {
            if (e.imageUrl) newItem.imageUrl = e.imageUrl;
            if (e.altNames?.length) newItem.altNames = e.altNames;
            if (e.description) newItem.description = e.description;
            render();
            toast(`${e.imageUrl ? "🎮 Cover added from IGDB" : "✓ Details added from IGDB"}${where}`);
          } else { toast(`✓ Added${where}`); }
        } catch { toast(`✓ Added${where}`); }
      }
      // Its UPC (the one typed/scanned into Barcode counts; else eBay's catalog).
      upcFillInBackground([newItem.id]);
    } catch (e: any) { alert(e.message); }
  });

  /* ---------- eBay import ---------- */
  let pendingEbay: any = null;

  /* ---------- Market prices (PriceCharting) ----------
     Saved on a listing when it's added from its PriceCharting page. A copy's
     price follows its condition: Loose / Complete / New… → that average. */
  const marketPriceFor = (m: any, compCode: string): number | null => {
    if (!m) return null;
    const key = marketKeyFor(completeness.find((c: any) => c.code === compCode)?.label || compCode);
    const v = key ? Number(m[key]) : NaN;
    return Number.isFinite(v) && v > 0 ? v : null;
  };
  const marketLine = (m: any, clickable = false) => !m ? "" : MARKET_KEYS.filter((k) => Number(m[k]) > 0 && k !== "graded")
    .map((k) => clickable ? `<button type="button" class="link-btn" data-mkt="${k}">${MARKET_LABELS[k]} ${money(m[k])}</button>` : `${MARKET_LABELS[k]} ${money(m[k])}`).join(" · ");
  // The Add form: a PriceCharting import's prices, and whether a price was typed by hand.
  let pendingMarket: any = null;
  let npPriceTouched = false;
  function priceFromMarket() {
    if (!pendingMarket || npPriceTouched) return;
    // A condition PriceCharting has no average for → no price (not the last one's).
    const c = marketPriceFor(pendingMarket, compVal($("np-comp") as HTMLInputElement));
    ($("np-price") as HTMLInputElement).value = c != null ? (c / 100).toFixed(2) : "";
  }
  $("np-price")?.addEventListener("input", () => { npPriceTouched = true; });
  $("np-comp")?.addEventListener("input", priceFromMarket);
  $("np-comp")?.addEventListener("change", priceFromMarket);
  $("np-comp")?.addEventListener("blur", () => setTimeout(priceFromMarket, 0));

  /* ---------- 🔖 Send to TimeLag: a product from another shop's page ----------
     The bookmark reads the page in the browser it's open in (Suruga-ya etc.
     can't be read from our server) and opens /inventory?import=page here:
     the full page arrives by postMessage, a compact copy in the #fragment.
     The server cleans it into Add-form fields; on Save the photo, the page
     (as a supplier link, managers only) and the original title are attached. */
  let pendingSource: any = null;
  function openBookmarkDialog() {
    document.getElementById("bm-dialog")?.remove();
    const ov = document.createElement("div");
    ov.id = "bm-dialog";
    ov.className = "upc-pick";
    ov.setAttribute("role", "dialog");
    ov.setAttribute("aria-modal", "true");
    ov.innerHTML = `<div class="upc-pick-card bm-card">
      <h3>🔖 Send to TimeLag</h3>
      <p class="muted">Add products from <strong>PriceCharting</strong> (its UPC + Loose / Complete / New averages), <strong>Suruga-ya</strong>, <strong>Buyee</strong> (Yahoo! Auctions, Mercari…), Amazon JP or any shop. Dragged it in before? Drag it again — new sites need the new copy. The bookmark reads the page you're looking at, in your own browser, so nothing visits that shop from our server.</p>
      <ol class="bm-steps">
        <li><strong>Drag this button</strong> onto your bookmarks bar: <a class="bm-link" id="bm-link" draggable="true">🔖 Send to TimeLag</a>
          <br><span class="muted bm-small">And for PriceCharting: <a class="bm-link" id="bm-link-pc" draggable="true">📈 Update from PriceCharting</a> — on a PriceCharting game page it goes <em>straight into</em> the matching listing (today's averages, barcodes, photo), or creates it with 0 in stock.</span></li>
        <li>On a product page, <strong>click the bookmark</strong>. A POS tab opens with this form filled in: a clean English title, platform, region, condition, JAN and what you paid in dollars.</li>
        <li><strong>Check it, set your price, Save.</strong> The photo is copied into our own storage under a new name; the page is kept as the item's source (managers only, never on the website).</li>
      </ol>
      <p class="muted bm-small">No bookmarks bar? Chrome / Edge / Firefox: ⌘⇧B (Ctrl+Shift+B) · Safari: View → Show Favorites Bar. Can't drag it? <button type="button" class="link-btn" id="bm-copy">Copy the code</button>, make a new bookmark and paste it as its address (URL).</p>
      <div class="upc-pick-acts"><button type="button" class="btn btn-ghost btn-sm" id="bm-close">Close</button></div>
    </div>`;
    document.body.appendChild(ov);
    const href = bookmarkletHref(location.origin);
    const link = ov.querySelector<HTMLAnchorElement>("#bm-link")!;
    link.href = href;
    const linkPc = ov.querySelector<HTMLAnchorElement>("#bm-link-pc")!;
    linkPc.href = bookmarkletHref(location.origin, "pc-update");
    // Clicked here (not dragged) they would just run on the POS.
    for (const a of [link, linkPc]) a.addEventListener("click", (e) => { e.preventDefault(); toast("Drag it to your bookmarks bar — then click it on a product page"); });
    ov.querySelector("#bm-copy")!.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(href); toast("📋 Copied — paste it as a new bookmark's URL"); }
      catch { prompt("Copy this, then paste it as a new bookmark's URL:", href); }
    });
    const close = () => ov.remove();
    ov.querySelector("#bm-close")!.addEventListener("click", close);
    ov.addEventListener("click", (e) => { if (e.target === ov) close(); });
  }
  $("np-bookmark")?.addEventListener("click", openBookmarkDialog);

  // The page the bookmark sent: the full copy from the shop tab, else the
  // compact one in the address. Forgotten from the address bar right away.
  // How the page arrived: "message" = posted by the bookmark from the shop tab
  // itself (origin = that site); "fragment" = only the copy in the address
  // (pop-up blocked — or a link someone else made, so never acted on unasked).
  let receivedVia: { via: "message" | "fragment"; origin: string } = { via: "fragment", origin: "" };
  async function receivePage(): Promise<any | null> {
    let compact: any = null;
    const m = location.hash.match(/[#&]tl=([^&]*)/);
    if (m) { try { compact = JSON.parse(decodeURIComponent(m[1])); } catch { /* cut off */ } }
    history.replaceState(null, "", location.pathname);
    const opener = window.opener as Window | null;
    if (!opener) return compact;
    let from = "";
    try { from = compact?.url ? new URL(compact.url).origin : ""; } catch { /* no compact copy */ }
    return await new Promise((done) => {
      let finished = false;
      const finish = (page: any) => {
        if (finished) return;
        finished = true;
        window.removeEventListener("message", on);
        clearInterval(timer);
        done(page);
      };
      const on = (e: MessageEvent) => {
        if (e.source !== opener || (from && e.origin !== from) || e.data?.type !== "tl-page" || !e.data.page) return;
        // The page this tab was opened for (not one an older click still holds).
        if (compact?.url && e.data.page.url !== compact.url) return;
        receivedVia = { via: "message", origin: e.origin };
        finish(e.data.page);
      };
      window.addEventListener("message", on);
      // "Ready" (no data in it) until the shop tab answers.
      const ping = () => { try { opener.postMessage({ type: "tl-ready" }, "*"); } catch { /* tab gone */ } };
      ping();
      const timer = setInterval(ping, 400);
      setTimeout(() => finish(compact), 3500);
    });
  }

  /* ---------- 📈 Update from PriceCharting (second bookmark) ----------
     A PriceCharting page goes STRAIGHT into its listing — found by its
     PriceCharting id, a barcode, else the same title on the same platform +
     region: today's averages, every barcode, the photo (main if none, else an
     extra gallery photo), blank details. Unsure → you pick. None → the
     listing is created with 0 in stock (one stock row at the category's usual
     condition, priced at its average). */
  const pcuOpen = (html: string) => { $("pcu-body").innerHTML = html; ($("pcu-modal") as HTMLElement).hidden = false; };
  document.querySelectorAll<HTMLElement>("[data-pcuclose]").forEach((el) => el.addEventListener("click", () => { ($("pcu-modal") as HTMLElement).hidden = true; }));
  async function pcUpdateFromPage() {
    pcuOpen(`<p>📈 Reading the PriceCharting page…</p>`);
    const page = await receivePage();
    if (!page?.url) { pcuOpen(`<p>⚠ The page didn't come through — click the 📈 bookmark again on the PriceCharting game page.</p>`); return; }
    let j: any;
    try {
      const r = await fetch("/api/pos/source-import", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ mode: "pc-match", page }) });
      j = await r.json();
      if (!r.ok || !j.ok) throw new Error(j.error || "Couldn't read that page");
    } catch (e: any) { pcuOpen(`<p>⚠ ${esc(e.message)}</p>`); return; }
    const head = `<p style="margin:0 0 0.5rem;"><strong>${esc(j.fields.title)}</strong> <span class="muted">${esc(j.fields.platform)}${j.fields.regionCode && j.fields.regionCode !== "US" ? ` · ${esc(j.fields.regionCode)}` : ""}</span><br>${marketLine(j.market) || "no prices taken"} <span class="muted">(averages, ${esc(j.market.at)})</span>${j.priceNote ? `<br><span style="color:var(--magenta);">⚠ ${esc(j.priceNote)}</span>` : ""}${j.marketReady ? "" : `<br><span style="color:var(--magenta);">⚠ Averages can't be kept until the market-prices migration is run.</span>`}</p>`;
    // Hands-free only when the page really came from PriceCharting through the
    // bookmark (not just a link with data in it): else one click to confirm.
    const trusted = receivedVia.via === "message" && /^https:\/\/([a-z0-9-]+\.)*pricecharting\.com$/i.test(receivedVia.origin);
    if (j.match && trusted) { await pcApply(j, j.match.id, head, false); return; }
    const choices: any[] = j.match ? [j.match] : j.choices || [];
    const noPrice = marketPriceFor(j.market, j.fields.defaultCompleteness || "") == null;
    pcuOpen(`${head}<p class="muted" style="margin:0.6rem 0 0.3rem;">${j.match ? "Update this listing?" : choices.length ? "Which listing is this?" : "No listing for it yet."}</p>${choices.map((c, i) => `
      <div class="pcu-row"><div><strong>${esc(c.title)}</strong>${badge(c.regionCode)} <span class="muted">${esc(c.platform)} · ${c.stock} in stock · ${esc(c.by)}</span>${c.linkedPc ? `<br><span style="color:var(--magenta);font-size:0.8rem;">linked to another PriceCharting product (#${esc(c.linkedPc)})</span>` : ""}</div>
        <button type="button" class="btn ${j.match ? "btn-primary" : "btn-ghost"} btn-sm" data-pcuse="${i}">Update this one</button></div>`).join("")}
      <div class="pcu-acts"><button type="button" class="btn btn-ghost btn-sm" data-pcuclose2>Cancel</button><button type="button" class="btn ${choices.length ? "btn-ghost" : "btn-primary"} btn-sm" id="pcu-create">＋ Create a new listing (0 in stock)</button></div>
      ${noPrice ? `<p class="muted" style="font-size:0.8rem;">A new listing would start at $0 (no average for its usual condition) — set its price after.</p>` : ""}`);
    $("pcu-body").querySelectorAll<HTMLElement>("[data-pcuse]").forEach((b) => b.addEventListener("click", () => {
      const c = choices[+b.dataset.pcuse!];
      if (c.linkedPc && !confirm(`“${c.title}” is linked to another PriceCharting product (#${c.linkedPc}). Link it to this page instead? Its averages are replaced.`)) return;
      pcApply(j, c.id, head, false, !!c.linkedPc);
    }));
    document.getElementById("pcu-create")?.addEventListener("click", () => pcCreate(j, head));
    $("pcu-body").querySelector("[data-pcuclose2]")?.addEventListener("click", () => { ($("pcu-modal") as HTMLElement).hidden = true; });
  }
  // Today's averages / barcodes / photo / blank details onto a listing.
  async function pcApply(j: any, productId: string, head: string, created: boolean, replaceLink = false) {
    pcuOpen(`${head}<p>Saving…</p>`);
    let e: any;
    try {
      const r = await fetch("/api/pos/source-import", { method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ mode: "attach", productId, source: j.source, market: j.market, facts: j.fields, replaceLink }) });
      e = await r.json();
      if (r.status === 409 && e.linkedPc && !replaceLink) {
        const t = items.find((x: any) => x.id === productId)?.title || "This listing";
        if (confirm(`${t} is linked to another PriceCharting product (#${e.linkedPc}). Link it to this page instead? Its averages are replaced.`)) return pcApply(j, productId, head, created, true);
        pcuOpen(`${head}<p>Left as it is.</p>`); return;
      }
      if (!r.ok || !e.ok) throw new Error(e.error || "Couldn't update the listing");
    } catch (err: any) { pcuOpen(`${head}<p>⚠ ${esc(err.message)}</p>`); return; }
    const p = items.find((x: any) => x.id === productId);
    if (p) {
      if (e.market) p.marketPrices = e.market;
      if (j.market?.id) p.pcId = j.market.id;
      if (e.imageUrl && !p.imageUrl) p.imageUrl = e.imageUrl;
      for (const a of e.codes?.added || []) if (!(p.upcs || []).some((u: any) => u.upc === a.upc)) p.upcs = [...(p.upcs || []), { ...a, evidence: "From PriceCharting" }];
      render();
    }
    const did = [
      e.market ? "today's averages" : j.priceNote ? "no averages (see above) — the saved ones stay" : "",
      e.codes?.added?.length ? `${e.codes.added.length} barcode${e.codes.added.length === 1 ? "" : "s"} (${e.codes.added.map((a: any) => esc(a.upc)).join(", ")})` : "",
      e.galleryAdded ? "its photo (extra, in the gallery)" : e.imageUrl && created ? "its photo" : "",
      (e.filled || []).length ? `blank details (${(e.filled as string[]).map((f) => f === "brand" ? "publisher" : f === "release_year" ? "release year" : f).join(", ")})` : "",
    ].filter(Boolean);
    pcuOpen(`${head}<p style="margin:0.6rem 0 0;">${created ? "✓ <strong>Created</strong> with 0 in stock" : `✓ <strong>Updated</strong> ${esc(p?.title || "the listing")}`}${did.length ? ` — ${did.join(" · ")}` : ""}.</p>
      ${e.marketError ? `<p style="color:var(--magenta);">⚠ ${esc(e.marketError)}</p>` : ""}
      ${e.codes?.conflicts?.length ? `<p class="muted">Not added: ${e.codes.conflicts.map(esc).join("; ")}</p>` : ""}
      <div class="pcu-acts"><button type="button" class="btn btn-ghost btn-sm" data-pcuclose2>Close</button>${p ? `<button type="button" class="btn btn-primary btn-sm" id="pcu-open">Open the listing</button>` : ""}</div>`);
    $("pcu-body").querySelector("[data-pcuclose2]")?.addEventListener("click", () => { ($("pcu-modal") as HTMLElement).hidden = true; });
    document.getElementById("pcu-open")?.addEventListener("click", () => { ($("pcu-modal") as HTMLElement).hidden = true; openModal(productId); });
  }
  // No listing yet: create it with 0 in stock — one stock row at the
  // category's usual condition, priced at that condition's average.
  async function pcCreate(j: any, head: string) {
    const f = j.fields;
    if (!f.categoryId) { pcuOpen(`${head}<p>⚠ No category to put it in — add one first.</p>`); return; }
    const comp = f.defaultCompleteness || completeness.find((c: any) => /complete|cib/i.test(c.label))?.code || "";
    const label = completeness.find((c: any) => c.code === comp)?.label || "Used";
    const priceCents = marketPriceFor(j.market, comp) ?? 0;
    pcuOpen(`${head}<p>Creating the listing…</p>`);
    let a: any;
    try {
      a = await api({ action: "addProduct", title: f.title, platform: f.platform, regionCode: f.regionCode || undefined, categoryId: f.categoryId,
        condition: label, completenessCode: comp, gradeCode: "", priceCents, quantity: 0, barcode: f.barcode || null });
    } catch (err: any) { pcuOpen(`${head}<p>⚠ ${esc(err.message)}</p>`); return; }
    const cat = categories.find((c: any) => c.id === f.categoryId);
    items.push({ id: a.productId, title: a.title ?? f.title, slug: a.slug || "", platform: a.platform ?? f.platform, regionCode: a.regionCode ?? f.regionCode ?? "",
      franchise: "", genre: "", description: "", imageUrl: "", altNames: [], categoryId: f.categoryId, categoryName: cat?.name ?? "", categoryColor: cat?.color ?? "#2ce6e0",
      tags: [], upcs: [], marketPrices: null,
      variants: [{ id: a.variantId, condition: label, completeness: null, completenessCode: comp, gradeCode: "", sku: null, internalCode: a.internalCode || "", labelCode: a.labelCode || "",
        priceCents, onlinePriceCents: null, costCents: 0, quantity: 0, onlineVisible: false, inventoryTypeId: retailTypeId, locationId: "", barcodes: f.barcode ? [{ id: "primary:" + a.variantId, barcode: f.barcode, label: "Primary", primary: true }] : [] }] });
    render();
    await pcApply(j, a.productId, head, true);
  }

  async function importFromPage() {
    const page = await receivePage();
    if (!page?.url) { alert("The page didn't come through — click the 🔖 bookmark again on the product page."); return; }
    const src = sourceOf(page.url);
    if (entryMode) closeAddPanel();
    clearProductFields();
    clearRecv();
    setNpKind("stock");
    setAddOpen(true);
    const note = $("np-ebay-note") as HTMLElement;
    note.hidden = false;
    note.innerHTML = `<div><strong>🔖 Reading the ${esc(src.label || "shop")} page…</strong> <span class="muted">(cleaning up the title, finding the platform and condition)</span></div>`;
    ($("add-panel") as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    let j: any;
    try {
      const r = await fetch("/api/pos/source-import", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ mode: "parse", page }) });
      j = await r.json();
      if (!r.ok || !j.ok) throw new Error(j.error || "Couldn't read that page");
    } catch (e: any) { note.innerHTML = `<div>⚠ ${esc(e.message)}</div>`; return; }
    const f = j.fields, so = j.source;
    ($("np-title") as HTMLInputElement).value = f.title || "";
    setPlatform($("np-platform") as HTMLSelectElement, f.platform || "");
    setNpRegion(f.regionCode || "");
    if (f.categoryId) ($("np-cat") as HTMLSelectElement).value = f.categoryId;
    const newCode = completeness.find((c: any) => /^(new|sealed)/i.test(c.label) || c.code === "NEW")?.code || "";
    setComp($("np-comp") as HTMLInputElement, f.completenessCode || (f.isNew ? newCode : ""), $("np-comp-abbr"));
    ($("np-barcode") as HTMLInputElement).value = f.barcode || "";
    ($("np-cost") as HTMLInputElement).value = f.costCents != null ? (f.costCents / 100).toFixed(2) : "";
    ($("np-qty") as HTMLInputElement).value = "1";
    pendingSource = { url: so.url, priceText: so.priceText, titleOriginal: so.titleOriginal, images: so.images, market: j.market || null, codes: so.codes || [] };
    pendingMarket = j.market || null;
    npPriceTouched = false;
    const rate = j.money?.jpyPerUsd, fee = j.money?.feePct;
    const paid = f.costCents != null
      ? `Paid <strong>${money(f.costCents)}</strong> = ${esc(so.priceText)}${so.currency === "JPY" ? ` at ¥${rate}/$${fee ? ` + ${fee}% fees` : ""}` : fee ? ` + ${fee}% fees` : ""}`
      : so.priceText ? `price ${esc(so.priceText)}` : "no price found";
    const img = so.images?.[0] ? `<img src="${esc(so.images[0])}" alt="" referrerpolicy="no-referrer" style="width:54px;height:54px;object-fit:cover;border:1px solid var(--line);">` : "";
    if (j.market) {
      // A price guide: its averages are what copies SELL for — the price
      // follows the condition you pick (until you type one); nothing is "paid".
      const codes: string[] = so.codes || (f.barcode ? [f.barcode] : []);
      note.innerHTML = `${img}<div><strong>📈 From PriceCharting</strong>${codes.length ? ` · ${codes.length > 1 ? "UPC / EAN codes" : codes[0].length === 13 ? "EAN" : "UPC"} ${codes.map(esc).join(", ")}${codes.length > 1 ? " (all go on the listing)" : " (goes on the listing)"}` : " · no UPC / EAN on the page"}${f.regionCode && f.regionCode !== "US" ? ` · ${esc(f.regionCode)} release` : ""}
        <br>${marketLine(j.market, true) || "no prices taken"} <span style="color:var(--muted-2);">(averages, ${esc(j.market.at)})</span>
        ${j.priceNote ? `<br><span style="color:var(--magenta);">⚠ ${esc(j.priceNote)}</span>` : ""}
        <br><span style="color:var(--muted-2);">Pick the condition — the price follows it (or click one). On Save: ${j.marketReady ? "these averages are kept on the listing, plus" : "<span style='color:var(--magenta);'>(averages can't be kept until the market-prices migration is run)</span>"} its PriceCharting photo and link.</span>
        ${j.existing ? `<br><span style="color:var(--magenta);">Already in the POS: <strong>${esc(j.existing.title)}</strong> — <button type="button" class="link-btn" id="src-existing">add copies to it instead</button></span>` : ""}
        ${j.openEntry && !entryMode ? `<br><button type="button" class="link-btn" id="src-entry">📥 Put it on your open Entry #${esc(j.openEntry.human_id)} instead</button>` : ""}</div>`;
      note.querySelectorAll<HTMLElement>("[data-mkt]").forEach((b) => b.addEventListener("click", () => {
        ($("np-price") as HTMLInputElement).value = (Number(j.market[b.dataset.mkt!]) / 100).toFixed(2);
        npPriceTouched = true;
      }));
    } else
    note.innerHTML = `${img}<div><strong>🔖 From ${esc(so.label)}</strong> · ${paid}${f.barcode ? ` · JAN ${esc(f.barcode)}` : ""}${f.regionCode === "JP" ? " · 🇯🇵 Japan" : ""}
      ${so.titleOriginal ? `<br><span style="color:var(--muted-2);">Original: ${esc(so.titleOriginal)}</span>` : so.pageTitle && so.pageTitle !== f.title ? `<br><span style="color:var(--muted-2);">On the page: ${esc(so.pageTitle)}</span>` : ""}
      ${f.note ? `<br><span style="color:var(--muted-2);">Condition note: ${esc(f.note)}</span>` : ""}
      <br><span style="color:var(--muted-2);">${j.ai ? (j.official ? "✓ Title from the game database" : "✨ Title cleaned up by AI — check it") : `⚠ ${esc(j.aiError || "No AI")} — check the title`} · set your price, then Save. On Save: the photo + this page as the item's source (managers only).</span>
      ${j.existing ? `<br><span style="color:var(--magenta);">Already in the POS from this page: <strong>${esc(j.existing.title)}</strong> — <button type="button" class="link-btn" id="src-existing">add copies to it instead</button></span>` : ""}
      ${j.openEntry && !entryMode ? `<br><button type="button" class="link-btn" id="src-entry">📥 Put it on your open Entry #${esc(j.openEntry.human_id)} instead</button>` : ""}</div>`;
    document.getElementById("src-existing")?.addEventListener("click", () => {
      const t = j.existing.title;
      // PriceCharting: today's averages go onto that listing too (the rows price new conditions from them).
      if (j.market) {
        const ex = items.find((x: any) => x.id === j.existing.productId);
        if (ex) ex.marketPrices = j.market;
        fetch("/api/pos/source-import", { method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({ mode: "attach", productId: j.existing.productId, source: pendingSource, market: j.market }) })
          .then((r) => r.json()).then((e) => { if (e.marketError) alert(e.marketError); }).catch(() => {});
      }
      // What this copy cost goes onto the row you pick.
      pendingRecvCost = f.costCents != null ? (f.costCents / 100).toFixed(2) : "";
      clearProductFields();
      npFind.value = t;
      findSuggest(quickFind);
      npFind.focus();
    });
    document.getElementById("src-entry")?.addEventListener("click", async () => {
      // The open draft takes it: the form (still filled) moves into the entry.
      if (await loadEntry(j.openEntry.id)) { setEntryMode(true); toast(`📥 Entry #${j.openEntry.human_id} — Save puts it on the entry`); }
      else alert("That draft isn't open anymore.");
    });
    ($("np-price") as HTMLInputElement).value = "";
    priceFromMarket(); // PriceCharting: the current condition's average
    (j.market ? $("np-comp") : $("np-price") as HTMLInputElement).focus();
  }

  // Pasting a listing link (or pressing Enter) pulls it — no extra click.
  $("np-ebay")?.addEventListener("paste", () => setTimeout(() => {
    if (/\d{9,15}/.test(($("np-ebay") as HTMLInputElement).value)) ($("np-ebay-go") as HTMLButtonElement).click();
  }, 0));
  $("np-ebay")?.addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Enter") { e.preventDefault(); ($("np-ebay-go") as HTMLButtonElement).click(); } });

  // Paste a listing → pull its data into the add form for review.
  $("np-ebay-go")?.addEventListener("click", async () => {
    const input = ($("np-ebay") as HTMLInputElement).value.trim();
    if (!input) { alert("Paste an eBay item number or listing URL first"); return; }
    // Another shop's link (Suruga-ya, Buyee…): our server can't open those
    // pages — the 🔖 bookmark reads them in your own browser instead.
    if (/^https?:\/\//i.test(input) && !/(^|\.)ebay\.[a-z.]+\//i.test(input.replace(/^https?:\/\//i, "").split("/")[0] + "/")) {
      const note = $("np-ebay-note") as HTMLElement; note.hidden = false;
      const src = sourceOf(input);
      note.innerHTML = `<div><strong>🔖 ${esc(src.label || "That shop")} pages can't be opened from here.</strong> Open the page in your browser and click the <strong>Send to TimeLag</strong> bookmark there — it fills this form. <button type="button" class="link-btn" id="np-bm-open">Get the bookmark</button></div>`;
      document.getElementById("np-bm-open")?.addEventListener("click", openBookmarkDialog);
      return;
    }
    const btn = $("np-ebay-go") as HTMLButtonElement; btn.disabled = true; const o = btn.textContent; btn.textContent = "Pulling…";
    try {
      const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ mode: "preview", input }) });
      const j = await r.json();
      if (!r.ok || !j.ok) throw new Error(j.error || "Couldn't pull that listing");
      const it = j.item;
      // A previous 🔖 import's prices / page don't belong to this listing.
      pendingMarket = null; pendingSource = null; npPriceTouched = false;
      // Sell Similar suggestions (the store importer's title / platform / region /
      // category rules) — else the listing's raw fields.
      const sim = j.similar || {};
      ($("np-title") as HTMLInputElement).value = sim.title || it.title;
      setPlatform($("np-platform") as HTMLSelectElement, sim.platform ?? it.platform ?? "");
      setNpRegion(sim.region || it.region); // "" = home
      setComp($("np-comp") as HTMLInputElement, sim.completenessCode || it.completenessCode || "", $("np-comp-abbr"));
      const grade = sim.gradeCode || it.gradeCode;
      if (grade) ($("np-grade") as HTMLSelectElement).value = grade;
      // Their price + their (cheapest) shipping — what a buyer actually pays.
      const ship: number | null = typeof sim.shippingCents === "number" ? sim.shippingCents : null;
      ($("np-price") as HTMLInputElement).value = ((it.priceCents + (ship || 0)) / 100).toFixed(2);
      const code = sim.barcode || it.upc;
      ($("np-barcode") as HTMLInputElement).value = code || "";
      const sel = $("np-cat") as HTMLSelectElement;
      const opt = [...sel.options].find((op) => op.value === sim.categoryId)
        || [...sel.options].find((op) => op.textContent?.toLowerCase() === String(it.categoryName).toLowerCase());
      if (opt) sel.value = opt.value;
      // A Japan item keeps its real category — the Japan region puts it under
      // the virtual "🇯🇵 Japanese Imports" too.
      const catNote = sim.japan ? " → 🇯🇵 Japanese Imports" : "";
      pendingEbay = { input, group: sim.group || "", own: !!sim.ownListing };
      const meta = [sim.franchise && `series: ${sim.franchise}`, sim.character && `character: ${sim.character}`, sim.brand && `brand: ${sim.brand}`, sim.releaseYear && `year: ${sim.releaseYear}`].filter(Boolean).join(" · ");
      const note = $("np-ebay-note") as HTMLElement; note.hidden = false;
      note.innerHTML = `${it.primaryImage ? `<img src="${esc(it.primaryImage)}" alt="" style="width:46px;height:46px;object-fit:cover;border:1px solid var(--line);">` : ""}<div><strong>✓ Filled from eBay</strong> · ${esc(it.conditionLabel || "—")} · price ${ship ? `${money(it.priceCents)} + ${money(ship)} shipping = <strong>${money(it.priceCents + ship)}</strong> <button type="button" class="link-btn" id="np-ebay-noship" title="Use their item price without shipping">use ${money(it.priceCents)}</button>` : ship === 0 ? `${money(it.priceCents)} (free shipping)` : `${money(it.priceCents)}${sim.shipZip ? " (no shipping quote)" : ` <span title="Set the store's ZIP in Settings → eBay to include calculated shipping">(shipping not included — set ZIP in Settings → eBay)</span>`}`}${code ? " · UPC/EAN " + esc(code) : ""}${sim.japan ? ` · 🇯🇵 Japan item${sim.japanWhy ? ` (${esc(sim.japanWhy)})` : ""}${esc(catNote)}` : ""}${sim.ownListing ? " · <em>your own listing</em>" : sim.seller ? ` · seller ${esc(sim.seller)}` : ""}<br><span style="color:var(--muted-2);">${esc(it.title.slice(0, 90))}</span>${meta ? `<br><span style="color:var(--muted-2);">On Save: cover photo + ${esc(meta)}</span>` : `<br><span style="color:var(--muted-2);">On Save: cover photo</span>`}${(sim.warnings || []).length ? `<br><span style="color:var(--magenta);">⚠ ${esc(sim.warnings.join(" · "))}</span>` : ""}</div>`;
      document.getElementById("np-ebay-noship")?.addEventListener("click", (e) => {
        ($("np-price") as HTMLInputElement).value = (it.priceCents / 100).toFixed(2);
        (e.currentTarget as HTMLElement).replaceWith(document.createTextNode("(using item price)"));
      });
      toast("✓ Filled from eBay — check it & Save");
    } catch (e: any) { alert(e.message); } finally { btn.disabled = false; btn.textContent = o; }
  });

  // Manager-only: pull stock down from eBay — listings that ended or sold out
  // on eBay get zeroed + hidden on the website. Never raises local stock.
  document.getElementById("ebay-sync")?.addEventListener("click", async () => {
    const btn = document.getElementById("ebay-sync") as HTMLButtonElement; btn.disabled = true; const o = btn.textContent; btn.textContent = "Syncing…";
    try {
      const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ mode: "sync" }) });
      const j = await r.json();
      if (!r.ok || !j.ok) throw new Error(j.error || "Sync failed");
      toast(`✓ eBay sync — ${j.checked} checked · ${j.zeroed} sold/out → zeroed · ${j.inStock} in stock${j.errors ? ` · ${j.errors} skipped` : ""}`);
      if (j.zeroed) setTimeout(() => location.reload(), 1700);
    } catch (e: any) { alert(e.message); } finally { btn.disabled = false; btn.textContent = o; }
  });

  // Manager-only: the eBay store importer. Pick listings (filters, expo price
  // rule, photo count) → they're staged onto the open draft like a CSV import
  // (matched to existing listings, own eBay stock row) → Finish prints labels.
  // Photos + item specifics copy over in the background afterwards.
  async function openEbayStoreImport() {
    if (!closeAddPanel()) return; // the import opens a draft — the Add form can't straddle it
    if (!draftsReady) { alert("Run supabase/migrations/20260801000002_entry_drafts.sql in the Supabase SQL editor first, then refresh."); return; }
    try { await ensureEntry(); setEntryMode(true); } catch (e: any) { alert(e.message); return; }
    openEbayImportDialog({
      catalog: importCatalog(), completeness, grades, platforms: PLATFORMS, categories, invTypes, regions,
      createCategory: async (name) => {
        const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ mode: "ensure-category", name }) });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j.error || "Couldn't create the category");
        if (!categories.some((c: any) => c.id === j.category.id)) categories.push({ ...j.category, default_completeness: null });
        return j.category;
      },
      onImport: async (rows, ch, progress) => {
        const condText = (r: any) => [completeness.find((c) => c.code === r.row.completenessCode)?.label, grades.find((g) => g.code === r.row.gradeCode)?.label].filter(Boolean).join(" ") || "Used";
        // Two eBay listings of one game (same platform + region) → ONE new
        // listing: the first creates it (ref), the next goes on it (productRef).
        const firstOfGroup = new Set<string>();
        const payload = rows.map((r: any) => {
          // One import key per eBay listing (the server keys each copy #1, #2…):
          // a retry, or the same listing picked again, replays instead of doubling.
          const base = { qty: r.row.qty, costCents: null, importKey: `ebay:${r.row.ebay.id}`, tagEbayId: r.row.ebay.id };
          if (r.product && r.variant) return { kind: "variant", variantId: r.variant.id, productId: r.product.id, ...base };
          // The seller-typed UPC isn't trusted for the listing — the UPC lookup
          // (eBay's catalog) runs after the import instead.
          const v = { completenessCode: r.row.completenessCode, gradeCode: r.row.gradeCode, condition: condText(r), priceCents: r.row.priceCents ?? 0, barcode: null, inventoryTypeId: ch.inventoryTypeId || undefined };
          if (r.product) return { kind: "newVariant", productId: r.product.id, ...v, ...base };
          const g = newListingKey(r.row);
          if (firstOfGroup.has(g)) return { kind: "newVariant", productRef: g, title: r.row.title, platform: r.row.platform, regionCode: r.row.region, ...v, ...base };
          firstOfGroup.add(g);
          return { kind: "newProduct", ref: g, title: r.row.title, platform: r.row.platform, regionCode: r.row.region, categoryId: r.categoryId, ...v, ...base };
        });
        let staged: { results: any[]; newProducts: any[] };
        try { staged = await stageOntoDraft(rows, payload, progress, "your eBay store"); }
        catch (e: any) {
          if (e?.staged) { ebayMediaInBackground(ebayJobs(rows, e.staged.results), ch.galleryMax); upcFillInBackground(touchedListings(e.staged.results)); }
          throw e;
        }
        ebayMediaInBackground(ebayJobs(rows, staged.results), ch.galleryMax);
        upcFillInBackground(touchedListings(staged.results));
      },
    });
  }
  // One photo/details job per listing the import put stock on (a 2nd eBay
  // copy of the same listing is already tagged by the import itself).
  const ebayJobs = (rows: any[], results: any[]) => {
    const seen = new Set<string>();
    const jobs: { productId: string; legacyItemId: string }[] = [];
    results.forEach((res, i) => {
      if (!res?.ok || !res.productId || seen.has(res.productId) || !rows[i]?.row?.ebay?.id) return;
      seen.add(res.productId);
      jobs.push({ productId: String(res.productId), legacyItemId: String(rows[i].row.ebay.id) });
    });
    return jobs;
  };
  // Copy each listing's eBay photos (cover, + gallery when more than 1) and
  // item specifics (brand, year, franchise / series, genre, character) — only
  // what the listing is missing. A few at a time; if the tab closes, "📷 Fill
  // from eBay" picks up the rest.
  async function ebayMediaInBackground(jobs: { productId: string; legacyItemId: string }[], galleryMax: number) {
    if (!jobs.length) return;
    let done = 0, failed = 0;
    const CONC = 3;
    for (let i = 0; i < jobs.length; i += CONC) {
      await Promise.all(jobs.slice(i, i + CONC).map(async (job) => {
        try {
          const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ mode: "media", ...job, galleryMax }) });
          const j = await r.json();
          if (!r.ok || !j.ok) { failed++; return; }
          const p = items.find((x: any) => x.id === job.productId);
          if (p && j.imageUrl && !p.imageUrl) p.imageUrl = j.imageUrl;
          if (p && !p.ebayId) p.ebayId = job.legacyItemId;
          if (p && j.fields) for (const k of ["description", "franchise", "genre", "brand"]) if (j.fields[k] && !p[k]) p[k] = j.fields[k];
        } catch { failed++; } finally { done++; }
      }));
      toast(`📷 Copying eBay photos & details ${done}/${jobs.length}…`);
    }
    render();
    toast(`📷 eBay photos & details: ${done - failed} listing${done - failed === 1 ? "" : "s"}${failed ? ` · ${failed} failed (📷 Fill from eBay retries)` : ""}`);
  }
  document.getElementById("ebay-bulk")?.addEventListener("click", openEbayStoreImport);
  document.getElementById("ebay-media")?.addEventListener("click", async () => {
    const todo = items.filter((p: any) => p.ebayId && (!p.imageUrl || !p.franchise));
    if (!todo.length) { toast("✓ Every eBay listing has a photo and details"); return; }
    const photos = Number((() => { try { return localStorage.getItem("tl-ebay-photos"); } catch { return null; } })()) || 1;
    if (!confirm(`Copy photos and details from eBay for ${todo.length} listing${todo.length === 1 ? "" : "s"} missing them? Only empty fields are filled (${photos === 1 ? "cover photo only" : `up to ${photos} photos`}). Keep this tab open.`)) return;
    ebayMediaInBackground(todo.map((p: any) => ({ productId: p.id, legacyItemId: p.ebayId })), photos);
  });

  render();
  // Opened by a bookmark: 🔖 Send to TimeLag (the Add form) or 📈 Update from PriceCharting (straight in).
  const importMode = new URLSearchParams(location.search).get("import");
  if (importMode === "page") importFromPage();
  else if (importMode === "pc-update") pcUpdateFromPage();
</script>
