---
export const prerender = false;

import AppLayout from "../../layouts/AppLayout.astro";
import { fetchAll } from "../../lib/fetchAll";
import { labelTemplates } from "../../lib/labels";
import { MARKETING_HOSTS } from "../../consts";
import { createSupabaseAdminClient } from "../../lib/supabase";
import { loadRegions, regionsOn, regionBadgeHtml } from "../../lib/regions";
import { activeVirtualCategories, virtualHint, virtualTag } from "../../lib/virtualCategories";
import { customPlatforms, platformGroups } from "../../lib/platforms";

const supabase = Astro.locals.supabase;
const [{ data: categories }, { data: settings }, { data: completeness }, { data: grades }] = await Promise.all([
  supabase.from("categories").select("id, name, color, default_completeness").order("sort_order"),
  supabase.from("store_settings").select("condition_pricing_enabled, condition_entry_mode, store_name, settings").eq("id", 1).maybeSingle(),
  supabase.from("completeness_levels").select("code, label, aliases, sort_order").eq("is_active", true).order("sort_order"),
  supabase.from("condition_grades").select("code, label, icon, aliases, rank").eq("is_active", true).order("rank"),
]);
// Inventory types + locations (empty pre-migration → UI hides those controls).
const [{ data: invTypesSrv }, { data: locationsSrv }] = await Promise.all([
  supabase.from("store_inventory_types").select("id, key, name, icon, color, block_at_checkout").order("sort_order").order("name"),
  supabase.from("store_locations").select("id, key, name, is_default").order("sort_order").order("name"),
]);
const hasTypes = !!invTypesSrv;
// Entry DRAFTS (migration 20260801000002): staged lines need the `applied`
// column — probe so the entry screen can gate itself pre-migration.
const { error: draftProbeErr } = await supabase.from("inventory_entry_items").select("applied").limit(1);
// Sources + supplier links (migration 20260801000003).
const { error: srcProbeErr } = await supabase.from("inventory_entries").select("supplier").limit(1);
// Received-on date per entry (migration 20260924000002).
const { error: roProbeErr } = await supabase.from("inventory_entries").select("received_on").limit(1);
const { error: lcProbeErr } = await supabase.from("product_variants").select("label_code").limit(1);
// Previously-used sources feed the datalist (RLS keeps product_suppliers
// manager-only; entries are staff-visible anyway).
let knownSuppliers: string[] = [];
if (!srcProbeErr) {
  const [{ data: entSup }, { data: prodSup }] = await Promise.all([
    supabase.from("inventory_entries").select("supplier").not("supplier", "is", null).order("created_at", { ascending: false }).limit(200),
    supabase.from("product_suppliers").select("label").limit(200),
  ]);
  knownSuppliers = [...new Set([...(entSup ?? []).map((r: any) => r.supplier), ...(prodSup ?? []).map((r: any) => r.label)].filter(Boolean))].slice(0, 40);
}
// Soft-delete (migration 20260903000001): probe so pre-migration DBs keep
// working, and purge anything past its 7-day "Recently deleted" window.
const { error: delProbeErr } = await supabase.from("products").select("deleted_at").limit(1);
const RD_DAYS = 7;
if (!delProbeErr) {
  const cutoff = new Date(Date.now() - RD_DAYS * 864e5).toISOString();
  const { data: expired } = await supabase.from("products").select("id").not("deleted_at", "is", null).lt("deleted_at", cutoff).limit(200);
  if (expired?.length) {
    const admin = createSupabaseAdminClient();
    const ids = expired.map((r: any) => r.id);
    // transaction_items → variants has no cascade: unlink (receipts keep their
    // name/price snapshots), then the product delete cascades everything else.
    const { data: vars } = await admin.from("product_variants").select("id").in("product_id", ids);
    if (vars?.length) await admin.from("transaction_items").update({ variant_id: null }).in("variant_id", vars.map((v: any) => v.id));
    await admin.from("products").delete().in("id", ids);
  }
}
const variantExtraCols = `${hasTypes ? ", inventory_type_id, location_id" : ""}${lcProbeErr ? "" : ", label_code"}`;
// Draft-created rows stay hidden until Finish (migration 20260930000001). They
// still load (flagged) so the draft's own screen can find them; the grid,
// counts and every other page hide them.
const { error: pendProbeErr } = await supabase.from("products").select("pending_entry_id").limit(1);
const pendCol = pendProbeErr ? "" : ", pending_entry_id";
// Listing UPCs + the automatic lookup's last result (migration 20260930000003).
const { error: upcProbeErr } = await supabase.from("product_upcs").select("id").limit(1);
const upcCols = upcProbeErr ? "" : ", upc_status, upc_checked_at, product_upcs(id, upc, source, evidence)";
// Region tag (migration 20261005000001): before it, no column and no list →
// every region control and badge stays hidden.
const { error: rgProbeErr } = await supabase.from("products").select("region_code").limit(1);
// Market prices from PriceCharting (migration 20261006000003).
const { error: mpProbeErr } = await supabase.from("products").select("market_prices").limit(1);
const regions = rgProbeErr ? [] : await loadRegions(supabase);
const rgOn = regionsOn(regions);
// Virtual categories ("🇯🇵 Japanese Imports" = the Japan region) in the category filter.
// (Region ones only while regions are on.)
const vCats = activeVirtualCategories(regions).filter((v) => !v.region || rgOn);
// Ones a person tags by hand (🧸 Plush) — edit window + bulk bar.
const tagCats = vCats.filter((v) => virtualTag(v)).map((v) => ({ key: v.key, icon: v.icon, label: v.label, tag: virtualTag(v) }));
// Paged — one request stops at 1,000 listings (later titles silently vanished).
const { data: products } = await fetchAll((from, to) => supabase
  .from("products")
  .select(
    `id, title, slug, platform, franchise, genre, description, image_url, alternative_names, tags, category_id${mpProbeErr ? "" : ", market_prices"}${delProbeErr ? "" : ", deleted_at"}${pendCol}${upcCols}${rgProbeErr ? "" : ", region_code"}, category:categories(name,color)${srcProbeErr ? "" : ", product_suppliers(id, label, url)"}, product_variants(id, condition, completeness, completeness_code, grade_code, sku, barcode, internal_code, price_cents, online_price_cents, cost_cents, quantity, online_visible${variantExtraCols}${pendCol}, product_barcodes(id, barcode, label))`,
  )
  .order("title")
  .order("id")
  .range(from, to));

const mapVariant = (v: any) => ({
  id: v.id,
  condition: v.condition,
  completeness: v.completeness,
  completenessCode: v.completeness_code ?? "",
  gradeCode: v.grade_code ?? "",
  sku: v.sku,
  internalCode: v.internal_code ?? "",
  labelCode: v.label_code ?? "",
  priceCents: v.price_cents,
  onlinePriceCents: v.online_price_cents,
  costCents: v.cost_cents,
  quantity: v.quantity,
  onlineVisible: v.online_visible ?? false,
  inventoryTypeId: v.inventory_type_id ?? "",
  locationId: v.location_id ?? "",
  pendingEntryId: v.pending_entry_id ?? "",
  barcodes: [
    ...(v.barcode ? [{ id: "primary:" + v.id, barcode: v.barcode, label: "Primary", primary: true }] : []),
    ...(v.product_barcodes ?? []).map((b: any) => ({ id: b.id, barcode: b.barcode, label: b.label, primary: false })),
  ],
});
const allRows = (products ?? []).map((p: any) => ({
  id: p.id,
  deletedAt: p.deleted_at ?? null,
  pendingEntryId: p.pending_entry_id ?? "", // created by a draft that isn't finished yet
  title: p.title,
  slug: p.slug ?? "",
  platform: p.platform ?? "",
  regionCode: p.region_code ?? "", // "" = the home region (via regionOf)
  franchise: p.franchise ?? "",
  genre: p.genre ?? "",
  description: p.description ?? "",
  imageUrl: p.image_url ?? "",
  altNames: p.alternative_names ?? [],
  categoryId: p.category_id,
  categoryName: p.category?.name ?? "",
  categoryColor: p.category?.color ?? "#2ce6e0",
  ebayId: (p.tags ?? []).find((t: string) => t.startsWith("ebay:"))?.slice(5) ?? "",
  // Sell Similar: the other seller's listing it was copied from (never synced).
  ebayRefId: (p.tags ?? []).find((t: string) => t.startsWith("ebay-ref:"))?.slice(9) ?? "",
  pcId: (p.tags ?? []).find((t: string) => t.startsWith("pricecharting:"))?.slice("pricecharting:".length) ?? "",
  // Plain tags ("plush") — the "kind:value" ones above are internal markers.
  tags: (p.tags ?? []).filter((t: string) => !t.includes(":")),
  supplierLinks: p.product_suppliers ?? [], // manager-only via RLS (staff get [])
  upcs: (p.product_upcs ?? []).map((u: any) => ({ id: u.id, upc: u.upc, source: u.source, evidence: u.evidence ?? "" })),
  upcStatus: p.upc_status ?? "",
  marketPrices: p.market_prices ?? null, // PriceCharting's Loose / Complete / New… (cents)
  upcCheckedAt: p.upc_checked_at ?? null,
  // Live stock rows only; a draft's not-yet-finished rows sit apart.
  variants: (p.product_variants ?? []).filter((v: any) => !v.pending_entry_id).map(mapVariant),
  pendingVariants: (p.product_variants ?? []).filter((v: any) => v.pending_entry_id).map(mapVariant),
}));
const isManager = Astro.locals.can("inventory.manage");
const items = allRows.filter((i) => !i.deletedAt);
// "Recently deleted" (managers only): restorable for RD_DAYS, then purged above.
const deletedItems = isManager
  ? allRows
      .filter((i) => i.deletedAt)
      .map((i) => ({
        id: i.id, title: i.title, platform: i.platform, regionCode: i.regionCode,
        daysLeft: Math.max(1, Math.ceil(RD_DAYS - (Date.now() - Date.parse(i.deletedAt)) / 864e5)),
      }))
      .sort((a, b) => a.daysLeft - b.daysLeft)
  : [];
// Platforms: the ones the store added + the catalog's own spellings, then the built-ins.
const customPlats = customPlatforms((settings as any)?.settings);
const platGroups = platformGroups(items.map((i) => i.platform), customPlats);
const posData = {
  items,
  customPlatforms: customPlats,
  categories: categories ?? [],
  completeness: completeness ?? [],
  grades: grades ?? [],
  conditionPricing: settings?.condition_pricing_enabled ?? false,
  isManager,
  invTypes: invTypesSrv ?? [],
  locations: locationsSrv ?? [],
  lblTemplates: labelTemplates((settings as any)?.settings),
  storeName: (settings as any)?.store_name || "TimeLag",
  // Shop links must be ABSOLUTE: on pos.timelag.co a relative /shop/... falls
  // through the host-split middleware and lands on the dashboard.
  webBase: import.meta.env.PROD ? `https://${MARKETING_HOSTS[0]}` : "",
  draftsReady: !draftProbeErr,
  sourcesReady: !srcProbeErr,
  receivedOnReady: !roProbeErr,
  upcReady: !upcProbeErr,
  regions, // [] before the region migration → no region controls / badges
  regionReady: !rgProbeErr,
};
---

<AppLayout title="Inventory" active="inventory">
  <div slot="actions" class="inv-head-acts">
    <div class="inv-head-l">
    {isManager && (
      <div class="inv-menu" id="inv-menu">
        <button id="inv-menu-btn" class="btn btn-ghost btn-sm" type="button" aria-haspopup="true" aria-expanded="false" title="Bulk tools: eBay import/sync, covers, titles, UPCs">🛠 Inventory updates ▾</button>
        <div class="inv-menu-pop" id="inv-menu-pop" role="menu" hidden>
          <button id="ebay-bulk" class="btn btn-ghost btn-sm" role="menuitem" title="Pick listings from your eBay store (filter by platform, category, Japan…) and add them to a receiving draft — Finish prints the labels">🛒 Import from eBay store</button>
          <button id="ebay-media" class="btn btn-ghost btn-sm" role="menuitem" title="For listings imported from eBay that are missing a photo or details (franchise / series, brand, year, character), copy them from the eBay listing">📷 Fill from eBay (photos &amp; details)</button>
          <button id="ebay-sync" class="btn btn-ghost btn-sm" role="menuitem" title="Check eBay for ended / out-of-stock listings and zero them on the website (never raises local stock)">🔁 Sync eBay stock</button>
          <button id="resync-img" class="btn btn-ghost btn-sm" role="menuitem" title="Fetch covers for items with no image (only fills empties)">🔄 Resync images</button>
          <button id="fix-titles" class="btn btn-ghost btn-sm" role="menuitem" title="Suggest official game titles (from the game database) for listings with typos — you approve each one">✎ Fix titles</button>
          <button id="write-descs" class="btn btn-ghost btn-sm" role="menuitem" title="AI writes web descriptions for listings with none or only one short line — saved as they're written, each can be undone">✍ Write descriptions</button>
          {!upcProbeErr && <button id="fill-upcs" class="btn btn-ghost btn-sm" role="menuitem" title="Look up UPCs on eBay's product catalog for games that don't have one (attaches only sure matches)">🏷 Fill missing UPCs</button>}
        </div>
      </div>
    )}
    <button id="phone-scan-btn" class="btn btn-ghost btn-sm" title="Pair your phone as a wireless scanner">📱 Phone</button>
    <a href="/entries" class="btn btn-ghost btn-sm" title="Past receiving entries + label reprints">📥 Entries</a>
    <button id="inv-import" class="btn btn-ghost btn-sm" title="Import a collection .csv (PriceCharting export or any Title / Platform / Condition sheet) as staged lines on an entry">📄 Import CSV</button>
    </div>
    <!-- The two main actions, on the right: Start entry (outlined) + Add product. -->
    <div class="inv-head-r">
      <button id="recv-toggle" class="btn btn-primary-soft btn-sm" title="Start an inventory entry — new products and received stock get grouped for label printing">▶ Start entry</button>
      <button id="toggle-add" class="btn btn-primary btn-sm">＋ Add product</button>
    </div>
  </div>

  <div id="entry-screen" hidden>
    <div class="pos-panel ent-panel">
      <div class="ent-head">
        <h2 style="margin:0;">📥 Inventory Entry <span id="ent-num"></span></h2>
        <span class="pill cyan">draft — autosaves</span>
        <label class="ent-src">Source <input id="ent-supplier" list="supplier-list" placeholder="e.g. VGNY, eBay, estate sale…" /></label>
        <label class="ent-src ent-recv" title="The date the business received these items (for a personal-collection transfer, the transfer date)">Received <input id="ent-received" type="date" /></label>
        <div class="ent-head-actions">
          <button id="ent-exit" class="btn btn-ghost btn-sm" type="button" title="Leave — the draft stays in 📥 Entries">💾 Save &amp; exit</button>
          <button id="ent-delete" class="btn btn-ghost btn-sm ent-del" type="button">🗑 Delete draft</button>
          <button id="ent-finish" class="btn btn-primary btn-sm" type="button">✓ Finish — add to stock &amp; print</button>
        </div>
      </div>
      <p id="ent-note" class="muted" style="margin:0.4rem 0 0.9rem;font-size:0.84rem;">Nothing is added to stock or the website until you press <strong>Finish</strong>. Scan or type below to add lines; put what you <em>paid</em> in “Paid $” and the order total to see what's left to assign.</p>
      <div class="ent-add">
        <div class="ti-desc-cell" style="flex:1;">
          <input id="ent-search" placeholder="Scan a barcode or type to add — e.g. mario kart 64 cib" autocomplete="off" />
          <div class="ti-suggest" id="ent-suggest" hidden></div>
        </div>
        <button id="ent-new" class="btn btn-ghost btn-sm" type="button" title="Add a product to this entry (pre-filled from what's typed in the search)">＋ Add product</button>
        <button id="ent-noninv" class="btn btn-ghost btn-sm" type="button" title="Something you paid for that isn't sold as stock — a bulk lot, parts, supplies. Recorded on the entry for the books; no stock, no label.">＋ Non-inventory</button>
        <button id="ent-import" class="btn btn-ghost btn-sm" type="button" title="Import a collection .csv — each row becomes a staged line (matched to existing listings when possible)">📄 Import CSV</button>
      </div>
      <div class="ent-bulk" id="ent-bulk" hidden>
        <span><strong id="ent-bulk-n">0</strong> selected</span>
        <label>Condition <select id="ent-bulk-comp"></select></label>
        <label>Grade <select id="ent-bulk-grade"></select></label>
        {(invTypesSrv ?? []).length > 0 && <label>Type <select id="ent-bulk-type"></select></label>}
        <button id="ent-bulk-apply" class="btn btn-primary btn-sm" type="button">Apply to selected</button>
        <button id="ent-bulk-rm" class="btn btn-ghost btn-sm ent-del" type="button">🗑 Remove selected</button>
        <button id="ent-bulk-clear" class="link-btn" type="button">Clear selection</button>
      </div>
      <table class="tbl" id="ent-table">
        <thead><tr>
          <th class="ent-ck"><input type="checkbox" id="ent-selall" title="Select all lines" aria-label="Select all lines" /></th>
          <th style="width:26%">Item</th><th>Condition</th><th>Grade</th>{(invTypesSrv ?? []).length > 0 && <th title="Inventory type — e.g. Personal Collection">Type</th>}<th class="num">Qty</th>
          <th class="num">Paid $ <small class="muted">each</small></th><th class="num">Price $</th>
          <th>Compare</th><th></th>
        </tr></thead>
        <tbody id="ent-body"></tbody>
      </table>
      <div class="ent-totals">
        <span><strong id="ent-count">0</strong> lines · <strong id="ent-units">0</strong> units</span>
        <span>Retail <strong id="ent-retail" class="ent-cyan">$0.00</strong></span>
        <span>Paid <strong id="ent-paid">$0.00</strong></span>
        <label class="ent-ot">Order total $ <input id="ent-ordertotal" type="number" min="0" step="0.01" placeholder="—" /></label>
        <span id="ent-remaining" hidden></span>
      </div>
    </div>
  </div>

  <div id="add-panel" class="pos-panel" hidden style="margin-bottom:1rem;">
    <div class="np-head">
      <h2 id="np-heading">Add a product</h2>
      <div class="np-kind" role="group" aria-label="What are you adding?">
        <button type="button" class="np-kind-btn on" data-kind="stock" aria-pressed="true">📦 Product</button>
        <button type="button" class="np-kind-btn" data-kind="noninv" aria-pressed="false" title="Something you paid for that isn't sold as stock — a bulk lot, parts, supplies. Recorded on an entry for the books; no stock, no label.">🧾 Non-inventory</button>
      </div>
    </div>
    <div id="np-noninv" hidden>
      <div class="add-grid">
        <label class="np-wide">Description<input id="ni-desc" placeholder="e.g. DS loose games, bulk grade B" maxlength="200" /></label>
        <label>Paid $ (total)<input id="ni-total" type="number" min="0" step="0.01" placeholder="unknown" /></label>
      </div>
      <p class="muted" id="ni-note" style="margin:0.6rem 0 0;font-size:0.82rem;"></p>
      <button id="ni-save" class="btn btn-primary btn-sm" style="margin-top:0.7rem;">Record non-inventory item</button>
    </div>
    <div id="np-stock">
    <!-- Quick add: find it first (same search + scan as the entry). -->
    <div class="np-find" id="np-find-wrap">
      <div class="ti-desc-cell">
        <input id="np-find" placeholder="Scan a barcode or search — e.g. mario kart 64 cib" autocomplete="off" />
        <div class="ti-suggest" id="np-find-suggest" hidden></div>
      </div>
      <p class="muted np-find-hint">Already have it? Pick it to add copies. Not listed yet → <strong>＋ New product</strong> fills in the form below.</p>
      <div id="np-recv" class="np-recv" hidden>
        <div class="cond-scroll">
          <table class="tbl np-recv-tbl">
            <thead><tr><th>Item</th><th>Completeness</th><th>Grade</th><th class="num">Qty</th><th class="num">Paid $ each</th><th class="num" title="That condition's price — changing it re-prices every copy of that condition">Price $</th><th></th></tr></thead>
            <tbody id="np-recv-body"></tbody>
          </table>
        </div>
        <div class="np-recv-foot">
          <button type="button" id="np-recv-go" class="btn btn-primary btn-sm">＋ Add to stock &amp; print labels</button>
          <span id="np-recv-sum" class="muted"></span>
          <button type="button" id="np-recv-clear" class="link-btn">Clear</button>
        </div>
      </div>
    </div>
    <div class="ebay-import">
      <div class="ebay-row">
        <span class="ebay-tag" title="Fill this form from any eBay listing of the same item — title, platform, region, condition, category, price, UPC/EAN. On Save: its cover photo + details (brand, year, series, character). Never synced with eBay.">🛒 Sell similar</span>
        <input id="np-ebay" placeholder="Paste any eBay listing (URL or item #) of the same item to fill this form…" />
        <button type="button" id="np-ebay-go" class="btn btn-ghost btn-sm">⬇ Pull data</button>
        <button type="button" id="np-bookmark" class="link-btn" title="Suruga-ya, Buyee, Mercari, Amazon JP… — add a product from any shop page with the 🔖 Send to TimeLag bookmark">🔖 Other shops</button>
      </div>
      <div id="np-ebay-note" class="ebay-note" hidden></div>
    </div>
    <div class="add-grid">
      <label>Title<input id="np-title" placeholder="e.g. Donkey Kong 64" /></label>
      <label>Platform<select id="np-platform"><option value="">— none —</option>
        {platGroups.yours.length > 0 && <optgroup label="Your platforms">{platGroups.yours.map((n) => <option value={n}>{n}</option>)}</optgroup>}
        <optgroup label="More platforms">{platGroups.more.map((n) => <option value={n}>{n}</option>)}</optgroup>
      </select></label>
      {rgOn && (
        <label title="The release's market — an import (PAL, Japan…) gets a badge everywhere">Region<select id="np-region">{regions.filter((r) => r.isActive).map((r) => <option value={r.code} selected={r.isDefault}>{r.flag} {r.name}</option>)}</select></label>
      )}
      <label>Category<select id="np-cat">{categories?.map((c) => <option value={c.id}>{c.name}</option>)}</select></label>
      <label>Completeness<span class="comp-combo-wrap"><input id="np-comp" class="comp-combo" list="comp-list" placeholder="type CIB, complete, open box…" autocomplete="off" /><span class="comp-abbr" id="np-comp-abbr" aria-live="polite"></span></span></label>
      <label>Grade<select id="np-grade"><option value="">—</option>{grades?.map((g) => <option value={g.code}>{g.label}</option>)}</select></label>
      <label>Price $<input id="np-price" type="number" min="0" step="0.01" value="0" /></label>
      <label>Qty<input id="np-qty" type="number" min="0" value="1" /></label>
      <label title="Purchase price — what you paid per copy (optional)">Paid $ each<input id="np-cost" type="number" min="0" step="0.01" placeholder="optional" /></label>
      <label>Barcode (optional)<input id="np-barcode" /></label>
      {(invTypesSrv?.length ?? 0) > 0 && (
        <label>Inventory type<select id="np-invtype">{invTypesSrv!.map((t: any) => <option value={t.id} selected={t.key === "retail"}>{t.icon} {t.name}</option>)}</select></label>
      )}
    </div>
    <p class="muted" id="np-note" style="margin:0.6rem 0 0;font-size:0.82rem;"></p>
    <button id="np-save" class="btn btn-primary btn-sm" style="margin-top:0.7rem;">Save product</button>
    </div>
  </div>

  <datalist id="comp-list">{completeness?.map((c) => <option value={c.label}>{c.code}</option>)}</datalist>
  <datalist id="supplier-list">{knownSuppliers.map((s) => <option value={s} />)}</datalist>

  <div class="pos-panel inv-shell" id="inv-shell">
    <div class="inv-toolbar">
      <div class="search">
        <span class="mag" aria-hidden="true">🔎</span>
        <input id="inv-search" type="search" placeholder="Search or add — e.g. zelda botw switch cib good" autocomplete="off" />
      </div>
      <select id="inv-cat"><option value="">All categories</option>{categories?.map((c) => <option value={c.id}>{c.name}</option>)}{vCats.map((v) => <option value={`v:${v.key}`} title={virtualHint(v)}>{v.icon} {v.label}</option>)}</select>
      <select id="inv-plat" title="Only one platform (Nintendo Switch, 3DS…)"><option value="">All platforms</option></select>
      {rgOn && (
        <select id="inv-region" title="Only listings from one region (market)"><option value="">All regions</option>{regions.filter((r) => r.isActive).map((r) => <option value={r.code} title={r.name}>{r.flag} {r.short}</option>)}</select>
      )}
      <select id="inv-sort">
        <option value="title">Sort: Title</option>
        <option value="price">Sort: Price</option>
        <option value="qty">Sort: Quantity</option>
        {rgOn && <option value="region">Sort: Region</option>}
      </select>
      <button class="chip filt" data-filt="instock">In stock</button>
      <button class="chip filt" data-filt="web">On web</button>
      <button class="chip filt" data-filt="ebay">🛒 eBay imports</button>
      <button class="chip filt warn-chip" data-filt="attention" id="attn-chip">⚠ Needs attention</button>
      {!upcProbeErr && <button class="chip filt" data-filt="needsupc" id="upc-chip" title="Games with no UPC yet — scanning their box won't find them">Needs UPC</button>}
      {(invTypesSrv ?? []).filter((t: any) => t.key !== "retail").map((t: any) => (
        <button class="chip tfilt" data-invtype={t.id} title={`Only ${t.name} stock`}>{t.icon} {t.name}</button>
      ))}
    </div>
    <div id="smart-bar" class="smart-bar" hidden></div>
    <p class="inv-count" id="inv-count"></p>
    <div id="inv-list" class="inv-list"></div>
  </div>

  <div id="bulk-bar" class="bulk-bar" hidden>
    <span class="bulk-count"><strong id="bulk-n">0</strong> selected<span id="bulk-hidden" class="bulk-hidden"></span></span>
    <label class="bulk-keep" title="Off: a new search or filter starts a fresh selection. On: what you've picked stays selected while you search for more — e.g. to build one batch of labels. Printing labels clears it either way."><input type="checkbox" id="bulk-keep" /> Keep across searches</label>
    <div class="bulk-actions">
      <button id="bulk-selall" class="btn btn-ghost btn-sm" type="button">Select all shown</button>
      <button id="bulk-print" class="btn btn-ghost btn-sm" type="button">🏷 Print labels</button>
      <button id="bulk-offline" class="btn btn-ghost btn-sm" type="button">Unpublish</button>
      <button id="bulk-online" class="btn btn-primary btn-sm" type="button">🌐 Publish to web</button>
      {rgOn && (
        <select id="bulk-region" class="bulk-region" title="Move the selected listings to another region (market)"><option value="">Set region…</option>{regions.filter((r) => r.isActive).map((r) => <option value={r.code}>{r.flag} {r.name}</option>)}</select>
      )}
      {tagCats.length > 0 && (
        <select id="bulk-vtag" class="bulk-region" title="Put the selected listings in (or take them out of) a tag category"><option value="">Tag…</option>{tagCats.flatMap((t) => [<option value={`+${t.tag}`}>{t.icon} Mark as {t.label}</option>, <option value={`-${t.tag}`}>{t.icon} Not {t.label}</option>])}</select>
      )}
      {isManager && !delProbeErr && <button id="bulk-delete" class="btn btn-ghost btn-sm bulk-del" type="button" title="Move to Recently deleted (kept 7 days, then purged)">🗑 Delete</button>}
      <button id="bulk-clear" class="btn btn-ghost btn-sm" type="button">✕ Clear</button>
    </div>
  </div>

  {isManager && deletedItems.length > 0 && (
    <div class="pos-panel rd-panel" id="rd-panel">
      <h2 class="rd-head">🗑 Recently deleted</h2>
      <p class="muted rd-note">Kept for 7 days, then removed for good. Restored items come back <strong>unpublished</strong> — review, then publish again.</p>
      <ul class="rd-list">
        {deletedItems.map((d) => (
          <li>
            <span class="rd-title">{d.title}</span>
            <Fragment set:html={regionBadgeHtml(d.regionCode, regions)} />
            {d.platform && <span class="muted">{d.platform}</span>}
            <span class="rd-days">{d.daysLeft} day{d.daysLeft === 1 ? "" : "s"} left</span>
            <button class="btn btn-ghost btn-sm rd-restore" data-id={d.id} type="button">↩ Restore</button>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div id="pcu-modal" class="modal-wrap" hidden>
    <div class="modal-backdrop" data-pcuclose></div>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="pcu-heading" style="width:min(640px,100%);">
      <header class="modal-head">
        <h2 id="pcu-heading">📈 Update from PriceCharting</h2>
        <button class="modal-x" data-pcuclose aria-label="Close">✕</button>
      </header>
      <div id="pcu-body" style="padding:0.9rem 1.1rem;overflow:auto;font-size:0.9rem;"></div>
    </div>
  </div>

  <div id="desc-modal" class="modal-wrap" hidden>
    <div class="modal-backdrop" data-dclose></div>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="desc-heading" style="width:min(880px,100%);">
      <header class="modal-head">
        <h2 id="desc-heading">✍ Write descriptions</h2>
        <button class="modal-x" data-dclose aria-label="Close">✕</button>
      </header>
      <div style="padding:0.8rem 1.1rem;overflow:auto;">
        <p class="muted" style="margin:0 0 0.6rem;font-size:0.84rem;">The AI writes a short web description — in your voice from Settings → AI — for listings with <strong>no description</strong> or just <strong>one short line</strong>, using only the listing's own facts (title, platform, series, genre, publisher, year, region) — never one copy's condition, since it covers every copy. Each is saved as soon as it's written; ↩ puts the old one back. It goes a few seconds apart to stay within the AI's free limits.</p>
        <div class="desc-opts">
          <label><input type="checkbox" id="desc-instock" checked /> Only listings in stock</label>
          <label><input type="checkbox" id="desc-thin" checked /> Include one-line descriptions</label>
        </div>
        <div id="desc-list"></div>
      </div>
      <footer style="display:flex;gap:0.6rem;justify-content:flex-end;align-items:center;padding:0.8rem 1.1rem;border-top:1px solid var(--border);">
        <span class="muted" id="desc-count" style="margin-right:auto;font-size:0.84rem;"></span>
        <button class="btn btn-ghost btn-sm" type="button" data-dclose>Close</button>
        <button class="btn btn-ghost btn-sm" type="button" id="desc-stop" hidden>■ Stop</button>
        <button class="btn btn-primary btn-sm" type="button" id="desc-go">✨ Write selected</button>
      </footer>
    </div>
  </div>

  <div id="fix-modal" class="modal-wrap" hidden>
    <div class="modal-backdrop" data-fclose></div>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="fix-heading" style="width:min(820px,100%);">
      <header class="modal-head">
        <h2 id="fix-heading">✎ Fix titles</h2>
        <button class="modal-x" data-fclose aria-label="Close">✕</button>
      </header>
      <div style="padding:0.8rem 1.1rem;overflow:auto;">
        <p class="muted" style="margin:0 0 0.6rem;font-size:0.84rem;">Official names from the game database for listings whose title looks misspelled or incomplete. The old title stays searchable, and web links don't change. Close matches are pre-checked — untick anything that's wrong.</p>
        <div id="fix-list"></div>
      </div>
      <footer style="display:flex;gap:0.6rem;justify-content:flex-end;align-items:center;padding:0.8rem 1.1rem;border-top:1px solid var(--border);">
        <span class="muted" id="fix-count" style="margin-right:auto;font-size:0.84rem;"></span>
        <button class="btn btn-ghost btn-sm" type="button" data-fclose>Cancel</button>
        <button class="btn btn-primary btn-sm" type="button" id="fix-apply">Rename selected</button>
      </footer>
    </div>
  </div>

  <div id="edit-modal" class="modal-wrap" hidden>
    <div class="modal-backdrop" data-close></div>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="m-heading">
      <header class="modal-head">
        <h2 id="m-heading">Edit product</h2>
        <button class="modal-x" data-close aria-label="Close">✕</button>
      </header>
      <!-- Price check, same links as an entry line (title + platform + region). -->
      <div class="m-pricelinks" id="m-pricelinks"></div>
      <div class="modal-body" id="modal-body"></div>
      <footer class="modal-foot">
        <a id="m-weblink" class="weblink" target="_blank" rel="noopener" hidden>↗ View on website</a>
        <a id="m-ebaylink" class="weblink" target="_blank" rel="noopener" hidden>🛒 View on eBay</a>
        <div class="foot-actions">
          <button class="btn btn-ghost btn-sm" data-close>Cancel</button>
          <button id="m-save" class="btn btn-primary btn-sm">Save changes</button>
        </div>
      </footer>
    </div>
  </div>

  <div id="toast" class="inv-toast" hidden></div>

  <script type="application/json" id="pos-data" set:html={JSON.stringify(posData)}></script>
</AppLayout>

<style is:global>
  /* "hidden" means hidden — panels/bars here set display:flex, which used to
     override it (the inventory list showed under an open entry, and the bulk
     bar sat at the bottom even with nothing selected). */
  [hidden] { display:none !important; }
  /* 🛠 Inventory updates — the bulk tools tucked into one menu. */
  .inv-menu { position:relative; }
  .inv-menu-pop { position:absolute; right:0; top:calc(100% + 4px); z-index:60; display:flex; flex-direction:column; gap:0.3rem; min-width:15rem; padding:0.5rem; background:var(--panel); border:1px solid var(--border-strong); box-shadow:0 8px 28px rgba(0,0,0,.45); }
  .inv-menu-pop .btn { justify-content:flex-start; text-align:left; width:100%; }
  /* Header: tools on the left, the two main actions (Start entry + Add
     product) on the right. */
  .top-actions:has(.inv-head-acts) { flex:1; display:flex; justify-content:flex-end; }
  .inv-head-acts { display:flex; flex:1; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.5rem 1rem; }
  .inv-head-l, .inv-head-r { display:flex; flex-wrap:wrap; align-items:center; gap:0.5rem; }
  .inv-head-r { margin-left:auto; }
  .inv-head-l .inv-menu-pop { left:0; right:auto; }
  /* Add panel: Product / Non-inventory switch. */
  .np-head { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.6rem; margin-bottom:0.85rem; }
  .np-head h2 { margin:0; }
  .np-kind { display:inline-flex; border:1px solid var(--border-strong); }
  .np-kind-btn { background:transparent; border:0; color:var(--muted); font:inherit; font-size:0.82rem; font-weight:700; padding:0.4rem 0.8rem; cursor:pointer; }
  .np-kind-btn + .np-kind-btn { border-left:1px solid var(--border-strong); }
  .np-kind-btn.on { background:color-mix(in srgb, var(--cyan) 16%, transparent); color:var(--cyan); }
  .add-grid .np-wide { grid-column:span 2; }
  @media (max-width: 600px) { .add-grid .np-wide { grid-column:auto; } }
  .inv-shell { display:flex; flex-direction:column; }
  .inv-toolbar { display:flex; flex-wrap:wrap; gap:0.6rem; align-items:center; }
  .inv-toolbar .search { flex:1; min-width:200px; }
  /* Category + sort share the search row instead of stacking as full bars. */
  .inv-toolbar select { width:auto; flex:0 1 auto; min-width:9.5rem; }
  .chip.filt { cursor:pointer; }
  .chip.filt.active { border-color:var(--cyan); color:var(--cyan); }
  .chip.tfilt { cursor:pointer; }
  .chip.tfilt.active { border-color:var(--magenta); color:var(--magenta); }
  .vchip .vtype { font-size:0.72rem; }
  .inv-count { color:var(--muted-2); font-size:0.82rem; margin:0.7rem 0 0.3rem; }
  .smart-bar { display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap; margin-top:0.7rem; padding:0.5rem 0.8rem; background:rgba(44,230,224,.07); border:1px solid rgba(44,230,224,.28); border-radius:10px; font-size:0.86rem; }
  .smart-bar .sb-label { color:var(--muted-2); font-size:0.68rem; text-transform:uppercase; letter-spacing:0.06em; }
  .smart-bar .sb-chip { background:rgba(255,255,255,.08); padding:0.1rem 0.55rem; border-radius:999px; font-size:0.78rem; }
  .smart-bar .sb-count { color:var(--muted-2); font-size:0.78rem; margin-left:auto; }
  .smart-bar strong { font-family:var(--font-display); }
  .smart-bar .btn { padding:0.25rem 0.7rem; }

  /* ---- Rich product cards ---- */
  .inv-list { display:grid; gap:0.7rem; }
  .inv-card {
    display:grid; grid-template-columns:auto 1fr auto; gap:0.9rem; align-items:start;
    border:1px solid var(--border); border-radius:14px; padding:0.85rem 1rem;
    background:linear-gradient(180deg, rgba(255,255,255,.025), rgba(255,255,255,0));
    transition:border-color .15s ease, transform .15s ease;
  }
  .inv-card { cursor:pointer; position:relative; }
  .inv-card:hover { border-color:var(--border-strong); }
  .inv-card.selected { border-color:var(--cyan); box-shadow:inset 0 0 0 1px var(--cyan); }
  .inv-card .inv-actions, .inv-card .vchip, .inv-card .inv-warn { cursor:auto; }
  .inv-check { position:absolute; top:0.55rem; left:0.55rem; z-index:3; width:1.25rem; height:1.25rem; cursor:pointer; accent-color:var(--cyan); }

  /* Recently deleted (soft-delete holding pen) */
  .rd-panel { margin-top:1.5rem; border-color:rgba(208,66,110,.45); }
  .rd-head { font-size:1rem; }
  .rd-note { font-size:0.85rem; margin:0.3rem 0 0.8rem; }
  .rd-list { list-style:none; padding:0; margin:0; display:grid; gap:0.4rem; }
  .rd-list li { display:flex; align-items:center; gap:0.8rem; padding:0.5rem 0.2rem; border-top:1px solid var(--border); flex-wrap:wrap; }
  .rd-title { font-weight:700; }
  .rd-days { margin-left:auto; font-size:0.8rem; color:var(--magenta); font-family:var(--font-mono); }
  .bulk-del { color:var(--magenta); }

  /* Bulk-edit action bar */
  .bulk-bar {
    position:sticky; bottom:1rem; z-index:20; display:flex; flex-wrap:wrap; align-items:center;
    justify-content:space-between; gap:0.8rem; margin-top:1rem; padding:0.7rem 1rem;
    background:var(--panel); border:1px solid var(--cyan); box-shadow:0 6px 24px rgba(0,0,0,.4);
  }
  .bulk-count { font-weight:700; }
  .bulk-count strong { color:var(--cyan); font-family:var(--font-mono); }
  .bulk-hidden { font-weight:500; color:var(--muted); font-size:0.85rem; }
  .bulk-keep { display:flex; align-items:center; gap:0.4rem; font-size:0.82rem; color:var(--muted); cursor:pointer; white-space:nowrap; }
  .bulk-keep input { width:1rem; height:1rem; accent-color:var(--cyan); margin:0; }
  .bulk-actions { display:flex; flex-wrap:wrap; gap:0.5rem; }
  .bulk-region { width:auto; padding:0.3rem 0.45rem; font-size:0.84rem; }
  .m-vtag { display:flex; flex-direction:column; justify-content:flex-end; gap:0.2rem; }
  .m-vtag span { display:flex; align-items:center; gap:0.4rem; font-weight:600; }
  .m-vtag input { width:auto; }
  .upc-note.m-region-warn { color:var(--yellow,#ffd23f); margin-top:0.5rem; }
  .inv-warn { margin-top:0.5rem; font-size:0.76rem; color:var(--yellow,#ffd23f); font-weight:600; }
  .chip.warn-chip.active { border-color:var(--yellow,#ffd23f); color:var(--yellow,#ffd23f); }
  .inv-cover {
    width:62px; height:62px; flex:none; border-radius:10px; overflow:hidden;
    display:grid; place-items:center; background:rgba(0,0,0,.28); font-size:1.7rem;
    border:1px solid var(--border);
  }
  .inv-cover img { width:100%; height:100%; object-fit:cover; }
  .inv-main { min-width:0; }
  .inv-titlerow { display:flex; align-items:center; gap:0.55rem; flex-wrap:wrap; }
  .inv-title { font-family:var(--font-display); font-weight:600; font-size:1.08rem; line-height:1.2; }
  .inv-catpill { font-size:0.72rem; font-weight:700; padding:0.1rem 0.55rem; border-radius:999px; }
  .inv-ebay { font-size:0.68rem; font-weight:800; padding:0.1rem 0.45rem; background:#e5323822; color:#ff6b6b; white-space:nowrap; }
  .inv-tags { display:flex; flex-wrap:wrap; gap:0.35rem; margin:0.35rem 0; }
  .inv-tag { font-size:0.72rem; padding:0.1rem 0.5rem; border-radius:999px; background:rgba(255,255,255,.06); color:var(--muted); }
  .inv-sku { font-family:var(--font-mono); font-size:0.74rem; color:var(--muted-2); }
  .inv-variants { display:flex; flex-wrap:wrap; gap:0.4rem; margin-top:0.5rem; }
  .vchip {
    display:inline-flex; align-items:center; gap:0.45rem; font-size:0.78rem;
    padding:0.25rem 0.6rem; border-radius:8px; background:rgba(44,230,224,.08);
    border:1px solid rgba(44,230,224,.22); color:var(--text);
  }
  .vchip.oos { background:rgba(255,255,255,.04); border-color:var(--border); color:var(--muted); }
  .vchip .cond { font-weight:700; font-family:var(--font-mono); }
  .vchip .web { color:var(--green); font-size:0.82rem; }
  .vchip .nweb { color:var(--muted-2); }
  .inv-actions { display:flex; flex-direction:column; gap:0.4rem; align-items:stretch; }
  .inv-actions .tot { font-size:0.74rem; color:var(--muted-2); text-align:right; }
  .icon-btn { display:inline-flex; align-items:center; justify-content:center; gap:0.35rem; white-space:nowrap; }

  @media (max-width:720px) {
    .inv-card { grid-template-columns:auto 1fr; }
    .inv-actions { grid-column:1 / -1; flex-direction:row; flex-wrap:wrap; }
    .inv-actions .tot { width:100%; text-align:left; order:-1; }
    .inv-actions .icon-btn { flex:1; }
    .inv-toolbar select { flex:1; }
  }

  /* ---- Edit modal ---- */
  .modal-wrap { position:fixed; inset:0; z-index:80; display:grid; place-items:center; padding:1rem; }
  .modal-wrap[hidden] { display:none; }
  .modal-backdrop { position:absolute; inset:0; background:rgba(0,0,0,.6); backdrop-filter:blur(2px); }
  .modal-card {
    /* Wide enough that the per-condition table breathes on desktop; never
       wider than the viewport minus the wrapper padding. */
    position:relative; width:min(1060px, 100%); max-height:92vh; display:flex; flex-direction:column;
    background:var(--panel, #14101d); border:1px solid var(--border-strong); border-radius:16px; overflow:hidden;
    box-shadow:0 24px 60px rgba(0,0,0,.5);
  }
  .modal-head { display:flex; align-items:center; justify-content:space-between; padding:0.9rem 1.1rem; border-bottom:1px solid var(--border); }
  .modal-head h2 { font-size:1.15rem; margin:0; }
  .modal-x { background:none; border:none; color:var(--muted); font-size:1.1rem; cursor:pointer; padding:0.2rem 0.4rem; }
  .modal-x:hover { color:var(--text); }
  .modal-body { padding:1rem 1.1rem; overflow:auto; display:flex; flex-direction:column; gap:1.2rem; }
  .modal-foot { display:flex; align-items:center; justify-content:space-between; gap:0.8rem; padding:0.8rem 1.1rem; border-top:1px solid var(--border); }
  .modal-foot .foot-actions { display:flex; gap:0.5rem; margin-left:auto; }
  .weblink { color:var(--cyan); font-size:0.85rem; font-weight:600; text-decoration:none; }
  .weblink:hover { text-decoration:underline; }

  .m-section > .m-label { font-size:0.72rem; letter-spacing:0.05em; text-transform:uppercase; color:var(--muted-2); margin-bottom:0.5rem; }
  .m-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:0.6rem; }
  .m-grid label, .m-field label { display:grid; gap:0.25rem; font-size:0.82rem; font-weight:600; color:var(--muted); }
  .m-field { margin-top:0.6rem; }
  .modal-card input, .modal-card select, .modal-card textarea { padding:0.45rem 0.6rem; width:100%; }

  /* The row has up to 9 columns — give each a workable minimum and let the
     whole table scroll sideways instead of crushing inputs into each other. */
  .cond-scroll { overflow-x:auto; }
  .cond-table { width:100%; min-width:880px; border-collapse:collapse; font-size:0.82rem; }
  .cond-table th { text-align:left; color:var(--muted-2); font-weight:600; font-size:0.72rem; padding:0 0.4rem 0.4rem; white-space:nowrap; }
  .cond-table td { padding:0.3rem 0.4rem; border-top:1px solid var(--border); vertical-align:middle; }
  .cond-table input { padding:0.35rem 0.45rem; }
  .cond-table .c-cond { width:7rem; }
  .cond-table [data-vf="comp"] { min-width:8.5rem; }
  .cond-table [data-vf="grade"] { min-width:4.5rem; }
  .cond-table [data-vf="sku"] { min-width:6.5rem; }
  .cond-table [data-vf="instore"], .cond-table [data-vf="online"] { min-width:5rem; }
  .cond-table [data-vf="qty"] { min-width:3.6rem; }
  .cond-table [data-vf="invtype"], .cond-table [data-vf="loc"] { min-width:6.5rem; }
  .cond-table .c-num input { text-align:right; }
  .cond-table .c-web { text-align:center; }
  .cond-table .c-web input { width:auto; }
  .cond-table select { padding:0.35rem 0.4rem; width:100%; }
  .price-cell { display:flex; gap:4px; align-items:center; }
  .reprice-btn { flex:none; width:26px; height:30px; border:none; border-radius:6px; background:var(--cyan); color:#06232b; font-size:0.95rem; cursor:pointer; line-height:1; }
  .reprice-btn:hover { filter:brightness(1.12); }
  .cp-on { font-size:0.68rem; color:var(--cyan); font-weight:800; }
  .img-field { display:flex; gap:0.4rem; align-items:stretch; }
  .img-field input { flex:1; min-width:0; }
  /* The image URL + upload pair needs real width — span two grid tracks
     whenever the grid is wide enough to have them. */
  @media (min-width: 640px) { .m-grid .m-span2 { grid-column:span 2; } }
  .img-up { flex:none; white-space:nowrap; cursor:pointer; display:inline-flex; align-items:center; }
  .img-prev { margin-top:0.5rem; }
  .img-prev img { max-height:130px; border-radius:8px; border:1px solid var(--border); display:block; }
  .web-hint { font-size:0.74rem; color:var(--muted-2); margin-top:0.4rem; }

  .bc-block { border:1px solid var(--border); border-radius:10px; padding:0.5rem 0.7rem; margin-bottom:0.5rem; }
