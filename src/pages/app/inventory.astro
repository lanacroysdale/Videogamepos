<script>
  import { buildPlatforms, parseQuery as _parseQuery, smartMatches as _smartMatches, matchScore, resolveStaticPlatform, nameHas } from "../../lib/smartSearch";
  import { resolveComp, compAbbrev } from "../../lib/conditionDisplay";
  import { openPrintDialog } from "../../lib/labelPrint";
  import { initScanReceiver, openPairDialog } from "../../lib/scanReceive";
  import { barcodeEq } from "../../lib/gtin";
  import { openImportDialog, importPrice } from "../../lib/importDialog";
  import { openEbayImportDialog } from "../../lib/ebayImportDialog";
  import { VIRTUAL_CATEGORIES, inVirtualCategory, virtualTag } from "../../lib/virtualCategories";
  import { newListingKey, officialTitleFor, itemKind, norm as normImport } from "../../lib/collectionImport";
  import { upcEligible } from "../../lib/upcMatch";
  import { upcLike, identifyUpc } from "../../lib/upcClient";
  import { bookmarkletHref, sourceOf, marketKeyFor, MARKET_KEYS, MARKET_LABELS } from "../../lib/sourceImport";
  import { platformGroups, matchPlatform } from "../../lib/platforms";
  import { regionOf, regionsOn, regionByCode, isDefaultRegion, regionBadgeHtml, displayTitle, regionTag, regionSortKey, splitTitleRegion, regionFromPlatform, type Region } from "../../lib/regions";

  const data = JSON.parse(document.getElementById("pos-data")!.textContent!);
  // Tag categories a person sets by hand (🧸 Plush): edit window + bulk bar.
  const TAG_CATS = VIRTUAL_CATEGORIES.filter((v) => virtualTag(v));
  let items: any[] = data.items;
  const categories: any[] = data.categories;
  // "＋ New category…" at the end of a category dropdown (managers): asks for a
  // name, finds-or-creates it, adds it to every category dropdown, selects it.
  const NEW_CAT = "__new_category__";
  async function createCategory(name: string): Promise<any> {
    const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ mode: "ensure-category", name }) });
    const j = await r.json();
    if (!r.ok || !j.ok) throw new Error(j.error || "Couldn't create the category");
    if (!categories.some((c: any) => c.id === j.category.id)) categories.push({ ...j.category, default_completeness: null });
    for (const sel of document.querySelectorAll<HTMLSelectElement>("#np-cat, #m-category")) {
      if ([...sel.options].some((o) => o.value === j.category.id)) continue;
      const opt = new Option(j.category.name, j.category.id);
      const newOpt = [...sel.options].find((o) => o.value === NEW_CAT);
      sel.insertBefore(opt, newOpt || null);
    }
    return j.category;
  }
  function wireNewCategory(sel: HTMLSelectElement | null) {
    if (!sel || !data.isManager || [...sel.options].some((o) => o.value === NEW_CAT)) return;
    sel.add(new Option("＋ New category…", NEW_CAT));
    let prev = sel.value;
    sel.addEventListener("focus", () => { if (sel.value !== NEW_CAT) prev = sel.value; });
    sel.addEventListener("change", async () => {
      if (sel.value !== NEW_CAT) { prev = sel.value; return; }
      const name = (prompt("New category name (e.g. Japanese Imports):", "") || "").replace(/\s+/g, " ").trim().slice(0, 40);
      if (!name) { sel.value = prev; return; }
      try { const c = await createCategory(name); sel.value = c.id; prev = c.id; toast(`✓ Category “${c.name}” ready`); }
      catch (e: any) { sel.value = prev; alert(e.message); }
    });
  }
  // Platform dropdowns (Add form + edit window), like the category one: the
  // store's platforms + "＋ New platform…" (any staff — it's just a name,
  // kept in the store's list so it's offered next time).
  const NEW_PLAT = "__new_platform__";
  let customPlats: string[] = data.customPlatforms || [];
  const platOptions = (sel: HTMLSelectElement) => [...sel.options].map((o) => o.value).filter((v) => v && v !== NEW_PLAT);
  function addPlatformOption(sel: HTMLSelectElement, name: string) {
    if (platOptions(sel).some((o) => o.toLowerCase() === name.toLowerCase())) return;
    let grp = [...sel.querySelectorAll("optgroup")].find((g) => g.label === "Your platforms") as HTMLOptGroupElement | undefined;
    if (!grp) { grp = document.createElement("optgroup"); grp.label = "Your platforms"; sel.insertBefore(grp, sel.querySelector("optgroup")); }
    const before = [...grp.querySelectorAll("option")].find((o) => o.value.localeCompare(name) > 0) ?? null;
    grp.insertBefore(new Option(name, name), before);
    // A built-in "More platforms" entry with that name goes (no duplicates).
    sel.querySelectorAll("optgroup").forEach((g) => { if (g !== grp) g.querySelectorAll("option").forEach((o) => { if (o.value.toLowerCase() === name.toLowerCase()) o.remove(); }); });
  }
  /** Select a platform by name: the same one (or its built-in spelling), else add it. */
  function setPlatform(sel: HTMLSelectElement | null, name: string | null | undefined) {
    if (!sel) return;
    const n = String(name ?? "").trim();
    if (!n) { sel.value = ""; return; }
    const m = matchPlatform(n, platOptions(sel));
    if (m) { sel.value = m; return; }
    addPlatformOption(sel, n);
    sel.value = n;
  }
  const platformOptionsHtml = () => {
    const g = platformGroups(items.map((p: any) => p.platform), customPlats);
    const opts = (l: string[]) => l.map((n) => `<option value="${esc(n)}">${esc(n)}</option>`).join("");
    return `<option value="">— none —</option>${g.yours.length ? `<optgroup label="Your platforms">${opts(g.yours)}</optgroup>` : ""}<optgroup label="More platforms">${opts(g.more)}</optgroup>`;
  };
  function wireNewPlatform(sel: HTMLSelectElement | null) {
    if (!sel || [...sel.options].some((o) => o.value === NEW_PLAT)) return;
    sel.add(new Option("＋ New platform…", NEW_PLAT));
    let prev = sel.value;
    sel.addEventListener("focus", () => { if (sel.value !== NEW_PLAT) prev = sel.value; });
    sel.addEventListener("change", async () => {
      if (sel.value !== NEW_PLAT) { prev = sel.value; return; }
      const name = (prompt("New platform name (e.g. WonderSwan Color):", "") || "").replace(/\s+/g, " ").trim().slice(0, 60);
      if (!name) { sel.value = prev; return; }
      const same = matchPlatform(name, platOptions(sel));
      try {
        if (!same || !customPlats.some((c) => c.toLowerCase() === same.toLowerCase())) {
          const j = await api({ action: "addPlatform", name: same || name });
          customPlats = j.platforms || customPlats;
        }
        const final = same || name;
        for (const s2 of document.querySelectorAll<HTMLSelectElement>("#np-platform, #m-platform")) addPlatformOption(s2, final);
        sel.value = final; prev = final;
        toast(same ? `“${final}” is already in the list — selected` : `✓ Platform “${final}” added`);
      } catch (e: any) { sel.value = prev; alert(e.message); }
    });
  }
  const completeness: any[] = data.completeness || [];
  const grades: any[] = data.grades || [];
  const conditionPricing: boolean = !!data.conditionPricing;
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: any) => String(s ?? "").replace(/[&<>"]/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[m] as string));
  const money = (c: number) => (c / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
  const toCents = (v: string) => Math.max(0, Math.round(parseFloat(v) * 100) || 0);
  const state = { q: "", cat: "", plat: "", region: "", sort: "title", instock: false, web: false, ebay: false, attention: false, needsupc: false, parsed: null as any };
  const selected = new Set<string>(); // product ids selected for bulk edit
  let shownIds = new Set<string>(); // the cards on screen (render)
  // Off (default): a new search or filter starts a fresh selection, so items
  // picked earlier can't ride along unseen into Print labels / Publish. On:
  // picks carry across searches (building one batch). Remembered per station.
  let keepSel = false;
  try { keepSel = localStorage.getItem("tl-inv-keepsel") === "1"; } catch { /* private mode */ }
  const searchMoved = () => { if (!keepSel) selected.clear(); };

  // Regions (migration 20261005000001): a listing's market is a tag shown as a
  // badge next to its title. [] before the migration → no badges / controls.
  const regions: Region[] = data.regions || [];
  const rgOn = regionsOn(regions);
  const regionReady: boolean = !!data.regionReady;
  const badge = (code: string | null | undefined) => { const h = regionBadgeHtml(code, regions); return h ? " " + h : ""; };
  const rgTitle = (p: any) => displayTitle(p.title, p.regionCode, regions); // "Okami HD [JP]" for plain text
  // Same title → the home region first.
  const byTitle = (a: any, b: any) => a.title.localeCompare(b.title) || regionSortKey(a.regionCode, regions) - regionSortKey(b.regionCode, regions);
  // A catalog listing's region: its field, else (before the migration) the
  // "[PAL]" tag its title still carries / a regional platform name.
  const listingRegion = (p: any) => regionOf(p.regionCode || splitTitleRegion(p.title, regions).code || regionFromPlatform(p.platform, regions).code, regions);

  /* ---------- Smart find-or-create (shared module: src/lib/smartSearch.ts) ---------- */
  const PLATFORMS = buildPlatforms([...items.map((p) => p.platform), ...customPlats]);
  const parseQuery = (raw: string) => _parseQuery(raw, { completeness, grades, platforms: PLATFORMS, regions });
  // A draft's not-yet-finished listings / stock rows are hidden everywhere but
  // that draft's own screen (search, scanning, import matching, Finish).
  const liveItems = () => items.filter((p: any) => !p.pendingEntryId);
  const draftItems = () => items.filter((p: any) => !p.pendingEntryId || (entryId && p.pendingEntryId === entryId));
  const draftVariants = (p: any) => [...p.variants, ...(p.pendingVariants || []).filter((v: any) => entryId && v.pendingEntryId === entryId)];
  const everyVariant = (p: any) => [...p.variants, ...(p.pendingVariants || [])];
  // The server discarded a removed line's hidden stock row / listing — forget them too.
  const forgetDiscarded = (j: any) => {
    if (j?.removedProductId) items = items.filter((p: any) => p.id !== j.removedProductId);
    if (j?.removedVariantId) items.forEach((p: any) => {
      p.variants = p.variants.filter((v: any) => v.id !== j.removedVariantId);
      if (p.pendingVariants) p.pendingVariants = p.pendingVariants.filter((v: any) => v.id !== j.removedVariantId);
    });
  };
  const smartMatches = (parsed: any, list: any[] = liveItems()) => _smartMatches(list, parsed);
  const complLabel = (code: string) => completeness.find((c) => c.code === code)?.label || code;
  const compAbbr = (code: string) => compAbbrev(code, completeness);
  const gradeLabel = (code: string) => { const g = grades.find((x) => x.code === code); return g ? (g.icon ? g.icon + " " : "") + g.label : code; };

  // Typeable completeness field: resolve free text ("cib", "complete", "open
  // box") to a canonical code held in dataset.code, and show its short badge.
  // A typeable box with a suggestion list (<datalist>) only suggests what
  // matches its current text — with "Complete In Box" in it, nothing else
  // shows. Clicking / tabbing in clears it (the old value stays as the grey
  // placeholder) so the WHOLE list shows; leaving without touching it puts
  // the old value back. Deleting it on purpose keeps it empty.
  function fullListOnOpen(input: HTMLInputElement) {
    const ph = input.placeholder;
    let held: string | null = null, touched = false;
    const open = () => {
      if (!input.value) return;
      held = input.value; touched = false;
      input.placeholder = held;
      input.value = "";
    };
    input.addEventListener("pointerdown", open);
    input.addEventListener("focus", open);
    input.addEventListener("input", (e) => { if (e.isTrusted) touched = true; });
    input.addEventListener("blur", () => {
      if (held === null) return;
      if (!touched && !input.value) { input.value = held; input.dispatchEvent(new Event("input")); }
      input.placeholder = ph;
      held = null;
    });
  }
  function wireComp(input: HTMLInputElement, badge?: HTMLElement | null) {
    fullListOnOpen(input); // first, so its blur restores before the label tidy below
    const sync = () => {
      const code = resolveComp(input.value, completeness);
      input.dataset.code = code;
      input.classList.toggle("comp-unknown", !!input.value.trim() && !code);
      if (badge) badge.textContent = code ? compAbbr(code) : "";
    };
    input.addEventListener("input", sync);
    input.addEventListener("blur", () => { const code = input.dataset.code; if (code) input.value = complLabel(code); sync(); });
    sync();
  }
  function setComp(input: HTMLInputElement, code: string, badge?: HTMLElement | null) {
    input.value = code ? complLabel(code) : "";
    input.dataset.code = code || "";
    if (badge) badge.textContent = code ? compAbbr(code) : "";
  }

  function renderSmart() {
    const bar = $("smart-bar");
    const parsed = state.parsed;
    const q = (state.q || "").trim();
    if (upcLike(q) && !codeOnListing(q, liveItems())) {
      bar.innerHTML = `<span class="sb-label">UPC</span> <span>🔎 Looking it up…</span>`;
      bar.hidden = false;
      identifyUpc(q).then((id) => {
        if ((state.q || "").trim() !== q) return;
        bar.innerHTML = `<span class="sb-label">UPC</span> <span>${upcFoundHtml(id)}</span>${id.found && !id.inCatalog ? ` <button class="btn btn-primary btn-sm" id="sb-upcadd">＋ Add product</button>` : ""}`;
        document.getElementById("sb-upcadd")?.addEventListener("click", () => addFromUpc(id));
      });
      return;
    }
    if (!parsed || (!parsed.title && !parsed.platform && !parsed.completenessCode && !parsed.gradeCode)) { bar.hidden = true; return; }
    const chips: string[] = [];
    if (parsed.platform) chips.push(`<span class="sb-chip">${esc(parsed.platform)}</span>`);
    const pr = parsed.regionCode ? regionByCode(parsed.regionCode, regions) : null;
    if (pr) chips.push(`<span class="sb-chip" title="${esc(pr.name)}">${esc(`${pr.flag ? pr.flag + " " : ""}${pr.short}`)}</span>`);
    if (parsed.completenessCode) chips.push(`<span class="sb-chip">${esc(complLabel(parsed.completenessCode))}</span>`);
    if (parsed.gradeCode) chips.push(`<span class="sb-chip">${esc(gradeLabel(parsed.gradeCode))}</span>`);
    const matches = smartMatches(parsed);
    const exact = matches.length > 0 && matches[0].s >= 0.99;
    bar.innerHTML = `
      <span class="sb-label">Understood</span>
      ${parsed.title ? `<strong>${esc(parsed.title)}</strong>` : `<em>any title</em>`}
      ${chips.join("")}
      <span class="sb-count">${matches.length} match${matches.length === 1 ? "" : "es"}</span>
      ${parsed.title && !exact ? `<button class="btn btn-primary btn-sm" id="sb-create">＋ Create this</button>` : ""}`;
    bar.hidden = false;
    document.getElementById("sb-create")?.addEventListener("click", createFromSmart);
  }

  // The Add form's Region select (regions on only); "" → the home region.
  const setNpRegion = (code: string | null | undefined) => {
    const sel = document.getElementById("np-region") as HTMLSelectElement | null;
    if (sel) sel.value = regionOf(code, regions);
  };
  // A new product starts clean: no price / UPC / eBay data left from the last
  // one. Platform, region, category, condition and type stay (handy for a
  // stack of games for one console).
  function clearProductFields() {
    for (const id of ["np-title", "np-price", "np-cost", "np-barcode", "np-ebay", "ni-desc", "ni-total"]) { const el = document.getElementById(id) as HTMLInputElement | null; if (el) el.value = ""; }
    const q = document.getElementById("np-qty") as HTMLInputElement | null; if (q) q.value = "1";
    const note = document.getElementById("np-ebay-note") as HTMLElement | null; if (note) { note.hidden = true; note.innerHTML = ""; }
    pendingEbay = null;
    pendingSource = null;
    pendingMarket = null;
    npPriceTouched = false;
  }
  // The Add panel: open = the "＋ Add product" button turns into "✕ Cancel".
  // Closing with something typed asks first (also when Start entry closes it).
  // After a save it stays open for the next one, and the button reads
  // "✓ Done" (what's saved is saved; only a half-typed one would be lost).
  let addSaved = false;
  function setAddOpen(open: boolean) {
    ($("add-panel") as HTMLElement).hidden = !open;
    if (!open) addSaved = false;
    const b = $("toggle-add");
    b.textContent = open ? (addSaved ? "✓ Done" : "✕ Cancel") : "＋ Add product";
    b.classList.toggle("btn-primary", !open);
    b.classList.toggle("btn-ghost", open);
    b.title = open ? (addSaved ? "Close the Add form" : "Close without saving") : "";
  }
  const addDirty = () => ["np-title", "np-cost", "np-barcode", "np-ebay", "ni-desc", "ni-total"].some((id) => ((document.getElementById(id) as HTMLInputElement | null)?.value ?? "").trim() !== "")
    || (parseFloat((document.getElementById("np-price") as HTMLInputElement | null)?.value || "0") || 0) > 0
    || recvRows.length > 0;
  function closeAddPanel(): boolean {
    if (($("add-panel") as HTMLElement).hidden) return true;
    const kind = npKind === "noninv" ? "non-inventory item" : "product";
    if (addDirty() && !confirm(`Discard this ${kind}? What you've typed will be cleared.`)) return false;
    clearProductFields();
    clearRecv();
    setNpKind("stock");
    setAddOpen(false);
    return true;
  }
  // Product (stock) or Non-inventory (a bulk lot / supplies: what was paid,
  // no stock, no label).
  let npKind: "stock" | "noninv" = "stock";
  function setNpKind(k: "stock" | "noninv") {
    npKind = k;
    ($("np-stock") as HTMLElement).hidden = k !== "stock";
    ($("np-noninv") as HTMLElement).hidden = k !== "noninv";
    document.querySelectorAll<HTMLElement>(".np-kind-btn").forEach((b) => { const on = b.dataset.kind === k; b.classList.toggle("on", on); b.setAttribute("aria-pressed", String(on)); });
    $("np-heading").textContent = k === "stock" ? "Add a product" : "Add a non-inventory item";
    refreshAddNotes();
  }
  // Where a save goes NOW: the open entry, or today's ⚡ Quick adds entry.
  function refreshAddNotes() {
    const onEntry = entryMode && entryId;
    $("ni-note").textContent = onEntry
      ? `Goes on this entry (#${entryHuman}) — counted in what you paid, no stock or label.`
      : "Recorded right away on today's ⚡ Quick adds entry (see 📥 Entries) — counted in what you paid, no stock or label.";
    // In an entry its own search (right above) does this.
    ($("np-find-wrap") as HTMLElement).hidden = !!onEntry;
    $("np-note").textContent = onEntry
      ? `Goes on Entry #${entryHuman} as a line — in stock and labeled when you Finish. The form stays open for the next one.`
      : "Goes into stock now, onto today's ⚡ Quick adds entry (see 📥 Entries), and its labels pop up. The form stays open for the next one.";
  }
  document.querySelectorAll<HTMLElement>(".np-kind-btn").forEach((b) => b.addEventListener("click", () => {
    setNpKind(b.dataset.kind === "noninv" ? "noninv" : "stock");
    (document.getElementById(npKind === "noninv" ? "ni-desc" : "np-title") as HTMLInputElement | null)?.focus();
  }));
  function createFromSmart() {
    const parsed = state.parsed;
    if (!parsed) return;
    clearProductFields();
    setNpKind("stock");
    const panel = $("add-panel") as HTMLElement;
    setAddOpen(true);
    ($("np-title") as HTMLInputElement).value = parsed.titleForNew.replace(/\b\w/g, (c: string) => c.toUpperCase());
    setPlatform($("np-platform") as HTMLSelectElement, parsed.platform || "");
    setNpRegion(parsed.regionCode);
    setComp($("np-comp") as HTMLInputElement, parsed.completenessCode || "", $("np-comp-abbr"));
    ($("np-grade") as HTMLSelectElement).value = parsed.gradeCode || "3";
    panel.scrollIntoView({ behavior: "smooth", block: "center" });
    ($("np-price") as HTMLInputElement).focus();
  }

  async function api(body: any) {
    const r = await fetch("/api/pos/inventory", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    const j = await r.json();
    if (!r.ok || !j.ok) throw new Error(j.error || "Failed");
    return j;
  }
  async function enrich(payload: any) {
    const r = await fetch("/api/pos/enrich", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
    return r.ok ? r.json() : { ok: false };
  }
  let toastT: any;
  function toast(msg: string) {
    const t = $("toast"); t.textContent = msg; t.hidden = false;
    clearTimeout(toastT); toastT = setTimeout(() => (t.hidden = true), 2000);
  }

  // Inventory types + locations (empty pre-migration → related UI stays hidden).
  const invTypes: any[] = (data as any).invTypes || [];
  const locations: any[] = (data as any).locations || [];
  const typeById = new Map(invTypes.map((t: any) => [t.id, t]));
  const retailTypeId = invTypes.find((t: any) => t.key === "retail")?.id || "";
  const lblTemplates: any[] = (data as any).lblTemplates || [];
  const storeName: string = (data as any).storeName || "TimeLag";
  const webBase: string = (data as any).webBase || "";

  // Stock rows made on this page (quick add, + condition, import…) don't know
  // the short label code the DB gave them — without it a label falls back to
  // the wide internal code, whose barcode runs across the spine. Fetch the
  // missing ones right before printing.
  async function fillLabelCodes(vs: any[]) {
    const need = vs.filter((v: any) => v && !v.labelCode && v.id);
    if (!need.length) return;
    try {
      const j = await api({ action: "labelCodes", variantIds: need.map((v: any) => v.id) });
      for (const v of need) if (j.codes?.[v.id]) v.labelCode = j.codes[v.id];
    } catch { /* the wide code still scans */ }
  }
  // Everything a printed label needs for one variant.
  function labelItemOf(p: any, v: any) {
    const loc = locations.find((l: any) => l.id === v.locationId) || locations.find((l: any) => l.is_default);
    return {
      title: p.title,
      categoryName: p.platform || p.categoryName || "",
      region: regionTag(p.regionCode, regions),
      condShort: condLabel(v), compCode: v.completenessCode || "",
      priceCents: v.priceCents,
      invTypeName: typeById.get(v.inventoryTypeId)?.name ?? "",
      invTypeId: v.inventoryTypeId || "", invTypeIcon: typeById.get(v.inventoryTypeId)?.icon ?? "",
      locationKey: loc?.key ?? "",
      internalCode: v.internalCode || "",
      labelCode: v.labelCode || "",
      sku: v.sku || "",
      storeName,
    };
  }

  const totalQty = (p: any) => p.variants.reduce((s: number, v: any) => s + v.quantity, 0);
  const maxPrice = (p: any) => Math.max(0, ...p.variants.map((v: any) => v.priceCents));
  const anyWeb = (p: any) => p.variants.some((v: any) => v.onlineVisible);
  // Listing UPCs (every condition shares them). "Needs UPC" = a US game on a
  // known platform with none yet — scanning its box would find nothing.
  const upcReady: boolean = !!(data as any).upcReady;
  const upcsOf = (p: any): string[] => (p.upcs || []).map((u: any) => u.upc);
  const needsUpc = (p: any) => upcReady && !upcsOf(p).length && upcEligible({ title: p.title, platform: p.platform, categoryName: p.categoryName, regionCode: p.regionCode });
  // A scanned UPC that isn't in inventory: ask eBay's catalog which game it is
  // (official title + box art from our game database). One lookup per code.
  // Is this code already on a listing loaded here (listing UPC or a condition's barcode)?
  const codeOnListing = (q: string, list: any[]) => list.some((p: any) => upcsOf(p).some((u) => barcodeEq(u, q)) || everyVariant(p).some((v: any) => (v.barcodes || []).some((b: any) => barcodeEq(b.barcode, q))));
  const catForKind = (kind: string) => {
    const re = kind === "console" ? /console|system|hardware/i : kind === "accessory" ? /accessor/i : kind === "collectible" ? /collect/i : /game/i;
    return categories.find((c: any) => re.test(c.name))?.id || "";
  };
  // The Add-product panel, pre-filled from an identified UPC.
  function addFromUpc(id: any) {
    if (entryMode) entNewProduct("", { title: id.title, platform: id.platform, region: id.region || "" });
    else {
      clearProductFields();
      setNpKind("stock");
      const panel = $("add-panel") as HTMLElement;
      setAddOpen(true);
      ($("np-title") as HTMLInputElement).value = id.title;
      setPlatform($("np-platform") as HTMLSelectElement, id.platform || "");
      setNpRegion(id.region); // eBay's catalog is the US one: "" = home
      ($("np-qty") as HTMLInputElement).value = "1";
      panel.scrollIntoView({ behavior: "smooth", block: "center" });
      ($("np-price") as HTMLInputElement).focus();
    }
    ($("np-barcode") as HTMLInputElement).value = id.upc; // saved as the listing's UPC too
    const cat = catForKind(id.kind || "");
    if (cat) ($("np-cat") as HTMLSelectElement).value = cat;
    toast(`📦 ${displayTitle(id.title, id.region, regions)} — set the condition + price, then Save`);
  }
  // The "not in inventory" row/bar for an identified UPC.
  // The owning listing's region as the server reports it (it may be a listing
  // this page hasn't loaded — "refresh this page").
  const catalogBadge = (id: any) => badge(id.region || items.find((x: any) => x.id === id.inCatalog.productId)?.regionCode);
  const upcFoundHtml = (id: any) => id.inCatalog
    ? (id.pending
      ? `📦 <strong>${esc(id.inCatalog.title)}</strong>${catalogBadge(id)} is on an unfinished inventory entry — finish that entry to scan it`
      : `📦 Already in inventory as <strong>${esc(id.inCatalog.title)}</strong>${catalogBadge(id)} — refresh this page to scan it`)
    : id.found
      ? `${id.cover ? `<img src="${esc(id.cover)}" alt="" style="width:30px;height:30px;object-fit:contain;vertical-align:middle;margin-right:0.4rem;">` : "📦 "}Not in inventory: <strong>${esc(id.title)}</strong>${badge(id.region)}${id.platform ? ` (${esc(id.platform)})` : ""}`
      : id.error
        ? `⚠ Couldn't look up UPC ${esc(id.upc || "")}: ${esc(id.evidence || "error")}`
        : `🔎 UPC ${esc(id.upc || "")}: ${esc(id.evidence || "not found")} — type the name to add it`;
  // What a listing is still missing (drives the "needs attention" inbox + badge).
  function issues(p: any): string[] {
    const out: string[] = [];
    if (!p.imageUrl) out.push("image");
    if (!p.description) out.push("description");
    if (p.variants.some((v: any) => !v.completenessCode)) out.push("condition");
    return out;
  }

  // Display label for a variant from the structured condition codes (falls back
  // to the legacy free-text condition).
  function condLabel(v: any) {
    const c = completeness.find((x) => x.code === v.completenessCode);
    const g = grades.find((x) => x.code === v.gradeCode);
    if (c || g) return [c ? compAbbr(c.code) : null, g ? (g.icon || g.label) : null].filter(Boolean).join(" · ");
    return v.condition || "—";
  }
  const gradeOpts = (sel: string) =>
    `<option value="">—</option>` + grades.map((g) => `<option value="${g.code}"${g.code === sel ? " selected" : ""}>${esc((g.icon ? g.icon + " " : "") + g.label)}</option>`).join("");
  const typeOpts = (sel: string) =>
    invTypes.map((t: any) => `<option value="${t.id}"${t.id === sel ? " selected" : ""}>${esc((t.icon ? t.icon + " " : "") + t.name)}</option>`).join("");
  const locOpts = (sel: string) =>
    `<option value="">—</option>` + locations.map((l: any) => `<option value="${l.id}"${l.id === sel ? " selected" : ""}>${esc(l.key)}</option>`).join("");

  function vchip(v: any) {
    const cls = v.quantity > 0 ? "" : "oos";
    const web = v.onlineVisible
      ? `<span class="web" title="On website">🌐</span>`
      : `<span class="nweb" title="In store only">·</span>`;
    // Flag non-retail pools (e.g. 🔒 Personal Collection) at a glance.
    const t = typeById.get(v.inventoryTypeId);
    const tIcon = t && t.key !== "retail" ? `<span class="vtype" title="${esc(t.name)}">${esc(t.icon || "📦")}</span> ` : "";
    return `<span class="vchip ${cls}">${tIcon}<span class="cond">${esc(condLabel(v))}</span> ${money(v.priceCents)} · ${v.quantity} ${web}</span>`;
  }

  function cardHtml(p: any) {
    const cover = p.imageUrl
      ? `<div class="inv-cover"><img src="${esc(p.imageUrl)}" alt=""></div>`
      : `<div class="inv-cover" style="color:${esc(p.categoryColor)}">🎮</div>`;
    const tags = [p.platform, p.genre, p.franchise].filter(Boolean).map((t: string) => `<span class="inv-tag">${esc(t)}</span>`).join("");
    const skus = p.variants.map((v: any) => v.sku).filter(Boolean);
    const webBtn = anyWeb(p)
      ? `<a class="btn btn-ghost btn-sm icon-btn" href="${webBase}${p.slug ? `/shop/${p.slug}` : "/shop"}" target="_blank" rel="noopener">↗ Web</a>`
      : "";
    const sellV = p.variants.find((v: any) => v.quantity > 0);
    const sellBtn = sellV
      ? `<a class="btn btn-ghost btn-sm icon-btn" href="/checkout?add=${sellV.id}" title="Add to checkout">🛒 Sell</a>`
      : "";
    return `
      <div class="inv-card${selected.has(p.id) ? " selected" : ""}" data-p="${p.id}">
        <input type="checkbox" class="inv-check" data-sel="${p.id}"${selected.has(p.id) ? " checked" : ""} aria-label="Select ${esc(rgTitle(p))}">
        ${cover}
        <div class="inv-main">
          <div class="inv-titlerow">
            <span class="inv-title">${esc(p.title)}</span>${badge(p.regionCode)}
            <span class="inv-catpill" style="background:${esc(p.categoryColor)}22;color:${esc(p.categoryColor)}">${esc(p.categoryName)}</span>
            ${p.ebayId ? `<span class="inv-ebay" title="Imported from eBay">🛒 eBay</span>` : ""}
          </div>
          <div class="inv-tags">${tags}</div>
          ${skus.length ? `<div class="inv-sku">${esc(skus[0])}${skus.length > 1 ? ` +${skus.length - 1}` : ""}</div>` : ""}
          ${upcsOf(p).length ? `<div class="inv-sku" title="UPC — scanning it finds this listing">UPC ${esc(upcsOf(p)[0])}${upcsOf(p).length > 1 ? ` +${upcsOf(p).length - 1}` : ""}</div>` : ""}
          <div class="inv-variants">${p.variants.map(vchip).join("")}</div>
          ${issues(p).length ? `<div class="inv-warn">⚠ Needs: ${issues(p).join(", ")}</div>` : ""}
        </div>
        <div class="inv-actions">
          <span class="tot">${totalQty(p)} in stock</span>
          <button class="btn btn-primary btn-sm icon-btn" data-edit="${p.id}">✎ Edit</button>
          ${sellBtn}
          ${webBtn}
        </div>
      </div>`;
  }

  function visible() {
    // Code-first search: a query that hits a SKU (contains), UPC/alt barcode,
    // label code, or internal code returns those items outright — scanning or
    // pasting an identifier should never depend on fuzzy title matching.
    const rawQ = (state.q || "").trim();
    if (rawQ.length >= 2) {
      const Q = rawQ.toUpperCase();
      const codeHits = liveItems().filter((p) => upcsOf(p).some((u) => barcodeEq(u, rawQ)) || p.variants.some((v: any) =>
        (v.sku && v.sku.toUpperCase().includes(Q)) ||
        (v.internalCode && v.internalCode === Q) ||
        (v.labelCode && v.labelCode === rawQ) ||
        (v.barcodes || []).some((b: any) => barcodeEq(b.barcode, rawQ))));
      if (codeHits.length) return codeHits.sort(byTitle);
    }
    let list = liveItems().filter((p) => {
      if (state.cat.startsWith("v:")) {
        // Virtual category: a field, not the listing's one category.
        const v = VIRTUAL_CATEGORIES.find((x) => `v:${x.key}` === state.cat);
        if (v && !inVirtualCategory(v, p, regions)) return false;
      } else if (state.cat && p.categoryId !== state.cat) return false;
      if (state.plat && platKey(p) !== (state.plat === NO_PLAT ? "" : state.plat)) return false;
      if (state.region && regionOf(p.regionCode, regions) !== state.region) return false;
      if (state.instock && totalQty(p) <= 0) return false;
      if (state.web && !anyWeb(p)) return false;
      if (state.ebay && !p.ebayId) return false;
      if (state.attention && issues(p).length === 0) return false;
      if (state.needsupc && !needsUpc(p)) return false;
      if ((state as any).invType && !p.variants.some((v: any) => v.inventoryTypeId === (state as any).invType)) return false;
      return true;
    });
    const parsed = state.parsed;
    if (parsed && (parsed.title || parsed.platform || parsed.completenessCode || parsed.gradeCode)) {
      list = list.map((p) => ({ p, s: matchScore(p, parsed) })).filter((x) => x.s > 0).sort((a, b) => b.s - a.s).map((x) => x.p);
    } else {
      list.sort((a, b) =>
        state.sort === "price" ? maxPrice(b) - maxPrice(a)
        : state.sort === "qty" ? totalQty(b) - totalQty(a)
        : state.sort === "region" ? regionSortKey(a.regionCode, regions) - regionSortKey(b.regionCode, regions) || a.title.localeCompare(b.title)
        : byTitle(a, b));
    }
    return list;
  }

  // Platform filter: one entry per platform, spellings merged ("Game Boy
  // Advance" / "Nintendo Game Boy Advance"), with counts. Rebuilt only when
  // the set changes (a new product, an import), keeping the pick.
  const NO_PLAT = "__none__";
  const platKey = (p: any) => { const raw = String(p.platform || "").trim(); return resolveStaticPlatform(raw) ?? raw; };
  let platSig = "";
  function renderPlatformFilter() {
    const sel = document.getElementById("inv-plat") as HTMLSelectElement | null;
    if (!sel) return;
    const counts = new Map<string, number>();
    for (const p of liveItems()) { const k = platKey(p); counts.set(k, (counts.get(k) || 0) + 1); }
    const keys = [...counts.keys()].sort((a, b) => (a === "" ? 1 : b === "" ? -1 : a.localeCompare(b)));
    const sig = keys.map((k) => `${k}:${counts.get(k)}`).join("|");
    if (sig === platSig) return;
    platSig = sig;
    if (state.plat && !counts.has(state.plat === NO_PLAT ? "" : state.plat)) state.plat = "";
    sel.innerHTML = `<option value="">All platforms</option>` + keys.map((k) => {
      const v = k || NO_PLAT;
      return `<option value="${esc(v)}"${v === state.plat ? " selected" : ""}>${esc(k || "(no platform)")} (${counts.get(k)})</option>`;
    }).join("");
  }
  function render() {
    renderPlatformFilter();
    const list = visible();
    shownIds = new Set(list.map((p) => p.id));
    $("inv-count").textContent = `${list.length} product${list.length === 1 ? "" : "s"}`;
    $("inv-list").innerHTML = list.length ? list.map(cardHtml).join("") : `<p class="empty">No products match.</p>`;
    document.querySelectorAll<HTMLElement>("[data-edit]").forEach((b) => b.addEventListener("click", (e) => { e.stopPropagation(); openModal(b.dataset.edit!); }));
    // Click a card (not a control) → open the item's edit modal (owner spec:
    // the old shop-page popup 404'd through the host-split and hit dashboard).
    document.querySelectorAll<HTMLElement>(".inv-card").forEach((card) => {
      card.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("button, a, input, select, label")) return;
        openModal(card.dataset.p!);
      });
    });
    // Bulk-select checkboxes.
    document.querySelectorAll<HTMLInputElement>(".inv-check").forEach((cb) => {
      cb.addEventListener("change", () => {
        if (cb.checked) selected.add(cb.dataset.sel!); else selected.delete(cb.dataset.sel!);
        cb.closest(".inv-card")?.classList.toggle("selected", cb.checked);
        updateBulkBar();
      });
    });
    // Live count on the "needs attention" chip.
    const attn = liveItems().filter((p) => issues(p).length).length;
    const chip = document.getElementById("attn-chip");
    if (chip) chip.textContent = `⚠ Needs attention${attn ? ` (${attn})` : ""}`;
    const nu = liveItems().filter(needsUpc).length;
    const upcChip = document.getElementById("upc-chip");
    if (upcChip) upcChip.textContent = `Needs UPC${nu ? ` (${nu})` : ""}`;
    updateBulkBar();
  }

  /* ---------- Bulk edit ---------- */
  function updateBulkBar() {
    const bar = $("bulk-bar") as HTMLElement;
    bar.hidden = entryMode || selected.size === 0;
    $("bulk-n").textContent = String(selected.size);
    const hidden = [...selected].filter((id) => !shownIds.has(id)).length;
    $("bulk-hidden").textContent = hidden ? ` · ${hidden} not shown` : "";
  }
  ($("bulk-keep") as HTMLInputElement).checked = keepSel;
  $("bulk-keep").addEventListener("change", (e) => {
    keepSel = (e.target as HTMLInputElement).checked;
    try { localStorage.setItem("tl-inv-keepsel", keepSel ? "1" : "0"); } catch { /* private mode */ }
    // Back to "this search only": drop picks that aren't on screen.
    if (!keepSel) { [...selected].forEach((id) => { if (!shownIds.has(id)) selected.delete(id); }); render(); }
  });
  $("bulk-clear").addEventListener("click", () => { selected.clear(); render(); });
  $("bulk-selall").addEventListener("click", () => { visible().forEach((p) => selected.add(p.id)); render(); });

  async function bulkSetOnline(online: boolean) {
    const ids = [...selected];
    if (!ids.length) return;
    const btn = $("bulk-online") as HTMLButtonElement; const oTxt = btn.textContent; btn.disabled = true; btn.textContent = "Saving…";
    try {
      const j = await api({ action: "bulkSetOnline", productIds: ids, online });
      // Reflect locally so the cards update without a reload.
      const set = new Set(ids);
      items.forEach((p) => { if (set.has(p.id)) p.variants.forEach((v: any) => (v.onlineVisible = online)); });
      selected.clear();
      render();
      toast(`✓ ${online ? "Published" : "Unpublished"} ${j.updated ?? ids.length} variant${(j.updated ?? 1) === 1 ? "" : "s"} across ${ids.length} item${ids.length === 1 ? "" : "s"}`);
    } catch (e: any) { alert(e.message); }
    finally { btn.disabled = false; btn.textContent = oTxt; }
  }
  $("bulk-online").addEventListener("click", () => bulkSetOnline(true));
  $("bulk-offline").addEventListener("click", () => bulkSetOnline(false));

  // Bulk "Set region" (regions on only): fix many listings' market at once.
  // Tag categories in bulk: "+plush" puts the selected listings in 🧸 Plush, "-plush" takes them out.
  document.getElementById("bulk-vtag")?.addEventListener("change", async (e) => {
    const sel = e.currentTarget as HTMLSelectElement;
    const v = sel.value; sel.value = "";
    const ids = [...selected];
    if (!v || !ids.length) return;
    const on = v.startsWith("+"), tag = v.slice(1);
    const cat = TAG_CATS.find((c) => virtualTag(c) === tag);
    const name = cat ? `${cat.icon} ${cat.label}` : tag;
    sel.disabled = true;
    try {
      const j = await api({ action: "bulkSetTag", productIds: ids, tag, on });
      items.forEach((p) => {
        if (!selected.has(p.id)) return;
        const t = new Set<string>(p.tags || []);
        if (on) t.add(tag); else t.delete(tag);
        p.tags = [...t];
      });
      selected.clear();
      render();
      const n = j.updated ?? ids.length;
      toast(on ? `✓ ${n} listing${n === 1 ? "" : "s"} → ${name}` : `✓ ${n} listing${n === 1 ? "" : "s"} taken out of ${name}${cat ? " (a title that says so still counts)" : ""}`);
    } catch (err: any) { alert(err.message); }
    finally { sel.disabled = false; }
  });
  document.getElementById("bulk-region")?.addEventListener("change", async (e) => {
    const sel = e.currentTarget as HTMLSelectElement;
    const code = sel.value; sel.value = "";
    const ids = [...selected];
    const r = regionByCode(code, regions);
    if (!r || !ids.length) return;
    // eBay's UPC lookup is the US catalog: its codes name the US release.
    const losing = code === "US" ? 0 : items.filter((p) => selected.has(p.id) && regionOf(p.regionCode, regions) !== code && (p.upcs || []).some((u: any) => u.source === "ebay")).length;
    if (!confirm(`Set the region of ${ids.length} listing${ids.length === 1 ? "" : "s"} to ${r.flag ? r.flag + " " : ""}${r.name}?${losing ? `\n\n${losing} of them ha${losing === 1 ? "s" : "ve"} an automatic eBay UPC — that's the US release's code, so it comes off.` : ""}`)) return;
    sel.disabled = true;
    try {
      const j = await api({ action: "bulkSetRegion", productIds: ids, regionCode: code });
      const reset = new Set<string>(j.upcReset || []);
      items.forEach((p) => {
        if (!selected.has(p.id)) return;
        p.regionCode = j.regionCode || code;
        if (reset.has(p.id)) { p.upcs = (p.upcs || []).filter((u: any) => u.source !== "ebay"); p.upcStatus = ""; p.upcCheckedAt = null; }
      });
      selected.clear();
      render();
      toast(`✓ ${j.updated ?? ids.length} listing${(j.updated ?? ids.length) === 1 ? "" : "s"} → ${r.flag ? r.flag + " " : ""}${r.short}`);
    } catch (err: any) { alert(err.message); }
    finally { sel.disabled = false; }
  });

  // Bulk delete (managers only; the button only renders for them — the API
  // enforces the role server-side too). Soft-delete: 7 days in Recently
  // deleted, restorable, then purged for good.
  document.getElementById("bulk-delete")?.addEventListener("click", async () => {
    const ids = [...selected];
    if (!ids.length) return;
    const n = ids.length;
    if (!confirm(`Delete ${n} item${n === 1 ? "" : "s"}?\n\nThey come off the website immediately and sit in "Recently deleted" for 7 days (restorable), then are removed permanently.`)) return;
    const btn = document.getElementById("bulk-delete") as HTMLButtonElement;
    btn.disabled = true; btn.textContent = "Deleting…";
    try {
      await api({ action: "bulkDelete", productIds: ids });
      location.reload();
    } catch (e: any) {
      toast("✗ " + e.message);
      btn.disabled = false; btn.textContent = "🗑 Delete";
    }
  });
  document.querySelectorAll<HTMLButtonElement>(".rd-restore").forEach((btn) => {
    btn.addEventListener("click", async () => {
      btn.disabled = true; btn.textContent = "Restoring…";
      try {
        await api({ action: "bulkRestore", productIds: [btn.dataset.id] });
        location.reload();
      } catch (e: any) {
        toast("✗ " + e.message);
        btn.disabled = false; btn.textContent = "↩ Restore";
      }
    });
  });
  // Print labels for every condition of the selected items (1 each by default,
  // with the per-line "all N" escape hatch for full re-tags).
  $("bulk-print").addEventListener("click", async () => {
    await fillLabelCodes(items.filter((p) => selected.has(p.id)).flatMap((p) => p.variants));
    const lines: any[] = [];
    items.filter((p) => selected.has(p.id)).forEach((p) => p.variants.forEach((v: any) => {
      if (v.internalCode || v.labelCode) lines.push({ item: labelItemOf(p, v), defaultCopies: 1, allCopies: v.quantity });
    }));
    if (!lines.length) { alert("Selected items have no label codes yet."); return; }
    // Printed = done with this batch: the selection clears (cancel keeps it).
    openPrintDialog(lines, lblTemplates, {
      title: `Print labels — ${lines.length} condition${lines.length === 1 ? "" : "s"}`,
      onPrinted: () => { selected.clear(); render(); },
    });
  });

  /* ---------- Edit modal ---------- */
  // Manager-only restock links shown in the modal (staff never receive the data).
  function supRowHtml(l: any) {
    return `<div class="sup-row" data-supid="${l.id}">${l.url ? `<a href="${esc(l.url)}" target="_blank" rel="noopener noreferrer">${esc(l.label)} ↗</a>` : `<span>${esc(l.label)}</span>`}<button class="link-btn" data-supdel="${l.id}" type="button">✕</button></div>`;
  }
  const modal = $("edit-modal");
  function closeModal() { modal.hidden = true; }
  modal.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", closeModal));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) closeModal(); });

  function openModal(pid: string) {
    const p = items.find((x) => x.id === pid);
    if (!p) return;
    modal.dataset.pid = pid;
    $("m-heading").innerHTML = "Edit · " + esc(p.title) + badge(p.regionCode);
    $("m-pricelinks").innerHTML = `<span class="muted-2">Price check:</span> ${cmpLinks([p.title, p.platform, regionTag(p.regionCode, regions)].filter(Boolean).join(" "))}`;
    const catOpts = categories.map((c) => `<option value="${c.id}"${c.id === p.categoryId ? " selected" : ""}>${esc(c.name)}</option>`).join("");
    // Active regions + the listing's own (even if since switched off).
    const curRegion = regionOf(p.regionCode, regions);
    const regionOpts = regions.filter((r) => r.isActive || r.code === curRegion)
      .map((r) => `<option value="${esc(r.code)}"${r.code === curRegion ? " selected" : ""}>${esc(`${r.flag ? r.flag + " " : ""}${r.name}`)}</option>`).join("");

    const condRows = p.variants.map(condRowHtml).join("");
    const bcBlocks = p.variants.map(bcBlockHtml).join("");

    $("modal-body").innerHTML = `
      <div class="m-section">
        <div class="m-label" style="display:flex;align-items:center;gap:0.5rem;">Product <button type="button" class="btn btn-ghost btn-sm" id="m-enrich">✨ Auto‑fill from IGDB</button></div>
        <div class="m-grid">
          <label>Title<input id="m-title" value="${esc(p.title)}"></label>
          <label>Platform<select id="m-platform">${platformOptionsHtml()}</select></label>
          ${rgOn ? `<label title="The release's market — an import (PAL, Japan…) gets a badge everywhere">Region<select id="m-region">${regionOpts}</select></label>` : ""}
          <label>Genre / set<input id="m-genre" value="${esc(p.genre)}"></label>
          <label>Franchise<input id="m-franchise" value="${esc(p.franchise)}"></label>
          <label>Category<select id="m-category">${catOpts}</select></label>
          ${TAG_CATS.map((v) => {
            const on = (p.tags || []).includes(virtualTag(v));
            const byTitle = !on && inVirtualCategory(v, { ...p, tags: [] }, regions);
            return `<label class="m-vtag" title="Shows under ${esc(v.icon + " " + v.label)} in the category filter and on the shop, whatever its category">
              <span><input type="checkbox" data-vtag="${esc(virtualTag(v))}"${on ? " checked" : ""}> ${esc(v.icon + " " + v.label)}</span>
              ${byTitle ? `<small class="muted">already — its title says so</small>` : ""}</label>`;
          }).join("")}
          <label class="m-span2">Image<div class="img-field"><input id="m-image" value="${esc(p.imageUrl)}" placeholder="https://… or upload →"><label class="btn btn-ghost btn-sm img-up">📷 Upload<input type="file" id="m-imgfile" accept="image/*" hidden></label></div></label>
        </div>
        ${rgOn ? `<div id="m-region-warn" class="upc-note m-region-warn" hidden></div>` : ""}
        <div id="m-imgprev" class="img-prev"${p.imageUrl ? "" : " hidden"}>${p.imageUrl ? `<img src="${esc(p.imageUrl)}" alt="">` : ""}</div>
        <div class="m-field"><label style="display:flex;align-items:center;gap:0.5rem;justify-content:space-between;">Description (web) <button type="button" class="btn btn-ghost btn-sm" id="m-ai-desc" data-pid="${p.id}">✨ Write with AI</button></label><textarea id="m-desc" rows="3" placeholder="Shown on the website listing" data-orig="${esc(String(p.description ?? "").trim())}">${esc(p.description)}</textarea></div>
      </div>

      <div class="m-section">
        <div class="m-label">Pricing &amp; web — per condition${conditionPricing ? ` <span class="cp-on">↻ condition pricing on</span>` : ""}</div>
        ${p.marketPrices ? `<p class="muted m-market">📈 PriceCharting averages (${esc(p.marketPrices.at || "")}): ${marketLine(p.marketPrices)}${p.marketPrices.url ? ` <a href="${esc(p.marketPrices.url)}" target="_blank" rel="noopener noreferrer">↗</a>` : ""}</p>` : ""}
        <div class="cond-scroll">
          <table class="cond-table"${invTypes.length ? "" : ` style="min-width:660px;"`}>
            <thead><tr><th>Completeness</th><th>Grade</th><th>SKU</th><th>In‑store $</th><th>Online $</th><th>Qty</th>${data.isManager ? `<th title="Purchase price — what you paid per copy">Paid $</th>` : ""}<th>Web</th>${invTypes.length ? "<th>Type</th><th>Loc</th>" : ""}</tr></thead>
            <tbody id="cond-body">${condRows}</tbody>
          </table>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" id="add-cond" style="margin-top:0.5rem;">＋ Add condition</button>
        <p class="web-hint">${conditionPricing ? "Set one condition's price and tap ↻ to re‑price the others by your rule. " : ""}Leave “Online $” blank to use the in‑store price; “Web” publishes that condition to the shop.</p>
      </div>

      ${data.isManager ? `
      <div class="m-section">
        <div class="m-label" style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">Running cost <small class="muted" style="font-weight:400;">weighted avg paid per unit (trade-ins)</small>
          <select id="cost-tf" style="margin-left:auto;">
            <option value="90">Last 3 months</option>
            <option value="365">Last year</option>
            <option value="0">All time</option>
          </select>
        </div>
        <div id="cost-body" class="muted" style="margin-top:0.4rem;">Loading…</div>
      </div>` : ""}

      <div class="m-section">
        <div class="m-label">Barcodes</div>
        ${upcReady ? `<div class="bc-block upc-block" id="upc-block">${upcBlockHtml(p)}</div>` : ""}
        <div id="bc-blocks">${bcBlocks}</div>
      </div>

      ${data.isManager && sourcesReady ? `
      <div class="m-section">
        <div class="m-label">Suppliers — where to restock <small style="text-transform:none;letter-spacing:0;">(only managers see this)</small></div>
        <div id="sup-list">${(p.supplierLinks || []).map(supRowHtml).join("")}</div>
        <div class="bc-add"><input id="sup-label" placeholder="Name — e.g. VGNY, Solutions2Go"><input id="sup-url" placeholder="https://… (optional)" style="width:14rem;"><button id="sup-add" class="btn btn-ghost btn-sm" type="button">＋ Add supplier</button></div>
      </div>` : ""}`;

    const link = $("m-weblink") as HTMLAnchorElement;
    if (anyWeb(p)) { link.href = webBase + (p.slug ? `/shop/${p.slug}` : "/shop"); link.hidden = false; } else { link.hidden = true; }
    const ebayLink = $("m-ebaylink") as HTMLAnchorElement;
    // Our own eBay listing, else (Sell Similar) the listing it was copied from.
    const ebayLinkId = p.ebayId || p.ebayRefId;
    if (ebayLinkId) {
      ebayLink.href = `https://www.ebay.com/itm/${ebayLinkId}`; ebayLink.hidden = false;
      ebayLink.textContent = p.ebayId ? "🛒 View on eBay" : "🔗 Similar on eBay";
      ebayLink.title = p.ebayId ? "This item's own eBay listing" : "The eBay listing this was added from (Sell similar) — not ours, never synced";
    } else { ebayLink.hidden = true; }

    wireNewCategory(document.getElementById("m-category") as HTMLSelectElement | null);
    // The listing's own platform, exactly as stored (never re-spelled / cut by
    // the list) — and only sent back on Save if it was changed.
    const mPlat = document.getElementById("m-platform") as HTMLSelectElement | null;
    if (mPlat) {
      const raw = String(p.platform ?? "");
      if (raw && ![...mPlat.options].some((o) => o.value === raw)) mPlat.insertBefore(new Option(raw, raw), mPlat.options[1] ?? null);
      mPlat.value = raw;
      mPlat.dataset.orig = raw;
    }
    wireNewPlatform(mPlat);
    // A UPC names ONE release — moving a listing that has one to another
    // region deserves a look before saving.
    document.getElementById("m-region")?.addEventListener("change", (ev) => {
      const to = (ev.currentTarget as HTMLSelectElement).value;
      const warn = document.getElementById("m-region-warn");
      if (!warn) return;
      warn.hidden = !(upcsOf(p).length && regionOf(to, regions) !== regionOf(p.regionCode, regions));
      if (warn.hidden) return;
      // eBay's lookup is the US catalog — the server removes its codes on a move off US.
      const ebay = (p.upcs || []).some((u: any) => u.source === "ebay");
      warn.textContent = `⚠ This listing has UPC ${upcsOf(p).join(", ")} — a UPC belongs to one release. ${ebay && to !== "US" ? "The automatic eBay UPC is the US release's, so it comes off when you save." : "Check it's the code on this region's box."}`;
    });
    bindBarcodes(p);
    if (upcReady) bindUpcBlock(p);
    bindReprice(p);
    wireModalComps();
    $("add-cond").addEventListener("click", () => addCondition(p));

    // Supplier links (manager-only section; delegated so re-renders stay clean).
    if (data.isManager && sourcesReady) {
      const supList = document.getElementById("sup-list");
      supList?.addEventListener("click", async (ev) => {
        const btn = (ev.target as HTMLElement).closest<HTMLElement>("[data-supdel]");
        if (!btn) return;
        try {
          await api({ action: "deleteSupplierLink", id: btn.dataset.supdel });
          p.supplierLinks = (p.supplierLinks || []).filter((x: any) => x.id !== btn.dataset.supdel);
          btn.closest(".sup-row")?.remove();
        } catch (e: any) { alert(e.message); }
      });
      document.getElementById("sup-add")?.addEventListener("click", async () => {
        const label = (document.getElementById("sup-label") as HTMLInputElement).value.trim();
        const url = (document.getElementById("sup-url") as HTMLInputElement).value.trim();
        if (!label) { alert("Supplier name required"); return; }
        try {
          const j = await api({ action: "addSupplierLink", productId: p.id, label, url: url || null });
          p.supplierLinks = [...(p.supplierLinks || []), j.link];
          supList?.insertAdjacentHTML("beforeend", supRowHtml(j.link));
          (document.getElementById("sup-label") as HTMLInputElement).value = "";
          (document.getElementById("sup-url") as HTMLInputElement).value = "";
        } catch (e: any) { alert(e.message); }
      });
    }

    // Label printing (per-condition buttons live in the Barcodes section).
    document.querySelectorAll<HTMLButtonElement>("[data-printlabel]").forEach((b) => b.addEventListener("click", async () => {
      const v = p.variants.find((x: any) => x.id === b.dataset.printlabel);
      if (!v) return;
      await fillLabelCodes([v]);
      if (!v.internalCode) { alert("This condition has no label code yet — reload the page and try again."); return; }
      openPrintDialog([{ item: labelItemOf(p, v), defaultCopies: 1, allCopies: v.quantity }], lblTemplates, { title: `Print · ${rgTitle(p)}` });
    }));
    // Quick stock adjust — IMMEDIATE (quantity + ledger, no draft), recorded
    // on the day's ⚡ Quick adds entry. Batch receiving lives in ▶ Start entry.
    document.querySelectorAll<HTMLButtonElement>("[data-recvstock]").forEach((b) => b.addEventListener("click", async () => {
      const v = p.variants.find((x: any) => x.id === b.dataset.recvstock);
      if (!v) return;
      const qty = parseInt(prompt(`Receive how many — ${rgTitle(p)} (${condLabel(v)})?`, "1") || "0");
      if (!qty || qty <= 0) return;
      const costRaw = prompt("Cost per unit $ (optional — what you paid):", "");
      const unitCostCents = costRaw && costRaw.trim() !== "" ? Math.round(parseFloat(costRaw) * 100) || 0 : null;
      try {
        const j = await api({ action: "receiveStock", variantId: v.id, qtyAdded: qty, unitCostCents, receivedOn: localDate() });
        v.quantity = j.newQuantity;
        const qi = $("cond-body")?.querySelector<HTMLInputElement>(`[data-vrow="${v.id}"] [data-vf="qty"]`);
        if (qi) { qi.value = String(j.newQuantity); qi.dataset.orig = qi.value; }
        render();
        toast(`✓ Received ${qty} — now ${j.newQuantity} in stock${j.quickEntry ? ` · ⚡ Quick adds (Entry #${j.quickEntry.humanId})` : ""}`);
        if (j.quickError) alert(`Received, but it couldn't be recorded on today's ⚡ Quick adds entry:\n${j.quickError}`);
      } catch (e: any) { alert(e.message); }
    }));

    // Running-average cost (managers): weighted avg paid per unit from trade-ins,
    // over a selectable timeframe.
    if (data.isManager) {
      let costEvents: Record<string, { q: number; c: number; d: string }[]> = {};
      const renderCost = () => {
        const body = document.getElementById("cost-body");
        if (!body) return;
        const tf = Number((document.getElementById("cost-tf") as HTMLSelectElement)?.value || "90");
        const cutoff = tf ? Date.now() - tf * 86400000 : 0;
        body.classList.remove("muted");
        body.innerHTML = p.variants.map((v: any) => {
          const evs = (costEvents[v.id] || []).filter((e) => !cutoff || new Date(e.d).getTime() >= cutoff);
          const units = evs.reduce((s, e) => s + e.q, 0);
          const total = evs.reduce((s, e) => s + e.c * e.q, 0);
          const avg = units ? total / units : null;
          const cur = v.costCents != null ? `<span class="muted">current ${money(v.costCents)}</span>` : "";
          const avgTxt = avg != null
            ? `<strong>${money(avg)}</strong> <span class="muted">avg · ${units} unit${units !== 1 ? "s" : ""}</span>`
            : `<span class="muted">no trade-in purchases</span>`;
          return `<div style="display:flex;justify-content:space-between;gap:1rem;padding:0.35rem 0;border-top:1px solid var(--border);font-size:0.88rem;"><span>${esc(condLabel(v))}</span><span style="text-align:right;">${avgTxt}${cur ? " · " + cur : ""}</span></div>`;
        }).join("") || `<span class="muted">No conditions.</span>`;
      };
      document.getElementById("cost-tf")?.addEventListener("change", renderCost);
      fetch("/api/pos/cost-history", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ productId: p.id }) })
        .then((r) => r.json())
        .then((j) => { if (j.ok) costEvents = j.events || {}; renderCost(); })
        .catch(() => { const b = document.getElementById("cost-body"); if (b) b.textContent = "Couldn't load cost history."; });
    }

    // Auto-fill from IGDB (cover, description) — no productId so it doesn't
    // persist; the user reviews and Saves.
    $("m-enrich").addEventListener("click", async () => {
      const title = ($("m-title") as HTMLInputElement).value.trim();
      if (!title) { alert("Enter a title first"); return; }
      toast("Looking up on IGDB…");
      try {
        const e = await enrich({ title, platform: ($("m-platform") as HTMLInputElement).value.trim() });
        if (!e.ok) throw new Error(e.error || "Lookup failed");
        if (!e.found) { toast("No IGDB match found"); return; }
        if (e.imageUrl) {
          ($("m-image") as HTMLInputElement).value = e.imageUrl;
          const prev = $("m-imgprev"); prev.innerHTML = `<img src="${e.imageUrl}" alt="">`; prev.hidden = false;
        }
        if (e.description && !($("m-desc") as HTMLTextAreaElement).value.trim()) ($("m-desc") as HTMLTextAreaElement).value = e.description;
        toast("✓ Filled from IGDB · " + e.matchedName);
      } catch (err: any) { alert(err.message); }
    });

    // Write an on-brand SEO description with the AI assistant.
    $("m-ai-desc").addEventListener("click", async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const title = ($("m-title") as HTMLInputElement).value.trim();
      if (!title) { alert("Enter a title first"); return; }
      const orig = btn.textContent;
      btn.disabled = true; btn.textContent = "✨ Writing…";
      try {
        const r = await fetch("/api/pos/ai/describe", {
          method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({ productId: btn.dataset.pid, title, platform: ($("m-platform") as HTMLInputElement).value.trim(),
            ...(rgOn ? { regionCode: (document.getElementById("m-region") as HTMLSelectElement | null)?.value || p.regionCode } : {}) }),
        });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j.error || "Failed");
        ($("m-desc") as HTMLTextAreaElement).value = j.description;
        toast("✓ Description written — review & Save");
      } catch (err: any) { alert(err.message); }
      finally { btn.disabled = false; btn.textContent = orig; }
    });

    // Image upload → stores in Supabase, fills the URL + preview.
    const imgFile = document.getElementById("m-imgfile") as HTMLInputElement | null;
    imgFile?.addEventListener("change", async () => {
      const f = imgFile.files?.[0];
      if (!f) return;
      const fd = new FormData(); fd.append("file", f);
      toast("Uploading image…");
      try {
        const r = await fetch("/api/pos/upload-image", { method: "POST", body: fd });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j.error || "Upload failed");
        ($("m-image") as HTMLInputElement).value = j.url;
        const prev = $("m-imgprev"); prev.innerHTML = `<img src="${j.url}" alt="">`; prev.hidden = false;
        toast("✓ Image uploaded");
      } catch (e: any) { alert(e.message); }
    });

    modal.hidden = false;
  }

