  // The listing's UPC(s): one code for the game, whatever the condition.
  const UPC_SOURCE: Record<string, string> = { ebay: "eBay catalog", manual: "entered", import: "from sheet" };
  function upcStatusLine(p: any): string {
    if ((p.upcs || []).length) return "";
    const when = p.upcCheckedAt ? ` (checked ${new Date(p.upcCheckedAt).toLocaleDateString()})` : "";
    const why: Record<string, string> = {
      not_found: "eBay's catalog didn't have a sure match", ambiguous: "eBay lists more than one release that could be this one",
      conflict: "eBay's UPC is already on another listing", error: "eBay didn't answer", rejected: "a manager removed the automatic UPC",
    };
    if (p.upcStatus && why[p.upcStatus]) return `No UPC yet — ${why[p.upcStatus]}${when}. Scan the box's barcode into the field to add it.`;
    return needsUpc(p) ? "No UPC yet — it's looked up automatically, or scan the box's barcode into the field." : "No UPC — scan or type it if this item has one.";
  }
  function upcBlockHtml(p: any) {
    const chips = (p.upcs || []).map((u: any) =>
      `<span class="bc-chip" title="${esc(u.evidence || UPC_SOURCE[u.source] || "")}">${esc(u.upc)} · ${esc(UPC_SOURCE[u.source] || u.source)}${data.isManager ? ` <button data-upcdel="${u.id}" title="Remove">✕</button>` : ""}</span>`).join("");
    const line = upcStatusLine(p);
    return `
      <div class="bc-head" style="display:flex;align-items:center;gap:0.5rem;">UPC <span style="font-weight:400;font-family:var(--font-body,inherit);">· the game's code, shared by every condition</span></div>
      <div data-upclist>${chips}</div>
      ${line ? `<div class="upc-note">${esc(line)}</div>` : ""}
      <div class="bc-add">
        <input id="upc-new" inputmode="numeric" placeholder="Scan or type the UPC">
        <button class="btn btn-ghost btn-sm" type="button" id="upc-add">Add</button>
        ${!(p.upcs || []).length || data.isManager ? `<button class="btn btn-ghost btn-sm" type="button" id="upc-find" title="Look it up on eBay's product catalog">🔎 Find on eBay</button>` : ""}
      </div>`;
  }
  async function upcApi(body: any) {
    const r = await fetch("/api/pos/upc", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    const j = await r.json().catch(() => ({}));
    if (!r.ok || !j.ok) throw new Error(j.error || "UPC request failed");
    return j;
  }
  // A lookup's answer for one listing → the loaded item.
  // "Is this the same game?" — the lookup's possible matches next to this
  // listing, each with eBay's catalog photo. Picking one attaches its UPC.
  // Used one listing at a time (🔎 Find on eBay) and as a QUEUE after "Fill
  // missing UPCs" (step = "3 of 12", plus Stop). Resolves with what staff did:
  // picked one / none of these (remembered — not suggested again) / skip.
  type PickResult = "picked" | "none" | "skip" | "stop";
  function chooseUpcCandidate(p: any, res: any, step?: { i: number; n: number }): Promise<PickResult> {
    return new Promise((done) => {
      const cands: any[] = res.candidates || [];
      const ov = document.createElement("div");
      ov.className = "upc-pick";
      ov.setAttribute("role", "dialog");
      ov.setAttribute("aria-modal", "true");
      ov.innerHTML = `<div class="upc-pick-card">
        ${step ? `<div class="upc-pick-step">Confirm UPCs · <strong>${step.i} of ${step.n}</strong></div>` : ""}
        <h3>Is this the same game?</h3>
        <p class="muted">eBay's catalog didn't match this listing exactly${res.status === "ambiguous" ? " (more than one release fits)" : ""}. Compare the covers — pick the right one, or none.</p>
        <div class="upc-pick-row upc-pick-ours">
          ${p.imageUrl ? `<img src="${esc(p.imageUrl)}" alt="" />` : `<span class="upc-pick-noimg">no cover</span>`}
          <div><span class="muted-2">This listing</span><strong>${esc(p.title)}${badge(p.regionCode)}</strong><span class="muted">${esc(p.platform || "")}</span></div>
        </div>
        ${cands.map((c, i) => `<div class="upc-pick-row">
          ${c.image ? `<img src="${esc(c.image)}" alt="" loading="lazy" />` : `<span class="upc-pick-noimg">no photo</span>`}
          <div><span class="muted-2">${esc(c.why || "Possible match")} · ${c.listings} eBay listing${c.listings === 1 ? "" : "s"}</span><strong>${esc(c.title)}</strong>
            <span class="muted">${esc(c.platform || "")} · UPC ${esc((c.upcs || []).join(", "))}</span>
            ${c.owner ? `<span class="upc-pick-warn">⚠ That UPC is already on “${esc(c.owner)}”</span>` : ""}</div>
          <button class="btn btn-primary btn-sm" type="button" data-pick="${i}"${c.owner ? " disabled" : ""}>✓ Use this</button>
        </div>`).join("")}
        <div class="upc-pick-foot">
          ${step ? `<button class="btn btn-ghost btn-sm" type="button" data-stop title="End the review — the rest stay for later">Stop reviewing</button>` : ""}
          <button class="btn btn-ghost btn-sm" type="button" data-skip title="Decide later — nothing is saved">Skip</button>
          <button class="btn btn-ghost btn-sm" type="button" data-none title="None of these is this game — they won't be suggested for it again">None of these</button>
        </div>
      </div>`;
      let saving = false; // a pick being saved: the dialog can't close under it
      const close = (r: PickResult) => { if (saving) return; ov.remove(); document.removeEventListener("keydown", onKey, true); done(r); };
      const onKey = (e: KeyboardEvent) => {
        if (e.key === "Escape") { e.stopPropagation(); close("skip"); }
        // Only a deliberate click picks one — a scanner's trailing Enter must not.
        else if ((e.key === "Enter" || e.key === " ") && (e.target as HTMLElement)?.matches?.("[data-pick]")) { e.preventDefault(); e.stopPropagation(); }
      };
      document.addEventListener("keydown", onKey, true);
      ov.addEventListener("click", (e) => { if (e.target === ov) close("skip"); });
      ov.querySelector("[data-skip]")!.addEventListener("click", () => close("skip"));
      ov.querySelector("[data-stop]")?.addEventListener("click", () => close("stop"));
      // None of these: remember the shown codes as wrong for this listing.
      ov.querySelector("[data-none]")!.addEventListener("click", async () => {
        if (saving) return;
        const codes = [...new Set(cands.flatMap((c) => c.upcs || []))];
        if (codes.length) {
          saving = true;
          try { await upcApi({ action: "rejectCandidates", productId: p.id, upcs: codes }); }
          catch (e: any) { saving = false; alert(e.message); return; }
          saving = false;
        }
        close("none");
      });
      ov.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) => b.addEventListener("click", async () => {
        if (saving) return;
        const c = cands[Number(b.dataset.pick)];
        saving = true;
        const btns = [...ov.querySelectorAll<HTMLButtonElement>("button")];
        const was = btns.map((x) => x.disabled);
        btns.forEach((x) => (x.disabled = true));
        b.textContent = "Saving…";
        try {
          const j = await upcApi({ action: "confirm", productId: p.id, upcs: c.upcs, title: c.title });
          p.upcs = j.upcs; p.upcStatus = "found";
          const skipped: string[] = j.skipped || [];
          const added = (j.upcs || []).map((u: any) => u.upc).filter((u: string) => c.upcs.includes(u));
          toast(`🏷 UPC ${added.join(", ") || "—"} added to ${rgTitle(p)}${skipped.length ? ` — skipped ${skipped.join("; ")}` : ""}`);
          saving = false; close("picked");
        } catch (e: any) {
          saving = false;
          btns.forEach((x, k) => (x.disabled = was[k]));
          b.textContent = "✓ Use this";
          alert(e.message);
        }
      }));
      document.body.appendChild(ov);
      // Focus the safe choice: a stray Enter skips — never attaches or rejects.
      (ov.querySelector("[data-skip]") as HTMLElement | null)?.focus();
    });
  }
  function applyUpcResult(res: any) {
    const p = items.find((x: any) => x.id === res.id);
    if (!p) return;
    if (Array.isArray(res.upcs)) p.upcs = res.upcs;
    if (!["has", "ineligible", "skipped"].includes(res.status)) { p.upcStatus = res.status; p.upcCheckedAt = new Date().toISOString(); }
  }
  function bindUpcBlock(p: any) {
    const block = $("upc-block");
    const redraw = () => { block.innerHTML = upcBlockHtml(p); bindUpcBlock(p); render(); };
    block.querySelectorAll<HTMLElement>("[data-upcdel]").forEach((btn) => btn.addEventListener("click", async () => {
      try { const j = await upcApi({ action: "remove", id: btn.dataset.upcdel }); p.upcs = j.upcs; if (j.status) p.upcStatus = j.status; redraw(); } catch (e: any) { alert(e.message); }
    }));
    const inp = block.querySelector<HTMLInputElement>("#upc-new")!;
    const add = async () => {
      const code = inp.value.trim();
      if (!code) return;
      try { const j = await upcApi({ action: "add", productId: p.id, upc: code }); p.upcs = j.upcs; p.upcStatus = "found"; redraw(); } catch (e: any) { alert(e.message); }
    };
    block.querySelector("#upc-add")!.addEventListener("click", add);
    // Wedge scanners end with Enter.
    inp.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); add(); } });
    block.querySelector("#upc-find")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true; btn.textContent = "Looking…";
      try {
        const j = await upcApi({ action: "fill", productIds: [p.id], force: (p.upcs || []).length > 0 });
        const res = j.results?.[0];
        if (res) applyUpcResult(res);
        if (j.stopped && !res) alert(j.stopped);
        // Close but not sure (the name differs, or several releases match):
        // show them with eBay's photo and let staff pick.
        else if (res?.candidates?.length) await chooseUpcCandidate(p, res);
        else if (res && res.status !== "found" && res.status !== "has") alert(res.evidence || "No sure match on eBay.");
        redraw();
      } catch (err: any) { alert(err.message); btn.disabled = false; btn.textContent = "🔎 Find on eBay"; }
    });
  }

  function bcChip(b: any) {
    return `<span class="bc-chip">${esc(b.barcode)}${b.label ? ` · ${esc(b.label)}` : ""}${b.primary ? "" : ` <button data-bcdel="${b.id}" title="Remove">✕</button>`}</span>`;
  }

  function bindBcBlock(block: HTMLElement, p: any) {
    const vid = block.dataset.bcv!;
    const v = p.variants.find((x: any) => x.id === vid);
    const list = block.querySelector<HTMLElement>("[data-bclist]")!;
    const redraw = () => { list.innerHTML = v.barcodes.map(bcChip).join("") || `<span style="color:var(--muted-2);font-size:0.76rem;">No barcodes</span>`; bindDel(); };
    const bindDel = () => list.querySelectorAll<HTMLElement>("[data-bcdel]").forEach((btn) => btn.addEventListener("click", async () => {
      try { await api({ action: "removeBarcode", id: btn.dataset.bcdel }); v.barcodes = v.barcodes.filter((b: any) => b.id !== btn.dataset.bcdel); redraw(); } catch (e: any) { alert(e.message); }
    }));
    bindDel();
    block.querySelector("[data-bcadd]")!.addEventListener("click", async () => {
      const code = block.querySelector<HTMLInputElement>("[data-bcnew]")!.value.trim();
      const label = block.querySelector<HTMLInputElement>("[data-bclabel]")!.value.trim();
      if (!code) return;
      try {
        const j = await api({ action: "addBarcode", variantId: vid, barcode: code, label });
        v.barcodes.push({ id: j.barcode.id, barcode: j.barcode.barcode, label: j.barcode.label, primary: false });
        redraw();
        block.querySelector<HTMLInputElement>("[data-bcnew]")!.value = "";
        block.querySelector<HTMLInputElement>("[data-bclabel]")!.value = "";
      } catch (e: any) { alert(e.message); }
    });
  }
  function bindBarcodes(p: any) {
    $("bc-blocks").querySelectorAll<HTMLElement>("[data-bcv]").forEach((block) => bindBcBlock(block, p));
  }

  // Condition-pricing engine: set one condition's price, the siblings follow.
  function bindRow(row: HTMLElement, p: any) {
    const rbtn = row.querySelector<HTMLElement>("[data-reprice]");
    if (!rbtn) return;
    rbtn.addEventListener("click", async () => {
      const vid = row.dataset.vrow!;
      const v = p.variants.find((x: any) => x.id === vid);
      const f = (n: string) => row.querySelector<HTMLInputElement>(`[data-vf="${n}"]`)!;
      const comp = compVal(f("comp")), grade = f("grade").value, price = toCents(f("instore").value);
      try {
        await api({ action: "updateVariant", id: vid, priceCents: price, completenessCode: comp, gradeCode: grade });
        Object.assign(v, { priceCents: price, completenessCode: comp, gradeCode: grade });
        const j = await api({ action: "repriceProduct", variantId: vid });
        (j.updated || []).forEach((u: any) => {
          const sv = p.variants.find((x: any) => x.id === u.variant_id);
          if (sv) sv.priceCents = u.new_price_cents;
          const inp = $("cond-body").querySelector<HTMLInputElement>(`[data-vrow="${u.variant_id}"] [data-vf="instore"]`);
          if (inp) inp.value = (u.new_price_cents / 100).toFixed(2);
        });
        toast(`↻ Re‑priced ${(j.updated || []).length} condition${(j.updated || []).length === 1 ? "" : "s"}`);
      } catch (e: any) { alert(e.message); }
    });
  }
  function bindReprice(p: any) {
    $("cond-body").querySelectorAll<HTMLElement>("[data-vrow]").forEach((row) => bindRow(row, p));
  }
  // Make every completeness cell in the edit modal a typeable combobox.
  function wireModalComps() {
    $("cond-body").querySelectorAll<HTMLInputElement>('[data-vf="comp"]').forEach((inp) => {
      if (inp.dataset.wired) return;
      inp.dataset.wired = "1";
      wireComp(inp);
    });
  }
  const compVal = (inp: HTMLInputElement) => inp.dataset.code || resolveComp(inp.value, completeness);

  async function addCondition(p: any) {
    const defComp = categories.find((c) => c.id === p.categoryId)?.default_completeness || "";
    const compLabel = completeness.find((c) => c.code === defComp)?.label || "New";
    try {
      const startPrice = marketPriceFor(p.marketPrices, defComp) ?? 0; // PriceCharting's average for it, when known
      const j = await api({ action: "addVariant", productId: p.id, completenessCode: defComp, gradeCode: "3", condition: compLabel, priceCents: startPrice, quantity: 0 });
      const nv: any = { id: j.variant.id, condition: compLabel, completeness: null, completenessCode: defComp, gradeCode: "3", sku: null, internalCode: j.variant.internal_code || "", labelCode: j.variant.label_code || "", priceCents: startPrice, onlinePriceCents: null, costCents: null, quantity: 0, onlineVisible: false, inventoryTypeId: retailTypeId, locationId: "", barcodes: [] };
      p.variants.push(nv);
      $("cond-body").insertAdjacentHTML("beforeend", condRowHtml(nv));
      $("bc-blocks").insertAdjacentHTML("beforeend", bcBlockHtml(nv));
      bindRow($("cond-body").querySelector<HTMLElement>(`[data-vrow="${nv.id}"]`)!, p);
      wireModalComps();
      bindBcBlock($("bc-blocks").querySelector<HTMLElement>(`[data-bcv="${nv.id}"]`)!, p);
      toast("Condition added — set its price");
    } catch (e: any) { alert(e.message); }
  }

  $("m-save").addEventListener("click", async () => {
    const pid = modal.dataset.pid!;
    const p = items.find((x) => x.id === pid);
    const btn = $("m-save") as HTMLButtonElement;
    const get = (id: string) => ($(id) as HTMLInputElement).value;
    if (!get("m-title").trim()) { alert("Title is required"); return; }
    btn.disabled = true; const orig = btn.textContent; btn.textContent = "Saving…";
    try {
      const regionSel = document.getElementById("m-region") as HTMLSelectElement | null;
      const descEl = $("m-desc") as HTMLTextAreaElement;
      const descChanged = descEl.value.trim() !== (descEl.dataset.orig ?? "");
      const pj = await api({
        action: "updateProduct", id: pid,
        title: get("m-title").trim(), genre: get("m-genre").trim(),
        // Platform only when it was changed (a save never re-spells it).
        ...(get("m-platform") !== ($("m-platform") as HTMLSelectElement).dataset.orig ? { platform: get("m-platform") } : {}),
        franchise: get("m-franchise").trim(), categoryId: get("m-category"), imageUrl: get("m-image").trim(),
        // Description only when it was changed here — an edit window left open
        // must not wipe one written meanwhile (e.g. by ✍ Write descriptions).
        ...(descChanged ? { description: ($("m-desc") as HTMLTextAreaElement).value.trim() } : {}),
        ...(regionSel ? { regionCode: regionSel.value } : {}),
        // Tag categories (🧸 Plush): on / off per tag.
        ...(document.querySelector("[data-vtag]") ? { tags: Object.fromEntries([...document.querySelectorAll<HTMLInputElement>("[data-vtag]")].map((c) => [c.dataset.vtag!, c.checked])) } : {}),
      });
      Object.assign(p, {
        title: get("m-title").trim(), platform: get("m-platform"), genre: get("m-genre").trim(),
        franchise: get("m-franchise").trim(), categoryId: get("m-category"), imageUrl: get("m-image").trim(),
        ...(descChanged ? { description: ($("m-desc") as HTMLTextAreaElement).value.trim() } : {}),
        categoryName: categories.find((c) => c.id === get("m-category"))?.name ?? p.categoryName,
        categoryColor: categories.find((c) => c.id === get("m-category"))?.color ?? p.categoryColor,
      });
      // What the server stored: a typed "[JP]" title tag becomes the region.
      if (typeof pj.title === "string") p.title = pj.title;
      if (typeof pj.regionCode === "string") p.regionCode = pj.regionCode;
      if (Array.isArray(pj.tags)) p.tags = pj.tags;
      if (pj.upcReset) { p.upcs = (p.upcs || []).filter((u: any) => u.source !== "ebay"); p.upcStatus = ""; p.upcCheckedAt = null; }

      for (const row of Array.from(document.querySelectorAll<HTMLElement>("[data-vrow]"))) {
        const vid = row.dataset.vrow!;
        const v = p.variants.find((x: any) => x.id === vid);
        const f = (name: string) => row.querySelector<HTMLInputElement>(`[data-vf="${name}"]`)!;
        const onlineRaw = f("online").value.trim();
        const comp = compVal(f("comp")), grade = f("grade").value;
        const derived = [completeness.find((c) => c.code === comp)?.label, grades.find((g) => g.code === grade)?.label].filter(Boolean).join(" ") || v.condition;
        const payload = {
          action: "updateVariant", id: vid,
          condition: derived,
          completenessCode: comp,
          gradeCode: grade,
          sku: f("sku").value.trim(),
          priceCents: toCents(f("instore").value),
          onlinePriceCents: onlineRaw === "" ? null : toCents(onlineRaw),
          // Only a count the user changed: the page's numbers can be stale
          // (sales on other stations) and must not overwrite live stock.
          ...(f("qty").value !== f("qty").dataset.orig ? { quantity: Math.max(0, Math.round(parseInt(f("qty").value)) || 0) } : {}),
          // Purchase price per copy (managers see the column).
          ...(row.querySelector('[data-vf="cost"]') ? { costCents: f("cost").value.trim() === "" ? null : toCents(f("cost").value) } : {}),
          onlineVisible: f("web").checked,
          ...(invTypes.length ? { inventoryTypeId: f("invtype").value, locationId: f("loc").value || null } : {}),
        };
        await api(payload);
        Object.assign(v, {
          condition: derived, completenessCode: comp, gradeCode: grade,
          sku: f("sku").value.trim() || null, priceCents: payload.priceCents,
          onlinePriceCents: payload.onlinePriceCents, quantity: payload.quantity ?? v.quantity, onlineVisible: payload.onlineVisible,
          ...("costCents" in payload ? { costCents: payload.costCents } : {}),
        });
        if (invTypes.length) Object.assign(v, { inventoryTypeId: f("invtype").value, locationId: f("loc").value || "" });
      }
      render(); closeModal(); toast("✓ Saved to POS + website");
    } catch (e: any) {
      alert(e.message);
    } finally { btn.disabled = false; btn.textContent = orig; }
  });

  /* ---------- Toolbar ---------- */
  $("inv-search").addEventListener("input", (e) => {
    if ((e.target as HTMLInputElement).value.trim() !== (state.q || "").trim()) searchMoved();
    state.q = (e.target as HTMLInputElement).value;
    state.parsed = state.q.trim() ? parseQuery(state.q) : null;
    renderSmart();
    render();
  });
  $("inv-cat").addEventListener("change", (e) => { searchMoved(); state.cat = (e.target as HTMLSelectElement).value; render(); });
  document.getElementById("inv-plat")?.addEventListener("change", (e) => { searchMoved(); state.plat = (e.target as HTMLSelectElement).value; render(); });
  document.getElementById("inv-region")?.addEventListener("change", (e) => { searchMoved(); state.region = (e.target as HTMLSelectElement).value; render(); });
  $("inv-sort").addEventListener("change", (e) => { state.sort = (e.target as HTMLSelectElement).value; render(); });
  document.querySelectorAll<HTMLElement>(".chip.filt").forEach((chip) => chip.addEventListener("click", () => {
    searchMoved();
    chip.classList.toggle("active");
    (state as any)[chip.dataset.filt!] = chip.classList.contains("active");
    render();
  }));
  // Inventory-type chips: exclusive toggle (click again to clear).
  document.querySelectorAll<HTMLElement>(".chip.tfilt").forEach((chip) => chip.addEventListener("click", () => {
    const on = !chip.classList.contains("active");
    searchMoved();
    document.querySelectorAll(".chip.tfilt").forEach((c) => c.classList.remove("active"));
    chip.classList.toggle("active", on);
    (state as any).invType = on ? chip.dataset.invtype : "";
    render();
  }));

  /* ---------- Entry DRAFTS: clean trade-in-style receiving screen ----------
     Staged lines only — nothing hits stock or the website until Finish. The
     draft autosaves on every edit and survives leaving the page (resume or
     delete it from 📥 Entries). */
  const draftsReady: boolean = !!(data as any).draftsReady;
  const sourcesReady: boolean = !!(data as any).sourcesReady;
  const receivedOnReady: boolean = !!(data as any).receivedOnReady;
  const localDate = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`; };
  let entryId = "";
  let entryHuman = 0;
  let entryMode = false;
  let entRows: any[] = []; // {itemId, variantId, title, platform, regionCode, cond, completenessCode, gradeCode, qty, costCents, priceCents, wasNew, supplier}
  const entSel = new Set<string>(); // selected draft lines (bulk actions)
  // Condition changes in flight — Finish waits for them (a Finish landing
  // mid-change would apply the line to the row it was leaving).
  let entBusy = 0;
  const entBusyStep = (d: number) => {
    entBusy = Math.max(0, entBusy + d);
    const f = $("ent-finish") as HTMLButtonElement | null;
    if (f) { f.disabled = entBusy > 0; f.title = entBusy > 0 ? "Wait — changes are still saving" : ""; }
  };
  const entCompOpts = (sel: string) =>
    `<option value="">—</option>` + completeness.map((c) => `<option value="${c.code}"${c.code === sel ? " selected" : ""}>${esc(c.label)}</option>`).join("");
  function entSyncSelection() {
    const all = $("ent-selall") as HTMLInputElement | null;
    if (all) { all.checked = entRows.length > 0 && entSel.size === entRows.length; all.indeterminate = entSel.size > 0 && entSel.size < entRows.length; }
    const bar = $("ent-bulk") as HTMLElement | null;
    if (bar) { bar.hidden = entSel.size === 0; $("ent-bulk-n").textContent = String(entSel.size); }
  }
  // Move a staged line to another completeness / grade (server picks or makes
  // the matching stock row on the same listing), then mirror it locally.
  async function setLineCondition(r: any, comp: string, grade: string, typeId?: string) {
    if (r.kind === "non_inventory") return;
    // The copy's CURRENT type: its stock row as loaded here (authoritative),
    // else the line's. A type change is only skipped when it truly matches.
    const before = items.flatMap(everyVariant).find((v: any) => v.id === r.variantId);
    const curType = before?.inventoryTypeId || r.inventoryTypeId || "";
    const typeChange = !!typeId && typeId !== curType;
    if ((r.completenessCode || "") === comp && (r.gradeCode || "") === grade && !typeChange) return;
    const condition = [completeness.find((c) => c.code === comp)?.label, grades.find((g) => g.code === grade)?.label].filter(Boolean).join(" ") || "Used";
    const j = await api({ action: "setEntryLineCondition", itemId: r.itemId, completenessCode: comp, gradeCode: grade, condition, ...(typeChange ? { inventoryTypeId: typeId } : {}) });
    const p: any = items.find((x) => x.id === j.productId) || items.find((x) => everyVariant(x).some((v: any) => v.id === r.variantId));
    if (!p) return;
    p.pendingVariants ||= [];
    const src = everyVariant(p).find((v: any) => v.id === r.variantId);
    // Mirror the type the SERVER used (it keeps the row's own type unless one was sent).
    const serverType: string = j.inventoryTypeId || src?.inventoryTypeId || curType || retailTypeId;
    if (j.mode === "renamed" && src) Object.assign(src, { completenessCode: comp, gradeCode: grade, condition, inventoryTypeId: serverType });
    // Mirror exactly what the server did (no SKU / web flag / cost copied from the old row).
    let dest = everyVariant(p).find((v: any) => v.id === j.variantId);
    if (!dest && (j.mode === "created" || j.mode === "moved")) {
      dest = {
        id: j.variantId, condition, completeness: null, completenessCode: comp, gradeCode: grade, sku: null,
        internalCode: j.internalCode || "", labelCode: j.labelCode || "", priceCents: j.priceCents ?? 0, onlinePriceCents: null, costCents: null,
        quantity: 0, onlineVisible: false, inventoryTypeId: serverType, locationId: src?.locationId || "", barcodes: [],
        pendingEntryId: j.mode === "created" ? entryId : "", // a row made for a draft stays hidden until Finish
      };
      (j.mode === "created" ? p.pendingVariants : p.variants).push(dest);
    }
    if (dest && j.removedVariantId) {
      // Barcodes the server moved onto the destination row.
      const have = new Set((dest.barcodes || []).map((b: any) => b.barcode));
      if (j.primaryBarcode && !have.has(j.primaryBarcode)) { dest.barcodes.unshift({ id: "primary:" + dest.id, barcode: j.primaryBarcode, label: "Primary", primary: true }); have.add(j.primaryBarcode); }
      for (const b of (src?.barcodes || [])) if (!b.primary && (j.movedBarcodes || []).includes(b.barcode) && !have.has(b.barcode)) dest.barcodes.push(b);
    }
    if (j.removedVariantId) {
      p.variants = p.variants.filter((v: any) => v.id !== j.removedVariantId);
      p.pendingVariants = p.pendingVariants.filter((v: any) => v.id !== j.removedVariantId);
    }
  }
  let entOrderTotal: number | null = null;
  let entSupplier = ""; // entry-level source (per-line placeholder default)
  if (!sourcesReady) document.querySelectorAll<HTMLElement>(".ent-src, .ent-srccol").forEach((el) => (el.style.display = "none"));
  const recvWrap = document.querySelector<HTMLElement>(".ent-recv");
  if (recvWrap) recvWrap.style.display = receivedOnReady ? "" : "none";
  try { const s = JSON.parse(sessionStorage.getItem("tl-entry") || "null"); if (s?.id) { entryId = s.id; entryHuman = s.h; } } catch {}
  refreshAddNotes();

  function setEntryMode(on: boolean) {
    entryMode = on && !!entryId;
    ($("entry-screen") as HTMLElement).hidden = !entryMode;
    // The entry screen stands alone: no inventory list, bulk bar or deleted items under it.
    ($("inv-shell") as HTMLElement).hidden = entryMode;
    const rd = document.getElementById("rd-panel"); if (rd) rd.hidden = entryMode;
    if (entryMode) { selected.clear(); updateBulkBar(); }
    const t = $("recv-toggle");
    if (t) t.textContent = entryMode ? `📥 Entry #${entryHuman} (open)` : "▶ Start entry";
    if (entryMode) { $("ent-num").textContent = `#${entryHuman}`; renderEnt(); }
    // The Add form sits where it's used: in the entry, right under its search
    // row (what you add shows up in the lines below); else above the list.
    const addPanel = $("add-panel");
    if (entryMode) document.querySelector("#entry-screen .ent-add")?.after(addPanel);
    else $("inv-shell").before(addPanel);
    // Any other way in / out of an entry: the Add form's notes must say where
    // a save will go NOW.
    refreshAddNotes();
  }
  function clearEntry() {
    entryId = ""; entryHuman = 0; entRows = []; entOrderTotal = null; entSel.clear();
    try { sessionStorage.removeItem("tl-entry"); } catch {}
    setEntryMode(false);
  }

  // Competitor price references per line (same links as the trade-in screen).
  const cmpLinks = (q0: string) => {
    const q = encodeURIComponent(q0 || "");
    return `<span class="ti-links">
      <a href="https://www.pricecharting.com/search-products?q=${q}&type=prices" target="_blank" rel="noopener">PriceCharting↗</a>
      <a href="https://www.ebay.com/sch/i.html?_nkw=${q}&LH_Sold=1&LH_Complete=1" target="_blank" rel="noopener">eBay sold↗</a>
      <a href="https://www.gamestop.com/search/?q=${q}" target="_blank" rel="noopener">GameStop↗</a>
    </span>`;
  };

  function entTotals() {
    const stock = entRows.filter((r) => r.kind !== "non_inventory");
    const units = stock.reduce((s, r) => s + r.qty, 0);
    const retail = stock.reduce((s, r) => s + r.priceCents * r.qty, 0);
    // Paid covers EVERYTHING bought on this entry, incl. non-inventory lines.
    const paid = entRows.reduce((s, r) => s + (r.costCents ?? 0) * r.qty, 0);
    const nonInv = entRows.length - stock.length;
    $("ent-count").textContent = String(entRows.length) + (nonInv ? ` (${nonInv} non-inventory)` : "");
    $("ent-units").textContent = String(units);
    $("ent-retail").textContent = money(retail);
    $("ent-paid").textContent = money(paid);
    const rem = $("ent-remaining") as HTMLElement;
    if (entOrderTotal == null) { rem.hidden = true; return; }
    const left = entOrderTotal - paid;
    rem.hidden = false;
    rem.className = left === 0 ? "ent-rem-ok" : left > 0 ? "ent-rem-left" : "ent-rem-over";
    rem.innerHTML = left === 0 ? `✓ fully assigned <strong>$0.00</strong>`
      : left > 0 ? `left to assign <strong>${money(left)}</strong>`
      : `over by <strong>${money(-left)}</strong>`;
  }

  // A finished entry put back to draft: its copies are still in stock (minus
  // any that sold since it was finished — those can't come back out).
  const entReopened = () => entRows.some((r) => r.stockedQty > 0);
  const stockLeft = (r: any) => Math.min(r.stockedQty || 0, r.stockedOnHand || 0);
  const soldSince = (r: any) => (r.stockedQty || 0) - stockLeft(r);
  // Mirror what the server just did to a reopened line's stock row (removed
  // line / deleted draft / Finish moved its copies) in the grid's numbers.
  const unstockLocal = (r: any) => {
    if (!r?.stockedQty || !r.stockedVariantId) return;
    const v = items.flatMap(everyVariant).find((x: any) => x.id === r.stockedVariantId);
    if (v) v.quantity = Math.max(0, (v.quantity || 0) - r.stockedQty);
  };
  const ENT_NOTE = $("ent-note")?.innerHTML ?? "";
  function renderEnt() {
    const note = $("ent-note");
    if (note) note.innerHTML = entReopened()
      ? `↩ <strong>Back in draft</strong> — this entry was finished before, so the copies marked <em>in stock</em> are still in stock (and can still be sold). Fix lines or add new ones; <strong>Finish</strong> applies only what changed. Removing a line takes its copies back out of stock.`
      : ENT_NOTE;
    const body = $("ent-body");
    body.innerHTML = entRows.length ? entRows.map((r) => r.kind === "non_inventory" ? `
      <tr data-item="${r.itemId}" class="ent-noninv">
        <td class="ent-ck"><input type="checkbox" data-esel aria-label="Select line"${entSel.has(r.itemId) ? " checked" : ""} /></td>
        <td><strong>${esc(r.title)}</strong> <span class="pill" style="font-size:0.66rem;" title="Recorded for the books (what you paid) — no stock, no label">🧾 non-inventory</span></td>
        <td colspan="${invTypes.length ? 3 : 2}" class="muted" style="font-size:0.8rem;">no stock · no label</td>
        <td class="num"><input data-ef="qty" type="number" min="1" value="${r.qty}"></td>
        <td class="num"><input data-ef="cost" type="number" min="0" step="0.01" value="${r.costCents == null ? "" : (r.costCents / 100).toFixed(2)}" placeholder="—"></td>
        <td class="num muted">—</td>
        <td></td>
        <td><button class="link-btn" data-erm title="Remove line">✕</button></td>
      </tr>` : `
      <tr data-item="${r.itemId}">
        <td class="ent-ck"><input type="checkbox" data-esel aria-label="Select line"${entSel.has(r.itemId) ? " checked" : ""} /></td>
        <td><strong>${esc(r.title)}</strong>${badge(r.regionCode)}${r.platform ? ` <span class="ti-sug-meta">${esc(r.platform)}</span>` : ""}${r.wasNew && !r.stockedQty ? ` <span class="pill cyan" style="font-size:0.66rem;">new</span>` : ""}${r.stockedQty ? ` <span class="pill" style="font-size:0.66rem;" title="Already in stock from when this entry was finished — Finish applies only changes to this line">✓ ${stockLeft(r)} in stock${soldSince(r) ? ` · ${soldSince(r)} sold` : ""}</span>` : ""}</td>
        <td><select data-ef="comp" title="Completeness — moves the copy to that condition's stock row">${entCompOpts(r.completenessCode)}</select></td>
        <td><select data-ef="grade" title="Grade (stars)">${gradeOpts(r.gradeCode)}</select></td>
        ${invTypes.length ? `<td><select data-ef="type" title="Inventory type — moves the copy to that type's stock row on the same listing">${typeOpts(r.inventoryTypeId || retailTypeId)}</select></td>` : ""}
        <td class="num"><input data-ef="qty" type="number" min="1" value="${r.qty}"></td>
        <td class="num"><input data-ef="cost" type="number" min="0" step="0.01" value="${r.costCents == null ? "" : (r.costCents / 100).toFixed(2)}" placeholder="—"></td>
        <td class="num"><input data-ef="price" type="number" min="0" step="0.01" value="${(r.priceCents / 100).toFixed(2)}"></td>
        <td>${cmpLinks([r.title, r.platform, regionTag(r.regionCode, regions)].filter(Boolean).join(" "))}</td>
        <td><button class="link-btn" data-erm title="Remove line">✕</button></td>
      </tr>`).join("") : `<tr><td colspan="${invTypes.length ? 10 : 9}" class="empty" style="padding:1rem 0.4rem;">Nothing staged yet — scan or search above to add the first item.</td></tr>`;
    // Drop selections of lines that are gone; sync the header box + bulk bar.
    for (const id of [...entSel]) if (!entRows.some((x) => x.itemId === id)) entSel.delete(id);
    entSyncSelection();

    body.querySelectorAll<HTMLElement>("tr[data-item]").forEach((tr) => {
      const r = entRows.find((x) => x.itemId === tr.dataset.item)!;
      tr.querySelector<HTMLInputElement>('[data-ef="qty"]')!.addEventListener("change", async (e) => {
        r.qty = Math.max(1, parseInt((e.target as HTMLInputElement).value) || 1);
        (e.target as HTMLInputElement).value = String(r.qty);
        entTotals();
        entBusyStep(1); // Finish waits for line edits still saving
        try { await api({ action: "updateEntryItem", itemId: r.itemId, qty: r.qty }); } catch (err: any) { alert(err.message); }
        finally { entBusyStep(-1); }
      });
      tr.querySelector<HTMLInputElement>('[data-ef="cost"]')!.addEventListener("change", async (e) => {
        const raw = (e.target as HTMLInputElement).value.trim();
        r.costCents = raw === "" ? null : toCents(raw);
        entTotals();
        entBusyStep(1);
        try { await api({ action: "updateEntryItem", itemId: r.itemId, unitCostCents: r.costCents }); } catch (err: any) { alert(err.message); }
        finally { entBusyStep(-1); }
      });
      tr.querySelector<HTMLInputElement>('[data-ef="price"]')?.addEventListener("change", async (e) => {
        // Emptied = un-typed: the row's own price again.
        const raw = (e.target as HTMLInputElement).value.trim();
        const rowPrice = items.flatMap(everyVariant).find((x: any) => x.id === r.variantId)?.priceCents ?? r.priceCents;
        r.priceCents = raw === "" ? rowPrice : toCents(raw);
        if (raw === "") (e.target as HTMLInputElement).value = (r.priceCents / 100).toFixed(2);
        // The LINE's price: it travels with the line, and Finish gives the
        // stock row the price typed last on its lines — so changing the
        // condition afterwards (Great → Fair) never re-prices the other
        // copies. (Before the migration the server applies it right away —
        // "live".) The row's other lines show the new price too.
        if (raw !== "") entRows.forEach((x) => { if (x !== r && x.variantId && x.variantId === r.variantId) x.priceCents = r.priceCents; });
        entTotals();
        if (raw !== "") body.querySelectorAll<HTMLElement>("tr[data-item]").forEach((row) => {
          const o = entRows.find((x) => x.itemId === row.dataset.item);
          const pi = row.querySelector<HTMLInputElement>('[data-ef="price"]');
          if (o && o !== r && pi && o.variantId === r.variantId) pi.value = (o.priceCents / 100).toFixed(2);
        });
        entBusyStep(1);
        try {
          const j = await api({ action: "updateEntryItem", itemId: r.itemId, priceCents: raw === "" ? null : r.priceCents });
          if (j.live && raw !== "") { const lv = items.flatMap(everyVariant).find((x: any) => x.id === r.variantId); if (lv) lv.priceCents = r.priceCents; }
          // Un-typed: another line of the row may still carry a typed price — reload what Finish will apply.
          if (raw === "") { await loadEntry(entryId); renderEnt(); }
        } catch (err: any) { alert(err.message); }
        finally { entBusyStep(-1); }
      });
      tr.querySelector<HTMLInputElement>("[data-esel]")!.addEventListener("change", (e) => {
        if ((e.target as HTMLInputElement).checked) entSel.add(r.itemId); else entSel.delete(r.itemId);
        entSyncSelection();
      });
      const onCond = async () => {
        const comp = tr.querySelector<HTMLSelectElement>('[data-ef="comp"]')!.value;
        const grade = tr.querySelector<HTMLSelectElement>('[data-ef="grade"]')!.value;
        tr.querySelectorAll<HTMLSelectElement>("select").forEach((x) => (x.disabled = true));
        entBusyStep(1);
        try { await setLineCondition(r, comp, grade); } catch (err: any) { alert(err.message); }
        finally { entBusyStep(-1); }
        await loadEntry(entryId); renderEnt();
      };
      tr.querySelector<HTMLSelectElement>('[data-ef="comp"]')?.addEventListener("change", onCond);
      tr.querySelector<HTMLSelectElement>('[data-ef="grade"]')?.addEventListener("change", onCond);
      tr.querySelector<HTMLSelectElement>('[data-ef="type"]')?.addEventListener("change", async (e) => {
        const typeId = (e.target as HTMLSelectElement).value;
        tr.querySelectorAll<HTMLSelectElement>("select").forEach((x) => (x.disabled = true));
        entBusyStep(1);
        try { await setLineCondition(r, r.completenessCode || "", r.gradeCode || "", typeId); } catch (err: any) { alert(err.message); }
        finally { entBusyStep(-1); }
        await loadEntry(entryId); renderEnt();
      });
      tr.querySelector("[data-erm]")!.addEventListener("click", async () => {
        if (soldSince(r)) { alert(`${rgTitle(r)}: ${soldSince(r)} of its copies sold since this entry was finished, so the line can't be removed. Lower its quantity instead.`); return; }
        if (r.stockedQty && !confirm(`Remove ${rgTitle(r)}?\n\nIts ${r.stockedQty} cop${r.stockedQty === 1 ? "y is" : "ies are"} already in stock from when this entry was finished — they come back OUT of stock.`)) return;
        entBusyStep(1); // Finish waits for the removal
        try {
          forgetDiscarded(await api({ action: "removeEntryItem", itemId: r.itemId }));
          unstockLocal(r);
          entRows = entRows.filter((x) => x.itemId !== r.itemId);
          renderEnt();
        } catch (err: any) { alert(err.message); }
        finally { entBusyStep(-1); }
      });
    });
    entTotals();
  }

  // Load a draft's lines (resume from Entries, page reload, or ?entry= link).
  async function loadEntry(id: string): Promise<boolean> {
    try {
      const j = await api({ action: "getEntry", entryId: id });
      if (j.entry?.status !== "open") return false;
      entryId = id; entryHuman = j.entry.human_id;
      entOrderTotal = j.entry.order_total_cents ?? null;
      ($("ent-ordertotal") as HTMLInputElement).value = entOrderTotal == null ? "" : (entOrderTotal / 100).toFixed(2);
      entSupplier = j.entry.supplier || "";
      const supInp = $("ent-supplier") as HTMLInputElement | null;
      if (supInp) supInp.value = entSupplier;
      const recvInp = $("ent-received") as HTMLInputElement | null;
      if (recvInp) recvInp.value = j.entry.received_on || "";
      entRows = (j.items || []).map((it: any) => {
        const v = it.variant || {}; const pr = v.product || {};
        if (it.kind === "non_inventory") {
          // Bought for the books only (bulk lot…): no stock row, no price, no label.
          return {
            itemId: it.id, variantId: null, kind: "non_inventory", qty: it.qty_added, costCents: it.unit_cost_cents,
            priceCents: 0, wasNew: false, supplier: it.supplier ?? null, title: it.description || "Non-inventory item",
            platform: "", cond: "", completenessCode: "", gradeCode: "",
          };
        }
        return {
          kind: "stock",
          itemId: it.id, variantId: v.id, qty: it.qty_added, costCents: it.unit_cost_cents,
          // A price typed on the line waits there until Finish.
          priceCents: it.price_set_cents ?? v.price_cents ?? 0, wasNew: it.was_new_variant, supplier: it.supplier ?? null,
          title: pr.title ?? "?", platform: pr.platform || pr.category?.name || "", regionCode: pr.region_code ?? "",
          cond: condLabel({ completenessCode: v.completeness_code, gradeCode: v.grade_code, condition: v.condition }),
          completenessCode: v.completeness_code || "", gradeCode: v.grade_code || "", inventoryTypeId: v.inventory_type_id || "",
          // Back to draft (migration 20261004000001): copies this line already
          // put in stock, and on which stock row — Finish applies only changes.
          stockedQty: it.stocked_qty || 0, stockedVariantId: it.stocked_variant_id || "", stockedOnHand: it.stocked_on_hand ?? 0,
        };
      });
      // Finish gives a stock row the price typed LAST on its lines — show that on each of them.
      const typed = new Map<string, { c: number; at: string }>();
      for (const it of j.items || []) {
        if (it.price_set_cents == null || !it.variant?.id) continue;
        const cur = typed.get(it.variant.id), at = it.price_set_at || "";
        if (!cur || at >= cur.at) typed.set(it.variant.id, { c: it.price_set_cents, at });
      }
      entRows.forEach((r) => { const t = r.variantId ? typed.get(r.variantId) : null; if (t) r.priceCents = t.c; });
      try { sessionStorage.setItem("tl-entry", JSON.stringify({ id: entryId, h: entryHuman })); } catch {}
      return true;
    } catch { return false; }
  }

  async function ensureEntry() {
    if (entryId) return;
    const j = await api({ action: "startEntry", receivedOn: localDate() });
    entryId = j.entry.id; entryHuman = j.entry.human_id;
    try { sessionStorage.setItem("tl-entry", JSON.stringify({ id: entryId, h: entryHuman })); } catch {}
    if (j.resumed) await loadEntry(entryId);
    else { const ri = $("ent-received") as HTMLInputElement | null; if (ri) ri.value = localDate(); }
    toast(j.resumed ? `📥 Resumed draft Entry #${entryHuman}` : `📥 Started Entry #${entryHuman}`);
  }

  $("recv-toggle")?.addEventListener("click", async () => {
    if (!closeAddPanel()) return; // an open Add form goes away first (asks if something's typed)
    if (!draftsReady) { alert("Run supabase/migrations/20260801000002_entry_drafts.sql in the Supabase SQL editor first, then refresh."); return; }
    try { await ensureEntry(); setEntryMode(true); } catch (e: any) { alert(e.message); }
  });
  // Phone-as-scanner: in entry mode scans stage lines (ent-search auto-adds on
  // exact code hits); otherwise they land in the grid search.
  const scanTarget = {
    target: () => (entryMode ? $("ent-search")
      : !($("add-panel") as HTMLElement).hidden && npKind === "stock" ? $("np-find") : $("inv-search")) as HTMLInputElement,
    page: "Inventory",
    // Same exact-identifier rules as the entry typeahead / grid search, so the
    // phone shows exactly what the station just staged or filtered to.
    describe: (code: string) => {
      const q = code.trim();
      if (!q) return null;
      const flat = (entryMode ? draftItems() : liveItems()).flatMap((p) => (entryMode ? draftVariants(p) : p.variants).map((v: any) => ({ p, v })));
      let hit = flat.find(({ v }: any) => (v.labelCode && v.labelCode === q) || (v.internalCode && v.internalCode === q.toUpperCase()));
      // A game's UPC: the station asks which condition when it has several.
      const upcP = hit ? null : (entryMode ? draftItems() : liveItems()).find((p: any) => upcsOf(p).some((u) => barcodeEq(u, q)));
      if (upcP) {
        const vs = entryMode ? draftVariants(upcP) : upcP.variants;
        if (vs.length === 1) hit = { p: upcP, v: vs[0] };
        else return `${rgTitle(upcP)}${upcP.platform ? ` (${upcP.platform})` : ""} · ${vs.length ? `${vs.length} conditions${entryMode ? " — choose on the station" : ""}` : "no stock rows yet"}`;
      }
      if (!hit) hit = flat.find(({ v }: any) => (v.barcodes || []).some((b: any) => barcodeEq(b.barcode, q)));
      if (!hit) {
        const skuExact = flat.filter(({ v }: any) => v.sku && v.sku.toUpperCase() === q.toUpperCase());
        if (skuExact.length === 1) hit = skuExact[0];
      }
      if (!hit) return null;
      return `${rgTitle(hit.p)}${hit.p.platform ? ` (${hit.p.platform})` : ""} · ${condLabel(hit.v)} · ${money(hit.v.priceCents)} · ${hit.v.quantity} in stock${entryMode ? " · staged" : ""}`;
    },
  };
  initScanReceiver(scanTarget);
  document.getElementById("phone-scan-btn")?.addEventListener("click", () => openPairDialog(scanTarget));
  $("ent-exit")?.addEventListener("click", () => {
    if (!closeAddPanel()) return; // an open Add form belongs to this entry
    const h = entryHuman;
    entryId = ""; entryHuman = 0; entRows = []; entSel.clear();
    try { sessionStorage.removeItem("tl-entry"); } catch {}
    setEntryMode(false);
    toast(`💾 Draft Entry #${h} saved — resume it from 📥 Entries`);
  });
  $("ent-delete")?.addEventListener("click", async () => {
    if (!entryId) return;
    if (!closeAddPanel()) return;
    const n = entRows.length;
    const sold = entRows.filter((r) => soldSince(r));
    if (sold.length) { alert(`This entry can't be deleted — copies of ${sold.length} line${sold.length === 1 ? "" : "s"} sold since it was finished:\n\n${sold.slice(0, 8).map((r) => `• ${rgTitle(r)} (${soldSince(r)} sold)`).join("\n")}\n\nFix the other lines and Finish instead.`); return; }
    const inStock = entRows.reduce((s, r) => s + (r.stockedQty || 0), 0);
    if (!confirm(inStock
      ? `Delete Entry #${entryHuman}?\n\nIt was finished before: its ${inStock} cop${inStock === 1 ? "y" : "ies"} still in stock come back OUT of stock, and the entry is removed.`
      : `Delete draft Entry #${entryHuman}?\n\n${n} staged line${n === 1 ? "" : "s"} will be discarded. Nothing was added to stock, so nothing else changes.`)) return;
    try {
      const gone = entryId;
      await api({ action: "deleteEntry", entryId });
      entRows.forEach(unstockLocal); // its stocked copies came back out
      // The server discarded the draft's unused hidden listings / stock rows.
      items = items.filter((p: any) => p.pendingEntryId !== gone);
      items.forEach((p: any) => { if (p.pendingVariants) p.pendingVariants = p.pendingVariants.filter((v: any) => v.pendingEntryId !== gone); });
      toast(`🗑 Draft deleted`);
      clearEntry();
    } catch (e: any) { alert(e.message); }
  });
  ($("ent-ordertotal") as HTMLInputElement)?.addEventListener("change", async (e) => {
    const raw = (e.target as HTMLInputElement).value.trim();
    entOrderTotal = raw === "" ? null : toCents(raw);
    entTotals();
    try { await api({ action: "setOrderTotal", entryId, orderTotalCents: entOrderTotal }); } catch (err: any) { alert(err.message); }
  });
  // ---- Draft line selection + bulk actions ----
  {
    const keep = `<option value="__keep">— keep —</option>`;
    const bc = $("ent-bulk-comp") as HTMLSelectElement | null, bg = $("ent-bulk-grade") as HTMLSelectElement | null;
    if (bc) bc.innerHTML = keep + completeness.map((c) => `<option value="${c.code}">${esc(c.label)}</option>`).join("");
    if (bg) bg.innerHTML = keep + grades.map((g) => `<option value="${g.code}">${esc((g.icon ? g.icon + " " : "") + g.label)}</option>`).join("");
    const bt = document.getElementById("ent-bulk-type") as HTMLSelectElement | null;
    if (bt) bt.innerHTML = keep + invTypes.map((t: any) => `<option value="${t.id}">${esc((t.icon ? t.icon + " " : "") + t.name)}</option>`).join("");
  }
  ($("ent-selall") as HTMLInputElement | null)?.addEventListener("change", (e) => {
    entSel.clear();
    if ((e.target as HTMLInputElement).checked) entRows.forEach((r) => entSel.add(r.itemId));
    renderEnt();
  });
  $("ent-bulk-clear")?.addEventListener("click", () => { entSel.clear(); renderEnt(); });
  $("ent-bulk-apply")?.addEventListener("click", async () => {
    const comp = ($("ent-bulk-comp") as HTMLSelectElement).value, grade = ($("ent-bulk-grade") as HTMLSelectElement).value;
    const type = (document.getElementById("ent-bulk-type") as HTMLSelectElement | null)?.value || "__keep";
    if (comp === "__keep" && grade === "__keep" && type === "__keep") { alert("Pick a condition, grade and/or type to apply."); return; }
    const btn = $("ent-bulk-apply") as HTMLButtonElement;
    const todo = entRows.filter((r) => entSel.has(r.itemId) && r.kind !== "non_inventory");
    if (!todo.length) { alert("None of the selected lines have a condition (non-inventory lines don't)."); return; }
    btn.disabled = true;
    entBusyStep(1);
    const errors: string[] = [];
    try {
      for (let i = 0; i < todo.length; i++) {
        btn.textContent = `Applying ${i + 1}/${todo.length}…`;
        const r = todo[i];
        try { await setLineCondition(r, comp === "__keep" ? r.completenessCode || "" : comp, grade === "__keep" ? r.gradeCode || "" : grade, type === "__keep" ? undefined : type); }
        catch (err: any) { errors.push(`${rgTitle(r)}: ${err.message}`); }
      }
    } finally { entBusyStep(-1); }
    btn.disabled = false; btn.textContent = "Apply to selected";
    entSel.clear();
    await loadEntry(entryId); renderEnt();
    if (errors.length) alert(`${errors.length} line(s) couldn't be changed:\n\n${errors.slice(0, 10).join("\n")}`);
    else toast(`✓ Updated ${todo.length} line${todo.length === 1 ? "" : "s"}`);
  });
  $("ent-bulk-rm")?.addEventListener("click", async () => {
    const todo = entRows.filter((r) => entSel.has(r.itemId));
    const inStock = todo.reduce((s, r) => s + (r.stockedQty || 0), 0);
    const sold = todo.filter((r) => soldSince(r)).length;
    if (!todo.length || !confirm(`Remove ${todo.length} line${todo.length === 1 ? "" : "s"} from this draft? ${inStock ? `(${inStock} cop${inStock === 1 ? "y is" : "ies are"} already in stock from before — they come back OUT of stock.${sold ? ` ${sold} line${sold === 1 ? "" : "s"} with copies sold since it was finished will stay.` : ""})` : "(Nothing is in stock yet, so nothing else changes.)"}`)) return;
    const btn = $("ent-bulk-rm") as HTMLButtonElement; btn.disabled = true;
    const label = btn.textContent;
    entBusyStep(1); // Finish waits — else it would add the lines still being removed
    const errors: string[] = [];
    try {
      for (let i = 0; i < todo.length; i++) {
        const r = todo[i];
        btn.textContent = `Removing ${i + 1}/${todo.length}…`;
        try { forgetDiscarded(await api({ action: "removeEntryItem", itemId: r.itemId })); unstockLocal(r); entRows = entRows.filter((x) => x.itemId !== r.itemId); }
        catch (err: any) { errors.push(`${rgTitle(r)}: ${err.message}`); }
      }
    } finally { entBusyStep(-1); btn.textContent = label; }
    btn.disabled = false; entSel.clear(); renderEnt();
    if (errors.length) alert(`${errors.length} line(s) couldn't be removed:\n\n${errors.slice(0, 10).join("\n")}`);
  });

  ($("ent-received") as HTMLInputElement)?.addEventListener("change", async (e) => {
    const inp = e.target as HTMLInputElement;
    if (!entryId || !inp.value) return;
    try { await api({ action: "setEntryReceivedOn", entryId, receivedOn: inp.value }); } catch (err: any) { alert(err.message); }
  });
  const entSupplierInp = document.getElementById("ent-supplier") as HTMLInputElement | null;
  if (entSupplierInp) fullListOnOpen(entSupplierInp);
  ($("ent-supplier") as HTMLInputElement)?.addEventListener("change", async (e) => {
    entSupplier = (e.target as HTMLInputElement).value.trim();
    renderEnt(); // refresh per-line placeholders
    if (!entryId) return;
    try { await api({ action: "setEntrySupplier", entryId, supplier: entSupplier || null }); } catch (err: any) { alert(err.message); }
  });

  // Stage a variant onto the draft (scanning the same one again bumps qty).
  async function stageVariant(p: any, v: any) {
    entBusyStep(1); // Finish waits for a scan still saving
    try {
      await ensureEntry();
      const existing = entRows.find((r) => r.variantId === v.id);
      if (existing) {
        existing.qty += 1;
        renderEnt();
        await api({ action: "updateEntryItem", itemId: existing.itemId, qty: existing.qty });
        return;
      }
      const j = await api({ action: "stageItem", entryId, variantId: v.id, qty: 1 });
      entRows.push({ itemId: j.itemId, variantId: v.id, qty: 1, costCents: null, priceCents: v.priceCents, wasNew: false, supplier: null, title: p.title, platform: p.platform || p.categoryName || "", regionCode: p.regionCode || "", cond: condLabel(v), completenessCode: v.completenessCode || "", gradeCode: v.gradeCode || "", inventoryTypeId: v.inventoryTypeId || "" });
      renderEnt();
    } catch (e: any) { alert(e.message); }
    finally { entBusyStep(-1); }
  }

  // Find-or-add typeahead — the entry's search, and the Add form's (a quick
  // add). Suggestions are individual VARIANTS (condition + price); an exact
  // barcode / label-code match picks instantly (wedge scanners).
  type FindCtx = {
    input: HTMLInputElement; box: HTMLElement;
    items: () => any[]; variants: (p: any) => any[];
    pick: (p: any, v: any) => void;                    // an existing condition
    create: (q: string, official?: { title: string; platform: string; parsed?: any; region?: string }) => void;
    nonInv: (q: string) => void;
    verb: string;                                      // "stage" / "add"
  };
  const entSearch = $("ent-search") as HTMLInputElement;
  function findSuggest(c: FindCtx) {
    const box = c.box;
    const q = c.input.value.trim();
    if (q.length < 2) { box.hidden = true; return; }
    const flat = c.items().flatMap((p) => c.variants(p).map((v: any) => ({ p, v })));
    // Our printed label codes name one condition → stage it.
    const own = flat.find(({ v }: any) => (v.labelCode && v.labelCode === q) || (v.internalCode && v.internalCode === q.toUpperCase()));
    if (own) { c.input.value = ""; box.hidden = true; c.pick(own.p, own.v); return; }
    // The game's UPC fits every condition: one → stage it; several → ask
    // (the box stays open and unfocused, so the next scan simply replaces it).
    const upcP = c.items().find((p: any) => upcsOf(p).some((u) => barcodeEq(u, q)));
    if (upcP) {
      const vs = c.variants(upcP);
      if (vs.length === 1) { c.input.value = ""; box.hidden = true; c.pick(upcP, vs[0]); return; }
      if (vs.length > 1) {
        c.input.value = "";
        box.innerHTML = `<div class="ti-sug-head">Which condition? — ${esc(upcP.title)}${badge(upcP.regionCode)}${upcP.platform ? ` (${esc(upcP.platform)})` : ""}</div>` + vs.map((v: any, i: number) => {
          const t = typeById.get(v.inventoryTypeId);
          return `<div class="ti-sug" data-cv="${i}">
            <span class="ti-sug-title">${esc(condLabel(v))}</span>
            <span class="ti-sug-meta">${t && t.key !== "retail" ? esc((t.icon || "") + " " + t.name) + " · " : ""}${v.quantity} in stock</span>
            <span class="ti-sug-price">${money(v.priceCents)}</span>
          </div>`;
        }).join("");
        box.hidden = false;
        box.querySelectorAll<HTMLElement>("[data-cv]").forEach((el) => el.addEventListener("mousedown", (e) => {
          e.preventDefault(); box.hidden = true; c.pick(upcP, vs[+el.dataset.cv!]);
        }));
        return;
      }
    }
    const hit = flat.find(({ v }: any) => (v.barcodes || []).some((b: any) => barcodeEq(b.barcode, q)));
    if (hit) { c.input.value = ""; box.hidden = true; c.pick(hit.p, hit.v); return; }
    // A unique exact-SKU hit stages instantly too (wedge scanners send SKUs).
    const skuExact = flat.filter(({ v }: any) => v.sku && v.sku.toUpperCase() === q.toUpperCase());
    if (skuExact.length === 1) { c.input.value = ""; box.hidden = true; c.pick(skuExact[0].p, skuExact[0].v); return; }
    // A UPC we don't stock yet: look the game up and offer to add it.
    if (upcLike(q) && !codeOnListing(q, c.items())) {
      box.innerHTML = `<div class="ti-sug-head">UPC ${esc(q)}</div><div class="ti-sug"><span class="ti-sug-meta">🔎 Looking it up…</span></div>`;
      box.hidden = false;
      identifyUpc(q).then((id) => {
        if (c.input.value.trim() !== q) return; // the employee moved on
        box.innerHTML = `<div class="ti-sug-head">UPC ${esc(q)}</div><div class="ti-sug"${id.found && !id.inCatalog ? " data-upcadd" : ""}><span class="ti-sug-title">${upcFoundHtml(id)}</span>${id.found && !id.inCatalog ? `<span class="ti-sug-meta">＋ Add${c.verb === "stage" ? " &amp; stage" : ""}</span>` : ""}</div>`;
        box.querySelector("[data-upcadd]")?.addEventListener("mousedown", (e) => { e.preventDefault(); box.hidden = true; c.input.value = ""; addFromUpc(id); });
      });
      return;
    }
    const parsed = parseQuery(q);
    // A typed region ("okami jp") is a filter — the US and JP copies are
    // otherwise identical rows (matchScore applies it, and steps aside when
    // the words are part of a listing's name: "European Assault").
    const matches = smartMatches(parsed, c.items()).slice(0, 5);
    let opts = matches.flatMap((m: any) => {
      const vs = c.variants(m.p).sort((a: any, b: any) =>
        (b.completenessCode === parsed.completenessCode ? 1 : 0) - (a.completenessCode === parsed.completenessCode ? 1 : 0));
      return vs.map((v: any) => ({ p: m.p, v }));
    }).slice(0, 8);
    // SKU-contains matches join the list (deduped) so partial SKUs find items.
    if (q.length >= 3) {
      const skuLike = flat.filter(({ p, v }: any) => v.sku && v.sku.toUpperCase().includes(q.toUpperCase()) && !opts.some((o: any) => o.v.id === v.id));
      opts = [...skuLike, ...opts].slice(0, 8);
    }
    box.innerHTML = opts.map((o: any, i: number) => `
      <div class="ti-sug" data-i="${i}">
        <span class="ti-sug-title">${esc(o.p.title)}${badge(o.p.regionCode)}</span>
        <span class="ti-sug-meta">${esc(o.p.platform || "")} · ${esc(condLabel(o.v))}</span>
        <span class="ti-sug-price">${money(o.v.priceCents)}</span>
      </div>`).join("") + `
      <div class="ti-sug" data-new><span class="ti-sug-title">＋ New product “${esc(q)}”</span><span class="ti-sug-meta">${c.verb === "stage" ? "create &amp; stage" : "fill in the form below"}</span></div>`;
    // "bulk …" / "lot of …" reads as a non-inventory purchase: offer it first.
    if (/\b(bulk|lot)\b/i.test(q)) box.innerHTML = `
      <div class="ti-sug" data-noninv><span class="ti-sug-title">🧾 Add “${esc(q)}” as non-inventory</span><span class="ti-sug-meta">recorded for the books · no stock</span></div>` + box.innerHTML;
    box.hidden = false;
    box.querySelectorAll<HTMLElement>("[data-i]").forEach((el) => el.addEventListener("mousedown", (e) => {
      e.preventDefault();
      const o = opts[+el.dataset.i!];
      box.hidden = true; c.input.value = "";
      c.pick(o.p, o.v);
    }));
    box.querySelector("[data-new]")?.addEventListener("mousedown", (e) => { e.preventDefault(); box.hidden = true; c.create(q); });
    box.querySelector("[data-noninv]")?.addEventListener("mousedown", (e) => { e.preventDefault(); box.hidden = true; c.input.value = ""; c.nonInv(q); });
    dbSuggest(c, q, parsed);
  }
  // "From the game database": official titles from our LaunchBox copy, so a
  // game the store has never stocked can be added under its real name (and
  // gets its box art). Debounced; stale answers are dropped.
  let dbSeq = 0;
  function dbSuggest(c: FindCtx, q: string, parsed: any) {
    const seq = ++dbSeq;
    const term = (parsed?.title || q).trim();
    if (term.length < 3) return;
    setTimeout(async () => {
      if (seq !== dbSeq) return;
      let games: any[] = [];
      try {
        const r = await fetch("/api/pos/game-search", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ q: term, platform: parsed?.platform || "" }) });
        games = (await r.json()).games || [];
      } catch { return; }
      const box = c.box;
      if (seq !== dbSeq || box.hidden || c.input.value.trim() !== q) return;
      // Skip games the store already lists on that platform in that region
      // (they're above). A pick becomes a listing in the region the query
      // named, else the home one — a JP-only "Okami" must not hide the US one.
      const dbRegion = regionOf(parsed?.regionCode, regions);
      // "Medal of Honor: European Assault": the region word is the game's NAME.
      const rgFor = (g: any) => (parsed?.regionText && nameHas({ title: g.name }, parsed.regionText) ? regionOf("", regions) : dbRegion);
      const key = (t: string, pl: string, rg: string) => `${normTitle(t)}|${(resolveStaticPlatform(pl) ?? pl ?? "").toLowerCase()}|${rg}`;
      const have = new Set(c.items().flatMap((p: any) => [p.title, ...(p.altNames || [])].map((t: string) => key(t, p.platform || "", regionOf(p.regionCode, regions)))));
      games = games.filter((g) => !have.has(key(g.name, g.platform || "", rgFor(g)))).slice(0, 6);
      if (!games.length) return;
      box.insertAdjacentHTML("beforeend", `<div class="ti-sug-head">From the game database</div>` + games.map((g, i) => `
        <div class="ti-sug" data-db="${i}" title="Add as a new listing with its official title">
          ${g.cover ? `<img class="ti-db-cover" src="${esc(g.cover)}" alt="" loading="lazy" />` : ""}
          <span class="ti-sug-title">${esc(g.name)}${badge(rgFor(g))}</span>
          <span class="ti-sug-meta">${esc(g.platform || "")} · new listing</span>
        </div>`).join(""));
      box.querySelectorAll<HTMLElement>("[data-db]").forEach((el) => el.addEventListener("mousedown", (e) => {
        e.preventDefault();
        const g = games[+el.dataset.db!];
        box.hidden = true; c.input.value = "";
        c.create("", { title: g.name, platform: g.platform, parsed, region: rgFor(g) });
      }));
    }, 250);
  }
  // Same folding as the importer (accents, apostrophes, "&"), minus "the"/"and".
  const normTitle = (t: string) => normImport(t).replace(/\b(the|and)\b/g, " ").replace(/\s+/g, " ").trim();
  // A bulk lot / parts / supplies bought on this entry: what was paid, no stock.
  async function entAddNonInventory(desc0 = "") {
    try { await ensureEntry(); setEntryMode(true); } catch (e: any) { alert(e.message); return; }
    const desc = (prompt("Non-inventory item — describe it (e.g. “DS loose games, bulk grade B”):", desc0 || "Bulk lot") || "").trim();
    if (!desc) return;
    const rawTotal = prompt(`What did you pay in TOTAL for “${desc}” ($)? Leave empty if unknown.`, "");
    if (rawTotal === null) return;
    const total = rawTotal.trim() === "" ? null : toCents(rawTotal.replace(/[^0-9.]/g, ""));
    try { await stageNonInventory(desc, total); } catch (e: any) { alert(e.message); }
  }
  // One line at the exact total (a lot's count stays in its description) —
  // splitting $100 over 3 would record $99.99.
  async function stageNonInventory(desc: string, total: number | null) {
    entBusyStep(1);
    let j: any;
    try { j = await api({ action: "addNonInventoryLine", entryId, description: desc, qty: 1, unitCostCents: total }); }
    finally { entBusyStep(-1); }
    entRows.push({ itemId: j.itemId, variantId: null, kind: "non_inventory", qty: 1, costCents: total, priceCents: 0, wasNew: false, supplier: null, title: desc, platform: "", cond: "", completenessCode: "", gradeCode: "" });
    renderEnt();
    toast(`🧾 Added “${desc}” (non-inventory)`);
  }
  // The Add panel's Non-inventory side: on the open entry, or — from the
  // inventory screen — recorded right away on the day's ⚡ Quick adds entry
  // (with the quick-added products). Stays open for the next one.
  $("ni-save")?.addEventListener("click", async () => {
    const btn = $("ni-save") as HTMLButtonElement;
    if (btn.disabled) return;
    const desc = ($("ni-desc") as HTMLInputElement).value.trim();
    if (!desc) { alert("Describe the item (e.g. “DS bulk loose games, grade B”)."); ($("ni-desc") as HTMLInputElement).focus(); return; }
    const raw = ($("ni-total") as HTMLInputElement).value.trim();
    const total = raw === "" ? null : toCents(raw.replace(/[^0-9.]/g, ""));
    btn.disabled = true;
    try {
      if (entryMode && entryId) await stageNonInventory(desc, total);
      else {
        const j = await api({ action: "quickNonInventory", description: desc, totalCents: total, receivedOn: localDate() });
        toast(`🧾 Recorded “${desc}” · ⚡ Quick adds (Entry #${j.humanId})`);
      }
      clearProductFields();
      addSaved = true;
      setAddOpen(true);
      ($("ni-desc") as HTMLInputElement).focus();
    } catch (e: any) { alert(e.message); }
    finally { btn.disabled = false; }
  });
  $("ent-noninv")?.addEventListener("click", () => entAddNonInventory(entSearch.value.trim()));
  const entFind: FindCtx = {
    input: entSearch, box: $("ent-suggest") as HTMLElement,
    items: draftItems, variants: draftVariants,
    pick: stageVariant, create: entNewProduct, nonInv: entAddNonInventory, verb: "stage",
  };
  entSearch?.addEventListener("input", () => findSuggest(entFind));
  entSearch?.addEventListener("blur", () => setTimeout(() => { ($("ent-suggest") as HTMLElement).hidden = true; }, 150));

  /* ---------- Quick add: find it first ----------
     The Add form's own search + scan (the entry's rules). A listing you have
     → a row: how many, which condition, what you paid; "＋ Add to stock"
     puts them in stock now (on today's ⚡ Quick adds entry) and prints their
     labels. Not listed yet → ＋ New product fills in the form below. */
  type RecvRow = { key: number; p: any; v: any; comp: string; grade: string; qty: number; cost: string; price: string; priceTouched: boolean };
  let recvRows: RecvRow[] = [];
  let pendingRecvCost = ""; // a 🔖 import's cost, for the row "add copies to it instead" picks
  let recvKey = 0;
  const npFind = $("np-find") as HTMLInputElement;
  const sameType = (a: any, b: any) => (a.inventoryTypeId || retailTypeId) === (b.inventoryTypeId || retailTypeId);
  // The stock row a row lands on: the one picked/scanned while its condition
  // is unchanged; else that listing's row for the new condition + same type
  // (none = a new condition).
  const recvTarget = (r: RecvRow) => (r.comp === (r.v.completenessCode || "") && r.grade === (r.v.gradeCode || "") && r.p.variants.includes(r.v))
    ? r.v
    : r.p.variants.find((x: any) => (x.completenessCode || "") === r.comp && (x.gradeCode || "") === r.grade && sameType(x, r.v));
  function clearRecv() { recvRows = []; renderRecv(); }
  function recvPick(p: any, v: any) {
    // The same stock row scanned again = one more copy.
    const same = recvRows.find((r) => recvTarget(r) === v);
    if (same) same.qty += 1;
    else { recvRows.push({ key: ++recvKey, p, v, comp: v.completenessCode || "", grade: v.gradeCode || "", qty: 1, cost: pendingRecvCost, price: (v.priceCents / 100).toFixed(2), priceTouched: false }); pendingRecvCost = ""; }
    renderRecv();
    npFind.focus(); // the next scan lands here too
  }
  function recvSum() {
    const n = recvRows.reduce((s, r) => s + r.qty, 0);
    $("np-recv-sum").textContent = recvRows.length ? `${n} cop${n === 1 ? "y" : "ies"} of ${recvRows.length} item${recvRows.length === 1 ? "" : "s"}` : "";
  }
  function renderRecv() {
    ($("np-recv") as HTMLElement).hidden = !recvRows.length;
    const body = $("np-recv-body");
    body.innerHTML = recvRows.map((r) => {
      const t = recvTarget(r);
      if (t && !r.priceTouched) r.price = (t.priceCents / 100).toFixed(2); // that condition's price now
      const meta = t ? `${t.quantity} in stock` : "new condition for this listing";
      return `<tr data-rk="${r.key}">
        <td><strong>${esc(r.p.title)}</strong>${badge(r.p.regionCode)} <span class="ti-sug-meta">${esc(r.p.platform || r.p.categoryName || "")} · ${esc(meta)}</span></td>
        <td><select data-rf="comp">${entCompOpts(r.comp)}</select></td>
        <td><select data-rf="grade">${gradeOpts(r.grade)}</select></td>
        <td class="num"><input data-rf="qty" type="number" min="1" value="${r.qty}"></td>
        <td class="num"><input data-rf="cost" type="number" min="0" step="0.01" value="${esc(r.cost)}" placeholder="—"></td>
        <td class="num"><input data-rf="price" type="number" min="0" step="0.01" value="${esc(r.price)}" title="${t ? "This condition's price — changing it re-prices every copy of it" : "The new condition's price"}"></td>
        <td><button type="button" class="link-btn" data-rf="rm" title="Remove">✕</button></td>
      </tr>`;
    }).join("");
    recvSum();
    body.querySelectorAll<HTMLElement>("tr[data-rk]").forEach((tr) => {
      const r = recvRows.find((x) => x.key === Number(tr.dataset.rk))!;
      const f = (k: string) => tr.querySelector(`[data-rf="${k}"]`) as HTMLInputElement;
      const onCond = () => {
        r.comp = f("comp").value; r.grade = f("grade").value;
        // The price follows the condition (that condition's own price — or, for
        // a condition the listing doesn't have yet, PriceCharting's average) until you type one.
        if (!r.priceTouched) {
          const t = recvTarget(r);
          const m = t ? null : marketPriceFor(r.p.marketPrices, r.comp);
          r.price = ((t ? t.priceCents : m ?? r.v.priceCents) / 100).toFixed(2);
        }
        renderRecv();
      };
      f("comp").addEventListener("change", onCond);
      f("grade").addEventListener("change", onCond);
      f("qty").addEventListener("input", () => { r.qty = Math.max(1, parseInt(f("qty").value) || 1); recvSum(); });
      f("cost").addEventListener("input", () => { r.cost = f("cost").value; });
      f("price").addEventListener("input", () => { r.price = f("price").value; r.priceTouched = true; });
      f("rm").addEventListener("click", () => { recvRows = recvRows.filter((x) => x !== r); renderRecv(); });
    });
  }
  $("np-recv-clear")?.addEventListener("click", () => { clearRecv(); npFind.focus(); });
  $("np-recv-go")?.addEventListener("click", async () => {
    if (!recvRows.length) return;
    const btn = $("np-recv-go") as HTMLButtonElement;
    btn.disabled = true;
    // This batch, as it stands now: a scan while it saves starts a new row.
    const batch = recvRows.map((r) => ({ ...r }));
    recvRows = [];
    renderRecv();
    const failed: RecvRow[] = [];
    const printLines: any[] = [];
    const errors: string[] = [];
    let quick: any = null, copies = 0;
    try {
      for (const r of batch) {
        const cost = r.cost.trim() === "" ? null : toCents(r.cost);
        const t = recvTarget(r);
        // Only a price typed here re-prices that condition (the shown one may
        // be stale — e.g. picked before another row's new price landed).
        const priceCents = t && !r.priceTouched ? t.priceCents : toCents(r.price);
        let v: any;
        try {
          if (t) {
            // A new price first, so the copies (and their ⚡ Quick adds line) carry it.
            if (priceCents !== t.priceCents) {
              try { await api({ action: "updateVariant", id: t.id, priceCents }); t.priceCents = priceCents; }
              catch (e: any) { errors.push(`${rgTitle(r.p)}: the price wasn't changed (${e.message})`); }
            }
            const j = await api({ action: "receiveStock", variantId: t.id, qtyAdded: r.qty, unitCostCents: cost, receivedOn: localDate() });
            t.quantity = j.newQuantity;
            quick ??= j.quickEntry ? j : null;
            if (j.quickError) errors.push(`${rgTitle(r.p)}: in stock, but not on today's ⚡ Quick adds entry (${j.quickError})`);
            v = t;
          } else {
            const condition = [completeness.find((c) => c.code === r.comp)?.label, grades.find((g) => g.code === r.grade)?.label].filter(Boolean).join(" ") || "Used";
            const j = await api({ action: "addVariant", productId: r.p.id, completenessCode: r.comp, gradeCode: r.grade, condition, priceCents, quantity: r.qty,
              unitCostCents: cost, inventoryTypeId: r.v.inventoryTypeId || undefined, locationId: r.v.locationId || undefined, receivedOn: localDate() });
            quick ??= j.quickEntry ? j : null;
            if (j.quickError) errors.push(`${rgTitle(r.p)}: in stock, but not on today's ⚡ Quick adds entry (${j.quickError})`);
            v = { id: j.variant.id, condition, completeness: null, completenessCode: r.comp, gradeCode: r.grade, sku: null, internalCode: j.variant.internal_code || "", labelCode: j.variant.label_code || "",
              priceCents, onlinePriceCents: null, costCents: cost ?? 0, quantity: r.qty, onlineVisible: false, inventoryTypeId: r.v.inventoryTypeId || retailTypeId, locationId: r.v.locationId || "", barcodes: [] };
            r.p.variants.push(v);
          }
        } catch (e: any) { errors.push(`${rgTitle(r.p)}: ${e.message}`); failed.push(r); continue; } // not added — the row comes back
        copies += r.qty;
        printLines.push({ p: r.p, v, qty: r.qty });
      }
    } finally { btn.disabled = false; }
    recvRows = [...failed, ...recvRows];
    renderRecv();
    render();
    if (copies) toast(`✓ ${copies} cop${copies === 1 ? "y" : "ies"} added to stock${quick ? ` · ⚡ Quick adds (Entry #${quick.quickEntry.humanId})` : ""}`);
    if (errors.length) alert(errors.join("\n"));
    if (printLines.length) {
      await fillLabelCodes(printLines.map((l) => l.v));
      openPrintDialog(printLines.map((l) => ({ item: labelItemOf(l.p, l.v), defaultCopies: l.qty, allCopies: l.v.quantity })), lblTemplates,
        { title: `Print · ${printLines.length === 1 ? rgTitle(printLines[0].p) : `${printLines.length} items`}`, onClose: () => npFind.focus() });
    } else npFind.focus();
  });
  const quickFind: FindCtx = {
    input: npFind, box: $("np-find-suggest") as HTMLElement,
    items: liveItems, variants: (p: any) => p.variants,
    pick: recvPick,
    create: (q, official) => { npFind.value = ""; entNewProduct(q, official); },
    nonInv: (q) => {
      npFind.value = "";
      setNpKind("noninv");
      ($("ni-desc") as HTMLInputElement).value = q;
      ($("ni-total") as HTMLInputElement).focus();
    },
    verb: "add",
  };
  npFind?.addEventListener("input", () => findSuggest(quickFind));
  npFind?.addEventListener("blur", () => setTimeout(() => { quickFind.box.hidden = true; }, 150));
  $("ent-new")?.addEventListener("click", () => entNewProduct(entSearch.value.trim()));
  function entNewProduct(q: string, official?: { title: string; platform: string; parsed?: any; region?: string }) {
    const parsed = q ? parseQuery(q) : official?.parsed ?? null;
    clearProductFields();
    setNpKind("stock");
    const panel = $("add-panel") as HTMLElement;
    setAddOpen(true);
    if (official) {
      // Picked from the game database (or a scanned UPC): its official name +
      // our platform name, in the region the query named (else the home one).
      ($("np-title") as HTMLInputElement).value = official.title;
      setPlatform($("np-platform") as HTMLSelectElement, official.platform || parsed?.platform || "");
      setNpRegion(official.region || parsed?.regionCode);
    } else {
      if (parsed?.title) ($("np-title") as HTMLInputElement).value = parsed.titleForNew.replace(/\b\w/g, (c: string) => c.toUpperCase());
      if (parsed?.platform) setPlatform($("np-platform") as HTMLSelectElement, parsed.platform);
      if (parsed) setNpRegion(parsed.regionCode);
    }
    if (parsed) { setComp($("np-comp") as HTMLInputElement, parsed.completenessCode || "", $("np-comp-abbr")); if (parsed.gradeCode) ($("np-grade") as HTMLSelectElement).value = parsed.gradeCode; }
    ($("np-qty") as HTMLInputElement).value = "1";
