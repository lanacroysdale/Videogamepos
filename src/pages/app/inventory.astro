  /* ---------- Collection CSV import (PriceCharting export etc.) ----------
     Rows are matched client-side against the loaded catalog (existing
     condition → same variant; other condition → new variant on that listing;
     no listing → new product) and STAGED onto the draft in batches. Nothing
     applies to stock until Finish, exactly like typed/scanned lines. */
  const importCatalog = () => draftItems().map((p: any) => ({
    id: p.id, title: p.title, platform: p.platform || "", franchise: p.franchise || "", altNames: p.altNames || [],
    categoryId: p.categoryId, pcId: p.pcId || "", upcs: upcsOf(p),
    // The listing's region (left out before the migration → the importer
    // reads the old "[PAL]" title tag instead).
    ...(regionReady ? { regionCode: p.regionCode || "" } : {}),
    variants: draftVariants(p).map((v: any) => ({
      id: v.id, completenessCode: v.completenessCode || "", gradeCode: v.gradeCode || "", priceCents: v.priceCents || 0,
      quantity: v.quantity, barcodes: (v.barcodes || []).map((b: any) => b.barcode),
      inventoryTypeId: v.inventoryTypeId || retailTypeId || "",
    })),
  }));
  const mkImportedVariant = (res: any, p: any) => ({
    id: res.variantId, condition: p.condition, completeness: null, completenessCode: p.completenessCode, gradeCode: p.gradeCode,
    sku: null, internalCode: res.internalCode || "", labelCode: "", priceCents: p.priceCents, onlinePriceCents: null, costCents: null,
    quantity: 0, onlineVisible: false, inventoryTypeId: p.inventoryTypeId || retailTypeId, locationId: "",
    pendingEntryId: entryId, // hidden until this draft is finished
    barcodes: p.barcode ? [{ id: "primary:" + res.variantId, barcode: p.barcode, label: "Primary", primary: true }] : [],
  });
  // Every listing an import put stock on (new or existing) — the UPC lookup
  // skips ones that already have a UPC or aren't games without an eBay call.
  const touchedListings = (results: any[]) => [...new Set(results.filter((r) => r?.ok && r.productId).map((r) => String(r.productId)))];
  // Listing UPCs from eBay's catalog, a few listings per request, after covers
  // are on their way. Stops quietly if the page closes — the daily run and
  // "Fill missing UPCs" catch the rest.
  async function upcFillInBackground(ids: string[]) {
    if (!upcReady || !ids.length) return;
    let found = 0;
    for (let i = 0; i < ids.length; i += 3) {
      try {
        const r = await upcApi({ action: "fill", productIds: ids.slice(i, i + 3) });
        for (const res of r.results || []) { applyUpcResult(res); if (res.status === "found") found++; }
        if (r.stopped) break;
      } catch { break; }
    }
    render();
    if (found) toast(`🏷 UPCs attached for ${found} listing${found === 1 ? "" : "s"}`);
  }
  document.getElementById("fill-upcs")?.addEventListener("click", async () => {
    const btn = document.getElementById("fill-upcs") as HTMLButtonElement;
    const orig = btn.textContent;
    btn.disabled = true; btn.textContent = "Checking…";
    try {
      const todo: any[] = (await upcApi({ action: "missing" })).items || [];
      if (!todo.length) { toast("Every game that can get a UPC automatically has one (or was checked today)"); return; }
      if (!confirm(`Look up UPCs on eBay's product catalog for ${todo.length} game${todo.length === 1 ? "" : "s"}? Only sure matches are attached; the rest stay under "Needs UPC". Takes about ${Math.max(1, Math.round(todo.length * 3 / 60))} min — keep this tab open.`)) return;
      const tally = { found: 0, none: 0, unsure: 0, review: 0 };
      const toReview: { p: any; res: any }[] = [];
      for (let i = 0; i < todo.length; i += 3) {
        btn.textContent = `UPCs ${Math.min(i + 3, todo.length)}/${todo.length}…`;
        const r = await upcApi({ action: "fill", productIds: todo.slice(i, i + 3).map((x) => x.id) });
        for (const res of r.results || []) {
          applyUpcResult(res);
          if (res.status === "found") tally.found++;
          else if (res.candidates?.length) {
            tally.review++;
            const p = items.find((x: any) => x.id === res.id);
            if (p) toReview.push({ p, res });
          }
          else if (res.status === "not_found") tally.none++;
          else if (res.status === "ambiguous" || res.status === "conflict") tally.unsure++;
        }
        render();
        if (r.stopped) { alert(r.stopped); break; }
      }
      toast(`🏷 UPCs: ${tally.found} attached · ${tally.none} not on eBay · ${tally.unsure} unsure${tally.review ? ` · ${tally.review} to confirm` : ""} — see "Needs UPC"`);
      // Then the close calls, one by one: "Is this the same game?"
      if (toReview.length) {
        btn.textContent = "Confirming…";
        const done = { picked: 0, none: 0, skip: 0 };
        let stoppedAt = -1;
        for (let k = 0; k < toReview.length; k++) {
          const r = await chooseUpcCandidate(toReview[k].p, toReview[k].res, { i: k + 1, n: toReview.length });
          if (r === "stop") { stoppedAt = k; break; }
          done[r]++;
          render();
        }
        const left = stoppedAt >= 0 ? toReview.length - stoppedAt : 0;
        toast(`🏷 Confirmed ${done.picked} · none ${done.none} · skipped ${done.skip}${left ? ` · ${left} left for later (🔎 Find on eBay on each listing)` : ""}`);
      }
    } catch (e: any) { alert(e.message); }
    finally { btn.disabled = false; btn.textContent = orig; }
  });
  async function enrichInBackground(list: any[]) {
    let done = 0, added = 0; const CONC = 3;
    for (let i = 0; i < list.length; i += CONC) {
      await Promise.all(list.slice(i, i + CONC).map(async (p) => {
        try {
          const e = await enrich({ productId: p.id, title: p.title, platform: p.platform });
          if (e.ok && e.found) { if (e.imageUrl) { p.imageUrl = e.imageUrl; added++; } if (e.altNames?.length) p.altNames = e.altNames; if (e.description) p.description = e.description; }
        } catch {}
        done++;
      }));
      toast(`🎮 Fetching covers ${done}/${list.length}…`);
    }
    render();
    toast(`🎮 Covers added for ${added} of ${list.length} new listing${list.length === 1 ? "" : "s"}`);
  }
  async function openCollectionImport() {
    if (!closeAddPanel()) return; // the import opens a draft — the Add form can't straddle it
    if (!draftsReady) { alert("Run supabase/migrations/20260801000002_entry_drafts.sql in the Supabase SQL editor first, then refresh."); return; }
    try { await ensureEntry(); setEntryMode(true); } catch (e: any) { alert(e.message); return; }
    openImportDialog({
      mode: "entry", catalog: importCatalog(), completeness, grades, platforms: PLATFORMS, categories, invTypes, regions,
      onImport: async (rows, ch, progress) => {
        const condText = (r: any) => [completeness.find((c) => c.code === r.row.completenessCode)?.label, grades.find((g) => g.code === r.row.gradeCode)?.label].filter(Boolean).join(" ") || "Used";
        const priceOf = (r: any) => (r.row.priceCents == null ? 0 : importPrice(r.row.priceCents, ch));
        // A brand-new game with several conditions in the sheet (Loose + CIB)
        // is ONE listing: the first row creates it (ref), the rest become new
        // conditions on it (productRef). The server resolves refs within a
        // batch; later batches get the real id from earlier results.
        const firstOfGroup = new Set<string>();
        // Import key = the file NAME + the row's CONTENTS (+ folder, + which
        // occurrence of that content). Retrying — or re-importing an edited copy
        // of the same sheet — replays rows already on the draft instead of
        // doubling them; only identical rows of a same-named file can collide,
        // and those are listed back to the employee after the import.
        const h32 = (str: string, seed: number) => { let h = seed >>> 0; for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; } return h.toString(16).padStart(8, "0"); };
        const fileTag = h32(ch.fileName || "sheet", 2166136261);
        const seenPrints = new Map<string, number>();
        const keyFor = (r: any) => {
          // Not the qty: the server keys each COPY (<key>#1, #2, …), so an edited
          // sheet that goes from 1 to 2 copies adds exactly one.
          // The SHEET's title (not the corrected one), so a re-import of the same
          // sheet replays whether or not the correction ran this time. The
          // region keeps a US and a PAL row of one game apart (titles are bare).
          const fp = [(r.row.titleFrom ?? r.row.title).toLowerCase().trim(), (r.row.platform || "").toLowerCase(), r.row.completenessCode, r.row.gradeCode, ch.inventoryTypeId || "", r.row.folder || "", r.row.region || ""].join("|");
          const occ = (seenPrints.get(fp) || 0) + 1; seenPrints.set(fp, occ);
          return `${fileTag}:${h32(fp, 2166136261)}${h32(fp, 5381)}:${occ}`;
        };
        const payload = rows.map((r: any) => {
          const base = {
            // A PriceCharting id is per release: never tag a PAL row's id onto
            // the US listing it was mapped to.
            qty: r.row.qty, costCents: r.row.costCents, tagPcId: r.row.pcId && !(r.product && (r.product.pcId || listingRegion(r.product) !== regionOf(r.row.region, regions))) ? r.row.pcId : undefined,
            importKey: keyFor(r),
          };
          // Bulk lot etc.: recorded on the entry (what was paid) — no listing, no stock.
          // One line at the sheet's total (cost × qty) so the books match what was paid.
          if (r.nonInventory) return { kind: "nonInventory", description: `${displayTitle(r.row.title, r.row.region, regions)}${r.row.platform ? ` (${r.row.platform})` : ""}${r.row.qty > 1 ? ` ×${r.row.qty}` : ""}`, ...base, qty: 1, costCents: r.row.costCents == null ? null : r.row.costCents * r.row.qty };
          if (r.product && r.variant) return { kind: "variant", variantId: r.variant.id, productId: r.product.id, ...base };
          const v = { completenessCode: r.row.completenessCode, gradeCode: r.row.gradeCode, condition: condText(r), priceCents: priceOf(r), barcode: r.row.upc || null, inventoryTypeId: ch.inventoryTypeId || undefined };
          if (r.product) return { kind: "newVariant", productId: r.product.id, ...v, ...base };
          const g = newListingKey(r.row);
          // title/platform let the server find the listing if its ref row was staged in an earlier attempt.
          if (firstOfGroup.has(g)) return { kind: "newVariant", productRef: g, title: r.row.title, platform: r.row.platform, regionCode: r.row.region, ...v, ...base };
          firstOfGroup.add(g);
          // A corrected title keeps the sheet's spelling as a search name.
          return { kind: "newProduct", ref: g, title: r.row.title, platform: r.row.platform, regionCode: r.row.region, categoryId: r.categoryId || ch.categoryId, altNames: r.row.titleFrom ? [r.row.titleFrom] : undefined, ...v, ...base };
        });
        let staged: { results: any[]; newProducts: any[] };
        try { staged = await stageOntoDraft(rows, payload, progress, `“${ch.fileName}”`); }
        catch (e: any) {
          // Covers + UPCs for what DID get created before the failure.
          if (e?.staged?.newProducts?.length) enrichInBackground(e.staged.newProducts);
          if (e?.staged) upcFillInBackground(touchedListings(e.staged.results));
          throw e;
        }
        if (staged.newProducts.length) enrichInBackground(staged.newProducts);
        upcFillInBackground(touchedListings(staged.results));
      },
    });
  }

  /* Stage built import rows onto the open draft in small batches (shared by the
     collection CSV import and the eBay store import). `payload[i]` is the
     importStage row for `rows[i]`. Rows that land are marked skipped so a retry
     only re-sends the rest. Mirrors new listings / stock rows into the loaded
     catalog, reloads the draft, and reports failed / replayed rows. On a failed
     batch it throws, with `.staged` = what made it. */
  async function stageOntoDraft(rows: any[], payload: any[], progress: (m: string) => void, sourceName: string): Promise<{ results: any[]; newProducts: any[] }> {
    const newProducts: any[] = [];
    const refToProduct = new Map<string, string>();
    const results: any[] = [];
    // Small batches: each new-listing row is ~7 database round trips, and
    // a batch must finish well inside the serverless time limit.
    const STEP = 10;
    // Does the server have replay protection (migration 20260929000001)?
    // Decides what we can promise the employee if a batch fails.
    const idempotent = !!(await api({ action: "importStage", entryId, rows: [] }).catch(() => ({}))).idempotent;
    try {
      for (let i = 0; i < payload.length; i += STEP) {
        progress(`Staging ${Math.min(i + STEP, payload.length)} / ${payload.length}…`);
        const batch = payload.slice(i, i + STEP).map((p: any) => (p.productRef && refToProduct.has(p.productRef) ? { ...p, productId: refToProduct.get(p.productRef) } : p));
        const j = await api({ action: "importStage", entryId, rows: batch });
        results.push(...(j.results || []));
        batch.forEach((p: any, k: number) => { if (p.ref && j.results?.[k]?.ok) refToProduct.set(p.ref, j.results[k].productId); });
        // Staged → never re-sent if a later batch fails and the employee retries.
        rows.slice(i, i + STEP).forEach((r: any, k: number) => { if (j.results?.[k]?.ok) r.skip = true; });
      }
    } catch (e) {
      if (results.length) { mirrorImported(); await loadEntry(entryId); setEntryMode(true); render(); }
      const err: any = new Error(`${(e as any)?.message || "A batch failed"}. ${idempotent
        ? "Press Import again: rows that already made it onto the draft are recognized and won't be added twice."
        : "Rows from the failed batch MAY already be on the draft (look before pressing Import again, or apply migration 20260929000001 for automatic protection)."}`);
      err.staged = { results, newProducts };
      throw err;
    }
    mirrorImported();
    function mirrorImported() {
      // Mirror new listings/conditions into the loaded catalog so the
      // typeahead (and a second import of the same sheet) sees them.
      results.forEach((res, i) => {
        if (!res?.ok) return;
        const r: any = rows[i]; const p: any = payload[i];
        if (res.newProduct) {
          if (items.some((x) => x.id === res.productId)) return; // replayed row, already mirrored
          const cat = categories.find((c: any) => c.id === p.categoryId);
          const np: any = {
            id: res.productId, title: r.row.title, slug: res.slug || r.row.title.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, ""),
            platform: r.row.platform, regionCode: regionReady ? r.row.region || "" : "", franchise: "", genre: "", description: "", imageUrl: "", altNames: p.altNames || [], categoryId: p.categoryId,
