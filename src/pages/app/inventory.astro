    const replayed = results.map((res, i) => (res?.replay ? `Row ${rows[i].row.n} “${rowTitle(i)}”`
      : res?.already ? `Row ${rows[i].row.n} “${rowTitle(i)}”: ${res.already} of ${rows[i].row.qty} copies (the rest were added)` : null)).filter(Boolean);
