        <div class="bc-head" style="display:flex;align-items:center;gap:0.5rem;">${esc(condLabel(v))}${v.sku ? " · " + esc(v.sku) : ""}
          <button type="button" class="btn btn-ghost btn-sm" data-recvstock="${v.id}" style="margin-left:auto;" title="Add copies to stock now (recorded on today's ⚡ Quick adds entry in 📥 Entries)">＋ Receive</button>
