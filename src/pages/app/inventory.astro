  async function describeOne(p: any, currentText: string): Promise<string> {
    const req = () => fetch("/api/pos/ai/describe", { method: "POST", headers: { "content-type": "application/json" },
      // A one-liner is REWRITTEN (its edition / bundle facts kept), not thrown away.
      body: JSON.stringify({ productId: p.id, title: p.title, platform: p.platform, regionCode: p.regionCode || "", omitCondition: true, currentText }) })
      .then(async (r) => ({ ok: r.ok, j: await r.json().catch(() => ({})) }));
    let { ok, j } = await req();
    // The AI is busy / over its per-minute limit → wait and try once more.
    if (!ok && !j.needsKey && /quota|rate|busy|overload|429|503|exhausted|try again/i.test(String(j.error))) { await descSleep(20_000); ({ ok, j } = await req()); }
