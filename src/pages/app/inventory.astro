    const go = $("desc-go") as HTMLButtonElement, stop = $("desc-stop") as HTMLButtonElement;
    go.disabled = true; stop.hidden = false; stop.textContent = "■ Stop";
    let written = 0, failed = 0, failedInRow = 0, skipped = 0;
    try {
      for (let k = 0; k < picked.length; k++) {
        if (descStop) break;
        const i = picked[k], r = descRows[i];
        const tr = document.querySelector<HTMLElement>(`tr[data-drow="${i}"]`)!;
        const st = tr.querySelector<HTMLElement>("[data-dst]")!;
        const cb = tr.querySelector<HTMLInputElement>("[data-desc]")!;
        // Unticked since, or its description changed here since the list was made → leave it.
