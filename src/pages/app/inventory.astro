  /* eBay import row */
  .ebay-import { margin-bottom:0.9rem; padding-bottom:0.9rem; border-bottom:1px dashed var(--line); }
  .ebay-row { display:flex; gap:0.5rem; align-items:center; }
  .ebay-row input { flex:1; min-width:0; }
  .ebay-tag { font-size:0.78rem; font-weight:800; letter-spacing:0.02em; padding:0.35rem 0.55rem; background:#e53238; color:#fff; white-space:nowrap; }
  .ebay-note { display:flex; gap:0.6rem; align-items:center; margin-top:0.6rem; padding:0.5rem 0.6rem; background:var(--surface-2,rgba(255,255,255,0.03)); border:1px solid var(--line); font-size:0.82rem; line-height:1.35; }
  .ebay-note img { flex:none; }
</style>

<script>
  import { buildPlatforms, parseQuery as _parseQuery, smartMatches as _smartMatches, matchScore, resolveStaticPlatform, nameHas } from "../../lib/smartSearch";
  import { resolveComp, compAbbrev } from "../../lib/conditionDisplay";
  import { openPrintDialog } from "../../lib/labelPrint";
  import { initScanReceiver, openPairDialog } from "../../lib/scanReceive";
  import { barcodeEq } from "../../lib/gtin";
  import { openImportDialog, importPrice } from "../../lib/importDialog";
  import { openEbayImportDialog } from "../../lib/ebayImportDialog";
  import { newListingKey, officialTitleFor, itemKind, norm as normImport } from "../../lib/collectionImport";
  import { upcEligible } from "../../lib/upcMatch";
  import { upcLike, identifyUpc } from "../../lib/upcClient";
  import { regionOf, regionsOn, regionByCode, isDefaultRegion, regionBadgeHtml, displayTitle, regionTag, regionSortKey, splitTitleRegion, regionFromPlatform, type Region } from "../../lib/regions";

  const data = JSON.parse(document.getElementById("pos-data")!.textContent!);
  let items: any[] = data.items;
  const categories: any[] = data.categories;
  const completeness: any[] = data.completeness || [];
  const grades: any[] = data.grades || [];
  const conditionPricing: boolean = !!data.conditionPricing;
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: any) => String(s ?? "").replace(/[&<>"]/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[m] as string));
  const money = (c: number) => (c / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
  const toCents = (v: string) => Math.max(0, Math.round(parseFloat(v) * 100) || 0);
  const state = { q: "", cat: "", plat: "", region: "", sort: "title", instock: false, web: false, ebay: false, attention: false, needsupc: false, parsed: null as any };
  const selected = new Set<string>(); // product ids selected for bulk edit

  // Regions (migration 20261005000001): a listing's market is a tag shown as a
  // badge next to its title. [] before the migration → no badges / controls.
  const regions: Region[] = data.regions || [];
  const rgOn = regionsOn(regions);
  const regionReady: boolean = !!data.regionReady;
  const badge = (code: string | null | undefined) => { const h = regionBadgeHtml(code, regions); return h ? " " + h : ""; };
  const rgTitle = (p: any) => displayTitle(p.title, p.regionCode, regions); // "Okami HD [JP]" for plain text
  // Same title → the home region first.
  const byTitle = (a: any, b: any) => a.title.localeCompare(b.title) || regionSortKey(a.regionCode, regions) - regionSortKey(b.regionCode, regions);
  // A catalog listing's region: its field, else (before the migration) the
  // "[PAL]" tag its title still carries / a regional platform name.
  const listingRegion = (p: any) => regionOf(p.regionCode || splitTitleRegion(p.title, regions).code || regionFromPlatform(p.platform, regions).code, regions);

  /* ---------- Smart find-or-create (shared module: src/lib/smartSearch.ts) ---------- */
  const PLATFORMS = buildPlatforms(items.map((p) => p.platform));
  const parseQuery = (raw: string) => _parseQuery(raw, { completeness, grades, platforms: PLATFORMS, regions });
  // A draft's not-yet-finished listings / stock rows are hidden everywhere but
  // that draft's own screen (search, scanning, import matching, Finish).
  const liveItems = () => items.filter((p: any) => !p.pendingEntryId);
  const draftItems = () => items.filter((p: any) => !p.pendingEntryId || (entryId && p.pendingEntryId === entryId));
  const draftVariants = (p: any) => [...p.variants, ...(p.pendingVariants || []).filter((v: any) => entryId && v.pendingEntryId === entryId)];
  const everyVariant = (p: any) => [...p.variants, ...(p.pendingVariants || [])];
  // The server discarded a removed line's hidden stock row / listing — forget them too.
  const forgetDiscarded = (j: any) => {
    if (j?.removedProductId) items = items.filter((p: any) => p.id !== j.removedProductId);
    if (j?.removedVariantId) items.forEach((p: any) => {
      p.variants = p.variants.filter((v: any) => v.id !== j.removedVariantId);
      if (p.pendingVariants) p.pendingVariants = p.pendingVariants.filter((v: any) => v.id !== j.removedVariantId);
    });
  };
  const smartMatches = (parsed: any, list: any[] = liveItems()) => _smartMatches(list, parsed);
  const complLabel = (code: string) => completeness.find((c) => c.code === code)?.label || code;
  const compAbbr = (code: string) => compAbbrev(code, completeness);
  const gradeLabel = (code: string) => { const g = grades.find((x) => x.code === code); return g ? (g.icon ? g.icon + " " : "") + g.label : code; };

  // Typeable completeness field: resolve free text ("cib", "complete", "open
  // box") to a canonical code held in dataset.code, and show its short badge.
  // A typeable box with a suggestion list (<datalist>) only suggests what
  // matches its current text — with "Complete In Box" in it, nothing else
  // shows. Clicking / tabbing in clears it (the old value stays as the grey
  // placeholder) so the WHOLE list shows; leaving without touching it puts
  // the old value back. Deleting it on purpose keeps it empty.
  function fullListOnOpen(input: HTMLInputElement) {
    const ph = input.placeholder;
    let held: string | null = null, touched = false;
    const open = () => {
      if (!input.value) return;
      held = input.value; touched = false;
      input.placeholder = held;
      input.value = "";
    };
    input.addEventListener("pointerdown", open);
    input.addEventListener("focus", open);
    input.addEventListener("input", (e) => { if (e.isTrusted) touched = true; });
    input.addEventListener("blur", () => {
      if (held === null) return;
      if (!touched && !input.value) { input.value = held; input.dispatchEvent(new Event("input")); }
      input.placeholder = ph;
      held = null;
    });
  }
  function wireComp(input: HTMLInputElement, badge?: HTMLElement | null) {
    fullListOnOpen(input); // first, so its blur restores before the label tidy below
    const sync = () => {
      const code = resolveComp(input.value, completeness);
      input.dataset.code = code;
      input.classList.toggle("comp-unknown", !!input.value.trim() && !code);
      if (badge) badge.textContent = code ? compAbbr(code) : "";
    };
    input.addEventListener("input", sync);
    input.addEventListener("blur", () => { const code = input.dataset.code; if (code) input.value = complLabel(code); sync(); });
    sync();
  }
  function setComp(input: HTMLInputElement, code: string, badge?: HTMLElement | null) {
    input.value = code ? complLabel(code) : "";
    input.dataset.code = code || "";
    if (badge) badge.textContent = code ? compAbbr(code) : "";
  }

  function renderSmart() {
    const bar = $("smart-bar");
    const parsed = state.parsed;
    const q = (state.q || "").trim();
    if (upcLike(q) && !codeOnListing(q, liveItems())) {
      bar.innerHTML = `<span class="sb-label">UPC</span> <span>🔎 Looking it up…</span>`;
      bar.hidden = false;
      identifyUpc(q).then((id) => {
        if ((state.q || "").trim() !== q) return;
        bar.innerHTML = `<span class="sb-label">UPC</span> <span>${upcFoundHtml(id)}</span>${id.found && !id.inCatalog ? ` <button class="btn btn-primary btn-sm" id="sb-upcadd">＋ Add product</button>` : ""}`;
        document.getElementById("sb-upcadd")?.addEventListener("click", () => addFromUpc(id));
      });
      return;
    }
    if (!parsed || (!parsed.title && !parsed.platform && !parsed.completenessCode && !parsed.gradeCode)) { bar.hidden = true; return; }
    const chips: string[] = [];
    if (parsed.platform) chips.push(`<span class="sb-chip">${esc(parsed.platform)}</span>`);
    const pr = parsed.regionCode ? regionByCode(parsed.regionCode, regions) : null;
    if (pr) chips.push(`<span class="sb-chip" title="${esc(pr.name)}">${esc(`${pr.flag ? pr.flag + " " : ""}${pr.short}`)}</span>`);
    if (parsed.completenessCode) chips.push(`<span class="sb-chip">${esc(complLabel(parsed.completenessCode))}</span>`);
    if (parsed.gradeCode) chips.push(`<span class="sb-chip">${esc(gradeLabel(parsed.gradeCode))}</span>`);
    const matches = smartMatches(parsed);
    const exact = matches.length > 0 && matches[0].s >= 0.99;
    bar.innerHTML = `
      <span class="sb-label">Understood</span>
      ${parsed.title ? `<strong>${esc(parsed.title)}</strong>` : `<em>any title</em>`}
      ${chips.join("")}
      <span class="sb-count">${matches.length} match${matches.length === 1 ? "" : "es"}</span>
      ${parsed.title && !exact ? `<button class="btn btn-primary btn-sm" id="sb-create">＋ Create this</button>` : ""}`;
    bar.hidden = false;
    document.getElementById("sb-create")?.addEventListener("click", createFromSmart);
  }

  // The Add form's Region select (regions on only); "" → the home region.
  const setNpRegion = (code: string | null | undefined) => {
    const sel = document.getElementById("np-region") as HTMLSelectElement | null;
    if (sel) sel.value = regionOf(code, regions);
  };
  // A new product starts clean: no price / UPC / eBay data left from the last
  // one. Platform, region, category, condition and type stay (handy for a
  // stack of games for one console).
  function clearProductFields() {
    for (const id of ["np-title", "np-price", "np-barcode", "np-ebay", "ni-desc", "ni-total"]) { const el = document.getElementById(id) as HTMLInputElement | null; if (el) el.value = ""; }
    const q = document.getElementById("np-qty") as HTMLInputElement | null; if (q) q.value = "1";
    const note = document.getElementById("np-ebay-note") as HTMLElement | null; if (note) { note.hidden = true; note.innerHTML = ""; }
    pendingEbay = null;
  }
  // The Add panel: open = the "＋ Add product" button turns into "✕ Cancel".
  // Closing with something typed asks first (also when Start entry closes it).
  function setAddOpen(open: boolean) {
    ($("add-panel") as HTMLElement).hidden = !open;
    const b = $("toggle-add");
    b.textContent = open ? "✕ Cancel" : "＋ Add product";
    b.classList.toggle("btn-primary", !open);
    b.classList.toggle("btn-ghost", open);
    b.title = open ? "Close without saving" : "";
  }
  const addDirty = () => ["np-title", "np-barcode", "np-ebay", "ni-desc", "ni-total"].some((id) => ((document.getElementById(id) as HTMLInputElement | null)?.value ?? "").trim() !== "")
    || (parseFloat((document.getElementById("np-price") as HTMLInputElement | null)?.value || "0") || 0) > 0;
  function closeAddPanel(): boolean {
    if (($("add-panel") as HTMLElement).hidden) return true;
    const kind = npKind === "noninv" ? "non-inventory item" : "product";
    if (addDirty() && !confirm(`Discard this ${kind}? What you've typed will be cleared.`)) return false;
    clearProductFields();
    setNpKind("stock");
    setAddOpen(false);
    return true;
  }
  // Product (stock) or Non-inventory (a bulk lot / supplies: what was paid,
  // no stock, no label).
  let npKind: "stock" | "noninv" = "stock";
  function setNpKind(k: "stock" | "noninv") {
    npKind = k;
    ($("np-stock") as HTMLElement).hidden = k !== "stock";
    ($("np-noninv") as HTMLElement).hidden = k !== "noninv";
    document.querySelectorAll<HTMLElement>(".np-kind-btn").forEach((b) => { const on = b.dataset.kind === k; b.classList.toggle("on", on); b.setAttribute("aria-pressed", String(on)); });
    $("np-heading").textContent = k === "stock" ? "Add a product" : "Add a non-inventory item";
    $("ni-note").textContent = entryMode && entryId
      ? `Goes on this entry (#${entryHuman}) — counted in what you paid, no stock or label.`
      : "Recorded right away as its own finished entry (see 📥 Entries) — counted in what you paid, no stock or label.";
  }
  document.querySelectorAll<HTMLElement>(".np-kind-btn").forEach((b) => b.addEventListener("click", () => {
    setNpKind(b.dataset.kind === "noninv" ? "noninv" : "stock");
    (document.getElementById(npKind === "noninv" ? "ni-desc" : "np-title") as HTMLInputElement | null)?.focus();
  }));
  function createFromSmart() {
    const parsed = state.parsed;
    if (!parsed) return;
    clearProductFields();
    setNpKind("stock");
    const panel = $("add-panel") as HTMLElement;
    setAddOpen(true);
    ($("np-title") as HTMLInputElement).value = parsed.titleForNew.replace(/\b\w/g, (c: string) => c.toUpperCase());
    ($("np-platform") as HTMLInputElement).value = parsed.platform || "";
    setNpRegion(parsed.regionCode);
    setComp($("np-comp") as HTMLInputElement, parsed.completenessCode || "", $("np-comp-abbr"));
    ($("np-grade") as HTMLSelectElement).value = parsed.gradeCode || "3";
    panel.scrollIntoView({ behavior: "smooth", block: "center" });
    ($("np-price") as HTMLInputElement).focus();
  }

  async function api(body: any) {
    const r = await fetch("/api/pos/inventory", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    const j = await r.json();
    if (!r.ok || !j.ok) throw new Error(j.error || "Failed");
    return j;
  }
  async function enrich(payload: any) {
    const r = await fetch("/api/pos/enrich", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
    return r.ok ? r.json() : { ok: false };
  }
  let toastT: any;
  function toast(msg: string) {
    const t = $("toast"); t.textContent = msg; t.hidden = false;
    clearTimeout(toastT); toastT = setTimeout(() => (t.hidden = true), 2000);
  }

  // Inventory types + locations (empty pre-migration → related UI stays hidden).
  const invTypes: any[] = (data as any).invTypes || [];
  const locations: any[] = (data as any).locations || [];
  const typeById = new Map(invTypes.map((t: any) => [t.id, t]));
  const retailTypeId = invTypes.find((t: any) => t.key === "retail")?.id || "";
  const lblTemplates: any[] = (data as any).lblTemplates || [];
  const storeName: string = (data as any).storeName || "TimeLag";
  const webBase: string = (data as any).webBase || "";

  // Stock rows made on this page (quick add, + condition, import…) don't know
  // the short label code the DB gave them — without it a label falls back to
  // the wide internal code, whose barcode runs across the spine. Fetch the
  // missing ones right before printing.
  async function fillLabelCodes(vs: any[]) {
    const need = vs.filter((v: any) => v && !v.labelCode && v.id);
    if (!need.length) return;
    try {
      const j = await api({ action: "labelCodes", variantIds: need.map((v: any) => v.id) });
      for (const v of need) if (j.codes?.[v.id]) v.labelCode = j.codes[v.id];
    } catch { /* the wide code still scans */ }
  }
  // Everything a printed label needs for one variant.
  function labelItemOf(p: any, v: any) {
    const loc = locations.find((l: any) => l.id === v.locationId) || locations.find((l: any) => l.is_default);
    return {
      title: p.title,
      categoryName: p.platform || p.categoryName || "",
      region: regionTag(p.regionCode, regions),
      condShort: condLabel(v),
      priceCents: v.priceCents,
      invTypeName: typeById.get(v.inventoryTypeId)?.name ?? "",
      invTypeId: v.inventoryTypeId || "", invTypeIcon: typeById.get(v.inventoryTypeId)?.icon ?? "",
      locationKey: loc?.key ?? "",
      internalCode: v.internalCode || "",
      labelCode: v.labelCode || "",
      sku: v.sku || "",
      storeName,
    };
  }

  const totalQty = (p: any) => p.variants.reduce((s: number, v: any) => s + v.quantity, 0);
  const maxPrice = (p: any) => Math.max(0, ...p.variants.map((v: any) => v.priceCents));
  const anyWeb = (p: any) => p.variants.some((v: any) => v.onlineVisible);
  // Listing UPCs (every condition shares them). "Needs UPC" = a US game on a
  // known platform with none yet — scanning its box would find nothing.
  const upcReady: boolean = !!(data as any).upcReady;
  const upcsOf = (p: any): string[] => (p.upcs || []).map((u: any) => u.upc);
  const needsUpc = (p: any) => upcReady && !upcsOf(p).length && upcEligible({ title: p.title, platform: p.platform, categoryName: p.categoryName, regionCode: p.regionCode });
  // A scanned UPC that isn't in inventory: ask eBay's catalog which game it is
  // (official title + box art from our game database). One lookup per code.
  // Is this code already on a listing loaded here (listing UPC or a condition's barcode)?
  const codeOnListing = (q: string, list: any[]) => list.some((p: any) => upcsOf(p).some((u) => barcodeEq(u, q)) || everyVariant(p).some((v: any) => (v.barcodes || []).some((b: any) => barcodeEq(b.barcode, q))));
  const catForKind = (kind: string) => {
    const re = kind === "console" ? /console|system|hardware/i : kind === "accessory" ? /accessor/i : kind === "collectible" ? /collect/i : /game/i;
    return categories.find((c: any) => re.test(c.name))?.id || "";
  };
  // The Add-product panel, pre-filled from an identified UPC.
  function addFromUpc(id: any) {
    if (entryMode) entNewProduct("", { title: id.title, platform: id.platform, region: id.region || "" });
    else {
      clearProductFields();
      setNpKind("stock");
      const panel = $("add-panel") as HTMLElement;
      setAddOpen(true);
      ($("np-title") as HTMLInputElement).value = id.title;
      ($("np-platform") as HTMLInputElement).value = id.platform || "";
      setNpRegion(id.region); // eBay's catalog is the US one: "" = home
      ($("np-qty") as HTMLInputElement).value = "1";
      panel.scrollIntoView({ behavior: "smooth", block: "center" });
      ($("np-price") as HTMLInputElement).focus();
    }
    ($("np-barcode") as HTMLInputElement).value = id.upc; // saved as the listing's UPC too
    const cat = catForKind(id.kind || "");
    if (cat) ($("np-cat") as HTMLSelectElement).value = cat;
    toast(`📦 ${displayTitle(id.title, id.region, regions)} — set the condition + price, then Save`);
  }
  // The "not in inventory" row/bar for an identified UPC.
  // The owning listing's region as the server reports it (it may be a listing
  // this page hasn't loaded — "refresh this page").
  const catalogBadge = (id: any) => badge(id.region || items.find((x: any) => x.id === id.inCatalog.productId)?.regionCode);
  const upcFoundHtml = (id: any) => id.inCatalog
    ? (id.pending
      ? `📦 <strong>${esc(id.inCatalog.title)}</strong>${catalogBadge(id)} is on an unfinished inventory entry — finish that entry to scan it`
      : `📦 Already in inventory as <strong>${esc(id.inCatalog.title)}</strong>${catalogBadge(id)} — refresh this page to scan it`)
    : id.found
      ? `${id.cover ? `<img src="${esc(id.cover)}" alt="" style="width:30px;height:30px;object-fit:contain;vertical-align:middle;margin-right:0.4rem;">` : "📦 "}Not in inventory: <strong>${esc(id.title)}</strong>${badge(id.region)}${id.platform ? ` (${esc(id.platform)})` : ""}`
      : id.error
        ? `⚠ Couldn't look up UPC ${esc(id.upc || "")}: ${esc(id.evidence || "error")}`
        : `🔎 UPC ${esc(id.upc || "")}: ${esc(id.evidence || "not found")} — type the name to add it`;
  // What a listing is still missing (drives the "needs attention" inbox + badge).
  function issues(p: any): string[] {
    const out: string[] = [];
    if (!p.imageUrl) out.push("image");
    if (!p.description) out.push("description");
    if (p.variants.some((v: any) => !v.completenessCode)) out.push("condition");
    return out;
  }

  // Display label for a variant from the structured condition codes (falls back
  // to the legacy free-text condition).
  function condLabel(v: any) {
    const c = completeness.find((x) => x.code === v.completenessCode);
    const g = grades.find((x) => x.code === v.gradeCode);
    if (c || g) return [c ? compAbbr(c.code) : null, g ? (g.icon || g.label) : null].filter(Boolean).join(" · ");
    return v.condition || "—";
  }
  const gradeOpts = (sel: string) =>
    `<option value="">—</option>` + grades.map((g) => `<option value="${g.code}"${g.code === sel ? " selected" : ""}>${esc((g.icon ? g.icon + " " : "") + g.label)}</option>`).join("");
  const typeOpts = (sel: string) =>
    invTypes.map((t: any) => `<option value="${t.id}"${t.id === sel ? " selected" : ""}>${esc((t.icon ? t.icon + " " : "") + t.name)}</option>`).join("");
  const locOpts = (sel: string) =>
    `<option value="">—</option>` + locations.map((l: any) => `<option value="${l.id}"${l.id === sel ? " selected" : ""}>${esc(l.key)}</option>`).join("");

  function vchip(v: any) {
    const cls = v.quantity > 0 ? "" : "oos";
    const web = v.onlineVisible
      ? `<span class="web" title="On website">🌐</span>`
      : `<span class="nweb" title="In store only">·</span>`;
    // Flag non-retail pools (e.g. 🔒 Personal Collection) at a glance.
    const t = typeById.get(v.inventoryTypeId);
    const tIcon = t && t.key !== "retail" ? `<span class="vtype" title="${esc(t.name)}">${esc(t.icon || "📦")}</span> ` : "";
    return `<span class="vchip ${cls}">${tIcon}<span class="cond">${esc(condLabel(v))}</span> ${money(v.priceCents)} · ${v.quantity} ${web}</span>`;
  }

  function cardHtml(p: any) {
    const cover = p.imageUrl
      ? `<div class="inv-cover"><img src="${esc(p.imageUrl)}" alt=""></div>`
      : `<div class="inv-cover" style="color:${esc(p.categoryColor)}">🎮</div>`;
    const tags = [p.platform, p.genre, p.franchise].filter(Boolean).map((t: string) => `<span class="inv-tag">${esc(t)}</span>`).join("");
    const skus = p.variants.map((v: any) => v.sku).filter(Boolean);
    const webBtn = anyWeb(p)
      ? `<a class="btn btn-ghost btn-sm icon-btn" href="${webBase}${p.slug ? `/shop/${p.slug}` : "/shop"}" target="_blank" rel="noopener">↗ Web</a>`
      : "";
    const sellV = p.variants.find((v: any) => v.quantity > 0);
    const sellBtn = sellV
      ? `<a class="btn btn-ghost btn-sm icon-btn" href="/checkout?add=${sellV.id}" title="Add to checkout">🛒 Sell</a>`
      : "";
    return `
      <div class="inv-card${selected.has(p.id) ? " selected" : ""}" data-p="${p.id}">
        <input type="checkbox" class="inv-check" data-sel="${p.id}"${selected.has(p.id) ? " checked" : ""} aria-label="Select ${esc(rgTitle(p))}">
        ${cover}
        <div class="inv-main">
          <div class="inv-titlerow">
            <span class="inv-title">${esc(p.title)}</span>${badge(p.regionCode)}
            <span class="inv-catpill" style="background:${esc(p.categoryColor)}22;color:${esc(p.categoryColor)}">${esc(p.categoryName)}</span>
            ${p.ebayId ? `<span class="inv-ebay" title="Imported from eBay">🛒 eBay</span>` : ""}
          </div>
          <div class="inv-tags">${tags}</div>
          ${skus.length ? `<div class="inv-sku">${esc(skus[0])}${skus.length > 1 ? ` +${skus.length - 1}` : ""}</div>` : ""}
          ${upcsOf(p).length ? `<div class="inv-sku" title="UPC — scanning it finds this listing">UPC ${esc(upcsOf(p)[0])}${upcsOf(p).length > 1 ? ` +${upcsOf(p).length - 1}` : ""}</div>` : ""}
          <div class="inv-variants">${p.variants.map(vchip).join("")}</div>
          ${issues(p).length ? `<div class="inv-warn">⚠ Needs: ${issues(p).join(", ")}</div>` : ""}
        </div>
        <div class="inv-actions">
          <span class="tot">${totalQty(p)} in stock</span>
          <button class="btn btn-primary btn-sm icon-btn" data-edit="${p.id}">✎ Edit</button>
          ${sellBtn}
          ${webBtn}
        </div>
      </div>`;
  }

  function visible() {
    // Code-first search: a query that hits a SKU (contains), UPC/alt barcode,
    // label code, or internal code returns those items outright — scanning or
    // pasting an identifier should never depend on fuzzy title matching.
    const rawQ = (state.q || "").trim();
    if (rawQ.length >= 2) {
      const Q = rawQ.toUpperCase();
      const codeHits = liveItems().filter((p) => upcsOf(p).some((u) => barcodeEq(u, rawQ)) || p.variants.some((v: any) =>
        (v.sku && v.sku.toUpperCase().includes(Q)) ||
        (v.internalCode && v.internalCode === Q) ||
        (v.labelCode && v.labelCode === rawQ) ||
        (v.barcodes || []).some((b: any) => barcodeEq(b.barcode, rawQ))));
      if (codeHits.length) return codeHits.sort(byTitle);
    }
    let list = liveItems().filter((p) => {
      if (state.cat && p.categoryId !== state.cat) return false;
      if (state.plat && platKey(p) !== (state.plat === NO_PLAT ? "" : state.plat)) return false;
      if (state.region && regionOf(p.regionCode, regions) !== state.region) return false;
      if (state.instock && totalQty(p) <= 0) return false;
      if (state.web && !anyWeb(p)) return false;
      if (state.ebay && !p.ebayId) return false;
      if (state.attention && issues(p).length === 0) return false;
      if (state.needsupc && !needsUpc(p)) return false;
      if ((state as any).invType && !p.variants.some((v: any) => v.inventoryTypeId === (state as any).invType)) return false;
      return true;
    });
    const parsed = state.parsed;
    if (parsed && (parsed.title || parsed.platform || parsed.completenessCode || parsed.gradeCode)) {
      list = list.map((p) => ({ p, s: matchScore(p, parsed) })).filter((x) => x.s > 0).sort((a, b) => b.s - a.s).map((x) => x.p);
    } else {
      list.sort((a, b) =>
        state.sort === "price" ? maxPrice(b) - maxPrice(a)
        : state.sort === "qty" ? totalQty(b) - totalQty(a)
        : state.sort === "region" ? regionSortKey(a.regionCode, regions) - regionSortKey(b.regionCode, regions) || a.title.localeCompare(b.title)
        : byTitle(a, b));
    }
    return list;
  }

  // Platform filter: one entry per platform, spellings merged ("Game Boy
  // Advance" / "Nintendo Game Boy Advance"), with counts. Rebuilt only when
  // the set changes (a new product, an import), keeping the pick.
  const NO_PLAT = "__none__";
  const platKey = (p: any) => { const raw = String(p.platform || "").trim(); return resolveStaticPlatform(raw) ?? raw; };
  let platSig = "";
  function renderPlatformFilter() {
    const sel = document.getElementById("inv-plat") as HTMLSelectElement | null;
    if (!sel) return;
    const counts = new Map<string, number>();
    for (const p of liveItems()) { const k = platKey(p); counts.set(k, (counts.get(k) || 0) + 1); }
    const keys = [...counts.keys()].sort((a, b) => (a === "" ? 1 : b === "" ? -1 : a.localeCompare(b)));
    const sig = keys.map((k) => `${k}:${counts.get(k)}`).join("|");
    if (sig === platSig) return;
    platSig = sig;
    if (state.plat && !counts.has(state.plat === NO_PLAT ? "" : state.plat)) state.plat = "";
    sel.innerHTML = `<option value="">All platforms</option>` + keys.map((k) => {
      const v = k || NO_PLAT;
      return `<option value="${esc(v)}"${v === state.plat ? " selected" : ""}>${esc(k || "(no platform)")} (${counts.get(k)})</option>`;
    }).join("");
  }
  function render() {
    renderPlatformFilter();
    const list = visible();
    $("inv-count").textContent = `${list.length} product${list.length === 1 ? "" : "s"}`;
    $("inv-list").innerHTML = list.length ? list.map(cardHtml).join("") : `<p class="empty">No products match.</p>`;
    document.querySelectorAll<HTMLElement>("[data-edit]").forEach((b) => b.addEventListener("click", (e) => { e.stopPropagation(); openModal(b.dataset.edit!); }));
    // Click a card (not a control) → open the item's edit modal (owner spec:
    // the old shop-page popup 404'd through the host-split and hit dashboard).
    document.querySelectorAll<HTMLElement>(".inv-card").forEach((card) => {
      card.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("button, a, input, select, label")) return;
        openModal(card.dataset.p!);
      });
    });
    // Bulk-select checkboxes.
    document.querySelectorAll<HTMLInputElement>(".inv-check").forEach((cb) => {
      cb.addEventListener("change", () => {
        if (cb.checked) selected.add(cb.dataset.sel!); else selected.delete(cb.dataset.sel!);
        cb.closest(".inv-card")?.classList.toggle("selected", cb.checked);
        updateBulkBar();
      });
    });
    // Live count on the "needs attention" chip.
    const attn = liveItems().filter((p) => issues(p).length).length;
    const chip = document.getElementById("attn-chip");
    if (chip) chip.textContent = `⚠ Needs attention${attn ? ` (${attn})` : ""}`;
    const nu = liveItems().filter(needsUpc).length;
    const upcChip = document.getElementById("upc-chip");
    if (upcChip) upcChip.textContent = `Needs UPC${nu ? ` (${nu})` : ""}`;
    updateBulkBar();
  }

  /* ---------- Bulk edit ---------- */
  function updateBulkBar() {
    const bar = $("bulk-bar") as HTMLElement;
    bar.hidden = entryMode || selected.size === 0;
    $("bulk-n").textContent = String(selected.size);
  }
  $("bulk-clear").addEventListener("click", () => { selected.clear(); render(); });
  $("bulk-selall").addEventListener("click", () => { visible().forEach((p) => selected.add(p.id)); render(); });

  async function bulkSetOnline(online: boolean) {
    const ids = [...selected];
    if (!ids.length) return;
    const btn = $("bulk-online") as HTMLButtonElement; const oTxt = btn.textContent; btn.disabled = true; btn.textContent = "Saving…";
    try {
      const j = await api({ action: "bulkSetOnline", productIds: ids, online });
      // Reflect locally so the cards update without a reload.
      const set = new Set(ids);
      items.forEach((p) => { if (set.has(p.id)) p.variants.forEach((v: any) => (v.onlineVisible = online)); });
      selected.clear();
      render();
      toast(`✓ ${online ? "Published" : "Unpublished"} ${j.updated ?? ids.length} variant${(j.updated ?? 1) === 1 ? "" : "s"} across ${ids.length} item${ids.length === 1 ? "" : "s"}`);
    } catch (e: any) { alert(e.message); }
    finally { btn.disabled = false; btn.textContent = oTxt; }
  }
  $("bulk-online").addEventListener("click", () => bulkSetOnline(true));
  $("bulk-offline").addEventListener("click", () => bulkSetOnline(false));

  // Bulk "Set region" (regions on only): fix many listings' market at once.
  document.getElementById("bulk-region")?.addEventListener("change", async (e) => {
    const sel = e.currentTarget as HTMLSelectElement;
    const code = sel.value; sel.value = "";
    const ids = [...selected];
    const r = regionByCode(code, regions);
    if (!r || !ids.length) return;
    // eBay's UPC lookup is the US catalog: its codes name the US release.
    const losing = code === "US" ? 0 : items.filter((p) => selected.has(p.id) && regionOf(p.regionCode, regions) !== code && (p.upcs || []).some((u: any) => u.source === "ebay")).length;
    if (!confirm(`Set the region of ${ids.length} listing${ids.length === 1 ? "" : "s"} to ${r.flag ? r.flag + " " : ""}${r.name}?${losing ? `\n\n${losing} of them ha${losing === 1 ? "s" : "ve"} an automatic eBay UPC — that's the US release's code, so it comes off.` : ""}`)) return;
    sel.disabled = true;
    try {
      const j = await api({ action: "bulkSetRegion", productIds: ids, regionCode: code });
      const reset = new Set<string>(j.upcReset || []);
      items.forEach((p) => {
        if (!selected.has(p.id)) return;
        p.regionCode = j.regionCode || code;
        if (reset.has(p.id)) { p.upcs = (p.upcs || []).filter((u: any) => u.source !== "ebay"); p.upcStatus = ""; p.upcCheckedAt = null; }
      });
      selected.clear();
      render();
      toast(`✓ ${j.updated ?? ids.length} listing${(j.updated ?? ids.length) === 1 ? "" : "s"} → ${r.flag ? r.flag + " " : ""}${r.short}`);
    } catch (err: any) { alert(err.message); }
    finally { sel.disabled = false; }
  });

  // Bulk delete (managers only; the button only renders for them — the API
  // enforces the role server-side too). Soft-delete: 7 days in Recently
  // deleted, restorable, then purged for good.
  document.getElementById("bulk-delete")?.addEventListener("click", async () => {
    const ids = [...selected];
    if (!ids.length) return;
    const n = ids.length;
    if (!confirm(`Delete ${n} item${n === 1 ? "" : "s"}?\n\nThey come off the website immediately and sit in "Recently deleted" for 7 days (restorable), then are removed permanently.`)) return;
    const btn = document.getElementById("bulk-delete") as HTMLButtonElement;
    btn.disabled = true; btn.textContent = "Deleting…";
    try {
      await api({ action: "bulkDelete", productIds: ids });
      location.reload();
    } catch (e: any) {
      toast("✗ " + e.message);
      btn.disabled = false; btn.textContent = "🗑 Delete";
    }
  });
  document.querySelectorAll<HTMLButtonElement>(".rd-restore").forEach((btn) => {
    btn.addEventListener("click", async () => {
      btn.disabled = true; btn.textContent = "Restoring…";
      try {
        await api({ action: "bulkRestore", productIds: [btn.dataset.id] });
        location.reload();
      } catch (e: any) {
        toast("✗ " + e.message);
        btn.disabled = false; btn.textContent = "↩ Restore";
      }
    });
  });
  // Print labels for every condition of the selected items (1 each by default,
  // with the per-line "all N" escape hatch for full re-tags).
  $("bulk-print").addEventListener("click", async () => {
    await fillLabelCodes(items.filter((p) => selected.has(p.id)).flatMap((p) => p.variants));
    const lines: any[] = [];
    items.filter((p) => selected.has(p.id)).forEach((p) => p.variants.forEach((v: any) => {
      if (v.internalCode || v.labelCode) lines.push({ item: labelItemOf(p, v), defaultCopies: 1, allCopies: v.quantity > 1 ? v.quantity : null });
    }));
    if (!lines.length) { alert("Selected items have no label codes yet."); return; }
    openPrintDialog(lines, lblTemplates, { title: `Print labels — ${lines.length} condition${lines.length === 1 ? "" : "s"}` });
  });

  /* ---------- Edit modal ---------- */
  // Manager-only restock links shown in the modal (staff never receive the data).
  function supRowHtml(l: any) {
    return `<div class="sup-row" data-supid="${l.id}">${l.url ? `<a href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.label)} ↗</a>` : `<span>${esc(l.label)}</span>`}<button class="link-btn" data-supdel="${l.id}" type="button">✕</button></div>`;
  }
  const modal = $("edit-modal");
  function closeModal() { modal.hidden = true; }
  modal.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", closeModal));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) closeModal(); });

  function openModal(pid: string) {
    const p = items.find((x) => x.id === pid);
    if (!p) return;
    modal.dataset.pid = pid;
    $("m-heading").innerHTML = "Edit · " + esc(p.title) + badge(p.regionCode);
    $("m-pricelinks").innerHTML = `<span class="muted-2">Price check:</span> ${cmpLinks([p.title, p.platform, regionTag(p.regionCode, regions)].filter(Boolean).join(" "))}`;
    const catOpts = categories.map((c) => `<option value="${c.id}"${c.id === p.categoryId ? " selected" : ""}>${esc(c.name)}</option>`).join("");
    // Active regions + the listing's own (even if since switched off).
    const curRegion = regionOf(p.regionCode, regions);
    const regionOpts = regions.filter((r) => r.isActive || r.code === curRegion)
      .map((r) => `<option value="${esc(r.code)}"${r.code === curRegion ? " selected" : ""}>${esc(`${r.flag ? r.flag + " " : ""}${r.name}`)}</option>`).join("");

    const condRows = p.variants.map(condRowHtml).join("");
    const bcBlocks = p.variants.map(bcBlockHtml).join("");

    $("modal-body").innerHTML = `
      <div class="m-section">
        <div class="m-label" style="display:flex;align-items:center;gap:0.5rem;">Product <button type="button" class="btn btn-ghost btn-sm" id="m-enrich">✨ Auto‑fill from IGDB</button></div>
        <div class="m-grid">
          <label>Title<input id="m-title" value="${esc(p.title)}"></label>
          <label>Platform<input id="m-platform" value="${esc(p.platform)}"></label>
          ${rgOn ? `<label title="The release's market — an import (PAL, Japan…) gets a badge everywhere">Region<select id="m-region">${regionOpts}</select></label>` : ""}
          <label>Genre / set<input id="m-genre" value="${esc(p.genre)}"></label>
          <label>Franchise<input id="m-franchise" value="${esc(p.franchise)}"></label>
          <label>Category<select id="m-category">${catOpts}</select></label>
          <label class="m-span2">Image<div class="img-field"><input id="m-image" value="${esc(p.imageUrl)}" placeholder="https://… or upload →"><label class="btn btn-ghost btn-sm img-up">📷 Upload<input type="file" id="m-imgfile" accept="image/*" hidden></label></div></label>
        </div>
        ${rgOn ? `<div id="m-region-warn" class="upc-note m-region-warn" hidden></div>` : ""}
        <div id="m-imgprev" class="img-prev"${p.imageUrl ? "" : " hidden"}>${p.imageUrl ? `<img src="${esc(p.imageUrl)}" alt="">` : ""}</div>
        <div class="m-field"><label style="display:flex;align-items:center;gap:0.5rem;justify-content:space-between;">Description (web) <button type="button" class="btn btn-ghost btn-sm" id="m-ai-desc" data-pid="${p.id}">✨ Write with AI</button></label><textarea id="m-desc" rows="3" placeholder="Shown on the website listing">${esc(p.description)}</textarea></div>
      </div>

      <div class="m-section">
        <div class="m-label">Pricing &amp; web — per condition${conditionPricing ? ` <span class="cp-on">↻ condition pricing on</span>` : ""}</div>
        <div class="cond-scroll">
          <table class="cond-table"${invTypes.length ? "" : ` style="min-width:660px;"`}>
            <thead><tr><th>Completeness</th><th>Grade</th><th>SKU</th><th>In‑store $</th><th>Online $</th><th>Qty</th><th>Web</th>${invTypes.length ? "<th>Type</th><th>Loc</th>" : ""}</tr></thead>
            <tbody id="cond-body">${condRows}</tbody>
          </table>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" id="add-cond" style="margin-top:0.5rem;">＋ Add condition</button>
        <p class="web-hint">${conditionPricing ? "Set one condition's price and tap ↻ to re‑price the others by your rule. " : ""}Leave “Online $” blank to use the in‑store price; “Web” publishes that condition to the shop.</p>
      </div>

      ${data.isManager ? `
      <div class="m-section">
        <div class="m-label" style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">Running cost <small class="muted" style="font-weight:400;">weighted avg paid per unit (trade-ins)</small>
          <select id="cost-tf" style="margin-left:auto;">
            <option value="90">Last 3 months</option>
            <option value="365">Last year</option>
            <option value="0">All time</option>
          </select>
        </div>
        <div id="cost-body" class="muted" style="margin-top:0.4rem;">Loading…</div>
      </div>` : ""}

      <div class="m-section">
        <div class="m-label">Barcodes</div>
        ${upcReady ? `<div class="bc-block upc-block" id="upc-block">${upcBlockHtml(p)}</div>` : ""}
        <div id="bc-blocks">${bcBlocks}</div>
      </div>

      ${data.isManager && sourcesReady ? `
      <div class="m-section">
        <div class="m-label">Suppliers — where to restock <small style="text-transform:none;letter-spacing:0;">(only managers see this)</small></div>
        <div id="sup-list">${(p.supplierLinks || []).map(supRowHtml).join("")}</div>
        <div class="bc-add"><input id="sup-label" placeholder="Name — e.g. VGNY, Solutions2Go"><input id="sup-url" placeholder="https://… (optional)" style="width:14rem;"><button id="sup-add" class="btn btn-ghost btn-sm" type="button">＋ Add supplier</button></div>
      </div>` : ""}`;

    const link = $("m-weblink") as HTMLAnchorElement;
    if (anyWeb(p)) { link.href = webBase + (p.slug ? `/shop/${p.slug}` : "/shop"); link.hidden = false; } else { link.hidden = true; }
    const ebayLink = $("m-ebaylink") as HTMLAnchorElement;
    if (p.ebayId) { ebayLink.href = `https://www.ebay.com/itm/${p.ebayId}`; ebayLink.hidden = false; } else { ebayLink.hidden = true; }

    // A UPC names ONE release — moving a listing that has one to another
    // region deserves a look before saving.
    document.getElementById("m-region")?.addEventListener("change", (ev) => {
      const to = (ev.currentTarget as HTMLSelectElement).value;
      const warn = document.getElementById("m-region-warn");
      if (!warn) return;
      warn.hidden = !(upcsOf(p).length && regionOf(to, regions) !== regionOf(p.regionCode, regions));
      if (warn.hidden) return;
      // eBay's lookup is the US catalog — the server removes its codes on a move off US.
      const ebay = (p.upcs || []).some((u: any) => u.source === "ebay");
      warn.textContent = `⚠ This listing has UPC ${upcsOf(p).join(", ")} — a UPC belongs to one release. ${ebay && to !== "US" ? "The automatic eBay UPC is the US release's, so it comes off when you save." : "Check it's the code on this region's box."}`;
    });
    bindBarcodes(p);
    if (upcReady) bindUpcBlock(p);
    bindReprice(p);
    wireModalComps();
    $("add-cond").addEventListener("click", () => addCondition(p));

    // Supplier links (manager-only section; delegated so re-renders stay clean).
    if (data.isManager && sourcesReady) {
      const supList = document.getElementById("sup-list");
      supList?.addEventListener("click", async (ev) => {
        const btn = (ev.target as HTMLElement).closest<HTMLElement>("[data-supdel]");
        if (!btn) return;
        try {
          await api({ action: "deleteSupplierLink", id: btn.dataset.supdel });
          p.supplierLinks = (p.supplierLinks || []).filter((x: any) => x.id !== btn.dataset.supdel);
          btn.closest(".sup-row")?.remove();
        } catch (e: any) { alert(e.message); }
      });
      document.getElementById("sup-add")?.addEventListener("click", async () => {
        const label = (document.getElementById("sup-label") as HTMLInputElement).value.trim();
        const url = (document.getElementById("sup-url") as HTMLInputElement).value.trim();
        if (!label) { alert("Supplier name required"); return; }
        try {
          const j = await api({ action: "addSupplierLink", productId: p.id, label, url: url || null });
          p.supplierLinks = [...(p.supplierLinks || []), j.link];
          supList?.insertAdjacentHTML("beforeend", supRowHtml(j.link));
          (document.getElementById("sup-label") as HTMLInputElement).value = "";
          (document.getElementById("sup-url") as HTMLInputElement).value = "";
        } catch (e: any) { alert(e.message); }
      });
    }

    // Label printing (per-condition buttons live in the Barcodes section).
    document.querySelectorAll<HTMLButtonElement>("[data-printlabel]").forEach((b) => b.addEventListener("click", async () => {
      const v = p.variants.find((x: any) => x.id === b.dataset.printlabel);
      if (!v) return;
      await fillLabelCodes([v]);
      if (!v.internalCode) { alert("This condition has no label code yet — reload the page and try again."); return; }
      openPrintDialog([{ item: labelItemOf(p, v), defaultCopies: 1, allCopies: v.quantity }], lblTemplates, { title: `Print · ${rgTitle(p)}` });
    }));
    // Quick stock adjust — IMMEDIATE (quantity + ledger, no draft). Batch
    // receiving with costs/labels lives in ▶ Start entry.
    document.querySelectorAll<HTMLButtonElement>("[data-recvstock]").forEach((b) => b.addEventListener("click", async () => {
      const v = p.variants.find((x: any) => x.id === b.dataset.recvstock);
      if (!v) return;
      const qty = parseInt(prompt(`Receive how many — ${rgTitle(p)} (${condLabel(v)})?`, "1") || "0");
      if (!qty || qty <= 0) return;
      const costRaw = prompt("Cost per unit $ (optional — what you paid):", "");
      const unitCostCents = costRaw && costRaw.trim() !== "" ? Math.round(parseFloat(costRaw) * 100) || 0 : null;
      try {
        const j = await api({ action: "receiveStock", variantId: v.id, qtyAdded: qty, unitCostCents });
        v.quantity = j.newQuantity;
        const qi = $("cond-body")?.querySelector<HTMLInputElement>(`[data-vrow="${v.id}"] [data-vf="qty"]`);
        if (qi) { qi.value = String(j.newQuantity); qi.dataset.orig = qi.value; }
        render();
        toast(`✓ Received ${qty} — now ${j.newQuantity} in stock`);
      } catch (e: any) { alert(e.message); }
    }));

    // Running-average cost (managers): weighted avg paid per unit from trade-ins,
    // over a selectable timeframe.
    if (data.isManager) {
      let costEvents: Record<string, { q: number; c: number; d: string }[]> = {};
      const renderCost = () => {
        const body = document.getElementById("cost-body");
        if (!body) return;
        const tf = Number((document.getElementById("cost-tf") as HTMLSelectElement)?.value || "90");
        const cutoff = tf ? Date.now() - tf * 86400000 : 0;
        body.classList.remove("muted");
        body.innerHTML = p.variants.map((v: any) => {
          const evs = (costEvents[v.id] || []).filter((e) => !cutoff || new Date(e.d).getTime() >= cutoff);
          const units = evs.reduce((s, e) => s + e.q, 0);
          const total = evs.reduce((s, e) => s + e.c * e.q, 0);
          const avg = units ? total / units : null;
          const cur = v.costCents != null ? `<span class="muted">current ${money(v.costCents)}</span>` : "";
          const avgTxt = avg != null
            ? `<strong>${money(avg)}</strong> <span class="muted">avg · ${units} unit${units !== 1 ? "s" : ""}</span>`
            : `<span class="muted">no trade-in purchases</span>`;
          return `<div style="display:flex;justify-content:space-between;gap:1rem;padding:0.35rem 0;border-top:1px solid var(--border);font-size:0.88rem;"><span>${esc(condLabel(v))}</span><span style="text-align:right;">${avgTxt}${cur ? " · " + cur : ""}</span></div>`;
        }).join("") || `<span class="muted">No conditions.</span>`;
      };
      document.getElementById("cost-tf")?.addEventListener("change", renderCost);
      fetch("/api/pos/cost-history", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ productId: p.id }) })
        .then((r) => r.json())
        .then((j) => { if (j.ok) costEvents = j.events || {}; renderCost(); })
        .catch(() => { const b = document.getElementById("cost-body"); if (b) b.textContent = "Couldn't load cost history."; });
    }

    // Auto-fill from IGDB (cover, description) — no productId so it doesn't
    // persist; the user reviews and Saves.
    $("m-enrich").addEventListener("click", async () => {
      const title = ($("m-title") as HTMLInputElement).value.trim();
      if (!title) { alert("Enter a title first"); return; }
      toast("Looking up on IGDB…");
      try {
        const e = await enrich({ title, platform: ($("m-platform") as HTMLInputElement).value.trim() });
        if (!e.ok) throw new Error(e.error || "Lookup failed");
        if (!e.found) { toast("No IGDB match found"); return; }
        if (e.imageUrl) {
          ($("m-image") as HTMLInputElement).value = e.imageUrl;
          const prev = $("m-imgprev"); prev.innerHTML = `<img src="${e.imageUrl}" alt="">`; prev.hidden = false;
        }
        if (e.description && !($("m-desc") as HTMLTextAreaElement).value.trim()) ($("m-desc") as HTMLTextAreaElement).value = e.description;
        toast("✓ Filled from IGDB · " + e.matchedName);
      } catch (err: any) { alert(err.message); }
    });

    // Write an on-brand SEO description with the AI assistant.
    $("m-ai-desc").addEventListener("click", async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const title = ($("m-title") as HTMLInputElement).value.trim();
      if (!title) { alert("Enter a title first"); return; }
      const orig = btn.textContent;
      btn.disabled = true; btn.textContent = "✨ Writing…";
      try {
        const r = await fetch("/api/pos/ai/describe", {
          method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({ productId: btn.dataset.pid, title, platform: ($("m-platform") as HTMLInputElement).value.trim(),
            ...(rgOn ? { regionCode: (document.getElementById("m-region") as HTMLSelectElement | null)?.value || p.regionCode } : {}) }),
        });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j.error || "Failed");
        ($("m-desc") as HTMLTextAreaElement).value = j.description;
        toast("✓ Description written — review & Save");
      } catch (err: any) { alert(err.message); }
      finally { btn.disabled = false; btn.textContent = orig; }
    });

    // Image upload → stores in Supabase, fills the URL + preview.
    const imgFile = document.getElementById("m-imgfile") as HTMLInputElement | null;
    imgFile?.addEventListener("change", async () => {
      const f = imgFile.files?.[0];
      if (!f) return;
      const fd = new FormData(); fd.append("file", f);
      toast("Uploading image…");
      try {
        const r = await fetch("/api/pos/upload-image", { method: "POST", body: fd });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j.error || "Upload failed");
        ($("m-image") as HTMLInputElement).value = j.url;
        const prev = $("m-imgprev"); prev.innerHTML = `<img src="${j.url}" alt="">`; prev.hidden = false;
        toast("✓ Image uploaded");
      } catch (e: any) { alert(e.message); }
    });

    modal.hidden = false;
  }

  function condRowHtml(v: any) {
    const repriceBtn = conditionPricing
      ? `<button type="button" class="reprice-btn" data-reprice="${v.id}" title="Set this price and re‑price the other conditions">↻</button>`
      : "";
    return `
      <tr data-vrow="${v.id}">
        <td><input data-vf="comp" class="comp-combo" list="comp-list" value="${esc(complLabel(v.completenessCode))}" data-code="${esc(v.completenessCode ?? "")}" placeholder="type…" autocomplete="off"></td>
        <td><select data-vf="grade">${gradeOpts(v.gradeCode)}</select></td>
        <td><input data-vf="sku" value="${esc(v.sku ?? "")}" placeholder="SKU" style="font-family:var(--font-mono);"></td>
        <td class="c-num"><div class="price-cell"><input data-vf="instore" type="number" min="0" step="0.01" value="${(v.priceCents / 100).toFixed(2)}">${repriceBtn}</div></td>
        <td class="c-num"><input data-vf="online" type="number" min="0" step="0.01" value="${v.onlinePriceCents != null ? (v.onlinePriceCents / 100).toFixed(2) : ""}" placeholder="${(v.priceCents / 100).toFixed(2)}"></td>
        <td class="c-num"><input data-vf="qty" type="number" min="0" value="${v.quantity}" data-orig="${v.quantity}"></td>
        <td class="c-web"><input data-vf="web" type="checkbox"${v.onlineVisible ? " checked" : ""}></td>
        ${invTypes.length ? `<td><select data-vf="invtype">${typeOpts(v.inventoryTypeId)}</select></td><td><select data-vf="loc">${locOpts(v.locationId)}</select></td>` : ""}
      </tr>`;
  }

  function bcBlockHtml(v: any) {
    return `
      <div class="bc-block" data-bcv="${v.id}">
        <div class="bc-head" style="display:flex;align-items:center;gap:0.5rem;">${esc(condLabel(v))}${v.sku ? " · " + esc(v.sku) : ""}
          <button type="button" class="btn btn-ghost btn-sm" data-recvstock="${v.id}" style="margin-left:auto;" title="Receive stock onto the current entry (logs the receipt for label printing)">＋ Receive</button>
          <button type="button" class="btn btn-ghost btn-sm" data-printlabel="${v.id}" title="Print price labels for this condition">🏷 Print</button>
        </div>
        <div data-bclist>${v.barcodes.map(bcChip).join("") || `<span style="color:var(--muted-2);font-size:0.76rem;">No barcodes</span>`}</div>
        <div class="bc-add">
          <input data-bcnew placeholder="New barcode">
          <input data-bclabel placeholder="Label (e.g. Target)">
          <button class="btn btn-ghost btn-sm" data-bcadd>Add</button>
        </div>
      </div>`;
  }

  // The listing's UPC(s): one code for the game, whatever the condition.
  const UPC_SOURCE: Record<string, string> = { ebay: "eBay catalog", manual: "entered", import: "from sheet" };
  function upcStatusLine(p: any): string {
    if ((p.upcs || []).length) return "";
    const when = p.upcCheckedAt ? ` (checked ${new Date(p.upcCheckedAt).toLocaleDateString()})` : "";
    const why: Record<string, string> = {
      not_found: "eBay's catalog didn't have a sure match", ambiguous: "eBay lists more than one release that could be this one",
      conflict: "eBay's UPC is already on another listing", error: "eBay didn't answer", rejected: "a manager removed the automatic UPC",
    };
    if (p.upcStatus && why[p.upcStatus]) return `No UPC yet — ${why[p.upcStatus]}${when}. Scan the box's barcode into the field to add it.`;
    return needsUpc(p) ? "No UPC yet — it's looked up automatically, or scan the box's barcode into the field." : "No UPC — scan or type it if this item has one.";
  }
  function upcBlockHtml(p: any) {
    const chips = (p.upcs || []).map((u: any) =>
      `<span class="bc-chip" title="${esc(u.evidence || UPC_SOURCE[u.source] || "")}">${esc(u.upc)} · ${esc(UPC_SOURCE[u.source] || u.source)}${data.isManager ? ` <button data-upcdel="${u.id}" title="Remove">✕</button>` : ""}</span>`).join("");
    const line = upcStatusLine(p);
    return `
      <div class="bc-head" style="display:flex;align-items:center;gap:0.5rem;">UPC <span style="font-weight:400;font-family:var(--font-body,inherit);">· the game's code, shared by every condition</span></div>
      <div data-upclist>${chips}</div>
      ${line ? `<div class="upc-note">${esc(line)}</div>` : ""}
      <div class="bc-add">
        <input id="upc-new" inputmode="numeric" placeholder="Scan or type the UPC">
        <button class="btn btn-ghost btn-sm" type="button" id="upc-add">Add</button>
        ${!(p.upcs || []).length || data.isManager ? `<button class="btn btn-ghost btn-sm" type="button" id="upc-find" title="Look it up on eBay's product catalog">🔎 Find on eBay</button>` : ""}
      </div>`;
  }
  async function upcApi(body: any) {
    const r = await fetch("/api/pos/upc", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    const j = await r.json().catch(() => ({}));
    if (!r.ok || !j.ok) throw new Error(j.error || "UPC request failed");
    return j;
  }
  // A lookup's answer for one listing → the loaded item.
  // "Is this the same game?" — the lookup's possible matches next to this
  // listing, each with eBay's catalog photo. Picking one attaches its UPC.
  function chooseUpcCandidate(p: any, res: any): Promise<void> {
    return new Promise((done) => {
      const cands: any[] = res.candidates || [];
      const ov = document.createElement("div");
      ov.className = "upc-pick";
      ov.setAttribute("role", "dialog");
      ov.setAttribute("aria-modal", "true");
      ov.innerHTML = `<div class="upc-pick-card">
        <h3>Is this the same game?</h3>
        <p class="muted">eBay's catalog didn't match this listing exactly${res.status === "ambiguous" ? " (more than one release fits)" : ""}. Compare the covers — pick the right one, or none.</p>
        <div class="upc-pick-row upc-pick-ours">
          ${p.imageUrl ? `<img src="${esc(p.imageUrl)}" alt="" />` : `<span class="upc-pick-noimg">no cover</span>`}
          <div><span class="muted-2">This listing</span><strong>${esc(p.title)}${badge(p.regionCode)}</strong><span class="muted">${esc(p.platform || "")}</span></div>
        </div>
        ${cands.map((c, i) => `<div class="upc-pick-row">
          ${c.image ? `<img src="${esc(c.image)}" alt="" loading="lazy" />` : `<span class="upc-pick-noimg">no photo</span>`}
          <div><span class="muted-2">${esc(c.why || "Possible match")} · ${c.listings} eBay listing${c.listings === 1 ? "" : "s"}</span><strong>${esc(c.title)}</strong>
            <span class="muted">${esc(c.platform || "")} · UPC ${esc((c.upcs || []).join(", "))}</span>
            ${c.owner ? `<span class="upc-pick-warn">⚠ That UPC is already on “${esc(c.owner)}”</span>` : ""}</div>
          <button class="btn btn-primary btn-sm" type="button" data-pick="${i}"${c.owner ? " disabled" : ""}>✓ Use this</button>
        </div>`).join("")}
        <div class="upc-pick-foot"><button class="btn btn-ghost btn-sm" type="button" data-none>None of these</button></div>
      </div>`;
      let saving = false; // a pick being saved: the dialog can't close under it
      const close = () => { if (saving) return; ov.remove(); document.removeEventListener("keydown", onKey, true); done(); };
      const onKey = (e: KeyboardEvent) => {
        if (e.key === "Escape") { e.stopPropagation(); close(); }
        // Only a deliberate click picks one — a scanner's trailing Enter must not.
        else if ((e.key === "Enter" || e.key === " ") && (e.target as HTMLElement)?.matches?.("[data-pick]")) { e.preventDefault(); e.stopPropagation(); }
      };
      document.addEventListener("keydown", onKey, true);
      ov.addEventListener("click", (e) => { if (e.target === ov) close(); });
      ov.querySelector("[data-none]")!.addEventListener("click", close);
      ov.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) => b.addEventListener("click", async () => {
        if (saving) return;
        const c = cands[Number(b.dataset.pick)];
        saving = true;
        const btns = [...ov.querySelectorAll<HTMLButtonElement>("button")];
        const was = btns.map((x) => x.disabled);
        btns.forEach((x) => (x.disabled = true));
        b.textContent = "Saving…";
        try {
          const j = await upcApi({ action: "confirm", productId: p.id, upcs: c.upcs, title: c.title });
          p.upcs = j.upcs; p.upcStatus = "found";
          const skipped: string[] = j.skipped || [];
          const added = (j.upcs || []).map((u: any) => u.upc).filter((u: string) => c.upcs.includes(u));
          toast(`🏷 UPC ${added.join(", ") || "—"} added to ${rgTitle(p)}${skipped.length ? ` — skipped ${skipped.join("; ")}` : ""}`);
          saving = false; close();
        } catch (e: any) {
          saving = false;
          btns.forEach((x, k) => (x.disabled = was[k]));
          b.textContent = "✓ Use this";
          alert(e.message);
        }
      }));
      document.body.appendChild(ov);
      // Focus the safe choice: a stray Enter closes it, never attaches anything.
      (ov.querySelector("[data-none]") as HTMLElement | null)?.focus();
    });
  }
  function applyUpcResult(res: any) {
    const p = items.find((x: any) => x.id === res.id);
    if (!p) return;
    if (Array.isArray(res.upcs)) p.upcs = res.upcs;
    if (!["has", "ineligible", "skipped"].includes(res.status)) { p.upcStatus = res.status; p.upcCheckedAt = new Date().toISOString(); }
  }
  function bindUpcBlock(p: any) {
    const block = $("upc-block");
    const redraw = () => { block.innerHTML = upcBlockHtml(p); bindUpcBlock(p); render(); };
    block.querySelectorAll<HTMLElement>("[data-upcdel]").forEach((btn) => btn.addEventListener("click", async () => {
      try { const j = await upcApi({ action: "remove", id: btn.dataset.upcdel }); p.upcs = j.upcs; if (j.status) p.upcStatus = j.status; redraw(); } catch (e: any) { alert(e.message); }
    }));
    const inp = block.querySelector<HTMLInputElement>("#upc-new")!;
    const add = async () => {
      const code = inp.value.trim();
      if (!code) return;
      try { const j = await upcApi({ action: "add", productId: p.id, upc: code }); p.upcs = j.upcs; p.upcStatus = "found"; redraw(); } catch (e: any) { alert(e.message); }
    };
    block.querySelector("#upc-add")!.addEventListener("click", add);
    // Wedge scanners end with Enter.
    inp.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); add(); } });
    block.querySelector("#upc-find")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true; btn.textContent = "Looking…";
      try {
        const j = await upcApi({ action: "fill", productIds: [p.id], force: (p.upcs || []).length > 0 });
        const res = j.results?.[0];
        if (res) applyUpcResult(res);
        if (j.stopped && !res) alert(j.stopped);
        // Close but not sure (the name differs, or several releases match):
        // show them with eBay's photo and let staff pick.
        else if (res?.candidates?.length) await chooseUpcCandidate(p, res);
        else if (res && res.status !== "found" && res.status !== "has") alert(res.evidence || "No sure match on eBay.");
        redraw();
      } catch (err: any) { alert(err.message); btn.disabled = false; btn.textContent = "🔎 Find on eBay"; }
    });
  }

  function bcChip(b: any) {
    return `<span class="bc-chip">${esc(b.barcode)}${b.label ? ` · ${esc(b.label)}` : ""}${b.primary ? "" : ` <button data-bcdel="${b.id}" title="Remove">✕</button>`}</span>`;
  }

  function bindBcBlock(block: HTMLElement, p: any) {
    const vid = block.dataset.bcv!;
    const v = p.variants.find((x: any) => x.id === vid);
    const list = block.querySelector<HTMLElement>("[data-bclist]")!;
    const redraw = () => { list.innerHTML = v.barcodes.map(bcChip).join("") || `<span style="color:var(--muted-2);font-size:0.76rem;">No barcodes</span>`; bindDel(); };
    const bindDel = () => list.querySelectorAll<HTMLElement>("[data-bcdel]").forEach((btn) => btn.addEventListener("click", async () => {
      try { await api({ action: "removeBarcode", id: btn.dataset.bcdel }); v.barcodes = v.barcodes.filter((b: any) => b.id !== btn.dataset.bcdel); redraw(); } catch (e: any) { alert(e.message); }
    }));
    bindDel();
    block.querySelector("[data-bcadd]")!.addEventListener("click", async () => {
      const code = block.querySelector<HTMLInputElement>("[data-bcnew]")!.value.trim();
      const label = block.querySelector<HTMLInputElement>("[data-bclabel]")!.value.trim();
      if (!code) return;
      try {
        const j = await api({ action: "addBarcode", variantId: vid, barcode: code, label });
        v.barcodes.push({ id: j.barcode.id, barcode: j.barcode.barcode, label: j.barcode.label, primary: false });
        redraw();
        block.querySelector<HTMLInputElement>("[data-bcnew]")!.value = "";
        block.querySelector<HTMLInputElement>("[data-bclabel]")!.value = "";
      } catch (e: any) { alert(e.message); }
    });
  }
  function bindBarcodes(p: any) {
    $("bc-blocks").querySelectorAll<HTMLElement>("[data-bcv]").forEach((block) => bindBcBlock(block, p));
  }

  // Condition-pricing engine: set one condition's price, the siblings follow.
  function bindRow(row: HTMLElement, p: any) {
    const rbtn = row.querySelector<HTMLElement>("[data-reprice]");
    if (!rbtn) return;
    rbtn.addEventListener("click", async () => {
      const vid = row.dataset.vrow!;
      const v = p.variants.find((x: any) => x.id === vid);
      const f = (n: string) => row.querySelector<HTMLInputElement>(`[data-vf="${n}"]`)!;
      const comp = compVal(f("comp")), grade = f("grade").value, price = toCents(f("instore").value);
      try {
        await api({ action: "updateVariant", id: vid, priceCents: price, completenessCode: comp, gradeCode: grade });
        Object.assign(v, { priceCents: price, completenessCode: comp, gradeCode: grade });
        const j = await api({ action: "repriceProduct", variantId: vid });
        (j.updated || []).forEach((u: any) => {
          const sv = p.variants.find((x: any) => x.id === u.variant_id);
          if (sv) sv.priceCents = u.new_price_cents;
          const inp = $("cond-body").querySelector<HTMLInputElement>(`[data-vrow="${u.variant_id}"] [data-vf="instore"]`);
          if (inp) inp.value = (u.new_price_cents / 100).toFixed(2);
        });
        toast(`↻ Re‑priced ${(j.updated || []).length} condition${(j.updated || []).length === 1 ? "" : "s"}`);
      } catch (e: any) { alert(e.message); }
    });
  }
  function bindReprice(p: any) {
    $("cond-body").querySelectorAll<HTMLElement>("[data-vrow]").forEach((row) => bindRow(row, p));
  }
  // Make every completeness cell in the edit modal a typeable combobox.
  function wireModalComps() {
    $("cond-body").querySelectorAll<HTMLInputElement>('[data-vf="comp"]').forEach((inp) => {
      if (inp.dataset.wired) return;
      inp.dataset.wired = "1";
      wireComp(inp);
    });
  }
  const compVal = (inp: HTMLInputElement) => inp.dataset.code || resolveComp(inp.value, completeness);

  async function addCondition(p: any) {
    const defComp = categories.find((c) => c.id === p.categoryId)?.default_completeness || "";
    const compLabel = completeness.find((c) => c.code === defComp)?.label || "New";
    try {
      const j = await api({ action: "addVariant", productId: p.id, completenessCode: defComp, gradeCode: "3", condition: compLabel, priceCents: 0, quantity: 0 });
      const nv: any = { id: j.variant.id, condition: compLabel, completeness: null, completenessCode: defComp, gradeCode: "3", sku: null, internalCode: j.variant.internal_code || "", labelCode: j.variant.label_code || "", priceCents: 0, onlinePriceCents: null, costCents: null, quantity: 0, onlineVisible: false, inventoryTypeId: retailTypeId, locationId: "", barcodes: [] };
      p.variants.push(nv);
      $("cond-body").insertAdjacentHTML("beforeend", condRowHtml(nv));
      $("bc-blocks").insertAdjacentHTML("beforeend", bcBlockHtml(nv));
      bindRow($("cond-body").querySelector<HTMLElement>(`[data-vrow="${nv.id}"]`)!, p);
      wireModalComps();
      bindBcBlock($("bc-blocks").querySelector<HTMLElement>(`[data-bcv="${nv.id}"]`)!, p);
      toast("Condition added — set its price");
    } catch (e: any) { alert(e.message); }
  }

  $("m-save").addEventListener("click", async () => {
    const pid = modal.dataset.pid!;
    const p = items.find((x) => x.id === pid);
    const btn = $("m-save") as HTMLButtonElement;
    const get = (id: string) => ($(id) as HTMLInputElement).value;
    if (!get("m-title").trim()) { alert("Title is required"); return; }
    btn.disabled = true; const orig = btn.textContent; btn.textContent = "Saving…";
    try {
      const regionSel = document.getElementById("m-region") as HTMLSelectElement | null;
      const pj = await api({
        action: "updateProduct", id: pid,
        title: get("m-title").trim(), platform: get("m-platform").trim(), genre: get("m-genre").trim(),
        franchise: get("m-franchise").trim(), categoryId: get("m-category"), imageUrl: get("m-image").trim(),
        description: ($("m-desc") as HTMLTextAreaElement).value.trim(),
        ...(regionSel ? { regionCode: regionSel.value } : {}),
      });
      Object.assign(p, {
        title: get("m-title").trim(), platform: get("m-platform").trim(), genre: get("m-genre").trim(),
        franchise: get("m-franchise").trim(), categoryId: get("m-category"), imageUrl: get("m-image").trim(),
        description: ($("m-desc") as HTMLTextAreaElement).value.trim(),
        categoryName: categories.find((c) => c.id === get("m-category"))?.name ?? p.categoryName,
        categoryColor: categories.find((c) => c.id === get("m-category"))?.color ?? p.categoryColor,
      });
      // What the server stored: a typed "[JP]" title tag becomes the region.
      if (typeof pj.title === "string") p.title = pj.title;
      if (typeof pj.regionCode === "string") p.regionCode = pj.regionCode;
      if (pj.upcReset) { p.upcs = (p.upcs || []).filter((u: any) => u.source !== "ebay"); p.upcStatus = ""; p.upcCheckedAt = null; }

      for (const row of Array.from(document.querySelectorAll<HTMLElement>("[data-vrow]"))) {
        const vid = row.dataset.vrow!;
        const v = p.variants.find((x: any) => x.id === vid);
        const f = (name: string) => row.querySelector<HTMLInputElement>(`[data-vf="${name}"]`)!;
        const onlineRaw = f("online").value.trim();
        const comp = compVal(f("comp")), grade = f("grade").value;
        const derived = [completeness.find((c) => c.code === comp)?.label, grades.find((g) => g.code === grade)?.label].filter(Boolean).join(" ") || v.condition;
        const payload = {
          action: "updateVariant", id: vid,
          condition: derived,
          completenessCode: comp,
          gradeCode: grade,
          sku: f("sku").value.trim(),
          priceCents: toCents(f("instore").value),
          onlinePriceCents: onlineRaw === "" ? null : toCents(onlineRaw),
          // Only a count the user changed: the page's numbers can be stale
          // (sales on other stations) and must not overwrite live stock.
          ...(f("qty").value !== f("qty").dataset.orig ? { quantity: Math.max(0, Math.round(parseInt(f("qty").value)) || 0) } : {}),
          onlineVisible: f("web").checked,
          ...(invTypes.length ? { inventoryTypeId: f("invtype").value, locationId: f("loc").value || null } : {}),
        };
        await api(payload);
        Object.assign(v, {
          condition: derived, completenessCode: comp, gradeCode: grade,
          sku: f("sku").value.trim() || null, priceCents: payload.priceCents,
          onlinePriceCents: payload.onlinePriceCents, quantity: payload.quantity ?? v.quantity, onlineVisible: payload.onlineVisible,
        });
        if (invTypes.length) Object.assign(v, { inventoryTypeId: f("invtype").value, locationId: f("loc").value || "" });
      }
      render(); closeModal(); toast("✓ Saved to POS + website");
    } catch (e: any) {
      alert(e.message);
    } finally { btn.disabled = false; btn.textContent = orig; }
  });

  /* ---------- Toolbar ---------- */
  $("inv-search").addEventListener("input", (e) => {
    state.q = (e.target as HTMLInputElement).value;
    state.parsed = state.q.trim() ? parseQuery(state.q) : null;
    renderSmart();
    render();
  });
  $("inv-cat").addEventListener("change", (e) => { state.cat = (e.target as HTMLSelectElement).value; render(); });
  document.getElementById("inv-plat")?.addEventListener("change", (e) => { state.plat = (e.target as HTMLSelectElement).value; render(); });
  document.getElementById("inv-region")?.addEventListener("change", (e) => { state.region = (e.target as HTMLSelectElement).value; render(); });
  $("inv-sort").addEventListener("change", (e) => { state.sort = (e.target as HTMLSelectElement).value; render(); });
  document.querySelectorAll<HTMLElement>(".chip.filt").forEach((chip) => chip.addEventListener("click", () => {
    chip.classList.toggle("active");
    (state as any)[chip.dataset.filt!] = chip.classList.contains("active");
    render();
  }));
  // Inventory-type chips: exclusive toggle (click again to clear).
  document.querySelectorAll<HTMLElement>(".chip.tfilt").forEach((chip) => chip.addEventListener("click", () => {
    const on = !chip.classList.contains("active");
    document.querySelectorAll(".chip.tfilt").forEach((c) => c.classList.remove("active"));
    chip.classList.toggle("active", on);
    (state as any).invType = on ? chip.dataset.invtype : "";
    render();
  }));

  /* ---------- Entry DRAFTS: clean trade-in-style receiving screen ----------
     Staged lines only — nothing hits stock or the website until Finish. The
     draft autosaves on every edit and survives leaving the page (resume or
     delete it from 📥 Entries). */
  const draftsReady: boolean = !!(data as any).draftsReady;
  const sourcesReady: boolean = !!(data as any).sourcesReady;
  const receivedOnReady: boolean = !!(data as any).receivedOnReady;
  const localDate = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`; };
  let entryId = "";
  let entryHuman = 0;
  let entryMode = false;
  let entRows: any[] = []; // {itemId, variantId, title, platform, regionCode, cond, completenessCode, gradeCode, qty, costCents, priceCents, wasNew, supplier}
  const entSel = new Set<string>(); // selected draft lines (bulk actions)
  // Condition changes in flight — Finish waits for them (a Finish landing
  // mid-change would apply the line to the row it was leaving).
  let entBusy = 0;
  const entBusyStep = (d: number) => {
    entBusy = Math.max(0, entBusy + d);
    const f = $("ent-finish") as HTMLButtonElement | null;
    if (f) { f.disabled = entBusy > 0; f.title = entBusy > 0 ? "Wait — condition changes are still saving" : ""; }
  };
  const entCompOpts = (sel: string) =>
    `<option value="">—</option>` + completeness.map((c) => `<option value="${c.code}"${c.code === sel ? " selected" : ""}>${esc(c.label)}</option>`).join("");
  function entSyncSelection() {
    const all = $("ent-selall") as HTMLInputElement | null;
    if (all) { all.checked = entRows.length > 0 && entSel.size === entRows.length; all.indeterminate = entSel.size > 0 && entSel.size < entRows.length; }
    const bar = $("ent-bulk") as HTMLElement | null;
    if (bar) { bar.hidden = entSel.size === 0; $("ent-bulk-n").textContent = String(entSel.size); }
  }
  // Move a staged line to another completeness / grade (server picks or makes
  // the matching stock row on the same listing), then mirror it locally.
  async function setLineCondition(r: any, comp: string, grade: string, typeId?: string) {
    if (r.kind === "non_inventory") return;
    // The copy's CURRENT type: its stock row as loaded here (authoritative),
    // else the line's. A type change is only skipped when it truly matches.
    const before = items.flatMap(everyVariant).find((v: any) => v.id === r.variantId);
    const curType = before?.inventoryTypeId || r.inventoryTypeId || "";
    const typeChange = !!typeId && typeId !== curType;
    if ((r.completenessCode || "") === comp && (r.gradeCode || "") === grade && !typeChange) return;
    const condition = [completeness.find((c) => c.code === comp)?.label, grades.find((g) => g.code === grade)?.label].filter(Boolean).join(" ") || "Used";
    const j = await api({ action: "setEntryLineCondition", itemId: r.itemId, completenessCode: comp, gradeCode: grade, condition, ...(typeChange ? { inventoryTypeId: typeId } : {}) });
    const p: any = items.find((x) => x.id === j.productId) || items.find((x) => everyVariant(x).some((v: any) => v.id === r.variantId));
    if (!p) return;
    p.pendingVariants ||= [];
    const src = everyVariant(p).find((v: any) => v.id === r.variantId);
    // Mirror the type the SERVER used (it keeps the row's own type unless one was sent).
    const serverType: string = j.inventoryTypeId || src?.inventoryTypeId || curType || retailTypeId;
    if (j.mode === "renamed" && src) Object.assign(src, { completenessCode: comp, gradeCode: grade, condition, inventoryTypeId: serverType });
    // Mirror exactly what the server did (no SKU / web flag / cost copied from the old row).
    let dest = everyVariant(p).find((v: any) => v.id === j.variantId);
    if (!dest && (j.mode === "created" || j.mode === "moved")) {
      dest = {
        id: j.variantId, condition, completeness: null, completenessCode: comp, gradeCode: grade, sku: null,
        internalCode: j.internalCode || "", labelCode: j.labelCode || "", priceCents: j.priceCents ?? 0, onlinePriceCents: null, costCents: null,
        quantity: 0, onlineVisible: false, inventoryTypeId: serverType, locationId: src?.locationId || "", barcodes: [],
        pendingEntryId: j.mode === "created" ? entryId : "", // a row made for a draft stays hidden until Finish
      };
      (j.mode === "created" ? p.pendingVariants : p.variants).push(dest);
    }
    if (dest && j.removedVariantId) {
      // Barcodes the server moved onto the destination row.
      const have = new Set((dest.barcodes || []).map((b: any) => b.barcode));
      if (j.primaryBarcode && !have.has(j.primaryBarcode)) { dest.barcodes.unshift({ id: "primary:" + dest.id, barcode: j.primaryBarcode, label: "Primary", primary: true }); have.add(j.primaryBarcode); }
      for (const b of (src?.barcodes || [])) if (!b.primary && (j.movedBarcodes || []).includes(b.barcode) && !have.has(b.barcode)) dest.barcodes.push(b);
    }
    if (j.removedVariantId) {
      p.variants = p.variants.filter((v: any) => v.id !== j.removedVariantId);
      p.pendingVariants = p.pendingVariants.filter((v: any) => v.id !== j.removedVariantId);
    }
  }
  let entOrderTotal: number | null = null;
  let entSupplier = ""; // entry-level source (per-line placeholder default)
  if (!sourcesReady) document.querySelectorAll<HTMLElement>(".ent-src, .ent-srccol").forEach((el) => (el.style.display = "none"));
  const recvWrap = document.querySelector<HTMLElement>(".ent-recv");
  if (recvWrap) recvWrap.style.display = receivedOnReady ? "" : "none";
  try { const s = JSON.parse(sessionStorage.getItem("tl-entry") || "null"); if (s?.id) { entryId = s.id; entryHuman = s.h; } } catch {}

  function setEntryMode(on: boolean) {
    entryMode = on && !!entryId;
    ($("entry-screen") as HTMLElement).hidden = !entryMode;
    // The entry screen stands alone: no inventory list, bulk bar or deleted items under it.
    ($("inv-shell") as HTMLElement).hidden = entryMode;
    const rd = document.getElementById("rd-panel"); if (rd) rd.hidden = entryMode;
    if (entryMode) { selected.clear(); updateBulkBar(); }
    const t = $("recv-toggle");
    if (t) t.textContent = entryMode ? `📥 Entry #${entryHuman} (open)` : "▶ Start entry";
    if (entryMode) { $("ent-num").textContent = `#${entryHuman}`; renderEnt(); }
    // Any other way in / out of an entry: the Add form's note must say where
    // a non-inventory item will go NOW.
    if (!($("add-panel") as HTMLElement).hidden && npKind === "noninv") setNpKind("noninv");
  }
  function clearEntry() {
    entryId = ""; entryHuman = 0; entRows = []; entOrderTotal = null; entSel.clear();
    try { sessionStorage.removeItem("tl-entry"); } catch {}
    setEntryMode(false);
  }

  // Competitor price references per line (same links as the trade-in screen).
  const cmpLinks = (q0: string) => {
    const q = encodeURIComponent(q0 || "");
    return `<span class="ti-links">
      <a href="https://www.pricecharting.com/search-products?q=${q}&type=prices" target="_blank" rel="noopener">PriceCharting↗</a>
      <a href="https://www.ebay.com/sch/i.html?_nkw=${q}&LH_Sold=1&LH_Complete=1" target="_blank" rel="noopener">eBay sold↗</a>
      <a href="https://www.gamestop.com/search/?q=${q}" target="_blank" rel="noopener">GameStop↗</a>
    </span>`;
  };

  function entTotals() {
    const stock = entRows.filter((r) => r.kind !== "non_inventory");
    const units = stock.reduce((s, r) => s + r.qty, 0);
    const retail = stock.reduce((s, r) => s + r.priceCents * r.qty, 0);
    // Paid covers EVERYTHING bought on this entry, incl. non-inventory lines.
    const paid = entRows.reduce((s, r) => s + (r.costCents ?? 0) * r.qty, 0);
    const nonInv = entRows.length - stock.length;
    $("ent-count").textContent = String(entRows.length) + (nonInv ? ` (${nonInv} non-inventory)` : "");
    $("ent-units").textContent = String(units);
    $("ent-retail").textContent = money(retail);
    $("ent-paid").textContent = money(paid);
    const rem = $("ent-remaining") as HTMLElement;
    if (entOrderTotal == null) { rem.hidden = true; return; }
    const left = entOrderTotal - paid;
    rem.hidden = false;
    rem.className = left === 0 ? "ent-rem-ok" : left > 0 ? "ent-rem-left" : "ent-rem-over";
    rem.innerHTML = left === 0 ? `✓ fully assigned <strong>$0.00</strong>`
      : left > 0 ? `left to assign <strong>${money(left)}</strong>`
      : `over by <strong>${money(-left)}</strong>`;
  }

  // A finished entry put back to draft: its copies are still in stock (minus
  // any that sold since it was finished — those can't come back out).
  const entReopened = () => entRows.some((r) => r.stockedQty > 0);
  const stockLeft = (r: any) => Math.min(r.stockedQty || 0, r.stockedOnHand || 0);
  const soldSince = (r: any) => (r.stockedQty || 0) - stockLeft(r);
  // Mirror what the server just did to a reopened line's stock row (removed
  // line / deleted draft / Finish moved its copies) in the grid's numbers.
  const unstockLocal = (r: any) => {
    if (!r?.stockedQty || !r.stockedVariantId) return;
    const v = items.flatMap(everyVariant).find((x: any) => x.id === r.stockedVariantId);
    if (v) v.quantity = Math.max(0, (v.quantity || 0) - r.stockedQty);
  };
  const ENT_NOTE = $("ent-note")?.innerHTML ?? "";
  function renderEnt() {
    const note = $("ent-note");
    if (note) note.innerHTML = entReopened()
      ? `↩ <strong>Back in draft</strong> — this entry was finished before, so the copies marked <em>in stock</em> are still in stock (and can still be sold). Fix lines or add new ones; <strong>Finish</strong> applies only what changed. Removing a line takes its copies back out of stock.`
      : ENT_NOTE;
    const body = $("ent-body");
    body.innerHTML = entRows.length ? entRows.map((r) => r.kind === "non_inventory" ? `
      <tr data-item="${r.itemId}" class="ent-noninv">
        <td class="ent-ck"><input type="checkbox" data-esel aria-label="Select line"${entSel.has(r.itemId) ? " checked" : ""} /></td>
        <td><strong>${esc(r.title)}</strong> <span class="pill" style="font-size:0.66rem;" title="Recorded for the books (what you paid) — no stock, no label">🧾 non-inventory</span></td>
        <td colspan="${invTypes.length ? 3 : 2}" class="muted" style="font-size:0.8rem;">no stock · no label</td>
        <td class="num"><input data-ef="qty" type="number" min="1" value="${r.qty}"></td>
        <td class="num"><input data-ef="cost" type="number" min="0" step="0.01" value="${r.costCents == null ? "" : (r.costCents / 100).toFixed(2)}" placeholder="—"></td>
        <td class="num muted">—</td>
        <td></td>
        <td><button class="link-btn" data-erm title="Remove line">✕</button></td>
      </tr>` : `
      <tr data-item="${r.itemId}">
        <td class="ent-ck"><input type="checkbox" data-esel aria-label="Select line"${entSel.has(r.itemId) ? " checked" : ""} /></td>
        <td><strong>${esc(r.title)}</strong>${badge(r.regionCode)}${r.platform ? ` <span class="ti-sug-meta">${esc(r.platform)}</span>` : ""}${r.wasNew && !r.stockedQty ? ` <span class="pill cyan" style="font-size:0.66rem;">new</span>` : ""}${r.stockedQty ? ` <span class="pill" style="font-size:0.66rem;" title="Already in stock from when this entry was finished — Finish applies only changes to this line">✓ ${stockLeft(r)} in stock${soldSince(r) ? ` · ${soldSince(r)} sold` : ""}</span>` : ""}</td>
        <td><select data-ef="comp" title="Completeness — moves the copy to that condition's stock row">${entCompOpts(r.completenessCode)}</select></td>
        <td><select data-ef="grade" title="Grade (stars)">${gradeOpts(r.gradeCode)}</select></td>
        ${invTypes.length ? `<td><select data-ef="type" title="Inventory type — moves the copy to that type's stock row on the same listing">${typeOpts(r.inventoryTypeId || retailTypeId)}</select></td>` : ""}
        <td class="num"><input data-ef="qty" type="number" min="1" value="${r.qty}"></td>
        <td class="num"><input data-ef="cost" type="number" min="0" step="0.01" value="${r.costCents == null ? "" : (r.costCents / 100).toFixed(2)}" placeholder="—"></td>
        <td class="num"><input data-ef="price" type="number" min="0" step="0.01" value="${(r.priceCents / 100).toFixed(2)}"></td>
        <td>${cmpLinks([r.title, r.platform, regionTag(r.regionCode, regions)].filter(Boolean).join(" "))}</td>
        <td><button class="link-btn" data-erm title="Remove line">✕</button></td>
      </tr>`).join("") : `<tr><td colspan="${invTypes.length ? 10 : 9}" class="empty" style="padding:1rem 0.4rem;">Nothing staged yet — scan or search above to add the first item.</td></tr>`;
    // Drop selections of lines that are gone; sync the header box + bulk bar.
    for (const id of [...entSel]) if (!entRows.some((x) => x.itemId === id)) entSel.delete(id);
    entSyncSelection();

    body.querySelectorAll<HTMLElement>("tr[data-item]").forEach((tr) => {
      const r = entRows.find((x) => x.itemId === tr.dataset.item)!;
      tr.querySelector<HTMLInputElement>('[data-ef="qty"]')!.addEventListener("change", async (e) => {
        r.qty = Math.max(1, parseInt((e.target as HTMLInputElement).value) || 1);
        (e.target as HTMLInputElement).value = String(r.qty);
        entTotals();
        try { await api({ action: "updateEntryItem", itemId: r.itemId, qty: r.qty }); } catch (err: any) { alert(err.message); }
      });
      tr.querySelector<HTMLInputElement>('[data-ef="cost"]')!.addEventListener("change", async (e) => {
        const raw = (e.target as HTMLInputElement).value.trim();
        r.costCents = raw === "" ? null : toCents(raw);
        entTotals();
        try { await api({ action: "updateEntryItem", itemId: r.itemId, unitCostCents: r.costCents }); } catch (err: any) { alert(err.message); }
      });
      tr.querySelector<HTMLInputElement>('[data-ef="price"]')?.addEventListener("change", async (e) => {
        r.priceCents = toCents((e.target as HTMLInputElement).value);
        entTotals();
        // Price edits are LIVE variant edits (labels print this price).
        const lv = items.flatMap(everyVariant).find((x: any) => x.id === r.variantId);
        if (lv) lv.priceCents = r.priceCents;
        try { await api({ action: "updateVariant", id: r.variantId, priceCents: r.priceCents }); } catch (err: any) { alert(err.message); }
      });
      tr.querySelector<HTMLInputElement>("[data-esel]")!.addEventListener("change", (e) => {
        if ((e.target as HTMLInputElement).checked) entSel.add(r.itemId); else entSel.delete(r.itemId);
        entSyncSelection();
      });
      const onCond = async () => {
        const comp = tr.querySelector<HTMLSelectElement>('[data-ef="comp"]')!.value;
        const grade = tr.querySelector<HTMLSelectElement>('[data-ef="grade"]')!.value;
        tr.querySelectorAll<HTMLSelectElement>("select").forEach((x) => (x.disabled = true));
        entBusyStep(1);
        try { await setLineCondition(r, comp, grade); } catch (err: any) { alert(err.message); }
        finally { entBusyStep(-1); }
        await loadEntry(entryId); renderEnt();
      };
      tr.querySelector<HTMLSelectElement>('[data-ef="comp"]')?.addEventListener("change", onCond);
      tr.querySelector<HTMLSelectElement>('[data-ef="grade"]')?.addEventListener("change", onCond);
      tr.querySelector<HTMLSelectElement>('[data-ef="type"]')?.addEventListener("change", async (e) => {
        const typeId = (e.target as HTMLSelectElement).value;
        tr.querySelectorAll<HTMLSelectElement>("select").forEach((x) => (x.disabled = true));
        entBusyStep(1);
        try { await setLineCondition(r, r.completenessCode || "", r.gradeCode || "", typeId); } catch (err: any) { alert(err.message); }
        finally { entBusyStep(-1); }
        await loadEntry(entryId); renderEnt();
      });
      tr.querySelector("[data-erm]")!.addEventListener("click", async () => {
        if (soldSince(r)) { alert(`${rgTitle(r)}: ${soldSince(r)} of its copies sold since this entry was finished, so the line can't be removed. Lower its quantity instead.`); return; }
        if (r.stockedQty && !confirm(`Remove ${rgTitle(r)}?\n\nIts ${r.stockedQty} cop${r.stockedQty === 1 ? "y is" : "ies are"} already in stock from when this entry was finished — they come back OUT of stock.`)) return;
        entBusyStep(1); // Finish waits for the removal
        try {
          forgetDiscarded(await api({ action: "removeEntryItem", itemId: r.itemId }));
          unstockLocal(r);
          entRows = entRows.filter((x) => x.itemId !== r.itemId);
          renderEnt();
        } catch (err: any) { alert(err.message); }
        finally { entBusyStep(-1); }
      });
    });
    entTotals();
  }

  // Load a draft's lines (resume from Entries, page reload, or ?entry= link).
  async function loadEntry(id: string): Promise<boolean> {
    try {
      const j = await api({ action: "getEntry", entryId: id });
      if (j.entry?.status !== "open") return false;
      entryId = id; entryHuman = j.entry.human_id;
      entOrderTotal = j.entry.order_total_cents ?? null;
      ($("ent-ordertotal") as HTMLInputElement).value = entOrderTotal == null ? "" : (entOrderTotal / 100).toFixed(2);
      entSupplier = j.entry.supplier || "";
      const supInp = $("ent-supplier") as HTMLInputElement | null;
      if (supInp) supInp.value = entSupplier;
      const recvInp = $("ent-received") as HTMLInputElement | null;
      if (recvInp) recvInp.value = j.entry.received_on || "";
      entRows = (j.items || []).map((it: any) => {
        const v = it.variant || {}; const pr = v.product || {};
        if (it.kind === "non_inventory") {
          // Bought for the books only (bulk lot…): no stock row, no price, no label.
          return {
            itemId: it.id, variantId: null, kind: "non_inventory", qty: it.qty_added, costCents: it.unit_cost_cents,
            priceCents: 0, wasNew: false, supplier: it.supplier ?? null, title: it.description || "Non-inventory item",
            platform: "", cond: "", completenessCode: "", gradeCode: "",
          };
        }
        return {
          kind: "stock",
          itemId: it.id, variantId: v.id, qty: it.qty_added, costCents: it.unit_cost_cents,
          priceCents: v.price_cents ?? 0, wasNew: it.was_new_variant, supplier: it.supplier ?? null,
          title: pr.title ?? "?", platform: pr.platform || pr.category?.name || "", regionCode: pr.region_code ?? "",
          cond: condLabel({ completenessCode: v.completeness_code, gradeCode: v.grade_code, condition: v.condition }),
          completenessCode: v.completeness_code || "", gradeCode: v.grade_code || "", inventoryTypeId: v.inventory_type_id || "",
          // Back to draft (migration 20261004000001): copies this line already
          // put in stock, and on which stock row — Finish applies only changes.
          stockedQty: it.stocked_qty || 0, stockedVariantId: it.stocked_variant_id || "", stockedOnHand: it.stocked_on_hand ?? 0,
        };
      });
      try { sessionStorage.setItem("tl-entry", JSON.stringify({ id: entryId, h: entryHuman })); } catch {}
      return true;
    } catch { return false; }
  }

  async function ensureEntry() {
    if (entryId) return;
    const j = await api({ action: "startEntry", receivedOn: localDate() });
    entryId = j.entry.id; entryHuman = j.entry.human_id;
    try { sessionStorage.setItem("tl-entry", JSON.stringify({ id: entryId, h: entryHuman })); } catch {}
    if (j.resumed) await loadEntry(entryId);
    else { const ri = $("ent-received") as HTMLInputElement | null; if (ri) ri.value = localDate(); }
    toast(j.resumed ? `📥 Resumed draft Entry #${entryHuman}` : `📥 Started Entry #${entryHuman}`);
  }

  $("recv-toggle")?.addEventListener("click", async () => {
    if (!closeAddPanel()) return; // an open Add form goes away first (asks if something's typed)
    if (!draftsReady) { alert("Run supabase/migrations/20260801000002_entry_drafts.sql in the Supabase SQL editor first, then refresh."); return; }
    try { await ensureEntry(); setEntryMode(true); } catch (e: any) { alert(e.message); }
  });
  // Phone-as-scanner: in entry mode scans stage lines (ent-search auto-adds on
  // exact code hits); otherwise they land in the grid search.
  const scanTarget = {
    target: () => (entryMode ? $("ent-search") : $("inv-search")) as HTMLInputElement,
    page: "Inventory",
    // Same exact-identifier rules as the entry typeahead / grid search, so the
    // phone shows exactly what the station just staged or filtered to.
    describe: (code: string) => {
      const q = code.trim();
      if (!q) return null;
      const flat = (entryMode ? draftItems() : liveItems()).flatMap((p) => (entryMode ? draftVariants(p) : p.variants).map((v: any) => ({ p, v })));
      let hit = flat.find(({ v }: any) => (v.labelCode && v.labelCode === q) || (v.internalCode && v.internalCode === q.toUpperCase()));
      // A game's UPC: the station asks which condition when it has several.
      const upcP = hit ? null : (entryMode ? draftItems() : liveItems()).find((p: any) => upcsOf(p).some((u) => barcodeEq(u, q)));
      if (upcP) {
        const vs = entryMode ? draftVariants(upcP) : upcP.variants;
        if (vs.length === 1) hit = { p: upcP, v: vs[0] };
        else return `${rgTitle(upcP)}${upcP.platform ? ` (${upcP.platform})` : ""} · ${vs.length ? `${vs.length} conditions${entryMode ? " — choose on the station" : ""}` : "no stock rows yet"}`;
      }
      if (!hit) hit = flat.find(({ v }: any) => (v.barcodes || []).some((b: any) => barcodeEq(b.barcode, q)));
      if (!hit) {
        const skuExact = flat.filter(({ v }: any) => v.sku && v.sku.toUpperCase() === q.toUpperCase());
        if (skuExact.length === 1) hit = skuExact[0];
      }
      if (!hit) return null;
      return `${rgTitle(hit.p)}${hit.p.platform ? ` (${hit.p.platform})` : ""} · ${condLabel(hit.v)} · ${money(hit.v.priceCents)} · ${hit.v.quantity} in stock${entryMode ? " · staged" : ""}`;
    },
  };
  initScanReceiver(scanTarget);
  document.getElementById("phone-scan-btn")?.addEventListener("click", () => openPairDialog(scanTarget));
  $("ent-exit")?.addEventListener("click", () => {
    if (!closeAddPanel()) return; // an open Add form belongs to this entry
    const h = entryHuman;
    entryId = ""; entryHuman = 0; entRows = []; entSel.clear();
    try { sessionStorage.removeItem("tl-entry"); } catch {}
    setEntryMode(false);
    toast(`💾 Draft Entry #${h} saved — resume it from 📥 Entries`);
  });
  $("ent-delete")?.addEventListener("click", async () => {
    if (!entryId) return;
    if (!closeAddPanel()) return;
    const n = entRows.length;
    const sold = entRows.filter((r) => soldSince(r));
    if (sold.length) { alert(`This entry can't be deleted — copies of ${sold.length} line${sold.length === 1 ? "" : "s"} sold since it was finished:\n\n${sold.slice(0, 8).map((r) => `• ${rgTitle(r)} (${soldSince(r)} sold)`).join("\n")}\n\nFix the other lines and Finish instead.`); return; }
    const inStock = entRows.reduce((s, r) => s + (r.stockedQty || 0), 0);
    if (!confirm(inStock
      ? `Delete Entry #${entryHuman}?\n\nIt was finished before: its ${inStock} cop${inStock === 1 ? "y" : "ies"} still in stock come back OUT of stock, and the entry is removed.`
      : `Delete draft Entry #${entryHuman}?\n\n${n} staged line${n === 1 ? "" : "s"} will be discarded. Nothing was added to stock, so nothing else changes.`)) return;
    try {
      const gone = entryId;
      await api({ action: "deleteEntry", entryId });
      entRows.forEach(unstockLocal); // its stocked copies came back out
      // The server discarded the draft's unused hidden listings / stock rows.
      items = items.filter((p: any) => p.pendingEntryId !== gone);
      items.forEach((p: any) => { if (p.pendingVariants) p.pendingVariants = p.pendingVariants.filter((v: any) => v.pendingEntryId !== gone); });
      toast(`🗑 Draft deleted`);
      clearEntry();
    } catch (e: any) { alert(e.message); }
  });
  ($("ent-ordertotal") as HTMLInputElement)?.addEventListener("change", async (e) => {
    const raw = (e.target as HTMLInputElement).value.trim();
    entOrderTotal = raw === "" ? null : toCents(raw);
    entTotals();
    try { await api({ action: "setOrderTotal", entryId, orderTotalCents: entOrderTotal }); } catch (err: any) { alert(err.message); }
  });
  // ---- Draft line selection + bulk actions ----
  {
    const keep = `<option value="__keep">— keep —</option>`;
    const bc = $("ent-bulk-comp") as HTMLSelectElement | null, bg = $("ent-bulk-grade") as HTMLSelectElement | null;
    if (bc) bc.innerHTML = keep + completeness.map((c) => `<option value="${c.code}">${esc(c.label)}</option>`).join("");
    if (bg) bg.innerHTML = keep + grades.map((g) => `<option value="${g.code}">${esc((g.icon ? g.icon + " " : "") + g.label)}</option>`).join("");
    const bt = document.getElementById("ent-bulk-type") as HTMLSelectElement | null;
    if (bt) bt.innerHTML = keep + invTypes.map((t: any) => `<option value="${t.id}">${esc((t.icon ? t.icon + " " : "") + t.name)}</option>`).join("");
  }
  ($("ent-selall") as HTMLInputElement | null)?.addEventListener("change", (e) => {
    entSel.clear();
    if ((e.target as HTMLInputElement).checked) entRows.forEach((r) => entSel.add(r.itemId));
    renderEnt();
  });
  $("ent-bulk-clear")?.addEventListener("click", () => { entSel.clear(); renderEnt(); });
  $("ent-bulk-apply")?.addEventListener("click", async () => {
    const comp = ($("ent-bulk-comp") as HTMLSelectElement).value, grade = ($("ent-bulk-grade") as HTMLSelectElement).value;
    const type = (document.getElementById("ent-bulk-type") as HTMLSelectElement | null)?.value || "__keep";
    if (comp === "__keep" && grade === "__keep" && type === "__keep") { alert("Pick a condition, grade and/or type to apply."); return; }
    const btn = $("ent-bulk-apply") as HTMLButtonElement;
    const todo = entRows.filter((r) => entSel.has(r.itemId) && r.kind !== "non_inventory");
    if (!todo.length) { alert("None of the selected lines have a condition (non-inventory lines don't)."); return; }
    btn.disabled = true;
    entBusyStep(1);
    const errors: string[] = [];
    try {
      for (let i = 0; i < todo.length; i++) {
        btn.textContent = `Applying ${i + 1}/${todo.length}…`;
        const r = todo[i];
        try { await setLineCondition(r, comp === "__keep" ? r.completenessCode || "" : comp, grade === "__keep" ? r.gradeCode || "" : grade, type === "__keep" ? undefined : type); }
        catch (err: any) { errors.push(`${rgTitle(r)}: ${err.message}`); }
      }
    } finally { entBusyStep(-1); }
    btn.disabled = false; btn.textContent = "Apply to selected";
    entSel.clear();
    await loadEntry(entryId); renderEnt();
    if (errors.length) alert(`${errors.length} line(s) couldn't be changed:\n\n${errors.slice(0, 10).join("\n")}`);
    else toast(`✓ Updated ${todo.length} line${todo.length === 1 ? "" : "s"}`);
  });
  $("ent-bulk-rm")?.addEventListener("click", async () => {
    const todo = entRows.filter((r) => entSel.has(r.itemId));
    const inStock = todo.reduce((s, r) => s + (r.stockedQty || 0), 0);
    const sold = todo.filter((r) => soldSince(r)).length;
    if (!todo.length || !confirm(`Remove ${todo.length} line${todo.length === 1 ? "" : "s"} from this draft? ${inStock ? `(${inStock} cop${inStock === 1 ? "y is" : "ies are"} already in stock from before — they come back OUT of stock.${sold ? ` ${sold} line${sold === 1 ? "" : "s"} with copies sold since it was finished will stay.` : ""})` : "(Nothing is in stock yet, so nothing else changes.)"}`)) return;
    const btn = $("ent-bulk-rm") as HTMLButtonElement; btn.disabled = true;
    const label = btn.textContent;
    entBusyStep(1); // Finish waits — else it would add the lines still being removed
    const errors: string[] = [];
    try {
      for (let i = 0; i < todo.length; i++) {
        const r = todo[i];
        btn.textContent = `Removing ${i + 1}/${todo.length}…`;
        try { forgetDiscarded(await api({ action: "removeEntryItem", itemId: r.itemId })); unstockLocal(r); entRows = entRows.filter((x) => x.itemId !== r.itemId); }
        catch (err: any) { errors.push(`${rgTitle(r)}: ${err.message}`); }
      }
    } finally { entBusyStep(-1); btn.textContent = label; }
    btn.disabled = false; entSel.clear(); renderEnt();
    if (errors.length) alert(`${errors.length} line(s) couldn't be removed:\n\n${errors.slice(0, 10).join("\n")}`);
  });

  ($("ent-received") as HTMLInputElement)?.addEventListener("change", async (e) => {
    const inp = e.target as HTMLInputElement;
    if (!entryId || !inp.value) return;
    try { await api({ action: "setEntryReceivedOn", entryId, receivedOn: inp.value }); } catch (err: any) { alert(err.message); }
  });
  const entSupplierInp = document.getElementById("ent-supplier") as HTMLInputElement | null;
  if (entSupplierInp) fullListOnOpen(entSupplierInp);
  ($("ent-supplier") as HTMLInputElement)?.addEventListener("change", async (e) => {
    entSupplier = (e.target as HTMLInputElement).value.trim();
    renderEnt(); // refresh per-line placeholders
    if (!entryId) return;
    try { await api({ action: "setEntrySupplier", entryId, supplier: entSupplier || null }); } catch (err: any) { alert(err.message); }
  });

  // Stage a variant onto the draft (scanning the same one again bumps qty).
  async function stageVariant(p: any, v: any) {
    try {
      await ensureEntry();
      const existing = entRows.find((r) => r.variantId === v.id);
      if (existing) {
        existing.qty += 1;
        renderEnt();
        await api({ action: "updateEntryItem", itemId: existing.itemId, qty: existing.qty });
        return;
      }
      const j = await api({ action: "stageItem", entryId, variantId: v.id, qty: 1 });
      entRows.push({ itemId: j.itemId, variantId: v.id, qty: 1, costCents: null, priceCents: v.priceCents, wasNew: false, supplier: null, title: p.title, platform: p.platform || p.categoryName || "", regionCode: p.regionCode || "", cond: condLabel(v), completenessCode: v.completenessCode || "", gradeCode: v.gradeCode || "", inventoryTypeId: v.inventoryTypeId || "" });
      renderEnt();
    } catch (e: any) { alert(e.message); }
  }

  // Typeahead: suggestions are individual VARIANTS (condition + price); an
  // exact barcode / label-code match stages instantly (wedge scanners).
  const entSearch = $("ent-search") as HTMLInputElement;
  function entSuggest() {
    const box = $("ent-suggest") as HTMLElement;
    const q = entSearch.value.trim();
    if (q.length < 2) { box.hidden = true; return; }
    const flat = draftItems().flatMap((p) => draftVariants(p).map((v: any) => ({ p, v })));
    // Our printed label codes name one condition → stage it.
    const own = flat.find(({ v }: any) => (v.labelCode && v.labelCode === q) || (v.internalCode && v.internalCode === q.toUpperCase()));
    if (own) { entSearch.value = ""; box.hidden = true; stageVariant(own.p, own.v); return; }
    // The game's UPC fits every condition: one → stage it; several → ask
    // (the box stays open and unfocused, so the next scan simply replaces it).
    const upcP = draftItems().find((p: any) => upcsOf(p).some((u) => barcodeEq(u, q)));
    if (upcP) {
      const vs = draftVariants(upcP);
      if (vs.length === 1) { entSearch.value = ""; box.hidden = true; stageVariant(upcP, vs[0]); return; }
      if (vs.length > 1) {
        entSearch.value = "";
        box.innerHTML = `<div class="ti-sug-head">Which condition? — ${esc(upcP.title)}${badge(upcP.regionCode)}${upcP.platform ? ` (${esc(upcP.platform)})` : ""}</div>` + vs.map((v: any, i: number) => {
          const t = typeById.get(v.inventoryTypeId);
          return `<div class="ti-sug" data-cv="${i}">
            <span class="ti-sug-title">${esc(condLabel(v))}</span>
            <span class="ti-sug-meta">${t && t.key !== "retail" ? esc((t.icon || "") + " " + t.name) + " · " : ""}${v.quantity} in stock</span>
            <span class="ti-sug-price">${money(v.priceCents)}</span>
          </div>`;
        }).join("");
        box.hidden = false;
        box.querySelectorAll<HTMLElement>("[data-cv]").forEach((el) => el.addEventListener("mousedown", (e) => {
          e.preventDefault(); box.hidden = true; stageVariant(upcP, vs[+el.dataset.cv!]);
        }));
        return;
      }
    }
    const hit = flat.find(({ v }: any) => (v.barcodes || []).some((b: any) => barcodeEq(b.barcode, q)));
    if (hit) { entSearch.value = ""; box.hidden = true; stageVariant(hit.p, hit.v); return; }
    // A unique exact-SKU hit stages instantly too (wedge scanners send SKUs).
    const skuExact = flat.filter(({ v }: any) => v.sku && v.sku.toUpperCase() === q.toUpperCase());
    if (skuExact.length === 1) { entSearch.value = ""; box.hidden = true; stageVariant(skuExact[0].p, skuExact[0].v); return; }
    // A UPC we don't stock yet: look the game up and offer to add it.
    if (upcLike(q) && !codeOnListing(q, draftItems())) {
      box.innerHTML = `<div class="ti-sug-head">UPC ${esc(q)}</div><div class="ti-sug"><span class="ti-sug-meta">🔎 Looking it up…</span></div>`;
      box.hidden = false;
      identifyUpc(q).then((id) => {
        if (entSearch.value.trim() !== q) return; // the employee moved on
        box.innerHTML = `<div class="ti-sug-head">UPC ${esc(q)}</div><div class="ti-sug"${id.found && !id.inCatalog ? " data-upcadd" : ""}><span class="ti-sug-title">${upcFoundHtml(id)}</span>${id.found && !id.inCatalog ? `<span class="ti-sug-meta">＋ Add &amp; stage</span>` : ""}</div>`;
        box.querySelector("[data-upcadd]")?.addEventListener("mousedown", (e) => { e.preventDefault(); box.hidden = true; entSearch.value = ""; addFromUpc(id); });
      });
      return;
    }
    const parsed = parseQuery(q);
    // A typed region ("okami jp") is a filter — the US and JP copies are
    // otherwise identical rows (matchScore applies it, and steps aside when
    // the words are part of a listing's name: "European Assault").
    const matches = smartMatches(parsed, draftItems()).slice(0, 5);
    let opts = matches.flatMap((m: any) => {
      const vs = draftVariants(m.p).sort((a: any, b: any) =>
        (b.completenessCode === parsed.completenessCode ? 1 : 0) - (a.completenessCode === parsed.completenessCode ? 1 : 0));
      return vs.map((v: any) => ({ p: m.p, v }));
    }).slice(0, 8);
    // SKU-contains matches join the list (deduped) so partial SKUs find items.
    if (q.length >= 3) {
      const skuLike = flat.filter(({ p, v }: any) => v.sku && v.sku.toUpperCase().includes(q.toUpperCase()) && !opts.some((o: any) => o.v.id === v.id));
      opts = [...skuLike, ...opts].slice(0, 8);
    }
    box.innerHTML = opts.map((o: any, i: number) => `
      <div class="ti-sug" data-i="${i}">
        <span class="ti-sug-title">${esc(o.p.title)}${badge(o.p.regionCode)}</span>
        <span class="ti-sug-meta">${esc(o.p.platform || "")} · ${esc(condLabel(o.v))}</span>
        <span class="ti-sug-price">${money(o.v.priceCents)}</span>
      </div>`).join("") + `
      <div class="ti-sug" data-new><span class="ti-sug-title">＋ New product “${esc(q)}”</span><span class="ti-sug-meta">create &amp; stage</span></div>`;
    // "bulk …" / "lot of …" reads as a non-inventory purchase: offer it first.
    if (/\b(bulk|lot)\b/i.test(q)) box.innerHTML = `
      <div class="ti-sug" data-noninv><span class="ti-sug-title">🧾 Add “${esc(q)}” as non-inventory</span><span class="ti-sug-meta">recorded for the books · no stock</span></div>` + box.innerHTML;
    box.hidden = false;
    box.querySelectorAll<HTMLElement>("[data-i]").forEach((el) => el.addEventListener("mousedown", (e) => {
      e.preventDefault();
      const o = opts[+el.dataset.i!];
      box.hidden = true; entSearch.value = "";
      stageVariant(o.p, o.v);
    }));
    box.querySelector("[data-new]")?.addEventListener("mousedown", (e) => { e.preventDefault(); box.hidden = true; entNewProduct(q); });
    box.querySelector("[data-noninv]")?.addEventListener("mousedown", (e) => { e.preventDefault(); box.hidden = true; entSearch.value = ""; entAddNonInventory(q); });
    entDbSuggest(q, parsed);
  }
  // "From the game database": official titles from our LaunchBox copy, so a
  // game the store has never stocked can be added under its real name (and
  // gets its box art). Debounced; stale answers are dropped.
  let dbSeq = 0;
  function entDbSuggest(q: string, parsed: any) {
    const seq = ++dbSeq;
    const term = (parsed?.title || q).trim();
    if (term.length < 3) return;
    setTimeout(async () => {
      if (seq !== dbSeq) return;
      let games: any[] = [];
      try {
        const r = await fetch("/api/pos/game-search", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ q: term, platform: parsed?.platform || "" }) });
        games = (await r.json()).games || [];
      } catch { return; }
      const box = $("ent-suggest") as HTMLElement;
      if (seq !== dbSeq || box.hidden || entSearch.value.trim() !== q) return;
      // Skip games the store already lists on that platform in that region
      // (they're above). A pick becomes a listing in the region the query
      // named, else the home one — a JP-only "Okami" must not hide the US one.
      const dbRegion = regionOf(parsed?.regionCode, regions);
      // "Medal of Honor: European Assault": the region word is the game's NAME.
      const rgFor = (g: any) => (parsed?.regionText && nameHas({ title: g.name }, parsed.regionText) ? regionOf("", regions) : dbRegion);
      const key = (t: string, pl: string, rg: string) => `${normTitle(t)}|${(resolveStaticPlatform(pl) ?? pl ?? "").toLowerCase()}|${rg}`;
      const have = new Set(draftItems().flatMap((p: any) => [p.title, ...(p.altNames || [])].map((t: string) => key(t, p.platform || "", regionOf(p.regionCode, regions)))));
      games = games.filter((g) => !have.has(key(g.name, g.platform || "", rgFor(g)))).slice(0, 6);
      if (!games.length) return;
      box.insertAdjacentHTML("beforeend", `<div class="ti-sug-head">From the game database</div>` + games.map((g, i) => `
        <div class="ti-sug" data-db="${i}" title="Add as a new listing with its official title">
          ${g.cover ? `<img class="ti-db-cover" src="${esc(g.cover)}" alt="" loading="lazy" />` : ""}
          <span class="ti-sug-title">${esc(g.name)}${badge(rgFor(g))}</span>
          <span class="ti-sug-meta">${esc(g.platform || "")} · new listing</span>
        </div>`).join(""));
      box.querySelectorAll<HTMLElement>("[data-db]").forEach((el) => el.addEventListener("mousedown", (e) => {
        e.preventDefault();
        const g = games[+el.dataset.db!];
        box.hidden = true; entSearch.value = "";
        entNewProduct("", { title: g.name, platform: g.platform, parsed, region: rgFor(g) });
      }));
    }, 250);
  }
  // Same folding as the importer (accents, apostrophes, "&"), minus "the"/"and".
  const normTitle = (t: string) => normImport(t).replace(/\b(the|and)\b/g, " ").replace(/\s+/g, " ").trim();
  // A bulk lot / parts / supplies bought on this entry: what was paid, no stock.
  async function entAddNonInventory(desc0 = "") {
    try { await ensureEntry(); setEntryMode(true); } catch (e: any) { alert(e.message); return; }
    const desc = (prompt("Non-inventory item — describe it (e.g. “DS loose games, bulk grade B”):", desc0 || "Bulk lot") || "").trim();
    if (!desc) return;
    const rawTotal = prompt(`What did you pay in TOTAL for “${desc}” ($)? Leave empty if unknown.`, "");
    if (rawTotal === null) return;
    const total = rawTotal.trim() === "" ? null : toCents(rawTotal.replace(/[^0-9.]/g, ""));
    try { await stageNonInventory(desc, total); } catch (e: any) { alert(e.message); }
  }
  // One line at the exact total (a lot's count stays in its description) —
  // splitting $100 over 3 would record $99.99.
  async function stageNonInventory(desc: string, total: number | null) {
    const j = await api({ action: "addNonInventoryLine", entryId, description: desc, qty: 1, unitCostCents: total });
    entRows.push({ itemId: j.itemId, variantId: null, kind: "non_inventory", qty: 1, costCents: total, priceCents: 0, wasNew: false, supplier: null, title: desc, platform: "", cond: "", completenessCode: "", gradeCode: "" });
    renderEnt();
    toast(`🧾 Added “${desc}” (non-inventory)`);
  }
  // The Add panel's Non-inventory side: on the open entry, or — from the
  // inventory screen — recorded right away as its own finished entry (the way
  // a quick-added product goes straight into stock).
  $("ni-save")?.addEventListener("click", async () => {
    const desc = ($("ni-desc") as HTMLInputElement).value.trim();
    if (!desc) { alert("Describe the item (e.g. “DS bulk loose games, grade B”)."); ($("ni-desc") as HTMLInputElement).focus(); return; }
    const raw = ($("ni-total") as HTMLInputElement).value.trim();
    const total = raw === "" ? null : toCents(raw.replace(/[^0-9.]/g, ""));
    const btn = $("ni-save") as HTMLButtonElement; btn.disabled = true;
    try {
      if (entryMode && entryId) await stageNonInventory(desc, total);
      else {
        const j = await api({ action: "quickNonInventory", description: desc, totalCents: total, receivedOn: localDate() });
        toast(`🧾 Recorded “${desc}” on Entry #${j.humanId}`);
      }
      clearProductFields();
      setNpKind("stock");
      setAddOpen(false);
    } catch (e: any) { alert(e.message); }
    finally { btn.disabled = false; }
  });
  $("ent-noninv")?.addEventListener("click", () => entAddNonInventory(entSearch.value.trim()));
  entSearch?.addEventListener("input", entSuggest);
  entSearch?.addEventListener("blur", () => setTimeout(() => { ($("ent-suggest") as HTMLElement).hidden = true; }, 150));
  $("ent-new")?.addEventListener("click", () => entNewProduct(entSearch.value.trim()));
  function entNewProduct(q: string, official?: { title: string; platform: string; parsed?: any; region?: string }) {
    const parsed = q ? parseQuery(q) : official?.parsed ?? null;
    clearProductFields();
    setNpKind("stock");
    const panel = $("add-panel") as HTMLElement;
    setAddOpen(true);
    if (official) {
      // Picked from the game database (or a scanned UPC): its official name +
      // our platform name, in the region the query named (else the home one).
      ($("np-title") as HTMLInputElement).value = official.title;
      ($("np-platform") as HTMLInputElement).value = official.platform || parsed?.platform || "";
      setNpRegion(official.region || parsed?.regionCode);
    } else {
      if (parsed?.title) ($("np-title") as HTMLInputElement).value = parsed.titleForNew.replace(/\b\w/g, (c: string) => c.toUpperCase());
      if (parsed?.platform) ($("np-platform") as HTMLInputElement).value = parsed.platform;
      if (parsed) setNpRegion(parsed.regionCode);
    }
    if (parsed) { setComp($("np-comp") as HTMLInputElement, parsed.completenessCode || "", $("np-comp-abbr")); if (parsed.gradeCode) ($("np-grade") as HTMLSelectElement).value = parsed.gradeCode; }
    ($("np-qty") as HTMLInputElement).value = "1";
    panel.scrollIntoView({ behavior: "smooth", block: "center" });
    ($("np-price") as HTMLInputElement).focus();
  }

  /* ---------- Collection CSV import (PriceCharting export etc.) ----------
     Rows are matched client-side against the loaded catalog (existing
     condition → same variant; other condition → new variant on that listing;
     no listing → new product) and STAGED onto the draft in batches. Nothing
     applies to stock until Finish, exactly like typed/scanned lines. */
  const importCatalog = () => draftItems().map((p: any) => ({
    id: p.id, title: p.title, platform: p.platform || "", franchise: p.franchise || "", altNames: p.altNames || [],
    categoryId: p.categoryId, pcId: p.pcId || "", upcs: upcsOf(p),
    // The listing's region (left out before the migration → the importer
    // reads the old "[PAL]" title tag instead).
    ...(regionReady ? { regionCode: p.regionCode || "" } : {}),
    variants: draftVariants(p).map((v: any) => ({
      id: v.id, completenessCode: v.completenessCode || "", gradeCode: v.gradeCode || "", priceCents: v.priceCents || 0,
      quantity: v.quantity, barcodes: (v.barcodes || []).map((b: any) => b.barcode),
      inventoryTypeId: v.inventoryTypeId || retailTypeId || "",
    })),
  }));
  const mkImportedVariant = (res: any, p: any) => ({
    id: res.variantId, condition: p.condition, completeness: null, completenessCode: p.completenessCode, gradeCode: p.gradeCode,
    sku: null, internalCode: res.internalCode || "", labelCode: "", priceCents: p.priceCents, onlinePriceCents: null, costCents: null,
    quantity: 0, onlineVisible: false, inventoryTypeId: p.inventoryTypeId || retailTypeId, locationId: "",
    pendingEntryId: entryId, // hidden until this draft is finished
    barcodes: p.barcode ? [{ id: "primary:" + res.variantId, barcode: p.barcode, label: "Primary", primary: true }] : [],
  });
  // Every listing an import put stock on (new or existing) — the UPC lookup
  // skips ones that already have a UPC or aren't games without an eBay call.
  const touchedListings = (results: any[]) => [...new Set(results.filter((r) => r?.ok && r.productId).map((r) => String(r.productId)))];
  // Listing UPCs from eBay's catalog, a few listings per request, after covers
  // are on their way. Stops quietly if the page closes — the daily run and
  // "Fill missing UPCs" catch the rest.
  async function upcFillInBackground(ids: string[]) {
    if (!upcReady || !ids.length) return;
    let found = 0;
    for (let i = 0; i < ids.length; i += 3) {
      try {
        const r = await upcApi({ action: "fill", productIds: ids.slice(i, i + 3) });
        for (const res of r.results || []) { applyUpcResult(res); if (res.status === "found") found++; }
        if (r.stopped) break;
      } catch { break; }
    }
    render();
    if (found) toast(`🏷 UPCs attached for ${found} listing${found === 1 ? "" : "s"}`);
  }
  document.getElementById("fill-upcs")?.addEventListener("click", async () => {
    const btn = document.getElementById("fill-upcs") as HTMLButtonElement;
    const orig = btn.textContent;
    btn.disabled = true; btn.textContent = "Checking…";
    try {
      const todo: any[] = (await upcApi({ action: "missing" })).items || [];
      if (!todo.length) { toast("Every game that can get a UPC automatically has one (or was checked today)"); return; }
      if (!confirm(`Look up UPCs on eBay's product catalog for ${todo.length} game${todo.length === 1 ? "" : "s"}? Only sure matches are attached; the rest stay under "Needs UPC". Takes about ${Math.max(1, Math.round(todo.length * 3 / 60))} min — keep this tab open.`)) return;
      const tally = { found: 0, none: 0, unsure: 0, review: 0 };
      for (let i = 0; i < todo.length; i += 3) {
        btn.textContent = `UPCs ${Math.min(i + 3, todo.length)}/${todo.length}…`;
        const r = await upcApi({ action: "fill", productIds: todo.slice(i, i + 3).map((x) => x.id) });
        for (const res of r.results || []) {
          applyUpcResult(res);
          if (res.status === "found") tally.found++;
          else if (res.candidates?.length) tally.review++;
          else if (res.status === "not_found") tally.none++;
          else if (res.status === "ambiguous" || res.status === "conflict") tally.unsure++;
        }
        render();
        if (r.stopped) { alert(r.stopped); break; }
      }
      toast(`🏷 UPCs: ${tally.found} attached · ${tally.none} not on eBay · ${tally.unsure} unsure${tally.review ? ` · ${tally.review} with a possible match to confirm (open the listing → 🔎 Find on eBay)` : ""} — see "Needs UPC"`);
    } catch (e: any) { alert(e.message); }
    finally { btn.disabled = false; btn.textContent = orig; }
  });
  async function enrichInBackground(list: any[]) {
    let done = 0, added = 0; const CONC = 3;
    for (let i = 0; i < list.length; i += CONC) {
      await Promise.all(list.slice(i, i + CONC).map(async (p) => {
        try {
          const e = await enrich({ productId: p.id, title: p.title, platform: p.platform });
          if (e.ok && e.found) { if (e.imageUrl) { p.imageUrl = e.imageUrl; added++; } if (e.altNames?.length) p.altNames = e.altNames; if (e.description) p.description = e.description; }
        } catch {}
        done++;
      }));
      toast(`🎮 Fetching covers ${done}/${list.length}…`);
    }
    render();
    toast(`🎮 Covers added for ${added} of ${list.length} new listing${list.length === 1 ? "" : "s"}`);
  }
  async function openCollectionImport() {
    if (!closeAddPanel()) return; // the import opens a draft — the Add form can't straddle it
    if (!draftsReady) { alert("Run supabase/migrations/20260801000002_entry_drafts.sql in the Supabase SQL editor first, then refresh."); return; }
    try { await ensureEntry(); setEntryMode(true); } catch (e: any) { alert(e.message); return; }
    openImportDialog({
      mode: "entry", catalog: importCatalog(), completeness, grades, platforms: PLATFORMS, categories, invTypes, regions,
      onImport: async (rows, ch, progress) => {
        const condText = (r: any) => [completeness.find((c) => c.code === r.row.completenessCode)?.label, grades.find((g) => g.code === r.row.gradeCode)?.label].filter(Boolean).join(" ") || "Used";
        const priceOf = (r: any) => (r.row.priceCents == null ? 0 : importPrice(r.row.priceCents, ch));
        // A brand-new game with several conditions in the sheet (Loose + CIB)
        // is ONE listing: the first row creates it (ref), the rest become new
        // conditions on it (productRef). The server resolves refs within a
        // batch; later batches get the real id from earlier results.
        const firstOfGroup = new Set<string>();
        // Import key = the file NAME + the row's CONTENTS (+ folder, + which
        // occurrence of that content). Retrying — or re-importing an edited copy
        // of the same sheet — replays rows already on the draft instead of
        // doubling them; only identical rows of a same-named file can collide,
        // and those are listed back to the employee after the import.
        const h32 = (str: string, seed: number) => { let h = seed >>> 0; for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; } return h.toString(16).padStart(8, "0"); };
        const fileTag = h32(ch.fileName || "sheet", 2166136261);
        const seenPrints = new Map<string, number>();
        const keyFor = (r: any) => {
          // Not the qty: the server keys each COPY (<key>#1, #2, …), so an edited
          // sheet that goes from 1 to 2 copies adds exactly one.
          // The SHEET's title (not the corrected one), so a re-import of the same
          // sheet replays whether or not the correction ran this time. The
          // region keeps a US and a PAL row of one game apart (titles are bare).
          const fp = [(r.row.titleFrom ?? r.row.title).toLowerCase().trim(), (r.row.platform || "").toLowerCase(), r.row.completenessCode, r.row.gradeCode, ch.inventoryTypeId || "", r.row.folder || "", r.row.region || ""].join("|");
          const occ = (seenPrints.get(fp) || 0) + 1; seenPrints.set(fp, occ);
          return `${fileTag}:${h32(fp, 2166136261)}${h32(fp, 5381)}:${occ}`;
        };
        const payload = rows.map((r: any) => {
          const base = {
            // A PriceCharting id is per release: never tag a PAL row's id onto
            // the US listing it was mapped to.
            qty: r.row.qty, costCents: r.row.costCents, tagPcId: r.row.pcId && !(r.product && (r.product.pcId || listingRegion(r.product) !== regionOf(r.row.region, regions))) ? r.row.pcId : undefined,
            importKey: keyFor(r),
          };
          // Bulk lot etc.: recorded on the entry (what was paid) — no listing, no stock.
          // One line at the sheet's total (cost × qty) so the books match what was paid.
          if (r.nonInventory) return { kind: "nonInventory", description: `${displayTitle(r.row.title, r.row.region, regions)}${r.row.platform ? ` (${r.row.platform})` : ""}${r.row.qty > 1 ? ` ×${r.row.qty}` : ""}`, ...base, qty: 1, costCents: r.row.costCents == null ? null : r.row.costCents * r.row.qty };
          if (r.product && r.variant) return { kind: "variant", variantId: r.variant.id, productId: r.product.id, ...base };
          const v = { completenessCode: r.row.completenessCode, gradeCode: r.row.gradeCode, condition: condText(r), priceCents: priceOf(r), barcode: r.row.upc || null, inventoryTypeId: ch.inventoryTypeId || undefined };
          if (r.product) return { kind: "newVariant", productId: r.product.id, ...v, ...base };
          const g = newListingKey(r.row);
          // title/platform let the server find the listing if its ref row was staged in an earlier attempt.
          if (firstOfGroup.has(g)) return { kind: "newVariant", productRef: g, title: r.row.title, platform: r.row.platform, regionCode: r.row.region, ...v, ...base };
          firstOfGroup.add(g);
          // A corrected title keeps the sheet's spelling as a search name.
          return { kind: "newProduct", ref: g, title: r.row.title, platform: r.row.platform, regionCode: r.row.region, categoryId: r.categoryId || ch.categoryId, altNames: r.row.titleFrom ? [r.row.titleFrom] : undefined, ...v, ...base };
        });
        let staged: { results: any[]; newProducts: any[] };
        try { staged = await stageOntoDraft(rows, payload, progress, `“${ch.fileName}”`); }
        catch (e: any) {
          // Covers + UPCs for what DID get created before the failure.
          if (e?.staged?.newProducts?.length) enrichInBackground(e.staged.newProducts);
          if (e?.staged) upcFillInBackground(touchedListings(e.staged.results));
          throw e;
        }
        if (staged.newProducts.length) enrichInBackground(staged.newProducts);
        upcFillInBackground(touchedListings(staged.results));
      },
    });
  }

  /* Stage built import rows onto the open draft in small batches (shared by the
     collection CSV import and the eBay store import). `payload[i]` is the
     importStage row for `rows[i]`. Rows that land are marked skipped so a retry
     only re-sends the rest. Mirrors new listings / stock rows into the loaded
     catalog, reloads the draft, and reports failed / replayed rows. On a failed
     batch it throws, with `.staged` = what made it. */
  async function stageOntoDraft(rows: any[], payload: any[], progress: (m: string) => void, sourceName: string): Promise<{ results: any[]; newProducts: any[] }> {
    const newProducts: any[] = [];
    const refToProduct = new Map<string, string>();
    const results: any[] = [];
    // Small batches: each new-listing row is ~7 database round trips, and
    // a batch must finish well inside the serverless time limit.
    const STEP = 10;
    // Does the server have replay protection (migration 20260929000001)?
    // Decides what we can promise the employee if a batch fails.
    const idempotent = !!(await api({ action: "importStage", entryId, rows: [] }).catch(() => ({}))).idempotent;
    try {
      for (let i = 0; i < payload.length; i += STEP) {
        progress(`Staging ${Math.min(i + STEP, payload.length)} / ${payload.length}…`);
        const batch = payload.slice(i, i + STEP).map((p: any) => (p.productRef && refToProduct.has(p.productRef) ? { ...p, productId: refToProduct.get(p.productRef) } : p));
        const j = await api({ action: "importStage", entryId, rows: batch });
        results.push(...(j.results || []));
        batch.forEach((p: any, k: number) => { if (p.ref && j.results?.[k]?.ok) refToProduct.set(p.ref, j.results[k].productId); });
        // Staged → never re-sent if a later batch fails and the employee retries.
        rows.slice(i, i + STEP).forEach((r: any, k: number) => { if (j.results?.[k]?.ok) r.skip = true; });
      }
    } catch (e) {
      if (results.length) { mirrorImported(); await loadEntry(entryId); setEntryMode(true); render(); }
      const err: any = new Error(`${(e as any)?.message || "A batch failed"}. ${idempotent
        ? "Press Import again: rows that already made it onto the draft are recognized and won't be added twice."
        : "Rows from the failed batch MAY already be on the draft (look before pressing Import again, or apply migration 20260929000001 for automatic protection)."}`);
      err.staged = { results, newProducts };
      throw err;
    }
    mirrorImported();
    function mirrorImported() {
      // Mirror new listings/conditions into the loaded catalog so the
      // typeahead (and a second import of the same sheet) sees them.
      results.forEach((res, i) => {
        if (!res?.ok) return;
        const r: any = rows[i]; const p: any = payload[i];
        if (res.newProduct) {
          if (items.some((x) => x.id === res.productId)) return; // replayed row, already mirrored
          const cat = categories.find((c: any) => c.id === p.categoryId);
          const np: any = {
            id: res.productId, title: r.row.title, slug: res.slug || r.row.title.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, ""),
            platform: r.row.platform, regionCode: regionReady ? r.row.region || "" : "", franchise: "", genre: "", description: "", imageUrl: "", altNames: p.altNames || [], categoryId: p.categoryId,
            categoryName: cat?.name ?? "", categoryColor: cat?.color ?? "#2ce6e0", ebayId: p.tagEbayId || "", pcId: r.row.pcId || "", supplierLinks: [],
            // Hidden from the grid until this draft is finished.
            pendingEntryId: entryId, variants: [], pendingVariants: [mkImportedVariant(res, p)],
          };
          items.push(np); newProducts.push(np);
        } else {
          const lp = items.find((x) => x.id === res.productId);
          // Only a row that CREATED the condition carries its fields — and a
          // replay of one the grid already shows must not add it twice.
          if (lp && res.newVariant && p.kind !== "variant" && !everyVariant(lp).some((x: any) => x.id === res.variantId)) (lp.pendingVariants ||= []).push(mkImportedVariant(res, p));
          if (lp && p.tagPcId) lp.pcId = p.tagPcId;
          if (lp && p.tagEbayId && !lp.ebayId) lp.ebayId = p.tagEbayId;
        }
      });
    }
    const rowTitle = (i: number) => displayTitle(rows[i].row.title, rows[i].row.region, regions);
    const failed = results.map((res, i) => (res?.ok ? null : `Row ${rows[i].row.n} “${rowTitle(i)}”: ${res?.error || "failed"}`)).filter(Boolean);
    const replayed = results.map((res, i) => (res?.replay ? `Row ${rows[i].row.n} “${rowTitle(i)}”`
      : res?.already ? `Row ${rows[i].row.n} “${rowTitle(i)}”: ${res.already} of ${rows[i].row.qty} copies (the rest were added)` : null)).filter(Boolean);
    progress("Loading the draft…");
    await loadEntry(entryId);
    setEntryMode(true);
    render();
    const okN = results.filter((r) => r?.ok).length;
    const replayN = results.filter((r) => r?.replay).length;
    toast(`📄 Imported ${okN} line${okN === 1 ? "" : "s"} → Entry #${entryHuman}${replayN ? ` (${replayN} were already on this draft — not added again)` : ""}`);
    if (failed.length) alert(`${failed.length} row(s) didn't import:\n\n${failed.slice(0, 15).join("\n")}${failed.length > 15 ? "\n…" : ""}`);
    // Rows recognized as already on this draft (a retry, or the same sheet
    // again) — say which, so a genuinely new identical row can be added by hand.
    if (replayed.length) alert(`${replayed.length} row(s) were already on this draft from an earlier import of ${sourceName}, so they weren't added again:\n\n${replayed.slice(0, 15).join("\n")}${replayed.length > 15 ? "\n…" : ""}\n\nIf any of these is a SECOND copy, raise its qty on the draft.`);
    return { results, newProducts };
  }
