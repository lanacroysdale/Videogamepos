  .upc-pick-noimg { display:flex; align-items:center; justify-content:center; font-size:0.7rem; color:#777; }
  .upc-pick-row > div { flex:1; min-width:0; display:flex; flex-direction:column; gap:0.15rem; font-size:0.84rem; }
