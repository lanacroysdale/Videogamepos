  .upc-pick-card { width:min(36rem, 100%); max-height:90vh; overflow:auto; background:var(--panel); border:1px solid var(--border-strong); padding:1.1rem; box-shadow:0 12px 40px rgba(0,0,0,.5); }
  .upc-pick-card h3 { margin:0 0 0.3rem; font-size:1.1rem; }
