      condition, completenessCode: comp, gradeCode: grade,
      priceCents: Math.round(parseFloat(($("np-price") as HTMLInputElement).value) * 100) || 0,
      quantity: parseInt(($("np-qty") as HTMLInputElement).value) || (entryMode ? 1 : 0),
      barcode: ($("np-barcode") as HTMLInputElement).value || null,
      inventoryTypeId: (document.getElementById("np-invtype") as HTMLSelectElement | null)?.value || undefined,
      // In entry mode the qty is STAGED on the draft (variant starts at 0).
      ...(entryMode && entryId ? { stageEntryId: entryId } : {}),
    };
    if (!body.title || !body.categoryId) { alert("Title and category required"); return; }
    try {
      const j = await api(body);
      const cat = categories.find((c: any) => c.id === body.categoryId);
      // Title / platform / region as STORED (a "PAL …" platform prefix or a
      // typed "[JP]" tag becomes the region).
      const newItem: any = { id: j.productId, title: j.title ?? body.title, slug: j.slug || body.title.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, ""), platform: j.platform ?? body.platform, regionCode: j.regionCode ?? "", franchise: "", genre: "", description: "", imageUrl: "", altNames: [], categoryId: body.categoryId, categoryName: cat?.name ?? "", categoryColor: cat?.color ?? "#2ce6e0",
        variants: [{ id: j.variantId, condition, completeness: null, completenessCode: comp, gradeCode: grade, sku: null, internalCode: j.internalCode || "", labelCode: j.labelCode || "", priceCents: body.priceCents, onlinePriceCents: null, costCents: null, quantity: body.quantity, onlineVisible: false, inventoryTypeId: body.inventoryTypeId || retailTypeId, locationId: "", barcodes: body.barcode ? [{ id: "primary:" + j.variantId, barcode: body.barcode, label: "Primary", primary: true }] : [] }] };
      items.push(newItem);
      if (entryMode && j.itemId) {
        // Staged: server created the variant at qty 0; the qty lands on Finish.
        newItem.variants[0].quantity = 0;
        entRows.push({
          itemId: j.itemId, variantId: j.variantId, qty: body.quantity || 1, costCents: null,
          priceCents: body.priceCents, wasNew: true, supplier: null, title: newItem.title,
          platform: newItem.platform || newItem.categoryName || "", regionCode: newItem.regionCode, cond: condLabel(newItem.variants[0]),
          completenessCode: comp || "", gradeCode: grade || "", kind: "stock",
          inventoryTypeId: newItem.variants[0].inventoryTypeId || body.inventoryTypeId || retailTypeId,
        });
        // A listing made on the draft screen is hidden until the draft is finished.
        newItem.pendingEntryId = entryId;
        newItem.pendingVariants = newItem.variants.map((v: any) => ({ ...v, pendingEntryId: entryId }));
        newItem.variants = [];
        renderEnt();
        ($("ent-search") as HTMLInputElement).value = "";
      }
      setAddOpen(false);
      const ebayAfter = pendingEbay; // the eBay attach below still needs it
      clearProductFields();
      pendingEbay = ebayAfter;
      ($("inv-search") as HTMLInputElement).value = ""; state.q = ""; state.parsed = null; renderSmart();
      render();
      if (pendingEbay) {
        // Sell Similar: the listing's cover photo + item specifics it doesn't
        // have (a reference tag — never synced). A game then also gets the
        // game database's description / trailer / names (empty fields only).
        toast("✓ Product added — copying the eBay photo…");
        const pe = pendingEbay;
        try {
          const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" },
            body: JSON.stringify({ mode: "attach", productId: newItem.id, variantId: j.variantId, input: pe.input }) });
          const e = await r.json();
          if (r.ok && e.ok) {
            if (e.imageUrl) newItem.imageUrl = e.imageUrl;
            for (const k of ["franchise", "genre", "brand"]) if (e.fields?.[k]) newItem[k] = e.fields[k];
            if (String(e.tag || "").startsWith("ebay:")) newItem.ebayId = String(e.tag).slice(5);
            render();
            toast(e.imageUrl ? "🛒 Added with the eBay photo" : "✓ Added from eBay");
          } else { toast("✓ Added (eBay photo failed: " + (e.error || "?") + ")"); }
        } catch { toast("✓ Product added"); }
        if (pe.group === "games") {
          try {
            const g = await enrich({ productId: newItem.id, title: newItem.title, platform: newItem.platform });
            if (g.ok && g.found) {
              if (g.altNames?.length) newItem.altNames = g.altNames;
              if (g.description && !newItem.description) newItem.description = g.description;
              render();
            }
          } catch { /* the eBay photo + details are already on */ }
        }
        pendingEbay = null;
        ($("np-ebay") as HTMLInputElement).value = "";
        ($("np-ebay-note") as HTMLElement).hidden = true;
      } else {
        toast("✓ Product added — fetching cover…");
        // Auto-enrich from IGDB: cover art, description, trailer, alt-names.
        try {
          const e = await enrich({ productId: newItem.id, title: newItem.title, platform: newItem.platform });
          if (e.ok && e.found) {
            if (e.imageUrl) newItem.imageUrl = e.imageUrl;
            if (e.altNames?.length) newItem.altNames = e.altNames;
            if (e.description) newItem.description = e.description;
            render();
            toast(e.imageUrl ? "🎮 Cover added from IGDB" : "✓ Details added from IGDB");
          } else { toast("✓ Product added"); }
        } catch { toast("✓ Product added"); }
      }
      // Its UPC (the one typed/scanned into Barcode counts; else eBay's catalog).
      upcFillInBackground([newItem.id]);
    } catch (e: any) { alert(e.message); }
  });

  /* ---------- eBay import ---------- */
  let pendingEbay: any = null;

  // Paste a listing → pull its data into the add form for review.
  $("np-ebay-go")?.addEventListener("click", async () => {
    const input = ($("np-ebay") as HTMLInputElement).value.trim();
    if (!input) { alert("Paste an eBay item number or listing URL first"); return; }
    const btn = $("np-ebay-go") as HTMLButtonElement; btn.disabled = true; const o = btn.textContent; btn.textContent = "Pulling…";
    try {
      const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ mode: "preview", input }) });
      const j = await r.json();
      if (!r.ok || !j.ok) throw new Error(j.error || "Couldn't pull that listing");
      const it = j.item;
      // Sell Similar suggestions (the store importer's title / platform / region /
      // category rules) — else the listing's raw fields.
      const sim = j.similar || {};
      ($("np-title") as HTMLInputElement).value = sim.title || it.title;
      ($("np-platform") as HTMLInputElement).value = sim.platform ?? it.platform ?? "";
      setNpRegion(sim.region || it.region); // "" = home
      setComp($("np-comp") as HTMLInputElement, sim.completenessCode || it.completenessCode || "", $("np-comp-abbr"));
      const grade = sim.gradeCode || it.gradeCode;
      if (grade) ($("np-grade") as HTMLSelectElement).value = grade;
      ($("np-price") as HTMLInputElement).value = (it.priceCents / 100).toFixed(2);
      const code = sim.barcode || it.upc;
      ($("np-barcode") as HTMLInputElement).value = code || "";
      const sel = $("np-cat") as HTMLSelectElement;
      const opt = [...sel.options].find((op) => op.value === sim.categoryId)
        || [...sel.options].find((op) => op.textContent?.toLowerCase() === String(it.categoryName).toLowerCase());
      if (opt) sel.value = opt.value;
      pendingEbay = { input, group: sim.group || "", own: !!sim.ownListing };
      const meta = [sim.franchise && `series: ${sim.franchise}`, sim.character && `character: ${sim.character}`, sim.brand && `brand: ${sim.brand}`, sim.releaseYear && `year: ${sim.releaseYear}`].filter(Boolean).join(" · ");
      const note = $("np-ebay-note") as HTMLElement; note.hidden = false;
      note.innerHTML = `${it.primaryImage ? `<img src="${esc(it.primaryImage)}" alt="" style="width:46px;height:46px;object-fit:cover;border:1px solid var(--line);">` : ""}<div><strong>✓ Filled from eBay</strong> · ${esc(it.conditionLabel || "—")} · their price ${money(it.priceCents)}${code ? " · UPC/EAN " + esc(code) : ""}${sim.japan ? " · 🇯🇵 Japan item" : ""}${sim.ownListing ? " · <em>your own listing</em>" : sim.seller ? ` · seller ${esc(sim.seller)}` : ""}<br><span style="color:var(--muted-2);">${esc(it.title.slice(0, 90))}</span>${meta ? `<br><span style="color:var(--muted-2);">On Save: cover photo + ${esc(meta)}</span>` : `<br><span style="color:var(--muted-2);">On Save: cover photo</span>`}${(sim.warnings || []).length ? `<br><span style="color:var(--magenta);">⚠ ${esc(sim.warnings.join(" · "))}</span>` : ""}</div>`;
      toast("✓ Filled from eBay — check it & Save");
    } catch (e: any) { alert(e.message); } finally { btn.disabled = false; btn.textContent = o; }
  });

  // Manager-only: pull stock down from eBay — listings that ended or sold out
  // on eBay get zeroed + hidden on the website. Never raises local stock.
  document.getElementById("ebay-sync")?.addEventListener("click", async () => {
    const btn = document.getElementById("ebay-sync") as HTMLButtonElement; btn.disabled = true; const o = btn.textContent; btn.textContent = "Syncing…";
    try {
      const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ mode: "sync" }) });
      const j = await r.json();
      if (!r.ok || !j.ok) throw new Error(j.error || "Sync failed");
      toast(`✓ eBay sync — ${j.checked} checked · ${j.zeroed} sold/out → zeroed · ${j.inStock} in stock${j.errors ? ` · ${j.errors} skipped` : ""}`);
      if (j.zeroed) setTimeout(() => location.reload(), 1700);
    } catch (e: any) { alert(e.message); } finally { btn.disabled = false; btn.textContent = o; }
  });

  // Manager-only: the eBay store importer. Pick listings (filters, expo price
  // rule, photo count) → they're staged onto the open draft like a CSV import
  // (matched to existing listings, own eBay stock row) → Finish prints labels.
  // Photos + item specifics copy over in the background afterwards.
  async function openEbayStoreImport() {
    if (!closeAddPanel()) return; // the import opens a draft — the Add form can't straddle it
    if (!draftsReady) { alert("Run supabase/migrations/20260801000002_entry_drafts.sql in the Supabase SQL editor first, then refresh."); return; }
    try { await ensureEntry(); setEntryMode(true); } catch (e: any) { alert(e.message); return; }
    openEbayImportDialog({
      catalog: importCatalog(), completeness, grades, platforms: PLATFORMS, categories, invTypes, regions,
      createCategory: async (name) => {
        const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ mode: "ensure-category", name }) });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j.error || "Couldn't create the category");
        if (!categories.some((c: any) => c.id === j.category.id)) categories.push({ ...j.category, default_completeness: null });
        return j.category;
      },
      onImport: async (rows, ch, progress) => {
        const condText = (r: any) => [completeness.find((c) => c.code === r.row.completenessCode)?.label, grades.find((g) => g.code === r.row.gradeCode)?.label].filter(Boolean).join(" ") || "Used";
        // Two eBay listings of one game (same platform + region) → ONE new
        // listing: the first creates it (ref), the next goes on it (productRef).
        const firstOfGroup = new Set<string>();
        const payload = rows.map((r: any) => {
          // One import key per eBay listing (the server keys each copy #1, #2…):
          // a retry, or the same listing picked again, replays instead of doubling.
          const base = { qty: r.row.qty, costCents: null, importKey: `ebay:${r.row.ebay.id}`, tagEbayId: r.row.ebay.id };
          if (r.product && r.variant) return { kind: "variant", variantId: r.variant.id, productId: r.product.id, ...base };
          // The seller-typed UPC isn't trusted for the listing — the UPC lookup
          // (eBay's catalog) runs after the import instead.
          const v = { completenessCode: r.row.completenessCode, gradeCode: r.row.gradeCode, condition: condText(r), priceCents: r.row.priceCents ?? 0, barcode: null, inventoryTypeId: ch.inventoryTypeId || undefined };
          if (r.product) return { kind: "newVariant", productId: r.product.id, ...v, ...base };
          const g = newListingKey(r.row);
          if (firstOfGroup.has(g)) return { kind: "newVariant", productRef: g, title: r.row.title, platform: r.row.platform, regionCode: r.row.region, ...v, ...base };
          firstOfGroup.add(g);
          return { kind: "newProduct", ref: g, title: r.row.title, platform: r.row.platform, regionCode: r.row.region, categoryId: r.categoryId, ...v, ...base };
        });
        let staged: { results: any[]; newProducts: any[] };
        try { staged = await stageOntoDraft(rows, payload, progress, "your eBay store"); }
        catch (e: any) {
          if (e?.staged) { ebayMediaInBackground(ebayJobs(rows, e.staged.results), ch.galleryMax); upcFillInBackground(touchedListings(e.staged.results)); }
          throw e;
        }
        ebayMediaInBackground(ebayJobs(rows, staged.results), ch.galleryMax);
        upcFillInBackground(touchedListings(staged.results));
      },
    });
  }
  // One photo/details job per listing the import put stock on (a 2nd eBay
  // copy of the same listing is already tagged by the import itself).
  const ebayJobs = (rows: any[], results: any[]) => {
    const seen = new Set<string>();
    const jobs: { productId: string; legacyItemId: string }[] = [];
    results.forEach((res, i) => {
      if (!res?.ok || !res.productId || seen.has(res.productId) || !rows[i]?.row?.ebay?.id) return;
      seen.add(res.productId);
      jobs.push({ productId: String(res.productId), legacyItemId: String(rows[i].row.ebay.id) });
    });
    return jobs;
  };
  // Copy each listing's eBay photos (cover, + gallery when more than 1) and
  // item specifics (brand, year, franchise / series, genre, character) — only
  // what the listing is missing. A few at a time; if the tab closes, "📷 Fill
  // from eBay" picks up the rest.
  async function ebayMediaInBackground(jobs: { productId: string; legacyItemId: string }[], galleryMax: number) {
    if (!jobs.length) return;
    let done = 0, failed = 0;
    const CONC = 3;
    for (let i = 0; i < jobs.length; i += CONC) {
      await Promise.all(jobs.slice(i, i + CONC).map(async (job) => {
        try {
          const r = await fetch("/api/pos/ebay-import", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ mode: "media", ...job, galleryMax }) });
          const j = await r.json();
          if (!r.ok || !j.ok) { failed++; return; }
          const p = items.find((x: any) => x.id === job.productId);
          if (p && j.imageUrl && !p.imageUrl) p.imageUrl = j.imageUrl;
          if (p && !p.ebayId) p.ebayId = job.legacyItemId;
          if (p && j.fields) for (const k of ["description", "franchise", "genre", "brand"]) if (j.fields[k] && !p[k]) p[k] = j.fields[k];
        } catch { failed++; } finally { done++; }
      }));
      toast(`📷 Copying eBay photos & details ${done}/${jobs.length}…`);
    }
    render();
    toast(`📷 eBay photos & details: ${done - failed} listing${done - failed === 1 ? "" : "s"}${failed ? ` · ${failed} failed (📷 Fill from eBay retries)` : ""}`);
  }
  document.getElementById("ebay-bulk")?.addEventListener("click", openEbayStoreImport);
  document.getElementById("ebay-media")?.addEventListener("click", async () => {
    const todo = items.filter((p: any) => p.ebayId && (!p.imageUrl || !p.franchise));
    if (!todo.length) { toast("✓ Every eBay listing has a photo and details"); return; }
    const photos = Number((() => { try { return localStorage.getItem("tl-ebay-photos"); } catch { return null; } })()) || 1;
    if (!confirm(`Copy photos and details from eBay for ${todo.length} listing${todo.length === 1 ? "" : "s"} missing them? Only empty fields are filled (${photos === 1 ? "cover photo only" : `up to ${photos} photos`}). Keep this tab open.`)) return;
    ebayMediaInBackground(todo.map((p: any) => ({ productId: p.id, legacyItemId: p.ebayId })), photos);
  });

  render();
</script>
