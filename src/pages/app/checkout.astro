---
export const prerender = false;

import AppLayout from "../../layouts/AppLayout.astro";
import { themeSettings } from "../../lib/themeSettings";
import { loadPosCatalog } from "../../lib/posCatalog";
import { loadRegions, regionsOn } from "../../lib/regions";

const supabase = Astro.locals.supabase;

const { data: storeRow } = await supabase.from("store_settings").select("settings").eq("id", 1).maybeSingle();
const gemGlow = themeSettings(storeRow?.settings).gemEffectEnabled;

const { data: categories } = await supabase.from("categories").select("*").order("sort_order");

// Sellable catalog snapshot (shared loader — /api/pos/catalog re-pulls it for
// open stations). The SERVER re-checks live type flags on submit — UX only.
const catalog = await loadPosCatalog(supabase);
// Regions ([] before migration 20261005000001 → no badges / chips).
const regions = await loadRegions(supabase);

const customerId = Astro.url.searchParams.get("customer");
let customer = null;
if (customerId) {
  const { data } = await supabase.from("customers").select("*").eq("id", customerId).maybeSingle();
  customer = data;
}

// "✓ Mark paid" (typed-in cash + card totals) — manager-level only; the
// server checks the same permission.
const canMarkPaid = Astro.locals.can("data.elevated");

const posData = { catalog, categories: categories ?? [], customer, regions, canMarkPaid, userId: Astro.locals.user?.id ?? "" };
---

<AppLayout title="Checkout" active="checkout">
  <div id="held-bar" class="held-bar" hidden>
    <span class="held-bar-title">🔖 Held sales</span>
    <div id="held-list" class="held-list"></div>
  </div>

  <div class="checkout-grid">
    <!-- LEFT: catalog -->
    <div class="pos-panel">

      <div class="search" style="margin-bottom:0.8rem;">
        <span class="mag" aria-hidden="true">🔎</span>
        <input id="prod-search" type="search" placeholder={regionsOn(regions) ? "Search title, platform, region, or SKU — or scan a barcode" : "Search title, platform, or SKU — or scan a barcode"} autocomplete="off" />
        <button id="scan-btn" class="btn btn-ghost btn-sm" type="button" title="Scan a barcode" style="position:absolute;right:74px;top:50%;transform:translateY(-50%);">📷 Scan</button>
        <button id="phone-scan-btn" class="btn btn-ghost btn-sm" type="button" title="Pair your phone as a wireless scanner" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);">📱</button>
      </div>

      <div id="rg-chips" class="rg-chips" hidden></div>
      <div class="tiles" id="cat-tiles" data-gem-glow={gemGlow ? "on" : "off"}></div>
      <div id="prod-list" style="margin-top:0.9rem;display:grid;gap:0.4rem;"></div>
    </div>

    <!-- RIGHT: cart -->
    <div class="pos-panel cart-panel">
      <div class="cart-head">
        <h2>Cart</h2>
        <button id="custom-btn" class="btn btn-ghost btn-sm" type="button" title="Sell something that isn't in inventory — type what it is and the price">＋ Custom item</button>
      </div>
      <div class="sale-meta">
        <div id="cust-slot" class="cust-slot"></div>
        <input id="sale-name" maxlength="120" placeholder="Name this sale (optional) — e.g. PRGE Day 1" autocomplete="off" data-noscan="1" />
      </div>
      <div id="cust-pick" class="cust-pick" hidden>
        <input id="cust-q" type="search" placeholder="Find a customer — name, phone or email" autocomplete="off" data-noscan="1" />
        <div id="cust-results" class="cust-results"></div>
        <form id="cust-new" class="cust-new" hidden>
          <input id="cn-first" placeholder="First name *" required data-noscan="1" />
          <input id="cn-last" placeholder="Last name" data-noscan="1" />
          <input id="cn-phone" placeholder="Phone" inputmode="tel" data-noscan="1" />
          <input id="cn-email" placeholder="Email" type="email" data-noscan="1" />
          <div class="cn-actions"><button class="btn btn-primary btn-sm" type="submit">Add customer</button><button class="btn btn-ghost btn-sm" type="button" id="cn-cancel">Cancel</button></div>
        </form>
        <div class="cust-pick-foot"><button class="link-btn" type="button" id="cust-new-btn">＋ New customer</button> · <button class="link-btn" type="button" id="cust-close">Close</button></div>
      </div>
      <form id="custom-form" class="custom-form" hidden>
        <p class="custom-note">Not in inventory — nothing comes out of stock.</p>
        <label class="cf-wide">What is it<input id="cf-desc" maxlength="200" placeholder="e.g. Used controller cable" autocomplete="off" required data-noscan="1" /></label>
        <label>Price $<input id="cf-price" inputmode="decimal" placeholder="0.00" autocomplete="off" required data-noscan="1" /></label>
        <label>Qty<input id="cf-qty" type="number" min="1" max="999" value="1" data-noscan="1" /></label>
        <label class="cf-wide">Category <span class="muted">(optional — for reports)</span>
          <select id="cf-cat"><option value="">—</option>{(categories ?? []).map((c: any) => <option value={c.id}>{c.name}</option>)}</select>
        </label>
        <div class="cf-actions">
          <button class="btn btn-primary btn-sm" type="submit">Add to cart</button>
          <button class="btn btn-ghost btn-sm" type="button" id="cf-cancel">Cancel</button>
        </div>
      </form>
      <div id="auth-warn" class="auth-warn" hidden>⚠ <strong>Your login has expired</strong> — saving won't work and items added since won't show. Open a <strong>new tab</strong>, log in to the POS there, then come back to this tab (don't reload it — your cart is here).</div>
      <div id="restore-banner" class="restore-banner" hidden></div>
      <div id="resume-banner" class="resume-banner" hidden></div>
      <div id="cart" class="cart"></div>
      <p id="cart-empty" class="empty">Cart is empty — tap a category or search to add items.</p>

      <div id="upsells" class="upsells" hidden>
        <p class="upsell-label">📦 Shipping protection</p>
        <label class="upsell"><input type="checkbox" data-upsell="reinforced" data-label="Reinforced box guarantee" data-price="500" /><span class="upsell-name">Reinforced box guarantee</span><span class="upsell-amt">+$5</span></label>
        <label class="upsell"><input type="checkbox" data-upsell="bubble" data-label="Extra bubble wrap padding" data-price="500" /><span class="upsell-name">Extra bubble wrap padding</span><span class="upsell-amt">+$5</span></label>
      </div>

      <div class="cart-totals" id="totals" hidden>
        <div class="row"><span>Subtotal</span><span id="t-sub">$0.00</span></div>
        <div class="row" id="t-disc-row"><span>Discounts <small id="t-disc-pct" class="muted"></small></span><span id="t-disc">-$0.00</span></div>
        <div class="row">
          <span>Cart discount $</span>
          <input id="cart-disc" type="number" min="0" step="0.01" value="0" style="width:6rem;text-align:right;" data-noscan="1" />
        </div>
        <div class="row grand"><span>Total</span><span id="t-total">$0.00</span></div>
        <div class="row" style="margin-top:0.5rem;"><span>Cash tendered $</span>
          <input id="cash-in" type="number" min="0" step="0.01" placeholder="0.00" style="width:6rem;text-align:right;" data-noscan="1" /></div>
        <div class="row" id="change-row" hidden><span>Change due</span><span id="t-change" style="color:var(--green);font-weight:700;">$0.00</span></div>
      </div>

      <div id="cart-actions" style="margin-top:1rem;display:flex;gap:0.6rem;flex-wrap:wrap;" hidden>
        <button id="complete-btn" class="btn btn-primary" style="flex:1;">Complete sale →</button>
        <button id="save-btn" class="btn btn-ghost btn-sm" title="Save this sale and keep working on it (it stays open here)">💾 Save</button>
        <button id="suspend-btn" class="btn btn-ghost btn-sm" title="Save this sale and clear the register for the next customer — it waits in Held sales">⏸ Hold</button>
        {canMarkPaid && <button id="paid-btn" class="btn btn-ghost btn-sm" title="Managers: complete it with the cash and card actually collected — e.g. one sale for a whole expo day">✓ Mark paid…</button>}
        <button id="clear-btn" class="btn btn-ghost btn-sm">Clear</button>
      </div>
      {canMarkPaid && (
        <form id="paid-form" class="paid-form" hidden>
          <p class="pf-head">✓ Mark paid — what was actually collected</p>
          <label>Cash $<input id="pf-cash" inputmode="decimal" placeholder="0.00" autocomplete="off" data-noscan="1" /></label>
          <label>Card $<input id="pf-card" inputmode="decimal" placeholder="0.00" autocomplete="off" data-noscan="1" /></label>
          <p id="pf-sum" class="pf-sum"></p>
          <div class="pf-actions">
            <button type="submit" class="btn btn-primary btn-sm" id="pf-go">Complete as paid</button>
            <button type="button" class="btn btn-ghost btn-sm" id="pf-cancel">Cancel</button>
          </div>
        </form>
      )}

      <div id="receipt" class="receipt" hidden></div>
    </div>
  </div>

  <script type="application/json" id="pos-data" set:html={JSON.stringify(posData)}></script>
</AppLayout>

<style>
  .checkout-grid { display: grid; gap: 1rem; align-items: start; }
  @media (min-width: 980px) { .checkout-grid { grid-template-columns: 1.5fr 1fr; } }
  .cart-panel { position: sticky; top: 90px; }
  /* Customer + sale name, under the Cart heading. */
  .sale-meta { display:grid; grid-template-columns:auto minmax(0, 1fr); gap:0.5rem; align-items:center; margin:0.6rem 0; }
  .sale-meta input { min-width:0; font-size:0.85rem; padding:0.35rem 0.5rem; }
  .cust-chip { display:inline-flex; align-items:center; gap:0.4rem; padding:0.3rem 0.55rem; border:1px solid rgba(44,230,224,.4); background:rgba(44,230,224,.08); font-size:0.85rem; white-space:nowrap; }
  .cust-chip .muted { font-size:0.76rem; }
  .cust-pick { margin:0 0 0.8rem; padding:0.6rem; border:1px solid var(--cyan); background:rgba(44,230,224,.05); display:grid; gap:0.45rem; }
  .cust-pick[hidden], .cust-new[hidden] { display:none; }
  .cust-results { display:grid; gap:0.25rem; max-height:14rem; overflow:auto; }
  .cust-results button { text-align:left; font:inherit; padding:0.4rem 0.55rem; background:rgba(255,255,255,.03); border:1px solid var(--border); color:var(--text); cursor:pointer; }
  .cust-results button:hover { border-color:var(--cyan); }
  .cust-results .muted { font-size:0.76rem; }
  .cust-new { display:grid; grid-template-columns:1fr 1fr; gap:0.4rem; }
  .cn-actions { grid-column:1 / -1; display:flex; gap:0.5rem; }
  .cust-pick-foot { font-size:0.82rem; }
  /* A long cart scrolls on its own, so the newest line (top) and the totals
     stay on screen. */
  #cart { max-height:min(56vh, 34rem); overflow-y:auto; overscroll-behavior:contain; }
  .receipt { margin-top:1rem; padding:1rem; border:1px solid rgba(128,255,114,.4); background:rgba(128,255,114,.08); border-radius:12px; text-align:center; }
  .receipt h3 { color:var(--green); margin-bottom:0.3rem; }

  /* Shipping-protection upsells */
  .upsells { margin:0.8rem 0; padding:0.7rem 0.85rem; border:1px dashed var(--border); background:rgba(255,255,255,.02); }
  .upsell-label { font-weight:800; font-size:0.85rem; margin:0 0 0.45rem; }
  .upsell { display:flex; align-items:center; gap:0.6rem; padding:0.3rem 0; font-size:0.9rem; cursor:pointer; }
  .upsell input { width:1.15rem; height:1.15rem; accent-color:var(--cyan); flex:none; }
  .upsell-name { flex:1; }
  .upsell-amt { font-family:var(--font-mono); font-weight:700; color:var(--green); }

  /* Held sales bar (static template elements). */
  .held-bar { display:flex; align-items:center; gap:0.8rem; margin-bottom:1rem; padding:0.65rem 0.85rem; background:rgba(255,210,63,.08); border:1px solid rgba(255,210,63,.35); }
  .held-bar-title { font-weight:800; font-size:0.9rem; white-space:nowrap; }
  .held-bar[hidden] { display:none; } /* display:flex above beat the hidden attribute */
  .held-list { display:flex; gap:0.55rem; overflow-x:auto; padding-bottom:0.15rem; }
  .resume-banner { margin-bottom:0.8rem; padding:0.5rem 0.75rem; background:rgba(44,230,224,.1); border:1px solid rgba(44,230,224,.35); font-size:0.85rem; }
  .restore-banner { margin-bottom:0.8rem; padding:0.5rem 0.75rem; background:rgba(255,210,63,.1); border:1px solid rgba(255,210,63,.45); font-size:0.85rem; }
  .restore-banner[hidden] { display:none; }
  .auth-warn { margin-bottom:0.8rem; padding:0.55rem 0.75rem; background:rgba(255,73,208,.12); border:1px solid var(--magenta,#ff49d0); font-size:0.85rem; }
  .auth-warn[hidden] { display:none; }
  .paid-form { display:grid; grid-template-columns:1fr 1fr; gap:0.5rem 0.7rem; margin-top:0.8rem; padding:0.75rem; border:1px solid var(--cyan); background:rgba(44,230,224,.05); }
  .paid-form[hidden] { display:none; }
  .paid-form label { display:grid; gap:0.2rem; font-size:0.78rem; font-weight:600; color:var(--muted); }
  .pf-head, .pf-sum, .pf-actions { grid-column:1 / -1; margin:0; }
  .pf-head { font-weight:700; font-size:0.85rem; }
  .pf-sum { font-size:0.82rem; color:var(--muted); }
  .pf-sum .bad { color:var(--magenta,#ff49d0); font-weight:700; }
  .pf-actions { display:flex; gap:0.5rem; }
</style>

<!-- Held-sale chips are built via innerHTML, so their styles must be global
     (Astro scoped styles don't reach runtime-inserted elements). -->
<style is:global>
  .held-chip { position:relative; flex:0 0 auto; }
  .held-chip-main { display:grid; grid-template-columns:auto auto; gap:0.05rem 0.6rem; align-items:baseline; width:100%; padding:0.45rem 1.5rem 0.45rem 0.7rem; background:var(--panel); border:1px solid var(--border); cursor:pointer; text-align:left; color:var(--text); transition:border-color .15s; }
  .held-chip-main:hover { border-color:var(--cyan); }
  .held-chip-id { font-weight:800; font-family:var(--font-mono); }
  .held-chip-who { font-size:0.82rem; color:var(--muted); justify-self:end; }
  .held-chip-total { font-family:var(--font-mono); font-weight:800; color:var(--green); grid-column:1; }
  .held-chip-main small { grid-column:1 / -1; color:var(--muted-2); font-size:0.72rem; white-space:nowrap; }
  .held-chip-del { position:absolute; top:1px; right:1px; width:1.3rem; height:1.3rem; display:grid; place-items:center; font-size:0.72rem; color:var(--muted-2); background:none; border:none; cursor:pointer; }
  .held-chip-del:hover { color:#ff6b6b; }

  /* Product rows are built via innerHTML too → must be global. */
  .prod-row { appearance:none; -webkit-appearance:none; font:inherit; display:flex; align-items:center; justify-content:space-between; gap:0.8rem; width:100%; text-align:left; padding:0.55rem 0.7rem; border:1px solid var(--border); background:rgba(255,255,255,.02); color:var(--text); cursor:pointer; }
  .prod-row:hover { border-color:var(--cyan); background:rgba(255,255,255,.06); }
  .prod-info { display:flex; flex-direction:column; gap:0.1rem; min-width:0; }
  /* Title + region badge: the badge never gets ellipsized away (US and JP
     copies of a game share a title). */
  .prod-title-line { display:flex; align-items:center; gap:0.4rem; min-width:0; }
  .prod-title-line .rg-badge { flex:none; }
  .prod-title { font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; }
  .pick-head .rg-badge, .cart-line .rg-badge { margin-left:0.35rem; }
  .cart-head { display:flex; align-items:center; justify-content:space-between; gap:0.6rem; }
  .cart-head h2 { margin:0; }
  .custom-form { display:grid; grid-template-columns:1fr 1fr; gap:0.5rem 0.7rem; margin:0.7rem 0; padding:0.75rem; border:1px solid var(--cyan); background:rgba(44,230,224,.05); }
  .custom-form[hidden] { display:none; }
  .custom-form label { display:grid; gap:0.2rem; font-size:0.78rem; font-weight:600; color:var(--muted); }
  .custom-form .cf-wide { grid-column:1 / -1; }
  .custom-note { grid-column:1 / -1; margin:0; font-size:0.78rem; color:var(--muted-2); }
  .cf-actions { grid-column:1 / -1; display:flex; gap:0.5rem; }

  /* The line just scanned / added (it's on top) — a brief highlight. */
  .cart-line.cart-new { animation: cart-new 1.6s ease-out; }
  @keyframes cart-new { 0% { background: rgba(44,230,224,.22); } 100% { background: transparent; } }
  @media (prefers-reduced-motion: reduce) { .cart-line.cart-new { animation: none; outline: 1px solid var(--cyan); } }
  /* Region filter chips (built at runtime; only when regions are on). */
  .rg-chips { display:flex; gap:0.4rem; flex-wrap:wrap; align-items:center; margin-bottom:0.8rem; }
  .rg-chips[hidden] { display:none; }
  .rg-chips .chip { cursor:pointer; padding:0.3rem 0.75rem; font:inherit; font-size:0.8rem; font-weight:600; }
  .rg-chips .chip.active { border-color:var(--cyan); color:var(--cyan); }
  .prod-meta { font-size:0.78rem; color:var(--muted-2); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .prod-meta .oos { color:#ff9aa2; font-weight:600; }
  .prod-price { font-weight:700; flex:none; white-space:nowrap; }
  .prod-row[data-oos] .prod-price { color:var(--muted-2); }
  .prod-hint, .prod-more { color:var(--muted-2); font-size:0.84rem; text-align:center; padding:0.7rem 0.3rem; }
  .pick-head { display:flex; align-items:center; justify-content:space-between; gap:0.6rem; padding:0.5rem 0.7rem; border:1px solid var(--cyan); background:rgba(44,230,224,.08); font-size:0.88rem; }
  .pick-cancel { appearance:none; font:inherit; font-size:0.78rem; padding:0.2rem 0.6rem; border:1px solid var(--border); background:transparent; color:var(--muted-2); cursor:pointer; }
</style>

<script>
  import { initScanReceiver, openPairDialog } from "../../lib/scanReceive";
  import { barcodeEq } from "../../lib/gtin";
  import { displayTitle, peelRegion, regionBadgeHtml, regionNorm, regionOf, regionTag, regionsOn, type Region } from "../../lib/regions";
  // title = the line's saved text (transaction_items.description) — for a
  // stocked item displayTitle() ("Okami HD [JP]"), set ONCE when it's added.
  type Item = { key: string; variantId: string | null; categoryId: string | null; kind: string; title: string; meta: string; unitPriceCents: number; qty: number; discountCents: number; regionCode?: string; custom?: boolean };
  const data = JSON.parse(document.getElementById("pos-data")!.textContent!);
  const catalog: any[] = data.catalog;
  const categories: any[] = data.categories;
  let customer: any = data.customer; // the sale's customer (none = walk-in)
  const regions: Region[] = data.regions || []; // [] = regions off

  const money = (c: number) => (c / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[m] as string));
  const $ = (id: string) => document.getElementById(id)!;

  // A glass gem shaped like each category's item, tinted with its colour. Returns
  // both the SVG and a silhouette MASK (data-URI) so the moving cursor-shine can
  // be clipped to the exact gem shape (no square outline). Each gem also carries a
  // clipped top "gloss" reflection for a genuine glass sheen.
  function gemParts(name: string, color: string): { svg: string; mask: string } {
    const id = "lg-" + name.toLowerCase().replace(/[^a-z0-9]/g, "");
    const F = `url(#${id})`;
    const n = name.toLowerCase();
    let shape: string, sil: string;
    if (n.includes("console")) {
      sil = `<polygon points="12,3 19,7 19,15 12,19 5,15 5,7"/>`;
      shape = `<polygon points="12,3 19,7 12,11 5,7" fill="${F}"/><polygon points="5,7 12,11 12,19 5,15" fill="${color}" fill-opacity="0.62"/><polygon points="19,7 12,11 12,19 19,15" fill="${color}" fill-opacity="0.88"/><circle cx="12" cy="6.7" r="1.5" fill="#fff" fill-opacity="0.22"/><g fill="none" stroke="#fff" stroke-opacity="0.32" stroke-width="0.55"><polygon points="12,3 19,7 12,11 5,7"/><path d="M5,7 12,11 19,7 M12,11 12,19"/></g><path d="M12,3.7 17,6.5" stroke="#fff" stroke-width="0.9" stroke-opacity="0.55" stroke-linecap="round"/>`;
    } else if (n.includes("accessor")) {
      sil = `<path d="M7.5,9 C4.5,9 3.3,11.5 3.2,13.8 C3.1,16 4.8,16.4 6,15.4 C6.9,14.7 7.4,14 8.2,14 H15.8 C16.6,14 17.1,14.7 18,15.4 C19.2,16.4 20.9,16 20.8,13.8 C20.7,11.5 19.5,9 16.5,9 Z"/>`;
      shape = `<path d="M7.5,9 C4.5,9 3.3,11.5 3.2,13.8 C3.1,16 4.8,16.4 6,15.4 C6.9,14.7 7.4,14 8.2,14 H15.8 C16.6,14 17.1,14.7 18,15.4 C19.2,16.4 20.9,16 20.8,13.8 C20.7,11.5 19.5,9 16.5,9 Z" fill="${F}"/><circle cx="8" cy="11.7" r="1.25" fill="#fff" fill-opacity="0.3"/><circle cx="16.2" cy="11" r="0.85" fill="#fff" fill-opacity="0.3"/><circle cx="14.4" cy="12.4" r="0.85" fill="#fff" fill-opacity="0.3"/>`;
    } else if (n.includes("book")) {
      sil = `<path d="M6.5,4 H15.5 A2,2 0 0 1 17.5,6 V18 A2,2 0 0 1 15.5,20 H6.5 Z"/>`;
      shape = `<path d="M6.5,4 H15.5 A2,2 0 0 1 17.5,6 V18 A2,2 0 0 1 15.5,20 H6.5 Z" fill="${F}"/><line x1="8.4" y1="4" x2="8.4" y2="20" stroke="#fff" stroke-opacity="0.3" stroke-width="0.6"/><g stroke="#fff" stroke-opacity="0.28" stroke-width="0.55"><line x1="10.2" y1="8" x2="15" y2="8"/><line x1="10.2" y1="11" x2="15" y2="11"/><line x1="10.2" y1="14" x2="13.6" y2="14"/></g>`;
    } else if (n.includes("movie")) {
      sil = `<rect x="4" y="6.5" width="16" height="11" rx="2"/>`;
      shape = `<rect x="4" y="6.5" width="16" height="11" rx="2" fill="${F}"/><polygon points="10,9.8 15,12 10,14.2" fill="#fff" fill-opacity="0.75"/><rect x="4" y="6.5" width="16" height="11" rx="2" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="0.55"/>`;
    } else if (n.includes("gift")) {
      sil = `<rect x="3.5" y="7" width="17" height="11" rx="1.5"/>`;
      shape = `<rect x="3.5" y="7" width="17" height="11" rx="1.5" fill="${F}"/><rect x="3.5" y="10.2" width="17" height="2" fill="#fff" fill-opacity="0.22"/><rect x="6" y="14.4" width="4.5" height="1.8" rx="0.4" fill="#fff" fill-opacity="0.4"/><rect x="3.5" y="7" width="17" height="11" rx="1.5" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="0.55"/>`;
    } else if (n.includes("disc")) {
      sil = `<circle cx="12" cy="12" r="8.4"/>`;
      shape = `<circle cx="12" cy="12" r="8.4" fill="${F}"/><circle cx="12" cy="12" r="2.3" fill="#0a0a12" fill-opacity="0.55"/><circle cx="12" cy="12" r="8.4" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="0.55"/><path d="M12,4.2 A7.8,7.8 0 0 1 19.2,9" fill="none" stroke="#fff" stroke-opacity="0.5" stroke-width="1.1" stroke-linecap="round"/>`;
    } else if (n.includes("toy")) {
      sil = `<polygon points="12,2.6 14.5,8.8 21.2,9.2 16,13.4 17.8,20 12,16.3 6.2,20 8,13.4 2.8,9.2 9.5,8.8"/>`;
      shape = `<polygon points="12,2.6 14.5,8.8 21.2,9.2 16,13.4 17.8,20 12,16.3 6.2,20 8,13.4 2.8,9.2 9.5,8.8" fill="${F}"/><polygon points="12,2.6 14.5,8.8 21.2,9.2 16,13.4 17.8,20 12,16.3 6.2,20 8,13.4 2.8,9.2 9.5,8.8" fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="0.6" stroke-linejoin="round"/>`;
    } else if (n.includes("game") || n.includes("video")) {
      sil = `<rect x="6.5" y="3" width="11" height="18" rx="0.5"/>`;
      shape = `<rect x="6.5" y="3" width="11" height="18" rx="0.5" fill="${F}"/><line x1="9" y1="3.4" x2="9" y2="20.6" stroke="#fff" stroke-opacity="0.3" stroke-width="0.7"/><rect x="10.5" y="6" width="5.3" height="7" fill="#fff" fill-opacity="0.16"/><rect x="6.5" y="3" width="11" height="18" rx="0.5" fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="0.7"/>`;
    } else {
      sil = `<polygon points="5,8 8,3 16,3 19,8 12,21"/>`;
      shape = `<polygon points="5,8 8,3 16,3 19,8 12,21" fill="${F}"/><polygon points="8,3 16,3 15,8 9,8" fill="#fff" fill-opacity="0.26"/><g fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="0.6"><polygon points="5,8 8,3 16,3 19,8 12,21"/><path d="M9,8 8,3 M15,8 16,3 M9,8 15,8 M5,8 12,21 19,8 M12,8 12,21"/></g>`;
    }

    const svg = `<svg class="cat-gem" viewBox="0 0 24 24" aria-hidden="true">
      <defs>
        <linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity="0.55"/>
          <stop offset="0.38" stop-color="${color}" stop-opacity="0.82"/>
          <stop offset="1" stop-color="${color}" stop-opacity="0.42"/>
        </linearGradient>
        <linearGradient id="gl-${id}" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity="0.5"/>
          <stop offset="0.55" stop-color="#fff" stop-opacity="0.06"/>
          <stop offset="1" stop-color="#fff" stop-opacity="0"/>
        </linearGradient>
        <clipPath id="clip-${id}">${sil}</clipPath>
      </defs>
      ${shape}
      <g clip-path="url(#clip-${id})"><rect x="0" y="0" width="24" height="13" fill="url(#gl-${id})"/></g>
    </svg>`;
    const maskSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><g fill='white'>${sil}</g></svg>`;
    const mask = `url("data:image/svg+xml,${encodeURIComponent(maskSvg)}")`;
    return { svg, mask };
  }

  let cart: Item[] = [];
  let activeCat: string | null = null;
  let activeRegion: string | null = null; // region chip (a code), null = all
  let search = "";

  // ---------- Category tiles ----------
  const tilesEl = $("cat-tiles");
  const gemBits = categories.map((c) => gemParts(c.name, c.color));
  tilesEl.innerHTML = categories
    .map((c, i) => `<button class="tile-btn" data-cat="${c.id}" data-track="${c.is_trackable}">
        <span class="gem-box">${gemBits[i].svg}<span class="gem-shine" aria-hidden="true"></span></span>
        <span class="tile-name">${esc(c.name)}</span>
        <small>${c.is_trackable ? catalog.filter((v) => v.categoryId === c.id).length + " items" : "custom / service"}</small>
      </button>`)
    .join("");
  // Clip each gem's moving shine to its exact silhouette (kills the square edge).
  tilesEl.querySelectorAll<HTMLElement>(".gem-box").forEach((box, i) => {
    if (gemBits[i]) box.style.setProperty("--gem-mask", gemBits[i].mask);
  });

  // "Grand" gem glisten: the cursor is a single moving light source for the WHOLE
  // grid. On any pointer move anywhere on screen (rAF-throttled, ~1 write/gem) we
  // re-light every gem — the specular highlight slides to the gem edge facing the
  // cursor and the gem tilts toward it, so all gems catch the light together even
  // when the cursor is across the screen. Cheap: a handful of CSS-var writes per
  // frame, GPU-composited. Honours the store gem-effect setting + reduced-motion.
  const glowOn = tilesEl.dataset.gemGlow !== "off" &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (glowOn) {
    const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
    let rafPending = false, mx = 0, my = 0;
    const relight = () => {
      rafPending = false;
      tilesEl.querySelectorAll<HTMLElement>(".gem-box").forEach((box) => {
        const r = box.getBoundingClientRect();
        if (!r.width) return;
        const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        // Direction to the cursor, normalised by a screen-ish radius so far-away
        // cursors still register but saturate gently.
        const nx = clamp((mx - cx) / 520, -1, 1);
        const ny = clamp((my - cy) / 520, -1, 1);
        // Highlight rides the gem edge facing the cursor (clamped just past the rim).
        box.style.setProperty("--gx", `${(50 + nx * 60).toFixed(1)}%`);
        box.style.setProperty("--gy", `${(38 + ny * 60).toFixed(1)}%`);
        box.style.setProperty("--tilt", `perspective(260px) rotateX(${(-ny * 12).toFixed(2)}deg) rotateY(${(nx * 12).toFixed(2)}deg)`);
      });
    };
    window.addEventListener("pointermove", (e) => {
      mx = e.clientX; my = e.clientY;
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(relight);
    }, { passive: true });
  } else {
    tilesEl.classList.add("gem-flat");
  }

  tilesEl.querySelectorAll<HTMLButtonElement>(".tile-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.cat!;
      activeCat = activeCat === id ? null : id; pick = null;
      tilesEl.querySelectorAll(".tile-btn").forEach((b) => b.classList.remove("active"));
      if (activeCat) btn.classList.add("active");
      if (btn.dataset.track === "false" && activeCat) {
        const cat = categories.find((c) => c.id === id);
        addCustom(cat);
        activeCat = null; pick = null;
        btn.classList.remove("active");
      }
      renderProducts();
    });
  });

  // ---------- Region chips ----------
  // Only when regions are on and the stock spans more than one region (one
  // choice filters nothing). Combines with the category tile and the search.
  const rgChipsEl = $("rg-chips");
  function renderRegionChips() {
    const present = new Set(catalog.map((v) => regionOf(v.regionCode, regions)));
    const list = regions.filter((r) => (r.isActive && present.has(r.code)) || r.code === activeRegion);
    if (!regionsOn(regions) || list.length < 2) { rgChipsEl.hidden = true; rgChipsEl.innerHTML = ""; activeRegion = null; return; }
    rgChipsEl.hidden = false;
    rgChipsEl.innerHTML = `<button type="button" class="chip${activeRegion ? "" : " active"}" data-rg="">All regions</button>`
      + list.map((r) => `<button type="button" class="chip${activeRegion === r.code ? " active" : ""}" data-rg="${esc(r.code)}" title="${esc(r.name)}">${esc(`${r.flag ? r.flag + " " : ""}${r.short}`)}</button>`).join("");
    rgChipsEl.querySelectorAll<HTMLButtonElement>("[data-rg]").forEach((b) => b.addEventListener("click", () => {
      const code = b.dataset.rg || null;
      activeRegion = activeRegion === code ? null : code; pick = null;
      renderRegionChips();
      renderProducts();
    }));
  }

  // ---------- Product list ----------
  function filtered() {
    // A region the cashier TYPES ("mario kart pal") is peeled into a region
    // filter (it wins over the chip) — never matched as text.
    const peel = regionsOn(regions) ? peelRegion(search, regions) : null;
    const rg = peel?.code || activeRegion;
    const q = peel?.code ? peel.rest : search.trim().toLowerCase();
    if (!activeCat && !q && !rg) return []; // keep the full catalog hidden until needed
    return catalog.filter((v) => {
      if (activeCat && v.categoryId !== activeCat) return false;
      const hay = `${v.title} ${v.platform} ${v.condition} ${v.sku ?? ""}`;
      // …unless those words are part of this item's NAME ("Medal of Honor:
      // European Assault") — then the whole phrase is a plain title search.
      if (peel?.code && (" " + regionNorm(v.title) + " ").includes(" " + peel.text + " ") && regionNorm(hay).includes(regionNorm(search)))
        return !activeRegion || regionOf(v.regionCode, regions) === activeRegion;
      if (rg && regionOf(v.regionCode, regions) !== rg) return false;
      if (!q) return true;
      // The peeled rest is normalized (lowercase words) — compare like with like.
      return peel?.code ? regionNorm(hay).includes(q) : hay.toLowerCase().includes(q);
    });
  }
  const prodRowHtml = (v: any) => `
      <button class="prod-row" type="button" data-add="${v.variantId}"${v.qty <= 0 ? ' data-oos="1"' : ""}>
        <span class="prod-info">
          <span class="prod-title-line"><span class="prod-title">${esc(v.title)}</span>${regionBadgeHtml(v.regionCode, regions)}</span>
          <span class="prod-meta">${esc(v.platform)}${v.condition ? " · " + esc(v.condition) : ""}${v.completeness ? " · " + esc(v.completeness) : ""}${v.typeName && v.typeName !== "Retail" ? " · " + esc(v.typeName) : ""} · ${v.qty <= 0 ? '<span class="oos">out of stock</span>' : v.qty + " in stock"}</span>
        </span>
        <span class="prod-price">${money(v.priceCents)}</span>
      </button>`;
  function renderProducts() {
    const list = $("prod-list");
    if (pick) {
      list.innerHTML = `<div class="pick-head"><span>Which condition? — <strong>${esc(pick.title)}</strong>${regionBadgeHtml(pick.regionCode, regions)}</span><button type="button" class="pick-cancel" data-pick-cancel>Cancel</button></div>`
        + pick.rows.map((v) => prodRowHtml(v)).join("");
      // mousedown → preventDefault: picking must not pull focus out of the
      // search box, or the next wedge scan would type into nothing.
      list.querySelectorAll<HTMLElement>("[data-pick-cancel], [data-add]").forEach((el) => el.addEventListener("mousedown", (e) => e.preventDefault()));
      list.querySelector("[data-pick-cancel]")?.addEventListener("click", () => { pick = null; renderProducts(); });
      list.querySelectorAll<HTMLButtonElement>("[data-add]").forEach((b) =>
        b.addEventListener("click", () => { pick = null; addVariant(b.dataset.add!); renderProducts(); }));
      return;
    }
    // Nothing below the grid until the cashier searches or picks a category.
    if (!activeCat && !search.trim() && !activeRegion) {
      list.innerHTML = `<p class="prod-hint">Search or tap a category to add items.</p>`;
      return;
    }
    const all = filtered();
    if (!all.length) { list.innerHTML = `<p class="empty">No matching items.</p>`; return; }
    const CAP = 40;
    const rows = all.slice(0, CAP);
    list.innerHTML = rows.map((v) => prodRowHtml(v)).join("")
      + (all.length > CAP ? `<p class="prod-more">+${all.length - CAP} more — keep typing to narrow it down</p>` : "");
    list.querySelectorAll<HTMLButtonElement>("[data-add]").forEach((b) =>
      b.addEventListener("click", () => addVariant(b.dataset.add!)));
  }

  // ---------- Cart ops ----------
  function addVariant(variantId: string, fresh = false) {
    const v = catalog.find((x) => x.variantId === variantId);
    if (!v) return;
    // Blocked inventory type (e.g. Personal Collection) — server re-checks too.
    // The page's catalog is a snapshot from load time, so before refusing on it
    // re-pull the catalog once: a station left open all day would otherwise
    // keep refusing an item a manager has since flipped back to Retail.
    if ((v as any).blocked) {
      if (!fresh) { refreshCatalog().then(() => addVariant(variantId, true)); return; }
      alert(`“${displayTitle(v.title, v.regionCode, regions)}” is ${(v as any).typeName || "a blocked inventory type"} — not for sale. A manager can unblock it in Settings → Inventory types.`);
      return;
    }
    const existing = cart.find((i) => i.variantId === variantId);
    if (existing) {
      // Scanned again: one more, and it becomes the latest line (top).
      existing.qty++;
      cart = [...cart.filter((i) => i !== existing), existing];
      flashKey = existing.key;
    } else {
      // The region tag goes into the line's text HERE, once (it's the saved
      // description) — hold/resume reuse that text as-is.
      const key = crypto.randomUUID();
      cart.push({ key, variantId, categoryId: v.categoryId, kind: "sale", title: displayTitle(v.title, v.regionCode, regions), meta: `${v.platform} · ${v.condition}`, unitPriceCents: v.priceCents, qty: 1, discountCents: 0, regionCode: v.regionCode });
      flashKey = key;
    }
    renderCart();
  }
  // A service tile (e.g. Disc Repair) opens the same form, set to it.
  function addCustom(cat: any) { openCustom(true, cat); }

  // ---------- Customer ----------
  // Who the sale is for (optional). Saved with the sale; shows in Sales.
  function setCustomer(c: any) {
    customer = c && c.id ? { id: c.id, first_name: c.first_name ?? "", last_name: c.last_name ?? "", store_credit_cents: c.store_credit_cents ?? 0 } : null;
    const slot = $("cust-slot");
    if (customer) {
      const nm = `${customer.first_name} ${customer.last_name}`.trim() || "Customer";
      slot.innerHTML = `<span class="cust-chip">👤 <strong>${esc(nm)}</strong>${customer.store_credit_cents ? ` <span class="muted">${money(customer.store_credit_cents)} credit</span>` : ""} <button class="link-btn" type="button" id="cust-change" title="Change customer">change</button> <button class="link-btn" type="button" id="cust-clear" title="Remove the customer">✕</button></span>`;
      $("cust-change").addEventListener("click", () => openCustPick(true));
      $("cust-clear").addEventListener("click", () => { if (!busy) { setCustomer(null); recalc(); } });
    } else {
      slot.innerHTML = `<button class="btn btn-ghost btn-sm" type="button" id="cust-add">👤 Add customer</button>`;
      $("cust-add").addEventListener("click", () => openCustPick(true));
    }
  }
  function openCustPick(on: boolean) {
    ($("cust-pick") as HTMLElement).hidden = !on;
    ($("cust-new") as HTMLElement).hidden = true;
    if (on) { ($("cust-q") as HTMLInputElement).value = ""; $("cust-results").innerHTML = ""; ($("cust-q") as HTMLInputElement).focus(); }
    else ($("prod-search") as HTMLInputElement).focus();
  }
  let custT: any, custSeq = 0;
  $("cust-q").addEventListener("input", () => {
    clearTimeout(custT);
    const q = ($("cust-q") as HTMLInputElement).value.trim();
    if (!q) { $("cust-results").innerHTML = ""; return; }
    custT = setTimeout(async () => {
      const seq = ++custSeq;
      try {
        const r = await fetch(`/api/pos/customers?q=${encodeURIComponent(q)}`);
        const j = await r.json();
        if (seq !== custSeq) return; // a newer search answered first
        if (r.status === 401) { ($("auth-warn") as HTMLElement).hidden = false; return; }
        const list: any[] = j.results || [];
        $("cust-results").innerHTML = list.length
          ? list.map((c, i) => `<button type="button" data-c="${i}"><strong>${esc(`${c.first_name ?? ""} ${c.last_name ?? ""}`.trim())}</strong> <span class="muted">${esc([c.phone, c.email].filter(Boolean).join(" · "))}${c.store_credit_cents ? ` · ${money(c.store_credit_cents)} credit` : ""}</span></button>`).join("")
          : `<p class="muted" style="margin:0;font-size:0.82rem;">No match — add them with ＋ New customer.</p>`;
        $("cust-results").querySelectorAll<HTMLButtonElement>("[data-c]").forEach((b) => b.addEventListener("click", () => {
          setCustomer(list[Number(b.dataset.c)]); openCustPick(false); recalc();
        }));
      } catch { /* offline — keep typing */ }
    }, 220);
  });
  $("cust-q").addEventListener("keydown", (e) => { if (e.key === "Escape") openCustPick(false); });
  $("cust-close").addEventListener("click", () => openCustPick(false));
  $("cust-new-btn").addEventListener("click", () => {
    const f = $("cust-new") as HTMLFormElement;
    f.hidden = false; f.reset();
    // A typed name starts the form.
    const q = ($("cust-q") as HTMLInputElement).value.trim();
    if (q && !/[@\d]/.test(q)) { const [a, ...b] = q.split(/\s+/); ($("cn-first") as HTMLInputElement).value = a; ($("cn-last") as HTMLInputElement).value = b.join(" "); }
    else if (/^[\d\s()+-]{7,}$/.test(q)) ($("cn-phone") as HTMLInputElement).value = q;
    else if (q.includes("@")) ($("cn-email") as HTMLInputElement).value = q;
    ($("cn-first") as HTMLInputElement).focus();
  });
  $("cn-cancel").addEventListener("click", () => { ($("cust-new") as HTMLElement).hidden = true; });
  ($("cust-new") as HTMLFormElement).addEventListener("submit", async (e) => {
    e.preventDefault();
    const v = (id: string) => ($(id) as HTMLInputElement).value.trim();
    if (!v("cn-first")) { alert("First name is needed."); return; }
    const btn = ($("cust-new") as HTMLFormElement).querySelector<HTMLButtonElement>("button[type=submit]")!;
    btn.disabled = true;
    try {
      const r = await fetch("/api/pos/customer", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ first_name: v("cn-first"), last_name: v("cn-last"), phone: v("cn-phone"), email: v("cn-email") }) });
      const j = await r.json().catch(() => ({}));
      if (r.status === 401) { ($("auth-warn") as HTMLElement).hidden = false; throw new Error("Your login has expired — log in again in a new tab."); }
      if (!r.ok || !j.ok) throw new Error(j.error || "Couldn't add the customer.");
      setCustomer({ id: j.id, first_name: v("cn-first"), last_name: v("cn-last"), store_credit_cents: 0 });
      openCustPick(false); recalc();
    } catch (err: any) { alert(err.message); }
    finally { btn.disabled = false; }
  });
  ($("sale-name") as HTMLInputElement).addEventListener("input", () => { recalc(); if (heldId) renderResumeBanner(heldHuman); });

  // ＋ Custom item: an ad-hoc sale line that isn't in inventory (no listing,
  // no stock change) — a typed description + price, optional category for
  // reports. Saved like any other line (variant_id null).
  const cform = $("custom-form") as HTMLFormElement;
  function openCustom(on: boolean, cat?: any) {
    cform.hidden = !on;
    if (on) {
      cform.reset();
      ($("cf-qty") as HTMLInputElement).value = "1";
      ($("cf-cat") as HTMLSelectElement).value = cat?.id ?? "";
      ($("cf-desc") as HTMLInputElement).value = cat ? (cat.name === "Disc Repair" ? "Disc resurfacing" : cat.name) : "";
      const first = $(cat ? "cf-price" : "cf-desc") as HTMLInputElement;
      first.focus(); first.select();
      cform.scrollIntoView({ block: "nearest" });
    } else ($("prod-search") as HTMLInputElement).focus();
  }
  $("custom-btn").addEventListener("click", () => openCustom(cform.hidden));
  $("cf-cancel").addEventListener("click", () => openCustom(false));
  cform.addEventListener("keydown", (e) => { if (e.key === "Escape") { e.preventDefault(); openCustom(false); } });
  cform.addEventListener("submit", (e) => {
    e.preventDefault();
    const desc = ($("cf-desc") as HTMLInputElement).value.trim();
    const priceRaw = ($("cf-price") as HTMLInputElement).value.replace(/[$,\s]/g, "");
    const price = Number(priceRaw);
    const qty = Math.min(999, Math.max(1, parseInt(($("cf-qty") as HTMLInputElement).value) || 1));
    if (!desc) { alert("Type what you're selling."); ($("cf-desc") as HTMLInputElement).focus(); return; }
    if (!priceRaw || !Number.isFinite(price) || price <= 0 || price > 100000) { alert("Type a price, e.g. 12.99"); ($("cf-price") as HTMLInputElement).focus(); return; }
    const cat = categories.find((c: any) => c.id === ($("cf-cat") as HTMLSelectElement).value) || null;
    const key = crypto.randomUUID();
    // A service category (Disc Repair…) stays a service line as before;
    // anything else is a custom retail item.
    const service = !!cat && !cat.is_trackable;
    cart.push({ key, variantId: null, categoryId: cat?.id ?? null, kind: service ? "service" : "sale", title: desc, meta: service ? cat.name : cat ? `Custom · ${cat.name}` : "Custom item", unitPriceCents: Math.round(price * 100), qty, discountCents: 0, custom: !service });
    flashKey = key;
    openCustom(false);
    renderCart();
  });

  // On screen a line's "[JP]" shows as the badge (the saved text keeps it).
  function cartTitleHtml(i: Item): string {
    const badge = regionBadgeHtml(i.regionCode, regions);
    if (!badge) return esc(i.title);
    const tag = ` [${regionTag(i.regionCode, regions)}]`;
    return esc(i.title.toLowerCase().endsWith(tag.toLowerCase()) ? i.title.slice(0, -tag.length) : i.title) + badge;
  }

  // Newest first: the line just scanned / added is on top (the cart array —
  // and the saved sale — stay in the order things were added). Shipping-
  // protection add-ons stay at the bottom. `flashKey` = the line to highlight.
  let flashKey: string | null = null;
  let backupOn = false;
  function renderCart() {
    const el = $("cart");
    const shown = [...cart.filter((i) => !i.key.startsWith("upsell:")).reverse(), ...cart.filter((i) => i.key.startsWith("upsell:"))];
    el.innerHTML = shown.map((i) => `
      <div class="cart-line${i.key === flashKey ? " cart-new" : ""}" data-key="${i.key}">
        <div><span class="title">${cartTitleHtml(i)}</span><span class="meta" style="display:block;">${esc(i.meta)}</span></div>
        <div class="price">${money(i.unitPriceCents * i.qty - i.discountCents)}</div>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <label class="meta">Qty <input type="number" min="1" value="${i.qty}" data-qty style="width:3.6rem;"></label>
          <label class="meta">Disc $ <input type="number" min="0" step="0.01" value="${(i.discountCents/100).toFixed(2)}" data-disc style="width:4.6rem;"></label>
          ${i.discountCents > 0 ? `<span class="pill magenta">${Math.round(i.discountCents / (i.unitPriceCents*i.qty) * 100)}%</span>` : ""}
          <button class="link-btn" data-remove>✕</button>
        </div>
      </div>`).join("");

    el.querySelectorAll<HTMLElement>(".cart-line").forEach((line) => {
      const key = line.dataset.key!;
      const item = cart.find((i) => i.key === key)!;
      line.querySelector<HTMLInputElement>("[data-qty]")!.addEventListener("change", (e) => {
        item.qty = Math.max(1, parseInt((e.target as HTMLInputElement).value) || 1);
        item.discountCents = Math.min(item.discountCents, item.unitPriceCents * item.qty);
        renderCart();
      });
      line.querySelector<HTMLInputElement>("[data-disc]")!.addEventListener("change", (e) => {
        item.discountCents = Math.min(item.unitPriceCents * item.qty, Math.max(0, Math.round(parseFloat((e.target as HTMLInputElement).value) * 100) || 0)); renderCart();
      });
      line.querySelector("[data-remove]")!.addEventListener("click", () => { cart = cart.filter((i) => i.key !== key); renderCart(); });
    });
    if (flashKey) el.scrollTop = 0; // the newest line is on top
    flashKey = null;
    recalc();
  }

  const upsellBoxes = () => [...document.querySelectorAll<HTMLInputElement>("[data-upsell]")];
  function syncUpsells() {
    document.querySelectorAll<HTMLInputElement>("[data-upsell]").forEach((cb) => {
      cb.checked = cart.some((i) => i.key === "upsell:" + cb.dataset.upsell);
    });
  }
  document.querySelectorAll<HTMLInputElement>("[data-upsell]").forEach((cb) => {
    cb.addEventListener("change", () => {
      const key = "upsell:" + cb.dataset.upsell;
      cart = cart.filter((i) => i.key !== key);
      if (cb.checked) cart.push({ key, variantId: null, categoryId: null, kind: "service", title: cb.dataset.label!, meta: "Shipping protection", unitPriceCents: Number(cb.dataset.price), qty: 1, discountCents: 0 });
      renderCart();
    });
  });

  function recalc() {
    const empty = cart.length === 0;
    $("cart-empty").hidden = !empty;
    $("totals").hidden = empty;
    ($("upsells") as HTMLElement).hidden = empty;
    syncUpsells();
    ($("cart-actions") as HTMLElement).hidden = empty;
    const subtotal = cart.reduce((s, i) => s + i.unitPriceCents * i.qty, 0);
    const itemDisc = cart.reduce((s, i) => s + i.discountCents, 0);
    const cartDisc = Math.max(0, Math.round(parseFloat(($("cart-disc") as HTMLInputElement).value) * 100) || 0);
    const totalDisc = Math.min(subtotal, itemDisc + cartDisc);
    const total = Math.max(0, subtotal - totalDisc);
    $("t-sub").textContent = money(subtotal);
    $("t-disc").textContent = "-" + money(totalDisc);
    $("t-disc-pct").textContent = subtotal ? `(${Math.round((totalDisc / subtotal) * 100)}% off)` : "";
    $("t-total").textContent = money(total);
    const cash = Math.round(parseFloat(($("cash-in") as HTMLInputElement).value) * 100) || 0;
    const change = cash > total ? cash - total : 0;
    ($("change-row") as HTMLElement).hidden = change <= 0;
    $("t-change").textContent = money(change);
    if (backupOn) backup();
  }

  // ---------- Live catalog ----------
  // The embedded catalog is a snapshot from page load. A POS station commonly
  // stays open for a whole shift, so re-pull it (same rows, same loader) when
  // the tab comes back into view, on a slow timer, before refusing a "blocked"
  // item, and after a scan misses. Mutated in place so every closure above
  // keeps pointing at the live array.
  let refreshInFlight: Promise<boolean> | null = null;
  let lastRefreshAt = 0;
  function refreshCatalog(minGapMs = 4000): Promise<boolean> {
    if (refreshInFlight) return refreshInFlight;
    if (Date.now() - lastRefreshAt < minGapMs) return Promise.resolve(false);
    refreshInFlight = (async () => {
      try {
        const r = await fetch("/api/pos/catalog", { cache: "no-store" });
        // Logged out (an expired login in a tab left open): say so — the
        // list would otherwise just stop updating, and saves would fail.
        ($("auth-warn") as HTMLElement).hidden = r.status !== 401;
        if (r.status === 401) return false;
        const j = await r.json();
        if (!r.ok || !j.ok || !Array.isArray(j.catalog)) return false;
        lastRefreshAt = Date.now();
        const before = JSON.stringify([catalog, regions]);
        catalog.splice(0, catalog.length, ...j.catalog);
        if (Array.isArray(j.regions)) regions.splice(0, regions.length, ...j.regions);
        if (JSON.stringify([catalog, regions]) === before) return false;
        // Tile counts + whatever product list is showing follow the new data.
        tilesEl.querySelectorAll<HTMLElement>("[data-cat]").forEach((btn) => {
          const small = btn.querySelector("small");
          if (small && btn.dataset.track === "true") small.textContent = catalog.filter((v) => v.categoryId === btn.dataset.cat).length + " items";
        });
        renderRegionChips();
        renderProducts();
        return true;
      } catch { return false; } finally { refreshInFlight = null; }
    })();
    return refreshInFlight;
  }
  document.addEventListener("visibilitychange", () => { if (document.visibilityState === "visible") refreshCatalog(); });
  window.addEventListener("focus", () => refreshCatalog());
  setInterval(() => { if (document.visibilityState === "visible") refreshCatalog(); }, 90_000);

  // ---------- Search + scan ----------
  // Barcode auto-add (wedge scanners "type" the code). In order:
  //  1. our printed codes (internal label code TL…, numeric label code) — they
  //     name ONE condition, so they never ask;
  //  2. the LISTING's UPC — every condition shares it, so when the listing has
  //     more than one sellable condition the cashier picks (below the search);
  //  3. a condition's own barcode / extra barcodes;
  //  4. a UNIQUE exact SKU (ambiguous SKUs stay a search).
  // UPC/EAN compare as GTINs, so a 12-digit camera read still hits a code
  // stored in 13-digit form. Returns the candidate rows (empty = no hit).
  function resolveCode(raw: string): any[] {
    const code = raw.trim();
    if (!code) return [];
    const own = catalog.find((v: any) => (v.labelCode && v.labelCode === code) || (v.internalCode && v.internalCode === code.toUpperCase()));
    if (own) return [own];
    const upcHits = catalog.filter((v: any) => (v.upcs || []).some((u: string) => barcodeEq(u, code)));
    if (upcHits.length) {
      const pids = new Set(upcHits.map((v: any) => v.productId));
      const sellable = catalog.filter((v: any) => pids.has(v.productId) && !v.blocked);
      if (!sellable.length) return [upcHits[0]]; // all blocked → addVariant explains why
      const inStock = sellable.filter((v: any) => v.qty > 0);
      return inStock.length ? inStock : sellable;
    }
    const hit = catalog.find((v: any) => barcodeEq(v.barcode, code) || (v.altBarcodes && v.altBarcodes.some((b: string) => barcodeEq(b, code))));
    if (hit) return [hit];
    if (code.length >= 3) {
      const skuHits = catalog.filter((v: any) => v.sku && v.sku.toUpperCase() === code.toUpperCase());
      if (skuHits.length === 1) return skuHits;
    }
    return [];
  }
  // "Which condition?" — shown in place of the search results. Never focused:
  // a wedge scanner's Enter must not pick an option, and the next scan simply
  // replaces it.
  let pick: { title: string; regionCode: string; code: string; rows: any[] } | null = null;
  function takeHit(rows: any[], code: string): boolean {
    if (!rows.length) return false;
    if (rows.length === 1) { pick = null; addVariant(rows[0].variantId); }
    else pick = { title: rows[0].title + (rows[0].platform ? ` (${rows[0].platform})` : ""), regionCode: rows[0].regionCode, code, rows };
    return true;
  }
  const looksScanned = (code: string) => /^[A-Za-z0-9-]{8,}$/.test(code);
  $("prod-search").addEventListener("input", (e) => {
    const input = e.target as HTMLInputElement;
    search = input.value;
    const code = search.trim();
    pick = null;
    if (takeHit(resolveCode(code), code)) { search = ""; input.value = ""; }
    else if (looksScanned(code)) {
      // A scan that misses may be an item added/edited since this station
      // loaded — re-pull the catalog once and retry (throttled inside).
      refreshCatalog().then((changed) => {
        if (!changed || input.value.trim() !== code) return;
        if (takeHit(resolveCode(code), code)) { search = ""; input.value = ""; }
        renderProducts();
      });
    }
    renderProducts();
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && pick) { pick = null; renderProducts(); } });
  $("scan-btn").addEventListener("click", () => { ($("prod-search") as HTMLInputElement).focus(); });
  // Phone-as-scanner: scans stream into the search box like a wedge scanner;
  // the phone is told what each one hit (or that nothing did).
  const scanTarget = {
    target: () => $("prod-search") as HTMLInputElement,
    page: "Checkout",
    describe: (code: string) => {
      const rows = resolveCode(code);
      if (!rows.length) return null;
      const v = rows[0];
      const title = displayTitle(v.title, v.regionCode, regions);
      if (rows.length > 1) return `${title}${v.platform ? ` (${v.platform})` : ""} · ${rows.length} conditions — choose on the register`;
      const cond = [v.completeness, v.condition].filter(Boolean).join(" ");
      return `${title}${v.platform ? ` (${v.platform})` : ""}${cond ? ` · ${cond}` : ""} · ${money(v.priceCents)}${v.qty <= 0 ? " · OUT OF STOCK" : ""}`;
    },
  };
  initScanReceiver(scanTarget);
  $("phone-scan-btn").addEventListener("click", () => openPairDialog(scanTarget));
  ($("cart-disc") as HTMLInputElement).addEventListener("input", recalc);
  ($("cash-in") as HTMLInputElement).addEventListener("input", recalc);

  // ---------- Held sales (hold / resume) ----------
  let heldId: string | null = null;
  let heldCache: any[] = []; // last-loaded held sales (for ?resume= deep links)

  const timeAgo = (iso: string) => {
    const s = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    if (s < 60) return "just now";
    if (s < 3600) return Math.floor(s / 60) + "m ago";
    if (s < 86400) return Math.floor(s / 3600) + "h ago";
    return Math.floor(s / 86400) + "d ago";
  };
  const custName = (c: any) => (c ? `${c.first_name ?? ""} ${c.last_name ?? ""}`.trim() : "");

  async function loadHeld() {
    try {
      const j = await (await fetch("/api/pos/checkout")).json();
      const all: any[] = j.held || [];
      heldCache = all;
      const held = all.filter((h) => h.id !== heldId); // hide the one being worked on
      $("held-list").innerHTML = held.map((h) => {
        const n = (h.transaction_items || []).reduce((s: number, it: any) => s + (it.qty || 1), 0);
        const who = custName(h.customer);
        return `<div class="held-chip">
            <button class="held-chip-main" data-resume="${h.id}" type="button">
              <span class="held-chip-id">#${h.human_id}</span>${who ? `<span class="held-chip-who">${esc(who)}</span>` : ""}
              <span class="held-chip-total">${money(h.total_cents)}</span>
              <small>${n} item${n === 1 ? "" : "s"} · ${timeAgo(h.created_at)}</small>
            </button>
            <button class="held-chip-del" data-del="${h.id}" type="button" title="Delete held sale" aria-label="Delete held sale #${h.human_id}">✕</button>
          </div>`;
      }).join("");
      ($("held-bar") as HTMLElement).hidden = held.length === 0;
      $("held-list").querySelectorAll<HTMLButtonElement>("[data-resume]").forEach((b) =>
        b.addEventListener("click", () => { if (!busy) resumeHeld(all.find((x) => x.id === b.dataset.resume)); }));
      $("held-list").querySelectorAll<HTMLButtonElement>("[data-del]").forEach((b) =>
        b.addEventListener("click", () => deleteHeld(all.find((x) => x.id === b.dataset.del))));
    } catch { /* leave the bar as-is */ }
  }

  function resumeHeld(h: any) {
    if (!h) return;
    // This computer has unsaved changes to that very sale (from before a
    // reload) — offer them rather than silently loading the older server copy.
    if (parked && parked.heldId === h.id) {
      if (confirm(`This computer has changes to sale #${h.human_id} that weren't saved (from ${new Date(parked.at).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })}).\n\nOK = continue with those changes · Cancel = open the last saved version (the changes stay offered above)`)) {
        applyParked(parked);
        return;
      }
    }
    if (cart.length && heldId !== h.id && !confirm(`Replace the current cart with held sale #${h.human_id}?`)) return;
    cart = (h.transaction_items || []).map((it: any) => {
      const cv = catalog.find((c) => c.variantId === it.variant_id);
      const cat = categories.find((c) => c.id === it.category_id);
      // A shipping-protection add-on gets its "upsell:" key back (its box
      // shows ticked; ticking again doesn't add a second one) — matched by
      // its label. A custom item is a retail line with no listing.
      const up = !it.variant_id && it.kind === "service" ? upsellBoxes().find((b) => b.dataset.label === it.description) : undefined;
      const custom = !it.variant_id && it.department === "retail";
      return {
        key: up ? "upsell:" + up.dataset.upsell : crypto.randomUUID(), variantId: it.variant_id, categoryId: it.category_id, kind: it.kind,
        title: it.description,
        meta: cv ? `${cv.platform} · ${cv.condition}` : up ? "Shipping protection" : custom ? (cat ? `Custom · ${cat.name}` : "Custom item") : (cat?.name || ""),
        unitPriceCents: it.unit_price_cents, qty: it.qty, discountCents: it.discount_cents, regionCode: cv?.regionCode, custom,
      };
    });
    heldId = h.id;
    heldLineIds = (h.transaction_items || []).map((it: any) => it.id).filter(Boolean);
    cartRef = crypto.randomUUID();
    unanswered = []; lostSig = "";
    savedAt = null;
    // The sale-level discount it was held with (its total discount minus the
    // lines' own); no cash tendered carried over.
    const lineDisc = (h.transaction_items || []).reduce((a: number, it: any) => a + (it.discount_cents || 0), 0);
    ($("cart-disc") as HTMLInputElement).value = (Math.max(0, (h.discount_cents || 0) - lineDisc) / 100).toFixed(2).replace(/\.00$/, "");
    ($("cash-in") as HTMLInputElement).value = "";
    ($("sale-name") as HTMLInputElement).value = h.note || "";
    setCustomer(h.customer?.id ? h.customer : null);
    $("receipt").hidden = true;
    renderResumeBanner(h.human_id);
    savedSig = sig();
    renderCart();
    loadHeld();
  }

  async function deleteHeld(h: any) {
    if (!h) return;
    if (!confirm(`Delete held sale #${h.human_id}? This can't be undone.`)) return;
    try {
      const res = await fetch("/api/pos/checkout", {
        method: "DELETE", headers: { "content-type": "application/json" }, body: JSON.stringify({ id: h.id }),
      });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Delete failed");
      if (heldId === h.id) { newCart(); renderCart(); }
      dropParked(h.id);
      loadHeld();
    } catch (err: any) { alert("Could not delete: " + err.message); }
  }

  // The open sale's number, and when 💾 Save last stored it.
  let heldHuman: number | null = null;
  let savedAt: number | null = null;
  // This cart's id (a retry after a lost answer finds the same sale instead of
  // making a second one), the sale's line ids as last loaded / saved here (a
  // save never overwrites a newer one from another screen), and what the cart
  // looked like then (= nothing unsaved).
  let cartRef = crypto.randomUUID();
  let heldLineIds: string[] | null = null;
  let savedSig = "";
  // Saves that got no answer (wifi / time-out): sent with the next save so the
  // server recognises its own earlier write instead of "changed elsewhere";
  // `lostSig` = what such a save sent.
  let unanswered: string[] = [];
  let lostSig = "";
  const sig = () => JSON.stringify([cart.map((i) => [i.variantId, i.title, i.qty, i.unitPriceCents, i.discountCents]), ($("cart-disc") as HTMLInputElement).value, customer?.id ?? null, ($("sale-name") as HTMLInputElement).value.trim()]);
  // A fresh register: no cart, no open sale.
  function newCart() {
    cart = []; heldId = null; heldLineIds = null; cartRef = crypto.randomUUID(); savedSig = "";
    unanswered = []; lostSig = "";
    ($("cart-disc") as HTMLInputElement).value = "0"; ($("cash-in") as HTMLInputElement).value = "";
    ($("sale-name") as HTMLInputElement).value = "";
    setCustomer(null);
    renderResumeBanner(null);
  }
  function renderResumeBanner(humanId: number | null) {
    const el = $("resume-banner") as HTMLElement;
    heldHuman = humanId;
    if (heldId == null) { el.hidden = true; el.innerHTML = ""; savedAt = null; return; }
    el.hidden = false;
    const when = savedAt ? new Date(savedAt).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" }) : "";
    const nm = ($("sale-name") as HTMLInputElement).value.trim();
    el.innerHTML = `▶ Sale <strong>#${humanId}</strong>${nm ? ` · ${esc(nm)}` : ""}${when ? ` · 💾 saved ${when}` : " · resumed"} · <button class="link-btn" id="resume-cancel" type="button">start a new sale</button>`;
    $("resume-cancel").addEventListener("click", () => {
      if (cart.length && sig() !== savedSig && !confirm(`Put sale #${humanId} aside and start a new one? Your changes since the last 💾 Save are NOT saved.`)) return;
      newCart(); renderCart(); loadHeld();
    });
  }

  // ---------- Backup of the cart on this computer ----------
  // The cart lives in this tab until it's saved; a refresh / crash would lose
  // it. Every change is copied to localStorage (per employee); after a reload
  // a copy with unsaved changes is offered back (never applied on its own).
  // A copy that's fully saved on the server is just dropped.
  const BK = `tl-checkout-cart:${data.userId || "anon"}`, BK_PREV = `${BK}:prev`;
  let parked: any = null; // the copy offered back after a reload
  function backup() {
    try {
      if (cart.length) localStorage.setItem(BK, JSON.stringify({ at: Date.now(), heldId, heldHuman, heldLineIds, cartRef, unanswered, cart, cartDisc: ($("cart-disc") as HTMLInputElement).value, customer, saleName: ($("sale-name") as HTMLInputElement).value, dirty: sig() !== savedSig || unanswered.length > 0 }));
      else localStorage.removeItem(BK);
    } catch { /* private mode / full */ }
  }
  // This tab took over (resumed / saved / completed) the parked copy's sale →
  // the copy is stale.
  function dropParked(saleId?: string | null) {
    if (!parked || saleId === null || (saleId !== undefined && parked.heldId !== saleId)) return;
    parked = null;
    try { localStorage.removeItem(BK_PREV); } catch {}
    const el = $("restore-banner") as HTMLElement; el.hidden = true; el.innerHTML = "";
  }
  function offerRestore() {
    let prev: any = null;
    try {
      const raw = localStorage.getItem(BK) || localStorage.getItem(BK_PREV);
      prev = raw ? JSON.parse(raw) : null;
      if (prev && prev.heldId && !prev.dirty) prev = null; // all of it is in that saved sale
      // Park it so this session's own backups can't overwrite it before a choice.
      localStorage.removeItem(BK);
      if (prev) localStorage.setItem(BK_PREV, JSON.stringify(prev)); else localStorage.removeItem(BK_PREV);
    } catch { prev = null; }
    const el = $("restore-banner") as HTMLElement;
    if (!prev || !Array.isArray(prev.cart) || !prev.cart.length) { el.hidden = true; return; }
    parked = prev;
    const n = prev.cart.reduce((s: number, i: any) => s + (i.qty || 1), 0);
    const sum = prev.cart.reduce((s: number, i: any) => s + i.unitPriceCents * i.qty - (i.discountCents || 0), 0);
    const when = new Date(prev.at).toLocaleString([], { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
    el.hidden = false;
    el.innerHTML = `↺ A cart from <strong>${esc(when)}</strong>${prev.heldHuman ? ` (sale #${prev.heldHuman}, with changes after its last save)` : ""} wasn't finished — ${n} item${n === 1 ? "" : "s"} · ${money(sum)}. <button class="link-btn" id="rb-restore" type="button">Restore it</button> · <button class="link-btn" id="rb-drop" type="button">Discard</button>`;
    $("rb-restore").addEventListener("click", () => {
      if (busy) return;
      if (cart.length && !confirm("Replace the current cart with the unfinished one?")) return;
      applyParked(prev);
    });
    $("rb-drop").addEventListener("click", () => { if (confirm("Discard the unfinished cart? This can't be undone.")) dropParked(); });
  }
  function applyParked(prev: any) {
      cart = prev.cart;
      heldId = prev.heldId || null;
      heldLineIds = Array.isArray(prev.heldLineIds) ? prev.heldLineIds : null;
      cartRef = prev.cartRef || crypto.randomUUID();
      unanswered = Array.isArray(prev.unanswered) ? prev.unanswered : [];
      ($("sale-name") as HTMLInputElement).value = prev.saleName || "";
      setCustomer(prev.customer || null);
      ($("cart-disc") as HTMLInputElement).value = prev.cartDisc || "0";
      savedAt = null; savedSig = ""; // restored = not saved yet
      renderResumeBanner(heldId ? prev.heldHuman : null);
      dropParked(); renderCart(); loadHeld();
  }

  // ---------- ✓ Mark paid (managers) ----------
  const pform = document.getElementById("paid-form") as HTMLFormElement | null;
  const pfCents = (id: string) => { const t = ($(id) as HTMLInputElement).value.replace(/[$,\s]/g, ""); if (!t) return 0; const n = Number(t); return Number.isFinite(n) && n >= 0 ? Math.round(n * 100) : NaN; };
  const itemsTotal = () => cart.reduce((s, i) => s + i.unitPriceCents * i.qty, 0);
  function pfSync() {
    const cash = pfCents("pf-cash"), card = pfCents("pf-card"), sub = itemsTotal(), paid = cash + card;
    const el = $("pf-sum");
    if (!Number.isFinite(paid)) { el.innerHTML = `<span class="bad">Type amounts like 125.50</span>`; return; }
    el.innerHTML = `Items ${money(sub)} · paid <strong>${money(paid)}</strong>` + (paid > sub ? ` · <span class="bad">more than the items — an item is missing?</span>` : paid < sub ? ` · ${money(sub - paid)} recorded as discount` : "");
  }
  if (pform) {
    $("paid-btn").addEventListener("click", () => {
      pform.hidden = !pform.hidden;
      if (!pform.hidden) { pform.reset(); pfSync(); ($("pf-cash") as HTMLInputElement).focus(); pform.scrollIntoView({ block: "nearest" }); }
    });
    $("pf-cancel").addEventListener("click", () => { pform.hidden = true; });
    pform.addEventListener("input", pfSync);
    pform.addEventListener("submit", (e) => {
      e.preventDefault();
      const cash = pfCents("pf-cash"), card = pfCents("pf-card"), sub = itemsTotal(), paid = cash + card;
      if (!Number.isFinite(paid) || paid <= 0) { alert("Type the cash and/or card amount that was paid."); return; }
      if (paid > sub) { alert(`Paid (${money(paid)}) is more than the items (${money(sub)}) — an item is missing, or check the amounts.`); return; }
      if (!confirm(`Mark this sale paid?\n\n${money(cash)} cash + ${money(card)} card = ${money(paid)}\nItems ${money(sub)}${paid < sub ? ` — ${money(sub - paid)} recorded as discount` : ""}\n\nEvery item comes out of stock.`)) return;
      submit("completed", { manual: { cashCents: cash, cardCents: card } });
    });
  }

  // ---------- Submit ----------
  // stay: 💾 Save — store it and keep working (the sale stays open here).
  // manual: ✓ Mark paid — the typed-in cash + card totals.
  // One save at a time: every register action is locked while it runs.
  let busy = false;
  const lockables = () => [...document.querySelectorAll<HTMLButtonElement>("#cart-actions button, #pf-go, #resume-cancel, #held-list button, #rb-restore, #rb-drop, #custom-btn")];
  async function submit(status: "completed" | "open", opts?: { stay?: boolean; manual?: { cashCents: number; cardCents: number } }) {
    if (busy) return;
    // A custom item typed but not added yet would be left off the sale.
    if (!cform.hidden && (($("cf-desc") as HTMLInputElement).value.trim() || ($("cf-price") as HTMLInputElement).value.trim())) {
      alert("Add the custom item to the cart (or Cancel it) first.");
      ($("cf-price") as HTMLInputElement).focus();
      return;
    }
    if (!cart.length) return;
    busy = true;
    const cartDisc = Math.round(parseFloat(($("cart-disc") as HTMLInputElement).value) * 100) || 0;
    const cash = Math.round(parseFloat(($("cash-in") as HTMLInputElement).value) * 100) || 0;
    const btn = $(opts?.manual ? "pf-go" : opts?.stay ? "save-btn" : status === "completed" ? "complete-btn" : "suspend-btn") as HTMLButtonElement;
    const orig = btn.textContent;
    const locked = lockables();
    locked.forEach((b) => (b.disabled = true));
    btn.textContent = "Saving…";
    try {
      // asNew: this cart's sale is gone / changed elsewhere → it can be kept
      // as a NEW held sale (never completed that way — someone completes it
      // on purpose after checking).
      let asNew = false;
      for (;;) {
        const st = asNew ? "open" : status;
        // What this attempt sends (edits made while it's in flight stay
        // unsaved / stay on the register).
        const sentSig = sig();
        const sentQty = new Map(cart.map((i) => [i.key, i.qty]));
        const saveRef = crypto.randomUUID();
        let res: Response | null = null, j: any = null;
        try {
          res = await fetch("/api/pos/checkout", {
            method: "POST", headers: { "content-type": "application/json" },
            body: JSON.stringify({
              customerId: customer?.id ?? null, status: st, resumeId: heldId, clientRef: cartRef,
              expectedLineIds: heldLineIds, saveRef, prevSaveRefs: unanswered, pageUserId: data.userId || null,
              cartDiscountCents: cartDisc, cashCents: cash, note: ($("sale-name") as HTMLInputElement).value.trim(),
              ...(opts?.manual && !asNew ? { manualPayment: opts.manual } : {}),
              items: cart.map((i) => ({ variantId: i.variantId, categoryId: i.categoryId, kind: i.kind, description: i.title, qty: i.qty, unitPriceCents: i.unitPriceCents, discountCents: i.discountCents, ...(i.custom ? { custom: true } : {}) })),
            }),
          });
          j = await res.json().catch(() => null);
        } catch { res = null; }
        if (!res || !j || (res.status >= 500 && j.state !== "retry")) {
          // No (usable) answer: it may or may not have saved. Remember this
          // attempt so the next save is recognised as its own.
          unanswered = [...unanswered, saveRef].slice(-20); lostSig = sentSig;
          backup();
          if (res && j && j.error) { alert(`Could not save: ${j.error}\n\nIt may or may not have gone through — check the Held sales strip at the top before trying again.`); loadHeld(); return; }
          alert("Couldn't confirm the save — no answer from the server (connection or time-out).\n\nIt may or may not have gone through: look at the Held sales strip at the top before trying again. Your cart is still here and backed up on this computer.");
          loadHeld();
          return;
        }
        // A definite answer: earlier lost attempts are settled.
        const prevLost = lostSig;
        unanswered = []; lostSig = "";
        if (res.ok && j.ok) {
          if (st === "open" && (opts?.stay || asNew)) {
            // Saved — still open here; the banner shows when. Edits made
            // while it was saving stay marked unsaved.
            heldId = j.id; heldLineIds = Array.isArray(j.lineIds) ? j.lineIds : null;
            savedAt = Date.now(); savedSig = sentSig;
            renderResumeBanner(j.humanId);
            dropParked(j.id);
            backup();
            loadHeld();
            if (asNew) alert(`Saved as a new held sale #${j.humanId}.`);
            return;
          }
          if (pform) pform.hidden = true;
          if (Array.isArray(j.stockMissed) && j.stockMissed.length)
            alert(`Sale saved — but stock couldn't be updated for ${j.stockMissed.length} item${j.stockMissed.length === 1 ? "" : "s"} (fix their counts in Inventory):\n\n${j.stockMissed.slice(0, 20).join("\n")}${j.stockMissed.length > 20 ? "\n…" : ""}`);
          const rc = $("receipt");
          rc.hidden = false;
          rc.innerHTML = st === "completed"
            ? `<h3>✓ Sale #${j.humanId} ${opts?.manual ? "paid" : "complete"}</h3><p>Total ${money(j.total)}${opts?.manual ? ` · ${money(opts.manual.cashCents)} cash + ${money(opts.manual.cardCents)} card` : ""}${j.change ? ` · Change due <strong>${money(j.change)}</strong>` : ""}</p><p><a href="/sales?id=${encodeURIComponent(j.id)}">See the full breakdown in Sales →</a></p>`
            : `<h3>⏸ Held as #${j.humanId}</h3><p>Saved — resume it anytime from the Held sales bar above.</p>`;
          dropParked(j.id);
          // Anything scanned while it was saving wasn't in it — it stays on
          // the register as the next sale.
          const carry = [
            ...cart.filter((i) => !sentQty.has(i.key)),
            ...cart.filter((i) => sentQty.has(i.key) && i.qty > sentQty.get(i.key)!).map((i) => ({ ...i, key: crypto.randomUUID(), qty: i.qty - sentQty.get(i.key)!, discountCents: 0 })),
          ];
          newCart();
          cart = carry;
          renderCart();
          loadHeld();
          rc.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }
        if (res.status === 401) {
          ($("auth-warn") as HTMLElement).hidden = false;
          alert("Your login has expired, so NOTHING was saved.\n\nOpen a NEW tab, log in to the POS there, then come back to THIS tab and press the button again. Don't reload this tab — your cart is here (and backed up on this computer).");
          return;
        }
        if (res.status === 409 && j.state === "completed") {
          // Already completed — never saved again. If this screen holds
          // nothing beyond what was saved / sent before, that's it (e.g. a
          // try whose answer was lost); otherwise its extra items are offered
          // as a new held sale instead of being wiped.
          const nothingNew = sig() === savedSig || (!!prevLost && (sig() === prevLost || sentSig === prevLost));
          if (nothingNew || asNew) {
            alert(`${j.error}\n\nThe register is cleared. See Reports for that sale.`);
            if (heldId) dropParked(heldId);
            newCart(); renderCart(); loadHeld();
            return;
          }
          if (!confirm(`${j.error}\n\nThis screen has items that may not be in it. Keep this cart as a NEW held sale so you can compare? (Nothing gets completed.)`)) return;
        } else if (res.status === 409 && !asNew && (j.state === "missing" || j.state === "changed")) {
          const q = j.state === "changed"
            ? `${j.error}\n\nKeep what's on THIS screen as a separate NEW held sale? (Nothing gets completed — compare both in Held sales.)`
            : `${j.error}\n\nSave this cart as a NEW held sale?`;
          if (!confirm(q)) return;
        } else {
          if (j.state === "retry" && Array.isArray(j.lineIds)) { heldLineIds = j.lineIds; backup(); }
          alert("Could not save: " + (j.error || `error ${res.status}`));
          return;
        }
        // Keep this cart as a NEW held sale: the screen becomes a fresh cart
        // first (its own new id), so a retry after a lost answer finds that
        // new sale instead of making another.
        asNew = true;
        heldId = null; heldLineIds = null; cartRef = crypto.randomUUID(); savedSig = "";
        renderResumeBanner(null);
        backup();
      }
    } finally {
      busy = false;
      locked.forEach((b) => { if (b.isConnected) b.disabled = false; });
      btn.textContent = orig;
    }
  }
  $("complete-btn").addEventListener("click", () => submit("completed"));
  $("save-btn").addEventListener("click", () => submit("open", { stay: true }));
  $("suspend-btn").addEventListener("click", () => submit("open"));
  $("clear-btn").addEventListener("click", () => {
    if (busy) return;
    if (cart.length && !confirm(heldId ? `Clear the register? Sale #${heldHuman} keeps its last 💾 save in Held sales${sig() !== savedSig ? " — changes since then are lost" : ""}.` : "Clear the cart? These items aren't saved anywhere.")) return;
    newCart(); renderCart(); $("receipt").hidden = true; loadHeld();
  });

  // initial paint (an unfinished cart from before a reload is offered back
  // first — only then do this session's changes start being backed up)
  renderRegionChips();
  renderProducts();
  setCustomer(customer);
  offerRestore();
  backupOn = true;
  renderCart();
  // Deep link from Inventory's "🛒 Sell" — drop that variant straight in the cart.
  {
    const ap = new URLSearchParams(location.search).get("add");
    if (ap) {
      const exact = catalog.find((v: any) => v.variantId === ap);
      if (exact) addVariant(exact.variantId);
      else if (takeHit(resolveCode(ap), ap)) renderProducts();
      history.replaceState(null, "", location.pathname);
    }
  }
  loadHeld().then(() => {
    // Deep link from the dashboard "Resume →" link auto-resumes that held sale.
    const rp = new URLSearchParams(location.search).get("resume");
    if (rp) {
      const h = heldCache.find((x) => x.id === rp);
      if (h) { resumeHeld(h); history.replaceState(null, "", location.pathname); }
    }
  });
</script>
