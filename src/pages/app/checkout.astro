---
export const prerender = false;

import AppLayout from "../../layouts/AppLayout.astro";
import { fmt, fullName } from "../../lib/money";
import { themeSettings } from "../../lib/themeSettings";

const supabase = Astro.locals.supabase;

const { data: storeRow } = await supabase.from("store_settings").select("settings").eq("id", 1).maybeSingle();
const gemGlow = themeSettings(storeRow?.settings).gemEffectEnabled;

const { data: categories } = await supabase.from("categories").select("*").order("sort_order");

const { data: variantRows } = await supabase
  .from("product_variants")
  .select("id, condition, completeness, price_cents, quantity, sku, barcode, product:products(title, platform, category:categories(id,name,color,is_trackable))")
  .order("price_cents", { ascending: false });

const catalog = (variantRows ?? []).map((v: any) => ({
  variantId: v.id,
  title: v.product?.title ?? "Item",
  platform: v.product?.platform ?? "",
  condition: v.condition,
  completeness: v.completeness,
  priceCents: v.price_cents,
  qty: v.quantity,
  sku: v.sku,
  barcode: v.barcode,
  categoryId: v.product?.category?.id ?? null,
  categoryName: v.product?.category?.name ?? "",
  categoryColor: v.product?.category?.color ?? "#2ce6e0",
}));

const customerId = Astro.url.searchParams.get("customer");
let customer = null;
if (customerId) {
  const { data } = await supabase.from("customers").select("*").eq("id", customerId).maybeSingle();
  customer = data;
}

const posData = { catalog, categories: categories ?? [], customer };
---

<AppLayout title="Checkout" active="checkout">
  <div id="held-bar" class="held-bar" hidden>
    <span class="held-bar-title">🔖 Held sales</span>
    <div id="held-list" class="held-list"></div>
  </div>

  <div class="checkout-grid">
    <!-- LEFT: catalog -->
    <div class="pos-panel">
      {customer && (
        <div class="cust-bar">
          <span>🧑 <strong>{fullName(customer)}</strong> · {customer.membership}</span>
          <span class="muted">{fmt(customer.store_credit_cents)} store credit</span>
        </div>
      )}

      <div class="search" style="margin-bottom:0.8rem;">
        <span class="mag" aria-hidden="true">🔎</span>
        <input id="prod-search" type="search" placeholder="Search title, platform, or SKU — or scan a barcode" autocomplete="off" />
        <button id="scan-btn" class="btn btn-ghost btn-sm" type="button" title="Scan a barcode" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);">📷 Scan</button>
      </div>

      <div class="tiles" id="cat-tiles" data-gem-glow={gemGlow ? "on" : "off"}></div>
      <div id="prod-list" style="margin-top:0.9rem;display:grid;gap:0.4rem;"></div>
    </div>

    <!-- RIGHT: cart -->
    <div class="pos-panel cart-panel">
      <h2>Cart</h2>
      <div id="resume-banner" class="resume-banner" hidden></div>
      <div id="cart" class="cart"></div>
      <p id="cart-empty" class="empty">Cart is empty — tap a category or search to add items.</p>

      <div id="upsells" class="upsells" hidden>
        <p class="upsell-label">📦 Shipping protection</p>
        <label class="upsell"><input type="checkbox" data-upsell="reinforced" data-label="Reinforced box guarantee" data-price="500" /><span class="upsell-name">Reinforced box guarantee</span><span class="upsell-amt">+$5</span></label>
        <label class="upsell"><input type="checkbox" data-upsell="bubble" data-label="Extra bubble wrap padding" data-price="500" /><span class="upsell-name">Extra bubble wrap padding</span><span class="upsell-amt">+$5</span></label>
      </div>

      <div class="cart-totals" id="totals" hidden>
        <div class="row"><span>Subtotal</span><span id="t-sub">$0.00</span></div>
        <div class="row" id="t-disc-row"><span>Discounts <small id="t-disc-pct" class="muted"></small></span><span id="t-disc">-$0.00</span></div>
        <div class="row">
          <span>Cart discount $</span>
          <input id="cart-disc" type="number" min="0" step="0.01" value="0" style="width:6rem;text-align:right;" />
        </div>
        <div class="row grand"><span>Total</span><span id="t-total">$0.00</span></div>
        <div class="row" style="margin-top:0.5rem;"><span>Cash tendered $</span>
          <input id="cash-in" type="number" min="0" step="0.01" placeholder="0.00" style="width:6rem;text-align:right;" /></div>
        <div class="row" id="change-row" hidden><span>Change due</span><span id="t-change" style="color:var(--green);font-weight:700;">$0.00</span></div>
      </div>

      <div id="cart-actions" style="margin-top:1rem;display:flex;gap:0.6rem;flex-wrap:wrap;" hidden>
        <button id="complete-btn" class="btn btn-primary" style="flex:1;">Complete sale →</button>
        <button id="suspend-btn" class="btn btn-ghost btn-sm" title="Save this cart to resume later">⏸ Hold</button>
        <button id="clear-btn" class="btn btn-ghost btn-sm">Clear</button>
      </div>

      <div id="receipt" class="receipt" hidden></div>
    </div>
  </div>

  <script type="application/json" id="pos-data" set:html={JSON.stringify(posData)}></script>
</AppLayout>

<style>
  .checkout-grid { display: grid; gap: 1rem; align-items: start; }
  @media (min-width: 980px) { .checkout-grid { grid-template-columns: 1.5fr 1fr; } }
  .cart-panel { position: sticky; top: 90px; }
  .cust-bar { display:flex; justify-content:space-between; gap:1rem; padding:0.6rem 0.8rem; margin-bottom:0.8rem; background:rgba(44,230,224,.08); border:1px solid rgba(44,230,224,.3); border-radius:10px; font-size:0.9rem; }
  .prod-row { display:grid; grid-template-columns:1fr auto auto; align-items:center; gap:0.8rem; padding:0.55rem 0.7rem; border:1px solid var(--border); border-radius:10px; background:rgba(255,255,255,.02); }
  .prod-row .meta { color:var(--muted-2); font-size:0.8rem; }
  .prod-row .stock-0 { color:#ff9aa2; }
  .receipt { margin-top:1rem; padding:1rem; border:1px solid rgba(128,255,114,.4); background:rgba(128,255,114,.08); border-radius:12px; text-align:center; }
  .receipt h3 { color:var(--green); margin-bottom:0.3rem; }

  /* Shipping-protection upsells */
  .upsells { margin:0.8rem 0; padding:0.7rem 0.85rem; border:1px dashed var(--border); background:rgba(255,255,255,.02); }
  .upsell-label { font-weight:800; font-size:0.85rem; margin:0 0 0.45rem; }
  .upsell { display:flex; align-items:center; gap:0.6rem; padding:0.3rem 0; font-size:0.9rem; cursor:pointer; }
  .upsell input { width:1.15rem; height:1.15rem; accent-color:var(--cyan); flex:none; }
  .upsell-name { flex:1; }
  .upsell-amt { font-family:var(--font-mono); font-weight:700; color:var(--green); }

  /* Held sales bar (static template elements). */
  .held-bar { display:flex; align-items:center; gap:0.8rem; margin-bottom:1rem; padding:0.65rem 0.85rem; background:rgba(255,210,63,.08); border:1px solid rgba(255,210,63,.35); }
  .held-bar-title { font-weight:800; font-size:0.9rem; white-space:nowrap; }
  .held-list { display:flex; gap:0.55rem; overflow-x:auto; padding-bottom:0.15rem; }
  .resume-banner { margin-bottom:0.8rem; padding:0.5rem 0.75rem; background:rgba(44,230,224,.1); border:1px solid rgba(44,230,224,.35); font-size:0.85rem; }
</style>

<!-- Held-sale chips are built via innerHTML, so their styles must be global
     (Astro scoped styles don't reach runtime-inserted elements). -->
<style is:global>
  .held-chip { position:relative; flex:0 0 auto; }
  .held-chip-main { display:grid; grid-template-columns:auto auto; gap:0.05rem 0.6rem; align-items:baseline; width:100%; padding:0.45rem 1.5rem 0.45rem 0.7rem; background:var(--panel); border:1px solid var(--border); cursor:pointer; text-align:left; color:var(--text); transition:border-color .15s; }
  .held-chip-main:hover { border-color:var(--cyan); }
  .held-chip-id { font-weight:800; font-family:var(--font-mono); }
  .held-chip-who { font-size:0.82rem; color:var(--muted); justify-self:end; }
  .held-chip-total { font-family:var(--font-mono); font-weight:800; color:var(--green); grid-column:1; }
  .held-chip-main small { grid-column:1 / -1; color:var(--muted-2); font-size:0.72rem; white-space:nowrap; }
  .held-chip-del { position:absolute; top:1px; right:1px; width:1.3rem; height:1.3rem; display:grid; place-items:center; font-size:0.72rem; color:var(--muted-2); background:none; border:none; cursor:pointer; }
  .held-chip-del:hover { color:#ff6b6b; }
</style>

<script>
  type Item = { key: string; variantId: string | null; categoryId: string | null; kind: string; title: string; meta: string; unitPriceCents: number; qty: number; discountCents: number };
  const data = JSON.parse(document.getElementById("pos-data")!.textContent!);
  const catalog: any[] = data.catalog;
  const categories: any[] = data.categories;
  const customer: any = data.customer;

  const money = (c: number) => (c / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[m] as string));
  const $ = (id: string) => document.getElementById(id)!;

  // A glass gem shaped like each category's item, tinted with its colour
  // (game case, GameCube cube, controller, book, disc, etc.).
  function catGem(name: string, color: string): string {
    const id = "lg-" + name.toLowerCase().replace(/[^a-z0-9]/g, "");
    const F = `url(#${id})`;
    const n = name.toLowerCase();
    let shape: string;
    if (n.includes("console"))
      shape = `<polygon points="12,3 19,7 12,11 5,7" fill="${F}"/><polygon points="5,7 12,11 12,19 5,15" fill="${color}" fill-opacity="0.62"/><polygon points="19,7 12,11 12,19 19,15" fill="${color}" fill-opacity="0.88"/><circle cx="12" cy="6.7" r="1.5" fill="#fff" fill-opacity="0.22"/><g fill="none" stroke="#fff" stroke-opacity="0.32" stroke-width="0.55"><polygon points="12,3 19,7 12,11 5,7"/><path d="M5,7 12,11 19,7 M12,11 12,19"/></g><path d="M12,3.7 17,6.5" stroke="#fff" stroke-width="0.9" stroke-opacity="0.55" stroke-linecap="round"/>`;
    else if (n.includes("accessor"))
      shape = `<path d="M7.5,9 C4.5,9 3.3,11.5 3.2,13.8 C3.1,16 4.8,16.4 6,15.4 C6.9,14.7 7.4,14 8.2,14 H15.8 C16.6,14 17.1,14.7 18,15.4 C19.2,16.4 20.9,16 20.8,13.8 C20.7,11.5 19.5,9 16.5,9 Z" fill="${F}"/><circle cx="8" cy="11.7" r="1.25" fill="#fff" fill-opacity="0.3"/><circle cx="16.2" cy="11" r="0.85" fill="#fff" fill-opacity="0.3"/><circle cx="14.4" cy="12.4" r="0.85" fill="#fff" fill-opacity="0.3"/><ellipse cx="9" cy="10" rx="3" ry="0.85" fill="#fff" fill-opacity="0.3"/>`;
    else if (n.includes("book"))
      shape = `<path d="M6.5,4 H15.5 A2,2 0 0 1 17.5,6 V18 A2,2 0 0 1 15.5,20 H6.5 Z" fill="${F}"/><line x1="8.4" y1="4" x2="8.4" y2="20" stroke="#fff" stroke-opacity="0.3" stroke-width="0.6"/><g stroke="#fff" stroke-opacity="0.28" stroke-width="0.55"><line x1="10.2" y1="8" x2="15" y2="8"/><line x1="10.2" y1="11" x2="15" y2="11"/><line x1="10.2" y1="14" x2="13.6" y2="14"/></g><ellipse cx="12" cy="6" rx="3" ry="0.75" fill="#fff" fill-opacity="0.32"/>`;
    else if (n.includes("movie"))
      shape = `<rect x="4" y="6.5" width="16" height="11" rx="2" fill="${F}"/><polygon points="10,9.8 15,12 10,14.2" fill="#fff" fill-opacity="0.75"/><ellipse cx="8.5" cy="8.3" rx="3.5" ry="0.85" fill="#fff" fill-opacity="0.3"/><rect x="4" y="6.5" width="16" height="11" rx="2" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="0.55"/>`;
    else if (n.includes("gift"))
      shape = `<rect x="3.5" y="7" width="17" height="11" rx="1.5" fill="${F}"/><rect x="3.5" y="10.2" width="17" height="2" fill="#fff" fill-opacity="0.22"/><rect x="6" y="14.4" width="4.5" height="1.8" rx="0.4" fill="#fff" fill-opacity="0.4"/><ellipse cx="9" cy="9" rx="3.6" ry="0.8" fill="#fff" fill-opacity="0.3"/><rect x="3.5" y="7" width="17" height="11" rx="1.5" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="0.55"/>`;
    else if (n.includes("disc"))
      shape = `<circle cx="12" cy="12" r="8.4" fill="${F}"/><circle cx="12" cy="12" r="2.3" fill="#0a0a12" fill-opacity="0.55"/><circle cx="12" cy="12" r="8.4" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="0.55"/><path d="M12,4.2 A7.8,7.8 0 0 1 19.2,9" fill="none" stroke="#fff" stroke-opacity="0.5" stroke-width="1.1" stroke-linecap="round"/>`;
    else if (n.includes("toy"))
      shape = `<polygon points="12,2.6 14.5,8.8 21.2,9.2 16,13.4 17.8,20 12,16.3 6.2,20 8,13.4 2.8,9.2 9.5,8.8" fill="${F}"/><polygon points="12,2.6 14.5,8.8 21.2,9.2 16,13.4 17.8,20 12,16.3 6.2,20 8,13.4 2.8,9.2 9.5,8.8" fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="0.6" stroke-linejoin="round"/><ellipse cx="12" cy="6.5" rx="1.4" ry="0.7" fill="#fff" fill-opacity="0.4"/>`;
    else if (n.includes("game") || n.includes("video"))
      shape = `<rect x="6.5" y="3" width="11" height="18" rx="0.5" fill="${F}"/><line x1="9" y1="3.4" x2="9" y2="20.6" stroke="#fff" stroke-opacity="0.3" stroke-width="0.7"/><rect x="10.5" y="6" width="5.3" height="7" fill="#fff" fill-opacity="0.16"/><rect x="6.5" y="3" width="11" height="18" rx="0.5" fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="0.7"/><ellipse cx="12" cy="5.3" rx="3.4" ry="0.8" fill="#fff" fill-opacity="0.35"/>`;
    else
      shape = `<polygon points="5,8 8,3 16,3 19,8 12,21" fill="${F}"/><polygon points="8,3 16,3 15,8 9,8" fill="#fff" fill-opacity="0.26"/><g fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="0.6"><polygon points="5,8 8,3 16,3 19,8 12,21"/><path d="M9,8 8,3 M15,8 16,3 M9,8 15,8 M5,8 12,21 19,8 M12,8 12,21"/></g><path d="M9.6,4.6 11.2,4.6" stroke="#fff" stroke-width="0.9" stroke-opacity="0.85" stroke-linecap="round"/>`;

    return `<svg class="cat-gem" viewBox="0 0 24 24" aria-hidden="true">
      <defs><linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="0.55"/>
        <stop offset="0.42" stop-color="${color}"/>
        <stop offset="1" stop-color="${color}" stop-opacity="0.92"/>
      </linearGradient></defs>${shape}</svg>`;
  }

  let cart: Item[] = [];
  let activeCat: string | null = null;
  let search = "";

  // ---------- Category tiles ----------
  const tilesEl = $("cat-tiles");
  tilesEl.innerHTML = categories
    .map((c) => `<button class="tile-btn" data-cat="${c.id}" data-track="${c.is_trackable}">
        <span class="gem-box">${catGem(c.name, c.color)}<span class="gem-shine" aria-hidden="true"></span></span>
        <span class="tile-name">${esc(c.name)}</span>
        <small>${c.is_trackable ? catalog.filter((v) => v.categoryId === c.id).length + " items" : "custom / service"}</small>
      </button>`)
    .join("");

  // Mouse-reactive gem glisten: track the cursor over the tile grid (rAF-throttled)
  // and feed its position to the hovered gem as CSS vars so the highlight follows.
  // Honours the store "gem effect" setting (data-gem-glow) + reduced-motion.
  const glowOn = tilesEl.dataset.gemGlow !== "off" &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (glowOn) {
    let rafPending = false, lastEv: PointerEvent | null = null;
    tilesEl.addEventListener("pointermove", (e) => {
      lastEv = e as PointerEvent;
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        rafPending = false;
        const tile = (lastEv!.target as HTMLElement).closest<HTMLElement>(".tile-btn");
        if (!tile) return;
        const box = tile.querySelector<HTMLElement>(".gem-box");
        if (!box) return;
        const r = box.getBoundingClientRect();
        box.style.setProperty("--gx", `${((lastEv!.clientX - r.left) / r.width) * 100}%`);
        box.style.setProperty("--gy", `${((lastEv!.clientY - r.top) / r.height) * 100}%`);
        const dx = (lastEv!.clientX - (r.left + r.width / 2)) / r.width;
        const dy = (lastEv!.clientY - (r.top + r.height / 2)) / r.height;
        box.style.setProperty("--tilt", `perspective(240px) rotateX(${(-dy * 14).toFixed(2)}deg) rotateY(${(dx * 14).toFixed(2)}deg)`);
      });
    });
    tilesEl.addEventListener("pointerleave", () => {
      tilesEl.querySelectorAll<HTMLElement>(".gem-box").forEach((b) => {
        b.style.removeProperty("--tilt");
        b.style.removeProperty("--gx");
        b.style.removeProperty("--gy");
      });
    });
  } else {
    tilesEl.classList.add("gem-flat");
  }

  tilesEl.querySelectorAll<HTMLButtonElement>(".tile-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.cat!;
      activeCat = activeCat === id ? null : id;
      tilesEl.querySelectorAll(".tile-btn").forEach((b) => b.classList.remove("active"));
      if (activeCat) btn.classList.add("active");
      if (btn.dataset.track === "false" && activeCat) {
        const cat = categories.find((c) => c.id === id);
        addCustom(cat);
        activeCat = null;
        btn.classList.remove("active");
      }
      renderProducts();
    });
  });

  // ---------- Product list ----------
  function filtered() {
    const q = search.toLowerCase();
    return catalog.filter((v) => {
      if (activeCat && v.categoryId !== activeCat) return false;
      if (!q) return true;
      return (`${v.title} ${v.platform} ${v.condition} ${v.sku ?? ""}`.toLowerCase().includes(q));
    });
  }
  function renderProducts() {
    const rows = filtered();
    $("prod-list").innerHTML = rows.length
      ? rows.map((v) => `
        <div class="prod-row">
          <span><strong>${esc(v.title)}</strong>
            <span class="meta" style="display:block;">${esc(v.platform)} · ${esc(v.condition)}${v.completeness ? " · " + esc(v.completeness) : ""}</span></span>
          <span class="meta ${v.qty === 0 ? "stock-0" : ""}">${v.qty} in stock</span>
          <button class="btn btn-ghost btn-sm" data-add="${v.variantId}">${money(v.priceCents)} ＋</button>
        </div>`).join("")
      : `<p class="empty">No matching items.</p>`;
    $("prod-list").querySelectorAll<HTMLButtonElement>("[data-add]").forEach((b) =>
      b.addEventListener("click", () => addVariant(b.dataset.add!)));
  }

  // ---------- Cart ops ----------
  function addVariant(variantId: string) {
    const v = catalog.find((x) => x.variantId === variantId);
    if (!v) return;
    const existing = cart.find((i) => i.variantId === variantId);
    if (existing) existing.qty++;
    else cart.push({ key: crypto.randomUUID(), variantId, categoryId: v.categoryId, kind: "sale", title: v.title, meta: `${v.platform} · ${v.condition}`, unitPriceCents: v.priceCents, qty: 1, discountCents: 0 });
    renderCart();
  }
  function addCustom(cat: any) {
    const label = prompt(`Add ${cat.name} item — description:`, cat.name === "Disc Repair" ? "Disc resurfacing" : cat.name);
    if (label === null) return;
    const amt = parseFloat(prompt(`Price for "${label}" ($):`, "4.99") || "0");
    if (!Number.isFinite(amt) || amt <= 0) return;
    cart.push({ key: crypto.randomUUID(), variantId: null, categoryId: cat.id, kind: cat.is_trackable ? "sale" : "service", title: label, meta: cat.name, unitPriceCents: Math.round(amt * 100), qty: 1, discountCents: 0 });
    renderCart();
  }

  function renderCart() {
    const el = $("cart");
    el.innerHTML = cart.map((i) => `
      <div class="cart-line" data-key="${i.key}">
        <div><span class="title">${esc(i.title)}</span><span class="meta" style="display:block;">${esc(i.meta)}</span></div>
        <div class="price">${money(i.unitPriceCents * i.qty - i.discountCents)}</div>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <label class="meta">Qty <input type="number" min="1" value="${i.qty}" data-qty style="width:3.6rem;"></label>
          <label class="meta">Disc $ <input type="number" min="0" step="0.01" value="${(i.discountCents/100).toFixed(2)}" data-disc style="width:4.6rem;"></label>
          ${i.discountCents > 0 ? `<span class="pill magenta">${Math.round(i.discountCents / (i.unitPriceCents*i.qty) * 100)}%</span>` : ""}
          <button class="link-btn" data-remove>✕</button>
        </div>
      </div>`).join("");

    el.querySelectorAll<HTMLElement>(".cart-line").forEach((line) => {
      const key = line.dataset.key!;
      const item = cart.find((i) => i.key === key)!;
      line.querySelector<HTMLInputElement>("[data-qty]")!.addEventListener("change", (e) => {
        item.qty = Math.max(1, parseInt((e.target as HTMLInputElement).value) || 1); renderCart();
      });
      line.querySelector<HTMLInputElement>("[data-disc]")!.addEventListener("change", (e) => {
        item.discountCents = Math.min(item.unitPriceCents * item.qty, Math.max(0, Math.round(parseFloat((e.target as HTMLInputElement).value) * 100) || 0)); renderCart();
      });
      line.querySelector("[data-remove]")!.addEventListener("click", () => { cart = cart.filter((i) => i.key !== key); renderCart(); });
    });
    recalc();
  }

  function syncUpsells() {
    document.querySelectorAll<HTMLInputElement>("[data-upsell]").forEach((cb) => {
      cb.checked = cart.some((i) => i.key === "upsell:" + cb.dataset.upsell);
    });
  }
  document.querySelectorAll<HTMLInputElement>("[data-upsell]").forEach((cb) => {
    cb.addEventListener("change", () => {
      const key = "upsell:" + cb.dataset.upsell;
      cart = cart.filter((i) => i.key !== key);
      if (cb.checked) cart.push({ key, variantId: null, categoryId: null, kind: "service", title: cb.dataset.label!, meta: "Shipping protection", unitPriceCents: Number(cb.dataset.price), qty: 1, discountCents: 0 });
      renderCart();
    });
  });

  function recalc() {
    const empty = cart.length === 0;
    $("cart-empty").hidden = !empty;
    $("totals").hidden = empty;
    ($("upsells") as HTMLElement).hidden = empty;
    syncUpsells();
    ($("cart-actions") as HTMLElement).hidden = empty;
    const subtotal = cart.reduce((s, i) => s + i.unitPriceCents * i.qty, 0);
    const itemDisc = cart.reduce((s, i) => s + i.discountCents, 0);
    const cartDisc = Math.max(0, Math.round(parseFloat(($("cart-disc") as HTMLInputElement).value) * 100) || 0);
    const totalDisc = Math.min(subtotal, itemDisc + cartDisc);
    const total = Math.max(0, subtotal - totalDisc);
    $("t-sub").textContent = money(subtotal);
    $("t-disc").textContent = "-" + money(totalDisc);
    $("t-disc-pct").textContent = subtotal ? `(${Math.round((totalDisc / subtotal) * 100)}% off)` : "";
    $("t-total").textContent = money(total);
    const cash = Math.round(parseFloat(($("cash-in") as HTMLInputElement).value) * 100) || 0;
    const change = cash > total ? cash - total : 0;
    ($("change-row") as HTMLElement).hidden = change <= 0;
    $("t-change").textContent = money(change);
  }

  // ---------- Search + scan ----------
  $("prod-search").addEventListener("input", (e) => {
    search = (e.target as HTMLInputElement).value;
    // Barcode auto-add (simulated scan): exact barcode match adds + clears.
    const hit = catalog.find((v) => v.barcode && v.barcode === search.trim());
    if (hit) { addVariant(hit.variantId); search = ""; (e.target as HTMLInputElement).value = ""; }
    renderProducts();
  });
  $("scan-btn").addEventListener("click", () => { ($("prod-search") as HTMLInputElement).focus(); });
  ($("cart-disc") as HTMLInputElement).addEventListener("input", recalc);
  ($("cash-in") as HTMLInputElement).addEventListener("input", recalc);

  // ---------- Held sales (hold / resume) ----------
  let heldId: string | null = null;
  let heldCache: any[] = []; // last-loaded held sales (for ?resume= deep links)

  const timeAgo = (iso: string) => {
    const s = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    if (s < 60) return "just now";
    if (s < 3600) return Math.floor(s / 60) + "m ago";
    if (s < 86400) return Math.floor(s / 3600) + "h ago";
    return Math.floor(s / 86400) + "d ago";
  };
  const custName = (c: any) => (c ? `${c.first_name ?? ""} ${c.last_name ?? ""}`.trim() : "");

  async function loadHeld() {
    try {
      const j = await (await fetch("/api/pos/checkout")).json();
      const all: any[] = j.held || [];
      heldCache = all;
      const held = all.filter((h) => h.id !== heldId); // hide the one being worked on
      $("held-list").innerHTML = held.map((h) => {
        const n = (h.transaction_items || []).reduce((s: number, it: any) => s + (it.qty || 1), 0);
        const who = custName(h.customer);
        return `<div class="held-chip">
            <button class="held-chip-main" data-resume="${h.id}" type="button">
              <span class="held-chip-id">#${h.human_id}</span>${who ? `<span class="held-chip-who">${esc(who)}</span>` : ""}
              <span class="held-chip-total">${money(h.total_cents)}</span>
              <small>${n} item${n === 1 ? "" : "s"} · ${timeAgo(h.created_at)}</small>
            </button>
            <button class="held-chip-del" data-del="${h.id}" type="button" title="Delete held sale" aria-label="Delete held sale #${h.human_id}">✕</button>
          </div>`;
      }).join("");
      ($("held-bar") as HTMLElement).hidden = held.length === 0;
      $("held-list").querySelectorAll<HTMLButtonElement>("[data-resume]").forEach((b) =>
        b.addEventListener("click", () => resumeHeld(all.find((x) => x.id === b.dataset.resume))));
      $("held-list").querySelectorAll<HTMLButtonElement>("[data-del]").forEach((b) =>
        b.addEventListener("click", () => deleteHeld(all.find((x) => x.id === b.dataset.del))));
    } catch { /* leave the bar as-is */ }
  }

  function resumeHeld(h: any) {
    if (!h) return;
    if (cart.length && heldId !== h.id && !confirm(`Replace the current cart with held sale #${h.human_id}?`)) return;
    cart = (h.transaction_items || []).map((it: any) => {
      const cv = catalog.find((c) => c.variantId === it.variant_id);
      const cat = categories.find((c) => c.id === it.category_id);
      return {
        key: crypto.randomUUID(), variantId: it.variant_id, categoryId: it.category_id, kind: it.kind,
        title: it.description, meta: cv ? `${cv.platform} · ${cv.condition}` : (cat?.name || ""),
        unitPriceCents: it.unit_price_cents, qty: it.qty, discountCents: it.discount_cents,
      };
    });
    heldId = h.id;
    $("receipt").hidden = true;
    renderResumeBanner(h.human_id);
    renderCart();
    loadHeld();
  }

  async function deleteHeld(h: any) {
    if (!h) return;
    if (!confirm(`Delete held sale #${h.human_id}? This can't be undone.`)) return;
    try {
      const res = await fetch("/api/pos/checkout", {
        method: "DELETE", headers: { "content-type": "application/json" }, body: JSON.stringify({ id: h.id }),
      });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Delete failed");
      if (heldId === h.id) { heldId = null; cart = []; renderResumeBanner(null); renderCart(); }
      loadHeld();
    } catch (err: any) { alert("Could not delete: " + err.message); }
  }

  function renderResumeBanner(humanId: number | null) {
    const el = $("resume-banner") as HTMLElement;
    if (heldId == null) { el.hidden = true; el.innerHTML = ""; return; }
    el.hidden = false;
    el.innerHTML = `▶ Resuming held sale <strong>#${humanId}</strong> · <button class="link-btn" id="resume-cancel" type="button">start a new sale</button>`;
    $("resume-cancel").addEventListener("click", () => { heldId = null; cart = []; renderResumeBanner(null); renderCart(); loadHeld(); });
  }

  // ---------- Submit ----------
  async function submit(status: "completed" | "open") {
    if (!cart.length) return;
    const cartDisc = Math.round(parseFloat(($("cart-disc") as HTMLInputElement).value) * 100) || 0;
    const cash = Math.round(parseFloat(($("cash-in") as HTMLInputElement).value) * 100) || 0;
    const btn = (status === "completed" ? $("complete-btn") : $("suspend-btn")) as HTMLButtonElement;
    const orig = btn.textContent; btn.disabled = true; btn.textContent = "Saving…";
    try {
      const res = await fetch("/api/pos/checkout", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({
          customerId: customer?.id ?? null, status, resumeId: heldId, cartDiscountCents: cartDisc, cashCents: cash,
          items: cart.map((i) => ({ variantId: i.variantId, categoryId: i.categoryId, kind: i.kind, description: i.title, qty: i.qty, unitPriceCents: i.unitPriceCents, discountCents: i.discountCents })),
        }),
      });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Failed");
      const rc = $("receipt");
      rc.hidden = false;
      rc.innerHTML = status === "completed"
        ? `<h3>✓ Sale #${j.humanId} complete</h3><p>Total ${money(j.total)}${j.change ? ` · Change due <strong>${money(j.change)}</strong>` : ""}</p>`
        : `<h3>⏸ Held as #${j.humanId}</h3><p>Saved — resume it anytime from the Held sales bar above.</p>`;
      cart = []; heldId = null; renderResumeBanner(null);
      ($("cart-disc") as HTMLInputElement).value = "0"; ($("cash-in") as HTMLInputElement).value = "";
      renderCart();
      loadHeld();
      rc.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch (err: any) {
      alert("Could not save: " + err.message);
    } finally {
      btn.disabled = false; btn.textContent = orig;
    }
  }
  $("complete-btn").addEventListener("click", () => submit("completed"));
  $("suspend-btn").addEventListener("click", () => submit("open"));
  $("clear-btn").addEventListener("click", () => { cart = []; heldId = null; renderResumeBanner(null); renderCart(); $("receipt").hidden = true; loadHeld(); });

  // initial paint
  renderProducts();
  renderCart();
  loadHeld().then(() => {
    // Deep link from the dashboard "Resume →" link auto-resumes that held sale.
    const rp = new URLSearchParams(location.search).get("resume");
    if (rp) {
      const h = heldCache.find((x) => x.id === rp);
      if (h) { resumeHeld(h); history.replaceState(null, "", location.pathname); }
    }
  });
</script>
