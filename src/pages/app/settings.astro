---
export const prerender = false;

import AppLayout from "../../layouts/AppLayout.astro";
import { lowStockSettings, freeShipSettings } from "../../lib/lowStock";
import { themeSettings, THEMES, SIDEBARS } from "../../lib/themeSettings";
import { aiSettings, aiStatus, AI_PROVIDERS, AI_QUALITIES } from "../../lib/ai";
import { barSettings } from "../../lib/barSettings";
import type { StoreDepartment } from "../../lib/types";
import { createSupabaseAdminClient } from "../../lib/supabase";

const supabase = Astro.locals.supabase;
const isOwner = Astro.locals.profile?.role === "owner";

// Team list (owner-only) — emails come from auth via the admin client.
let team: { id: string; full_name: string; role: string; email: string; isYou: boolean }[] = [];
if (isOwner) {
  const admin = createSupabaseAdminClient();
  const { data: profs } = await admin.from("profiles").select("id, full_name, role").order("full_name");
  // Per-id email lookup — bulk listUsers fails wholesale if any one auth row
  // can't be scanned; this degrades just that user's email to blank instead.
  const emailById = new Map<string, string>(
    await Promise.all(
      (profs ?? []).map(async (p: any): Promise<[string, string]> => {
        const { data } = await admin.auth.admin.getUserById(p.id);
        return [p.id, data?.user?.email ?? ""];
      }),
    ),
  );
  team = (profs ?? []).map((p: any) => ({ id: p.id, full_name: p.full_name, role: p.role, email: emailById.get(p.id) ?? "", isYou: p.id === Astro.locals.user!.id }));
}
const { data: row } = await supabase.from("store_settings").select("settings").eq("id", 1).maybeSingle();
const ls = lowStockSettings(row?.settings);
const fs = freeShipSettings(row?.settings);
const th = themeSettings(row?.settings);
const ai = aiSettings(row?.settings);
const notifyTasks = !!(row?.settings as any)?.notifyTaskComplete;
const menuEnabled = (row?.settings as any)?.menuEnabled === true;
const leadNotifyEnabled = (row?.settings as any)?.leadNotifyEnabled !== false;
const leadNotifyEmail = String((row?.settings as any)?.leadNotifyEmail ?? "");
const bar = barSettings(row?.settings);
const deptLocked = (row?.settings as any)?.departmentsLocked === true;
const KIND_LABEL: Record<string, string> = { retail: "Retail", food_bev: "Food & Beverage", arcade: "Arcade", service: "Service", other: "Other" };
let departments: StoreDepartment[] = [];
if (isOwner) {
  const { data: depts } = await supabase.from("store_departments").select("*").order("sort_order").order("name");
  departments = (depts as StoreDepartment[]) ?? [];
}
const aiSt = aiStatus(ai.provider);
const aiProviderLabel = aiSt.provider === "gemini" ? "Gemini" : aiSt.provider === "anthropic" ? "Claude" : "";
const minPriceDollars = (ls.lowStockMinPriceCents / 100).toFixed(2);
const freeShipDollars = (fs.freeShipThresholdCents / 100).toFixed(2);
---

<AppLayout title="Settings" active="settings">
  <p class="muted" style="margin-bottom:1.25rem;">Store-wide settings. Changes apply to the website immediately.</p>

  {isOwner && (
    <div class="pos-panel set-panel" style="margin-bottom:1.25rem;">
      <h2>Team & permissions</h2>
      <p class="muted set-desc">
        Invite employees and set access. <strong>Cashier</strong> = checkout, inventory, trade-ins ·
        <strong>Manager</strong> = + reports, pricing, settings · <strong>Owner</strong> = full access + team.
      </p>
      <table class="tbl team-tbl">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th></tr></thead>
        <tbody>
          {team.map((u) => (
            <tr>
              <td><strong>{u.full_name}</strong>{u.isYou && <span class="muted"> (you)</span>}</td>
              <td class="muted">{u.email}</td>
              <td>
                <select class="team-role" data-uid={u.id} disabled={u.isYou}>
                  <option value="cashier" selected={u.role === "cashier"}>Cashier</option>
                  <option value="manager" selected={u.role === "manager"}>Manager</option>
                  <option value="owner" selected={u.role === "owner"}>Owner</option>
                </select>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <span id="team-status" class="muted"></span>

      <h3 class="set-subh">Invite an employee</h3>
      <div class="inv-grid">
        <input id="inv-name" placeholder="Full name" autocomplete="off" />
        <input id="inv-email" type="email" placeholder="email@example.com" autocomplete="off" />
        <select id="inv-role">
          <option value="cashier">Cashier</option>
          <option value="manager">Manager</option>
          <option value="owner">Owner</option>
        </select>
        <button id="inv-send" class="btn btn-primary btn-sm">Invite</button>
      </div>
      <p id="inv-result" class="set-preview" hidden></p>
    </div>
  )}

  {isOwner && (
    <div class="pos-panel set-panel dept-panel" data-locked={deptLocked ? "1" : "0"} style="margin-bottom:1.25rem;">
      <h2>Departments <span class="dept-lock-pill" id="dept-lock-pill" hidden>🔒 Locked</span></h2>
      <p class="muted set-desc">
        The business areas this POS runs. Set these up once, then <strong>lock</strong> them — unlocking to edit
        needs you (the owner), plus a TimeLag authorization code where the software is licensed. Disabling a
        department hides its POS features. <strong>Bar vs Kitchen is a station within Food &amp; Beverage</strong>
        (set per menu item), not a separate department.
      </p>
      <table class="tbl dept-tbl">
        <thead><tr><th></th><th>Department</th><th>Type</th><th>On</th><th class="dept-act-col"></th></tr></thead>
        <tbody id="dept-rows">
          {departments.map((d) => (
            <tr data-dept-id={d.id} data-system={d.is_system ? "1" : "0"} data-name={d.name} data-kind={d.kind} data-icon={d.icon ?? ""}>
              <td class="dept-ico">{d.icon}</td>
              <td><strong>{d.name}</strong>{d.is_system && <span class="muted dept-core"> · core</span>}</td>
              <td class="muted">{KIND_LABEL[d.kind] ?? d.kind}</td>
              <td><input type="checkbox" class="dept-enabled" checked={d.is_enabled} /></td>
              <td class="dept-act-col">
                <button class="link-btn dept-edit" type="button">edit</button>
                {!d.is_system && <button class="link-btn dept-del" type="button">delete</button>}
              </td>
            </tr>
          ))}
          {departments.length === 0 && (
            <tr><td colspan="5" class="muted">No departments yet — run the departments migration, then refresh.</td></tr>
          )}
        </tbody>
      </table>
      <div class="dept-actions">
        <button id="dept-add" class="btn btn-ghost btn-sm" type="button">+ Department</button>
        <span class="dept-lock-actions">
          <button id="dept-unlock" class="btn btn-ghost btn-sm" type="button" hidden>🔓 Unlock to edit</button>
          <button id="dept-lock" class="btn btn-ghost btn-sm" type="button" hidden>🔒 Lock</button>
        </span>
        <span id="dept-status" class="muted"></span>
      </div>
    </div>
  )}

  {isOwner && (
    <div class="dept-modal" id="dept-modal" hidden>
      <div class="dept-modal-card">
        <h3 id="dm-title">New department</h3>
        <input type="hidden" id="dm-id" />
        <label class="dm-field">Name<input id="dm-name" autocomplete="off" placeholder="e.g. Retail, Arcade" /></label>
        <div class="dm-grid">
          <label class="dm-field">Type<select id="dm-kind">
            <option value="retail">Retail</option>
            <option value="food_bev">Food &amp; Beverage</option>
            <option value="arcade">Arcade</option>
            <option value="service">Service</option>
            <option value="other">Other</option>
          </select></label>
          <label class="dm-field">Icon<input id="dm-icon" maxlength="2" placeholder="🎮" /></label>
        </div>
        <label class="dm-toggle"><input type="checkbox" id="dm-enabled" checked /> Enabled</label>
        <p class="muted-2" id="dm-system-note" hidden>This is a core department — its type can't be changed.</p>
        <div class="dm-actions">
          <button id="dm-save" class="btn btn-primary btn-sm" type="button">Save</button>
          <button id="dm-cancel" class="btn btn-ghost btn-sm" type="button">Cancel</button>
          <span id="dm-status" class="muted-2"></span>
        </div>
      </div>
    </div>
  )}

  <div class="pos-panel set-panel" style="margin-bottom:1.25rem;">
    <h2>Appearance</h2>
    <p class="muted set-desc">Pick a color palette. This sets the store default for everyone; you can override it just on this device.</p>

    <div class="theme-grid" role="group" aria-label="Color palette">
      {THEMES.map((t) => (
        <button type="button" class="theme-swatch" data-theme-pick={t.key} aria-pressed={t.key === th.defaultTheme ? "true" : "false"}>
          <span class="theme-prev" style={`background:${t.swatch}`}><span class="theme-dot" style={`background:${t.accent}`}></span></span>
          <span class="theme-name">{t.label}</span>
        </button>
      ))}
    </div>
    <p class="set-preview" id="theme-scope-note">Applied as the store default. <button type="button" id="theme-local-reset" class="link-btn">Reset this device to the default</button></p>
    <span id="theme-status" class="muted"></span>

    <label class="set-row set-toggle" style="margin-top:0.6rem;">
      <input type="checkbox" id="theme-site" checked={!th.themePosOnly} />
      <span><strong>Apply the palette to the public website too</strong><br />
        <span class="muted">Off = the palette only changes the POS; customers always see the default brand look.</span></span>
    </label>
    <span id="theme-site-status" class="muted"></span>

    <h3 class="set-subh">POS sidebar accent</h3>
    <p class="muted set-desc" style="margin-bottom:0.8rem;">Recolors just the POS sidebar — mixes with any palette above.</p>
    <div class="theme-grid" role="group" aria-label="Sidebar accent">
      {SIDEBARS.map((s) => (
        <button type="button" class="theme-swatch" data-sidebar-pick={s.key} aria-pressed={s.key === th.defaultSidebar ? "true" : "false"}>
          <span class="theme-prev" style={`background:${s.swatch}`}></span>
          <span class="theme-name">{s.label}</span>
        </button>
      ))}
    </div>
    <span id="sidebar-status" class="muted"></span>

    <label class="set-row set-toggle" style="margin-top:1rem;">
      <input type="checkbox" id="gem-effect" checked={th.gemEffectEnabled} />
      <span><strong>Mouse-reactive gem shine on checkout</strong><br />
        <span class="muted">The category gems catch a moving glint as the cursor passes. Turn off for a flat look.</span></span>
    </label>
    <div class="set-actions">
      <button id="gem-save" class="btn btn-primary">Save effect</button>
      <span id="gem-status" class="muted"></span>
    </div>
  </div>

  <div class="pos-panel set-panel">
    <h2>Low-stock badge</h2>
    <p class="muted set-desc">
      Controls the “Only N left” urgency badge on the shop and product pages.
    </p>

    <label class="set-row set-toggle">
      <input type="checkbox" id="ls-enabled" checked={ls.lowStockEnabled} />
      <span><strong>Show the “Only N left” badge</strong><br />
        <span class="muted">Turn off to never show stock-urgency on the website.</span></span>
    </label>

    <label class="set-row">
      <span><strong>Show it when stock is at or below</strong><br />
        <span class="muted">Set to 1 for “Only 1 left” only; 3 shows it for 1–3 left.</span></span>
      <input type="number" id="ls-threshold" min="1" max="99" value={ls.lowStockThreshold} />
    </label>

    <label class="set-row">
      <span><strong>Only on items priced at or above</strong><br />
        <span class="muted">$0 shows it on everything. Set higher to flag only pricier items.</span></span>
      <span class="set-money">$<input type="number" id="ls-minprice" min="0" step="1" value={minPriceDollars} /></span>
    </label>

    <label class="set-row set-toggle">
      <input type="checkbox" id="ls-hover" checked={ls.lowStockHoverOnly} />
      <span><strong>Reveal on hover only</strong><br />
        <span class="muted">Hide the badge until the shopper hovers the item (less cluttered).</span></span>
    </label>

    <p class="set-preview" id="ls-preview"></p>

    <div class="set-actions">
      <button id="set-save" class="btn btn-primary">Save settings</button>
      <span id="set-status" class="muted"></span>
    </div>
  </div>

  <div class="pos-panel set-panel" style="margin-top:1.25rem;">
    <h2>Free shipping banner</h2>
    <p class="muted set-desc">A banner at the top of the shop promoting free shipping over a threshold.</p>

    <label class="set-row set-toggle">
      <input type="checkbox" id="fs-enabled" checked={fs.freeShipEnabled} />
      <span><strong>Show the free-shipping banner</strong></span>
    </label>

    <label class="set-row">
      <span><strong>Free shipping on orders over</strong></span>
      <span class="set-money">$<input type="number" id="fs-threshold" min="0" step="5" value={freeShipDollars} /></span>
    </label>

    <div class="set-actions">
      <button id="fs-save" class="btn btn-primary">Save banner</button>
      <span id="fs-status" class="muted"></span>
    </div>
  </div>

  <div class="pos-panel set-panel" style="margin-top:1.25rem;">
    <h2>Food &amp; Beverage</h2>
    <label class="set-row set-toggle">
      <input type="checkbox" id="menu-enabled" checked={menuEnabled} />
      <span><strong>Enable the Menu in the POS</strong><br />
        <span class="muted">Shows the “Menu” at the top of the sidebar (managers only), store-wide. Turn off for a retail-only setup.</span></span>
    </label>
    <div class="set-actions">
      <button id="menu-save" class="btn btn-primary">Save</button>
      <span id="menu-status" class="muted"></span>
    </div>

    <h3 class="set-subh">Bar tabs</h3>
    <label class="set-row">
      <span><strong>Auto-close tabs at closing time</strong><br />
        <span class="muted">Tabs left open at closing are settled to card on file. Blank = never auto-close.</span></span>
      <input type="time" id="tab-closing" value={bar.tabClosingTime} />
    </label>
    <label class="set-row set-toggle">
      <input type="checkbox" id="tab-grat-enabled" checked={bar.tabAutoGratuityEnabled} />
      <span><strong>Add auto-gratuity to tabs left open</strong><br />
        <span class="muted">Applied only when a tab is auto-closed at closing — never on a normal settle.</span></span>
    </label>
    <label class="set-row">
      <span><strong>Auto-gratuity percent</strong></span>
      <span class="set-money"><input type="number" id="tab-grat-pct" min="0" max="100" step="1" value={bar.tabAutoGratuityPercent} />%</span>
    </label>
    <div class="set-actions">
      <button id="tab-save" class="btn btn-primary">Save bar settings</button>
      <span id="tab-status" class="muted"></span>
    </div>

    <label class="set-row set-toggle" style="margin-top:0.6rem;">
      <input type="checkbox" id="menu-primary" />
      <span><strong>Make Menu the primary view on this device</strong><br />
        <span class="muted">This computer only — saves instantly. Expands the menu sections under “Menu” in the sidebar by default (e.g. set this on the bar POS).</span></span>
    </label>
  </div>

  <div class="pos-panel set-panel" style="margin-top:1.25rem;">
    <h2>Tasks</h2>
    <label class="set-row set-toggle">
      <input type="checkbox" id="notify-tasks" checked={notifyTasks} />
      <span><strong>Notify managers when a task is completed</strong><br />
        <span class="muted">Managers with alerts enabled get a desktop notification as tasks get checked off.</span></span>
    </label>
    <div class="set-actions">
      <button id="notify-save" class="btn btn-primary">Save</button>
      <span id="notify-status" class="muted"></span>
    </div>
  </div>

  <div class="pos-panel set-panel" style="margin-top:1.25rem;">
    <h2>Lead notifications</h2>
    <p class="muted set-desc">When someone submits the “Sell your games” form on the website, it always lands in the <strong>Leads</strong> tab (and pings staff in-app). This also emails you a copy.</p>
    <label class="set-row set-toggle">
      <input type="checkbox" id="lead-notify" checked={leadNotifyEnabled} />
      <span><strong>Email me new sell / trade leads</strong><br />
        <span class="muted">Needs email delivery configured (Resend). Off = leads still show in the Leads tab, just no email.</span></span>
    </label>
    <label class="set-row">
      <span><strong>Send lead emails to</strong><br />
        <span class="muted">Leave blank to use the shop inbox.</span></span>
      <input type="email" id="lead-email" placeholder="you@timelag.co" value={leadNotifyEmail} style="width:16rem;text-align:left;" />
    </label>
    <div class="set-actions">
      <button id="lead-save" class="btn btn-primary">Save</button>
      <span id="lead-status" class="muted"></span>
    </div>
  </div>

  <div class="pos-panel set-panel" style="margin-top:1.25rem;">
    <h2>AI assistant</h2>
    <p class="muted set-desc">
      Powers the “✨ Write with AI” description button (more skills coming).
      Status: {aiSt.configured
        ? <span style="color:var(--green);font-weight:700;">● Connected via {aiProviderLabel}</span>
        : <span style="color:var(--magenta);font-weight:700;">● Not configured</span>}
      {!aiSt.configured && <span class="muted"> — add <code>GEMINI_API_KEY</code> (free tier) or <code>ANTHROPIC_API_KEY</code> to your env (.env + Vercel) to enable.</span>}
    </p>

    <label class="set-row" style="display:block;">
      <strong>Provider</strong>
      <select id="ai-provider" style="margin-top:0.4rem;width:100%;max-width:320px;">
        {AI_PROVIDERS.map((p) => <option value={p.key} selected={p.key === ai.provider}>{p.label}</option>)}
      </select>
    </label>

    <label class="set-row" style="display:block;">
      <strong>Quality</strong>
      <select id="ai-quality" style="margin-top:0.4rem;width:100%;max-width:320px;">
        {AI_QUALITIES.map((q) => <option value={q.key} selected={q.key === ai.quality}>{q.label}</option>)}
      </select>
    </label>

    <label class="set-row" style="display:block;">
      <strong>Brand voice for descriptions</strong><br />
      <span class="muted">The rules applied to every generated description — this is what keeps them consistent.</span>
      <textarea id="ai-prompt" rows="8" style="margin-top:0.5rem;width:100%;font-family:var(--font-mono);font-size:0.82rem;line-height:1.5;">{ai.descriptionPrompt}</textarea>
    </label>

    <div class="set-actions">
      <button id="ai-save" class="btn btn-primary">Save AI settings</button>
      <span id="ai-status" class="muted"></span>
    </div>
  </div>
</AppLayout>

<style>
  .set-panel { max-width: 640px; }
  .set-desc { margin-bottom: 1.2rem; }
  .set-row { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; padding: 0.9rem 0; border-top: 1px solid var(--border); }
  .set-toggle { justify-content: flex-start; gap: 0.8rem; }
  .set-toggle input { width: 1.3rem; height: 1.3rem; accent-color: var(--cyan); flex: none; }
  .set-row input[type="number"] { width: 5rem; text-align: right; padding: 0.45rem 0.5rem; }
  .set-money { display: inline-flex; align-items: center; gap: 0.2rem; font-weight: 700; }
  .set-preview { margin: 1rem 0 0; padding: 0.7rem 0.9rem; background: rgba(255,255,255,.03); border: 1px solid var(--border); font-size: 0.9rem; }
  .set-actions { display: flex; align-items: center; gap: 1rem; margin-top: 1.3rem; }

  .theme-grid { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .theme-swatch {
    display: flex; flex-direction: column; align-items: center; gap: 0.45rem; padding: 0.5rem;
    background: var(--bg-2); border: 1px solid var(--border); cursor: pointer; min-width: 5rem;
  }
  .theme-swatch:hover { border-color: var(--muted); }
  .theme-swatch[aria-pressed="true"] { border-color: var(--cyan); box-shadow: 0 0 0 1px var(--cyan); }
  .theme-prev { display: grid; place-items: center; width: 3.6rem; height: 2.4rem; border: 1px solid var(--border-strong); }
  .theme-dot { width: 1rem; height: 1rem; border-radius: 50%; }
  .theme-name { font-size: 0.82rem; font-weight: 700; }
  .set-subh { font-size: 0.95rem; margin: 1.4rem 0 0.2rem; }
  .team-tbl { margin: 0.6rem 0 0.4rem; }
  .team-tbl select { padding: 0.3rem 0.4rem; font-size: 0.85rem; }
  .inv-grid { display: grid; grid-template-columns: 1fr 1fr auto auto; gap: 0.5rem; margin-top: 0.5rem; }
  @media (max-width: 640px) { .inv-grid { grid-template-columns: 1fr; } }
  #inv-result code { color: var(--cyan); font-weight: 700; }

  /* Departments */
  .dept-tbl { margin: 0.4rem 0 0.2rem; }
  .dept-tbl th, .dept-tbl td { vertical-align: middle; }
  .dept-ico { font-size: 1.15rem; width: 1.8rem; }
  .dept-core { font-size: 0.74rem; }
  .dept-act-col { text-align: right; white-space: nowrap; }
  .dept-act-col .link-btn { margin-left: 0.6rem; }
  .dept-enabled { width: 1.2rem; height: 1.2rem; accent-color: var(--cyan); }
  .dept-actions { display: flex; align-items: center; gap: 0.9rem; margin-top: 0.9rem; flex-wrap: wrap; }
  .dept-lock-actions { display: inline-flex; gap: 0.5rem; }
  .dept-lock-pill { font-size: 0.7rem; font-weight: 700; color: var(--magenta); border: 1px solid var(--magenta); padding: 0.05rem 0.45rem; vertical-align: middle; }
  .dept-panel[data-locked="1"] .dept-tbl { opacity: 0.6; }
  .dept-modal { position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,.55); display: grid; place-items: center; padding: 1rem; }
  .dept-modal[hidden] { display: none !important; }
  .dept-modal-card { width: 100%; max-width: 420px; background: var(--panel); border: 1px solid var(--border-strong); padding: 1.2rem 1.3rem; display: grid; gap: 0.8rem; }
  .dept-modal-card h3 { margin: 0; }
  .dm-grid { display: flex; gap: 0.7rem; flex-wrap: wrap; }
  .dm-field { display: grid; gap: 0.25rem; font-size: 0.82rem; font-weight: 600; flex: 1; min-width: 120px; }
  .dm-field input, .dm-field select { font: inherit; font-weight: 400; padding: 0.45rem 0.55rem; background: var(--bg); color: var(--text); border: 1px solid var(--border-strong); }
  .dm-toggle { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; }
  .dm-actions { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.3rem; }
</style>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const save = async (body: any, statusEl: HTMLElement, btn: HTMLButtonElement) => {
    btn.disabled = true; statusEl.textContent = "Saving…";
    try {
      const res = await fetch("/api/pos/settings", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Save failed");
      statusEl.textContent = "✓ Saved";
    } catch (e: any) { statusEl.textContent = ""; alert(e.message); }
    finally { btn.disabled = false; }
  };

  const enabled = $("ls-enabled"), threshold = $("ls-threshold"), minprice = $("ls-minprice"), hover = $("ls-hover");
  const preview = document.getElementById("ls-preview")!;
  function renderPreview() {
    if (!enabled.checked) { preview.textContent = "Badge is OFF — no stock-urgency shows on the website."; return; }
    const n = Math.max(1, parseInt(threshold.value) || 1);
    const p = Math.max(0, parseFloat(minprice.value) || 0);
    const example = n === 1 ? "“Only 1 left”" : `“Only N left” (for stock 1–${n})`;
    const priceText = p > 0 ? ` — only on items $${p.toFixed(2)}+` : " — on every item";
    preview.textContent = `Shows ${example}${priceText}${hover.checked ? ", on hover" : ""}.`;
  }
  [enabled, threshold, minprice, hover].forEach((el) => el.addEventListener("input", renderPreview));
  renderPreview();

  document.getElementById("set-save")!.addEventListener("click", (e) => save({
    lowStockEnabled: enabled.checked,
    lowStockThreshold: Math.max(1, parseInt(threshold.value) || 1),
    lowStockMinPriceCents: Math.round((parseFloat(minprice.value) || 0) * 100),
    lowStockHoverOnly: hover.checked,
  }, document.getElementById("set-status")!, e.currentTarget as HTMLButtonElement));

  // ---- Team & permissions (owners) ----
  document.querySelectorAll<HTMLSelectElement>(".team-role").forEach((sel) => {
    sel.dataset.prev = sel.value;
    sel.addEventListener("change", async () => {
      const st = document.getElementById("team-status")!;
      st.textContent = "Saving…";
      try {
        const res = await fetch("/api/pos/users", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: "set-role", userId: sel.dataset.uid, role: sel.value }) });
        const j = await res.json();
        if (!res.ok || !j.ok) throw new Error(j.error || "Failed");
        sel.dataset.prev = sel.value;
        st.textContent = "✓ Role updated";
      } catch (e: any) { sel.value = sel.dataset.prev || sel.value; st.textContent = ""; alert(e.message); }
    });
  });
  document.getElementById("inv-send")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const name = ($("inv-name") as HTMLInputElement).value.trim();
    const email = ($("inv-email") as HTMLInputElement).value.trim();
    const role = (document.getElementById("inv-role") as HTMLSelectElement).value;
    if (!name || !email) { alert("Enter a name and email."); return; }
    btn.disabled = true;
    try {
      const res = await fetch("/api/pos/users", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: "invite", fullName: name, email, role }) });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Failed");
      const out = document.getElementById("inv-result")!;
      out.hidden = false;
      out.innerHTML = `✓ Invited <strong>${email}</strong>. Temporary password: <code>${j.tempPassword}</code> — copy it and give it to them. They sign in at <code>/app/login</code> (refresh this page to see them in the list).`;
      ($("inv-name") as HTMLInputElement).value = ""; ($("inv-email") as HTMLInputElement).value = "";
    } catch (e: any) { alert(e.message); }
    finally { btn.disabled = false; }
  });

  document.getElementById("notify-save")!.addEventListener("click", (e) => save({
    notifyTaskComplete: ($("notify-tasks") as HTMLInputElement).checked,
  }, document.getElementById("notify-status")!, e.currentTarget as HTMLButtonElement));

  document.getElementById("lead-save")!.addEventListener("click", (e) => save({
    leadNotifyEnabled: ($("lead-notify") as HTMLInputElement).checked,
    leadNotifyEmail: ($("lead-email") as HTMLInputElement).value.trim(),
  }, document.getElementById("lead-status")!, e.currentTarget as HTMLButtonElement));

  document.getElementById("menu-save")!.addEventListener("click", (e) => save({
    menuEnabled: ($("menu-enabled") as HTMLInputElement).checked,
  }, document.getElementById("menu-status")!, e.currentTarget as HTMLButtonElement));

  // Per-device "Menu primary" — localStorage only, applies on next page load.
  const menuPrimary = $("menu-primary") as HTMLInputElement | null;
  if (menuPrimary) {
    try { menuPrimary.checked = localStorage.getItem("tl-menu-primary") === "1"; } catch {}
    menuPrimary.addEventListener("change", () => {
      try { localStorage.setItem("tl-menu-primary", menuPrimary.checked ? "1" : "0"); localStorage.removeItem("tl-menu-open"); } catch {}
    });
  }

  document.getElementById("ai-save")!.addEventListener("click", (e) => save({
    aiProvider: (document.getElementById("ai-provider") as HTMLSelectElement).value,
    aiQuality: (document.getElementById("ai-quality") as HTMLSelectElement).value,
    aiDescriptionPrompt: (document.getElementById("ai-prompt") as HTMLTextAreaElement).value,
  }, document.getElementById("ai-status")!, e.currentTarget as HTMLButtonElement));

  document.getElementById("fs-save")!.addEventListener("click", (e) => save({
    freeShipEnabled: $("fs-enabled").checked,
    freeShipThresholdCents: Math.round((parseFloat($("fs-threshold").value) || 0) * 100),
  }, document.getElementById("fs-status")!, e.currentTarget as HTMLButtonElement));

  // Appearance: theme palette + gem effect.
  const win = window as any;
  const themeBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-pick]")];
  const themeStatus = document.getElementById("theme-status")!;
  themeBtns.forEach((b) => b.addEventListener("click", async () => {
    const key = b.dataset.themePick!;
    win.setTheme?.(key);                       // apply on this device instantly
    win.__tlThemeDefault = key;
    themeBtns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    themeStatus.textContent = "Saving…";
    try {
      const res = await fetch("/api/pos/settings", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ defaultTheme: key }) });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Save failed");
      themeStatus.textContent = "✓ Saved as store default";
    } catch (e: any) { themeStatus.textContent = ""; alert(e.message); }
  }));
  $("theme-site").addEventListener("change", async () => {
    const st = document.getElementById("theme-site-status")!;
    st.textContent = "Saving…";
    try {
      const res = await fetch("/api/pos/settings", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ themePosOnly: !$("theme-site").checked }) });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Save failed");
      st.textContent = $("theme-site").checked ? "✓ Palette applies site-wide" : "✓ Palette is POS-only";
    } catch (e: any) { st.textContent = ""; alert(e.message); }
  });

  document.getElementById("theme-local-reset")?.addEventListener("click", () => {
    try { localStorage.removeItem("tl-theme"); } catch (e) {}
    const def = win.__tlThemeDefault || "default";
    win.setTheme?.(def === "default" ? "default" : def);
    if (def === "default") { try { localStorage.removeItem("tl-theme"); } catch (e) {} document.documentElement.removeAttribute("data-theme"); }
    themeBtns.forEach((x) => x.setAttribute("aria-pressed", String(x.dataset.themePick === def)));
    themeStatus.textContent = "✓ This device follows the store default";
  });

  // Sidebar accent picker (independent of the palette).
  const sbBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-sidebar-pick]")];
  const sbStatus = document.getElementById("sidebar-status")!;
  sbBtns.forEach((b) => b.addEventListener("click", async () => {
    const key = b.dataset.sidebarPick!;
    win.setSidebar?.(key);
    win.__tlSidebarDefault = key;
    sbBtns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    sbStatus.textContent = "Saving…";
    try {
      const res = await fetch("/api/pos/settings", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ defaultSidebar: key }) });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Save failed");
      sbStatus.textContent = "✓ Saved as store default";
    } catch (e: any) { sbStatus.textContent = ""; alert(e.message); }
  }));

  document.getElementById("gem-save")!.addEventListener("click", (e) => save({
    gemEffectEnabled: $("gem-effect").checked,
  }, document.getElementById("gem-status")!, e.currentTarget as HTMLButtonElement));

  // ---- Bar tabs (closing time + auto-gratuity) ----
  document.getElementById("tab-save")?.addEventListener("click", (e) => save({
    tabClosingTime: (document.getElementById("tab-closing") as HTMLInputElement).value || "",
    tabAutoGratuityEnabled: (document.getElementById("tab-grat-enabled") as HTMLInputElement).checked,
    tabAutoGratuityPercent: Math.max(0, Math.min(100, parseInt((document.getElementById("tab-grat-pct") as HTMLInputElement).value) || 0)),
  }, document.getElementById("tab-status")!, e.currentTarget as HTMLButtonElement));

  // ---- Departments (owner-only, governed) ----
  const deptPanel = document.querySelector<HTMLElement>(".dept-panel");
  if (deptPanel) {
    const deptApi = async (body: any) => {
      const r = await fetch("/api/pos/departments", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.ok) throw new Error(j.error || "Failed");
      return j;
    };
    const dStatus = document.getElementById("dept-status")!;
    let locked = deptPanel.dataset.locked === "1";

    function applyLock() {
      deptPanel!.dataset.locked = locked ? "1" : "0";
      (document.getElementById("dept-lock-pill") as HTMLElement).hidden = !locked;
      (document.getElementById("dept-unlock") as HTMLElement).hidden = !locked;
      (document.getElementById("dept-lock") as HTMLElement).hidden = locked;
      (document.getElementById("dept-add") as HTMLButtonElement).disabled = locked;
      deptPanel!.querySelectorAll<HTMLInputElement>(".dept-enabled").forEach((c) => (c.disabled = locked));
      deptPanel!.querySelectorAll<HTMLButtonElement>(".dept-edit, .dept-del").forEach((btn) => (btn.disabled = locked));
    }
    applyLock();

    deptPanel.querySelectorAll<HTMLInputElement>(".dept-enabled").forEach((cb) => {
      cb.addEventListener("change", async () => {
        const id = (cb.closest("tr") as HTMLElement).dataset.deptId;
        dStatus.textContent = "Saving…";
        try { await deptApi({ action: "set-enabled", id, enabled: cb.checked }); dStatus.textContent = "✓ Saved"; }
        catch (e: any) { cb.checked = !cb.checked; dStatus.textContent = ""; alert(e.message); }
      });
    });

    const dModal = document.getElementById("dept-modal");
    const dq = (id: string) => document.getElementById(id) as HTMLInputElement;
    const dsel = (id: string) => document.getElementById(id) as unknown as HTMLSelectElement;
    function openDept(tr?: HTMLElement) {
      (document.getElementById("dm-title") as HTMLElement).textContent = tr ? "Edit department" : "New department";
      dq("dm-id").value = tr?.dataset.deptId || "";
      dq("dm-name").value = tr?.dataset.name || "";
      dsel("dm-kind").value = tr?.dataset.kind || "other";
      dq("dm-icon").value = tr?.dataset.icon || "";
      dq("dm-enabled").checked = tr ? (tr.querySelector(".dept-enabled") as HTMLInputElement).checked : true;
      const isSystem = tr?.dataset.system === "1";
      dsel("dm-kind").disabled = !!isSystem;
      (document.getElementById("dm-system-note") as HTMLElement).hidden = !isSystem;
      document.getElementById("dm-status")!.textContent = "";
      if (dModal) dModal.hidden = false;
    }
    document.getElementById("dept-add")?.addEventListener("click", () => openDept());
    deptPanel.querySelectorAll<HTMLButtonElement>(".dept-edit").forEach((b) => b.addEventListener("click", () => openDept(b.closest("tr") as HTMLElement)));
    document.getElementById("dm-cancel")?.addEventListener("click", () => { if (dModal) dModal.hidden = true; });
    dModal?.addEventListener("click", (e) => { if (e.target === dModal) dModal.hidden = true; });
    document.getElementById("dm-save")?.addEventListener("click", async () => {
      const name = dq("dm-name").value.trim();
      if (!name) { alert("Department needs a name."); return; }
      document.getElementById("dm-status")!.textContent = "Saving…";
      try {
        await deptApi({ action: "save", id: dq("dm-id").value || undefined, name,
          kind: dsel("dm-kind").value, icon: dq("dm-icon").value, isEnabled: dq("dm-enabled").checked });
        location.reload();
      } catch (e: any) { document.getElementById("dm-status")!.textContent = ""; alert(e.message); }
    });

    deptPanel.querySelectorAll<HTMLButtonElement>(".dept-del").forEach((b) => b.addEventListener("click", async () => {
      const tr = b.closest("tr") as HTMLElement;
      if (!confirm(`Delete department “${tr.dataset.name}”?`)) return;
      try { await deptApi({ action: "delete", id: tr.dataset.deptId }); location.reload(); } catch (e: any) { alert(e.message); }
    }));

    document.getElementById("dept-lock")?.addEventListener("click", async () => {
      try { await deptApi({ action: "lock" }); locked = true; applyLock(); dStatus.textContent = "🔒 Locked"; } catch (e: any) { alert(e.message); }
    });
    document.getElementById("dept-unlock")?.addEventListener("click", async () => {
      try {
        await deptApi({ action: "unlock" });
        locked = false; applyLock(); dStatus.textContent = "🔓 Unlocked — edit, then lock again when done.";
      } catch {
        const code = prompt("Enter the TimeLag authorization code to unlock departments:");
        if (!code) return;
        try { await deptApi({ action: "unlock", code }); locked = false; applyLock(); dStatus.textContent = "🔓 Unlocked."; }
        catch (e2: any) { alert(e2.message); }
      }
    });
  }
</script>
