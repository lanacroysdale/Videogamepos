---
export const prerender = false;

import AppLayout from "../../layouts/AppLayout.astro";
import { lowStockSettings, freeShipSettings } from "../../lib/lowStock";

const supabase = Astro.locals.supabase;
const { data: row } = await supabase.from("store_settings").select("settings").eq("id", 1).maybeSingle();
const ls = lowStockSettings(row?.settings);
const fs = freeShipSettings(row?.settings);
const minPriceDollars = (ls.lowStockMinPriceCents / 100).toFixed(2);
const freeShipDollars = (fs.freeShipThresholdCents / 100).toFixed(2);
---

<AppLayout title="Settings" active="settings">
  <p class="muted" style="margin-bottom:1.25rem;">Store-wide settings. Changes apply to the website immediately.</p>

  <div class="pos-panel set-panel">
    <h2>Low-stock badge</h2>
    <p class="muted set-desc">
      Controls the “Only N left” urgency badge on the shop and product pages.
    </p>

    <label class="set-row set-toggle">
      <input type="checkbox" id="ls-enabled" checked={ls.lowStockEnabled} />
      <span><strong>Show the “Only N left” badge</strong><br />
        <span class="muted">Turn off to never show stock-urgency on the website.</span></span>
    </label>

    <label class="set-row">
      <span><strong>Show it when stock is at or below</strong><br />
        <span class="muted">Set to 1 for “Only 1 left” only; 3 shows it for 1–3 left.</span></span>
      <input type="number" id="ls-threshold" min="1" max="99" value={ls.lowStockThreshold} />
    </label>

    <label class="set-row">
      <span><strong>Only on items priced at or above</strong><br />
        <span class="muted">$0 shows it on everything. Set higher to flag only pricier items.</span></span>
      <span class="set-money">$<input type="number" id="ls-minprice" min="0" step="1" value={minPriceDollars} /></span>
    </label>

    <label class="set-row set-toggle">
      <input type="checkbox" id="ls-hover" checked={ls.lowStockHoverOnly} />
      <span><strong>Reveal on hover only</strong><br />
        <span class="muted">Hide the badge until the shopper hovers the item (less cluttered).</span></span>
    </label>

    <p class="set-preview" id="ls-preview"></p>

    <div class="set-actions">
      <button id="set-save" class="btn btn-primary">Save settings</button>
      <span id="set-status" class="muted"></span>
    </div>
  </div>

  <div class="pos-panel set-panel" style="margin-top:1.25rem;">
    <h2>Free shipping banner</h2>
    <p class="muted set-desc">A banner at the top of the shop promoting free shipping over a threshold.</p>

    <label class="set-row set-toggle">
      <input type="checkbox" id="fs-enabled" checked={fs.freeShipEnabled} />
      <span><strong>Show the free-shipping banner</strong></span>
    </label>

    <label class="set-row">
      <span><strong>Free shipping on orders over</strong></span>
      <span class="set-money">$<input type="number" id="fs-threshold" min="0" step="5" value={freeShipDollars} /></span>
    </label>

    <div class="set-actions">
      <button id="fs-save" class="btn btn-primary">Save banner</button>
      <span id="fs-status" class="muted"></span>
    </div>
  </div>
</AppLayout>

<style>
  .set-panel { max-width: 640px; }
  .set-desc { margin-bottom: 1.2rem; }
  .set-row { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; padding: 0.9rem 0; border-top: 1px solid var(--border); }
  .set-toggle { justify-content: flex-start; gap: 0.8rem; }
  .set-toggle input { width: 1.3rem; height: 1.3rem; accent-color: var(--cyan); flex: none; }
  .set-row input[type="number"] { width: 5rem; text-align: right; padding: 0.45rem 0.5rem; }
  .set-money { display: inline-flex; align-items: center; gap: 0.2rem; font-weight: 700; }
  .set-preview { margin: 1rem 0 0; padding: 0.7rem 0.9rem; background: rgba(255,255,255,.03); border: 1px solid var(--border); font-size: 0.9rem; }
  .set-actions { display: flex; align-items: center; gap: 1rem; margin-top: 1.3rem; }
</style>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const save = async (body: any, statusEl: HTMLElement, btn: HTMLButtonElement) => {
    btn.disabled = true; statusEl.textContent = "Saving…";
    try {
      const res = await fetch("/api/pos/settings", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Save failed");
      statusEl.textContent = "✓ Saved";
    } catch (e: any) { statusEl.textContent = ""; alert(e.message); }
    finally { btn.disabled = false; }
  };

  const enabled = $("ls-enabled"), threshold = $("ls-threshold"), minprice = $("ls-minprice"), hover = $("ls-hover");
  const preview = document.getElementById("ls-preview")!;
  function renderPreview() {
    if (!enabled.checked) { preview.textContent = "Badge is OFF — no stock-urgency shows on the website."; return; }
    const n = Math.max(1, parseInt(threshold.value) || 1);
    const p = Math.max(0, parseFloat(minprice.value) || 0);
    const example = n === 1 ? "“Only 1 left”" : `“Only N left” (for stock 1–${n})`;
    const priceText = p > 0 ? ` — only on items $${p.toFixed(2)}+` : " — on every item";
    preview.textContent = `Shows ${example}${priceText}${hover.checked ? ", on hover" : ""}.`;
  }
  [enabled, threshold, minprice, hover].forEach((el) => el.addEventListener("input", renderPreview));
  renderPreview();

  document.getElementById("set-save")!.addEventListener("click", (e) => save({
    lowStockEnabled: enabled.checked,
    lowStockThreshold: Math.max(1, parseInt(threshold.value) || 1),
    lowStockMinPriceCents: Math.round((parseFloat(minprice.value) || 0) * 100),
    lowStockHoverOnly: hover.checked,
  }, document.getElementById("set-status")!, e.currentTarget as HTMLButtonElement));

  document.getElementById("fs-save")!.addEventListener("click", (e) => save({
    freeShipEnabled: $("fs-enabled").checked,
    freeShipThresholdCents: Math.round((parseFloat($("fs-threshold").value) || 0) * 100),
  }, document.getElementById("fs-status")!, e.currentTarget as HTMLButtonElement));
</script>
