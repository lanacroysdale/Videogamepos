---
export const prerender = false;

import AppLayout from "../../layouts/AppLayout.astro";
import { fmt, fullName } from "../../lib/money";

const supabase = Astro.locals.supabase;
const [{ data: margins }, { data: categories }, { data: completeness }, { data: grades }, { data: products }] = await Promise.all([
  supabase.from("trade_margins").select("*").order("sort_order"),
  supabase.from("categories").select("id,name").order("sort_order"),
  supabase.from("completeness_levels").select("code,label,aliases").eq("is_active", true).order("sort_order"),
  supabase.from("condition_grades").select("code,label,aliases,icon").eq("is_active", true).order("rank"),
  supabase
    .from("products")
    .select("id, title, platform, franchise, alternative_names, category_id, product_variants(price_cents, completeness_code, grade_code)")
    .order("title"),
]);

const customerId = Astro.url.searchParams.get("customer");
let customer = null;
if (customerId) {
  const { data } = await supabase.from("customers").select("*").eq("id", customerId).maybeSingle();
  customer = data;
}

// Flat catalog the smart entry matches against (title/platform/aliases + the
// variant prices that suggest a resale value per condition).
const catalog = (products ?? []).map((p: any) => ({
  id: p.id,
  title: p.title,
  platform: p.platform ?? "",
  franchise: p.franchise ?? "",
  altNames: p.alternative_names ?? [],
  categoryId: p.category_id,
  variants: (p.product_variants ?? []).map((v: any) => ({
    priceCents: v.price_cents,
    completenessCode: v.completeness_code ?? "",
    gradeCode: v.grade_code ?? "",
  })),
}));

const posData = {
  margins: margins ?? [],
  categories: categories ?? [],
  completeness: completeness ?? [],
  grades: grades ?? [],
  catalog,
  customer,
};
---

<AppLayout title="Trade-In / Buy" active="tradein">
  <p class="muted" style="margin-bottom:1rem;">
    Add what the customer is selling and the resale value. Offers come from your
    margin settings; competitor links open price references for each item.
  </p>

  {customer && (
    <div class="cust-bar" style="display:flex;justify-content:space-between;padding:0.6rem 0.8rem;margin-bottom:1rem;background:rgba(44,230,224,.08);border:1px solid rgba(44,230,224,.3);border-radius:10px;">
      <span>🧑 <strong>{fullName(customer)}</strong> · {customer.membership}</span>
      <span class="muted">{fmt(customer.store_credit_cents)} store credit</span>
    </div>
  )}

  <div class="pos-panel">
    <table class="tbl" id="ti-table">
      <thead>
        <tr>
          <th style="width:30%">Item</th>
          <th>Category</th>
          <th class="num">Resale $</th>
          <th class="num">Cash offer</th>
          <th class="num">Credit offer</th>
          <th>Compare</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="ti-body"></tbody>
    </table>
    <button id="add-row" class="btn btn-ghost btn-sm" style="margin-top:0.8rem;">＋ Add item</button>
  </div>

  <div class="pos-grid two" style="margin-top:1rem;">
    <div class="pos-panel">
      <h2>Offer</h2>
      <div class="cart-totals">
        <div class="row"><span>Total resale value</span><span id="sum-resale">$0.00</span></div>
        <div class="row"><span>Cash offer (by margin)</span><span id="sum-cash">$0.00</span></div>
        <div class="row"><span>Store-credit offer</span><span id="sum-credit">$0.00</span></div>
        <div class="row" style="margin-top:0.6rem;">
          <span>Override total cash $ <small class="muted">(redistributes)</small></span>
          <input id="target-cash" type="number" min="0" step="0.01" placeholder="auto" style="width:7rem;text-align:right;" />
        </div>
      </div>
    </div>

    <div class="pos-panel">
      <h2>Pay out as</h2>
      <div style="display:flex;gap:0.6rem;margin-bottom:1rem;">
        <label class="pay-opt"><input type="radio" name="payout" value="cash" checked /> Cash <span id="lbl-cash" class="muted"></span></label>
        <label class="pay-opt"><input type="radio" name="payout" value="credit" /> Store credit <span id="lbl-credit" class="muted"></span></label>
      </div>
      <button id="save-ti" class="btn btn-primary btn-block">Save buy ticket →</button>
      <div id="ti-receipt" class="receipt" hidden style="margin-top:1rem;padding:1rem;border:1px solid rgba(128,255,114,.4);background:rgba(128,255,114,.08);border-radius:12px;text-align:center;"></div>
    </div>
  </div>

  <p class="muted" style="margin-top:1rem;font-size:0.85rem;">
    Margins: {margins?.map((m) => `${m.label}: ${m.cash_percent}% cash / ${m.credit_percent}% credit`).join(" · ")}
  </p>

  <script type="application/json" id="pos-data" set:html={JSON.stringify(posData)}></script>
</AppLayout>

<style>
  .pay-opt { display:flex; align-items:center; gap:0.4rem; padding:0.6rem 0.9rem; border:1px solid var(--border-strong); border-radius:10px; cursor:pointer; font-weight:600; }
  .ti-links a { font-size:0.78rem; margin-right:0.5rem; white-space:nowrap; }
  #ti-table input, #ti-table select { padding:0.4rem 0.5rem; }
</style>

<style is:global>
  #ti-table input, #ti-table select { padding:0.4rem 0.5rem; }
  .ti-desc-cell { position:relative; }
  .ti-desc-cell input { width:100%; }
  .ti-links a { font-size:0.78rem; margin-right:0.5rem; white-space:nowrap; }
  .ti-suggest { position:absolute; left:0; right:0; top:100%; z-index:30; background:var(--panel, #14101d); border:1px solid var(--border-strong); border-radius:8px; margin-top:2px; max-height:240px; overflow:auto; box-shadow:0 12px 30px rgba(0,0,0,.5); }
  .ti-sug { display:flex; align-items:center; gap:0.5rem; padding:0.45rem 0.6rem; cursor:pointer; font-size:0.85rem; border-bottom:1px solid var(--border); }
  .ti-sug:last-child { border-bottom:0; }
  .ti-sug:hover { background:rgba(44,230,224,.1); }
  .ti-sug-title { font-weight:600; }
  .ti-sug-meta { color:var(--muted-2); font-size:0.78rem; }
  .ti-sug-price { margin-left:auto; color:var(--green); font-weight:700; font-family:var(--font-mono); }
</style>

<script>
  import { buildPlatforms, parseQuery as parseQ, smartMatches } from "../../lib/smartSearch";

  type Row = { key: string; description: string; categoryId: string | null; resaleCents: number };
  const data = JSON.parse(document.getElementById("pos-data")!.textContent!);
  const margins: any[] = data.margins;
  const categories: any[] = data.categories;
  const completeness: any[] = data.completeness || [];
  const grades: any[] = data.grades || [];
  const catalog: any[] = data.catalog || [];
  const customer: any = data.customer;
  const $ = (id: string) => document.getElementById(id)!;
  const money = (c: number) => (c / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[m] as string));

  // Smart entry (shared with the inventory screen).
  const PLATFORMS = buildPlatforms(catalog.map((p) => p.platform));
  const parseQuery = (raw: string) => parseQ(raw, { completeness, grades, platforms: PLATFORMS });
  const complLabel = (code: string) => completeness.find((c) => c.code === code)?.label || code;
  const gradeLabel = (code: string) => { const g = grades.find((x) => x.code === code); return g ? (g.icon ? g.icon + " " : "") + g.label : code; };
  // Suggested resale = what we'd sell that exact condition for (falls back to top variant).
  function suggestResale(p: any, parsed: any): number | null {
    if (!p.variants.length) return null;
    if (parsed.completenessCode) {
      const v = p.variants.find((x: any) => x.completenessCode === parsed.completenessCode && (!parsed.gradeCode || x.gradeCode === parsed.gradeCode))
        || p.variants.find((x: any) => x.completenessCode === parsed.completenessCode);
      if (v) return v.priceCents;
    }
    return Math.max(...p.variants.map((x: any) => x.priceCents));
  }

  let rows: Row[] = [];

  function marginFor(cents: number) {
    return margins.find((m) => cents >= m.min_cents && (m.max_cents == null || cents < m.max_cents)) ?? margins[margins.length - 1] ?? { cash_percent: 35, credit_percent: 45 };
  }
  function links(desc: string) {
    const q = encodeURIComponent(desc || "");
    return `<span class="ti-links">
      <a href="https://www.pricecharting.com/search-products?q=${q}&type=prices" target="_blank" rel="noopener">PriceCharting↗</a>
      <a href="https://www.ebay.com/sch/i.html?_nkw=${q}&LH_Sold=1&LH_Complete=1" target="_blank" rel="noopener">eBay sold↗</a>
      <a href="https://www.gamestop.com/search/?q=${q}" target="_blank" rel="noopener">GameStop↗</a>
    </span>`;
  }

  // Returns per-row {cash, credit} honoring an optional override total cash.
  function computeOffers() {
    const base = rows.map((r) => {
      const m = marginFor(r.resaleCents);
      return { cash: Math.round(r.resaleCents * m.cash_percent / 100), credit: Math.round(r.resaleCents * m.credit_percent / 100) };
    });
    const sumAutoCash = base.reduce((s, b) => s + b.cash, 0);
    const target = Math.round((parseFloat(($("target-cash") as HTMLInputElement).value) || 0) * 100);
    if (target > 0 && sumAutoCash > 0) {
      const f = target / sumAutoCash;
      return base.map((b) => ({ cash: Math.round(b.cash * f), credit: Math.round(b.credit * f) }));
    }
    return base;
  }

  // Typeahead: as the employee types, suggest catalog matches + a resale value.
  function showSuggest(tr: HTMLElement, r: Row) {
    const inp = tr.querySelector<HTMLInputElement>("[data-desc]")!;
    const box = tr.querySelector<HTMLElement>("[data-suggest]")!;
    const q = inp.value.trim();
    if (q.length < 2) { box.hidden = true; return; }
    const parsed = parseQuery(q);
    const matches = smartMatches(catalog, parsed).slice(0, 6);
    if (!matches.length) { box.hidden = true; return; }
    const cond = parsed.completenessCode ? " · " + complLabel(parsed.completenessCode) : "";
    box.innerHTML = matches.map((m: any, i: number) => {
      const sug = suggestResale(m.p, parsed);
      return `<div class="ti-sug" data-i="${i}">
        <span class="ti-sug-title">${esc(m.p.title)}</span>
        <span class="ti-sug-meta">${esc(m.p.platform || "")}${cond}</span>
        ${sug != null ? `<span class="ti-sug-price">${money(sug)}</span>` : ""}
      </div>`;
    }).join("");
    box.hidden = false;
    box.querySelectorAll<HTMLElement>("[data-i]").forEach((el) => el.addEventListener("mousedown", (e) => {
      e.preventDefault(); // pick before the input blurs
      pickSuggestion(r, matches[+el.dataset.i!].p, parsed);
      box.hidden = true;
      render();
    }));
  }
  function pickSuggestion(r: Row, p: any, parsed: any) {
    const cond = [complLabel(parsed.completenessCode), gradeLabel(parsed.gradeCode)].filter(Boolean).join(" · ");
    r.description = p.title + (p.platform ? ` (${p.platform})` : "") + (cond ? ` — ${cond}` : "");
    r.categoryId = p.categoryId || r.categoryId;
    const sug = suggestResale(p, parsed);
    if (sug != null) r.resaleCents = sug;
  }

  function render() {
    if (rows.length === 0) addRow();
    const offers = computeOffers();
    $("ti-body").innerHTML = rows.map((r, idx) => `
      <tr data-key="${r.key}">
        <td class="ti-desc-cell"><input data-desc autocomplete="off" value="${esc(r.description)}" placeholder="Type to find — e.g. zelda botw switch cib"><div class="ti-suggest" data-suggest hidden></div></td>
        <td><select data-cat>
          <option value="">—</option>
          ${categories.map((c) => `<option value="${c.id}" ${r.categoryId === c.id ? "selected" : ""}>${esc(c.name)}</option>`).join("")}
        </select></td>
        <td class="num"><input data-resale type="number" min="0" step="0.01" value="${(r.resaleCents/100).toFixed(2)}" style="width:6rem;text-align:right;"></td>
        <td class="num" style="color:var(--green);font-weight:700;">${money(offers[idx].cash)}</td>
        <td class="num" style="color:var(--cyan);font-weight:700;">${money(offers[idx].credit)}</td>
        <td>${links(r.description)}</td>
        <td><button class="link-btn" data-remove>✕</button></td>
      </tr>`).join("");

    $("ti-body").querySelectorAll<HTMLElement>("tr").forEach((tr) => {
      const r = rows.find((x) => x.key === tr.dataset.key)!;
      const descInp = tr.querySelector<HTMLInputElement>("[data-desc]")!;
      descInp.addEventListener("input", (e) => { r.description = (e.target as HTMLInputElement).value; showSuggest(tr, r); });
      descInp.addEventListener("blur", () => setTimeout(() => { const b = tr.querySelector<HTMLElement>("[data-suggest]"); if (b) b.hidden = true; }, 150));
      descInp.addEventListener("change", render);
      tr.querySelector<HTMLSelectElement>("[data-cat]")!.addEventListener("change", (e) => { r.categoryId = (e.target as HTMLSelectElement).value || null; });
      tr.querySelector<HTMLInputElement>("[data-resale]")!.addEventListener("input", (e) => { r.resaleCents = Math.max(0, Math.round(parseFloat((e.target as HTMLInputElement).value) * 100) || 0); recalc(); });
      tr.querySelector("[data-remove]")!.addEventListener("click", () => { rows = rows.filter((x) => x.key !== r.key); render(); });
    });
    recalc();
  }

  function recalc() {
    const offers = computeOffers();
    const sumResale = rows.reduce((s, r) => s + r.resaleCents, 0);
    const sumCash = offers.reduce((s, o) => s + o.cash, 0);
    const sumCredit = offers.reduce((s, o) => s + o.credit, 0);
    $("sum-resale").textContent = money(sumResale);
    $("sum-cash").textContent = money(sumCash);
    $("sum-credit").textContent = money(sumCredit);
    $("lbl-cash").textContent = money(sumCash);
    $("lbl-credit").textContent = money(sumCredit);
    // refresh the per-row offer cells without rebuilding inputs
    Array.from($("ti-body").children).forEach((tr, idx) => {
      const tds = (tr as HTMLElement).querySelectorAll("td");
      if (tds[3]) tds[3].textContent = money(offers[idx].cash);
      if (tds[4]) tds[4].textContent = money(offers[idx].credit);
    });
  }

  function addRow() { rows.push({ key: crypto.randomUUID(), description: "", categoryId: null, resaleCents: 0 }); }
  $("add-row").addEventListener("click", () => { addRow(); render(); });
  ($("target-cash") as HTMLInputElement).addEventListener("input", recalc);

  $("save-ti").addEventListener("click", async () => {
    const valid = rows.filter((r) => r.description.trim() && r.resaleCents > 0);
    if (!valid.length) { alert("Add at least one item with a description and resale value."); return; }
    const offers = computeOffers();
    const payoutType = (document.querySelector('input[name="payout"]:checked') as HTMLInputElement).value;
    const items = rows.map((r, idx) => ({
      description: r.description, categoryId: r.categoryId, resaleCents: r.resaleCents,
      payoutCents: payoutType === "credit" ? offers[idx].credit : offers[idx].cash,
    })).filter((it) => it.description.trim() && it.resaleCents > 0);

    const btn = $("save-ti") as HTMLButtonElement;
    btn.disabled = true; btn.textContent = "Saving…";
    try {
      const res = await fetch("/api/pos/trade-in", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ customerId: customer?.id ?? null, payoutType, items }),
      });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || "Failed");
      const rc = $("ti-receipt"); rc.hidden = false;
      rc.innerHTML = `<h3 style="color:var(--green);">✓ Buy ticket #${j.humanId} saved</h3><p>Paying ${money(j.payout)} as ${payoutType}. Saved as an open transaction for review.</p>`;
      rows = []; render(); rc.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch (err: any) { alert("Could not save: " + err.message); }
    finally { btn.disabled = false; btn.textContent = "Save buy ticket →"; }
  });

  render();
</script>
