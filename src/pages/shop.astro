---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { SITE } from "../consts";
import { fmt } from "../lib/money";
import { createSupabaseAdminClient } from "../lib/supabase";
import { lowStockSettings, showLowStock, freeShipSettings } from "../lib/lowStock";
import { classify, DEPARTMENTS, PLATFORMS, CONDITIONS, REGIONS, FRANCHISES } from "../lib/shopFilters";
import type { Rule } from "../lib/shopFilters";

// HIDDEN, BROWSE-ONLY shop. Reads the SHARED inventory pool so anything sold in
// store disappears here automatically. Server-side service-role read selecting
// ONLY safe columns (never cost_cents); kept out of search via noindex + robots.
// Not linked from nav — reachable only by direct URL until launch.
const admin = createSupabaseAdminClient();
const { data: settingsRow } = await admin.from("store_settings").select("settings").eq("id", 1).maybeSingle();
const ls = lowStockSettings(settingsRow?.settings);
const fs = freeShipSettings(settingsRow?.settings);
const freeShipText = `🚚 Free shipping on orders over ${fmt(fs.freeShipThresholdCents)}`;
const { data: rows, error } = await admin
  .from("product_variants")
  .select(
    "id, condition, completeness, price_cents, online_price_cents, quantity, product:products(id, title, slug, platform, franchise, image_url, description, category:categories(name))",
  )
  .eq("online_visible", true)
  .gt("quantity", 0)
  .order("price_cents", { ascending: true });

const listings = (rows ?? []).map((v: any) => {
  const item = {
    id: v.id,
    title: v.product?.title ?? "Untitled",
    slug: v.product?.slug ?? "",
    platform: v.product?.platform ?? "",
    franchise: v.product?.franchise ?? "",
    category: v.product?.category?.name ?? "",
    image: v.product?.image_url ?? null,
    description: v.product?.description ?? "",
    condition: v.condition,
    completeness: v.completeness,
    priceCents: v.online_price_cents ?? v.price_cents,
    quantity: v.quantity,
    lowStock: showLowStock(v.quantity, v.online_price_cents ?? v.price_cents, ls),
  };
  // Keyword-derived department + facets (ignores the unreliable import category).
  return { ...item, facets: classify(item) };
});

// Build the department tabs + filter facets, keeping only values that actually
// occur in the catalogue (with live counts).
const countBy = (pick: (l: (typeof listings)[number]) => string) => {
  const m = new Map<string, number>();
  for (const l of listings) { const k = pick(l); if (k) m.set(k, (m.get(k) ?? 0) + 1); }
  return m;
};
const deptCounts = countBy((l) => l.facets.dept);
const platCounts = countBy((l) => l.facets.platform);
const condCounts = countBy((l) => l.facets.cond);
const regionCounts = countBy((l) => l.facets.region);
const franchiseCounts = countBy((l) => l.facets.franchise);

const present = (rules: Rule[], counts: Map<string, number>) =>
  rules.filter((r) => (counts.get(r.key) ?? 0) > 0).map((r) => ({ ...r, n: counts.get(r.key) ?? 0 }));

const deptTabs = [{ key: "all", label: "All", icon: "🛒", n: listings.length }, ...present(DEPARTMENTS, deptCounts)];
const platFacets = present(PLATFORMS, platCounts);
const condFacets = present(CONDITIONS, condCounts);
const regionFacets = present(REGIONS, regionCounts);
const franchiseFacets = present(FRANCHISES, franchiseCounts);
const hasFilters = platFacets.length + condFacets.length + regionFacets.length + franchiseFacets.length > 0;

---

<Layout
  title="Shop"
  description={`Browse games, consoles, and accessories in stock at ${SITE.name}.`}
  noindex
>
  {fs.freeShipEnabled && <div class="ship-banner">{freeShipText}</div>}

  <section class="section--tight shop-hero">
    <div class="container">
      <span class="eyebrow">In stock now · {SITE.location}</span>
      <h1>The <span class="grad">Shop</span></h1>
      <p class="lead">
        A live look at what&rsquo;s on our shelves. Everything here is in stock right now —
        reserve or buy in store while we build out online checkout.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      {error && (
        <p class="shop-empty">The shop is warming up — check back shortly.</p>
      )}
      {!error && listings.length === 0 && (
        <p class="shop-empty">
          Nothing published yet. Staff can mark items “Publish to web” from the POS inventory screen.
        </p>
      )}

      {listings.length > 0 && (
        <nav class="shop-cats" aria-label="Shop categories">
          {deptTabs.map((c) => (
            <button class="shop-cat" data-shopcat={c.key} aria-pressed={c.key === "all" ? "true" : "false"}>
              <span class="shop-cat-ico" aria-hidden="true">{c.icon}</span>{c.label}<span class="shop-cat-n">{c.n}</span>
            </button>
          ))}
        </nav>
      )}

      {listings.length > 0 && hasFilters && (
        <div class="shop-filterbar">
          <button type="button" id="shop-filter-toggle" class="shop-filter-toggle" aria-expanded="false">
            <span aria-hidden="true">⚙️</span> Filters <span class="shop-filter-count" id="shop-filter-count" hidden></span>
          </button>
          <button type="button" id="shop-filter-clear" class="shop-filter-clear" hidden>Clear all</button>
        </div>
      )}

      {listings.length > 0 && hasFilters && (
        <aside class="shop-filters" id="shop-filters" hidden>
          {platFacets.length > 0 && (
            <div class="shop-fgroup">
              <span class="shop-fgroup-h">Platform</span>
              <div class="shop-chips">
                {platFacets.map((p) => (
                  <button type="button" class="shop-fchip" data-facet="platform" data-val={p.key}>{p.label}<span class="shop-fchip-n">{p.n}</span></button>
                ))}
              </div>
            </div>
          )}
          {condFacets.length > 0 && (
            <div class="shop-fgroup">
              <span class="shop-fgroup-h">Condition</span>
              <div class="shop-chips">
                {condFacets.map((c) => (
                  <button type="button" class="shop-fchip" data-facet="cond" data-val={c.key}>{c.label}<span class="shop-fchip-n">{c.n}</span></button>
                ))}
              </div>
            </div>
          )}
          {franchiseFacets.length > 0 && (
            <div class="shop-fgroup">
              <span class="shop-fgroup-h">Franchise</span>
              <div class="shop-chips">
                {franchiseFacets.map((f) => (
                  <button type="button" class="shop-fchip" data-facet="franchise" data-val={f.key}>{f.label}<span class="shop-fchip-n">{f.n}</span></button>
                ))}
              </div>
            </div>
          )}
          {regionFacets.length > 0 && (
            <div class="shop-fgroup">
              <span class="shop-fgroup-h">Region</span>
              <div class="shop-chips">
                {regionFacets.map((r) => (
                  <button type="button" class="shop-fchip" data-facet="region" data-val={r.key}>{r.label}<span class="shop-fchip-n">{r.n}</span></button>
                ))}
              </div>
            </div>
          )}
          <div class="shop-fgroup">
            <span class="shop-fgroup-h">Price</span>
            <div class="shop-price-range">
              <span class="shop-money">$<input type="number" id="shop-min" min="0" step="5" placeholder="Min" /></span>
              <span class="shop-dash">–</span>
              <span class="shop-money">$<input type="number" id="shop-max" min="0" step="5" placeholder="Max" /></span>
            </div>
          </div>
        </aside>
      )}

      {listings.length > 0 && (
        <Fragment>
        <div class:list={["shop-grid", { "low-hover": ls.lowStockHoverOnly }]}>
          {listings.map((item) => (
            <a class="shop-card" data-dept={item.facets.dept} data-platform={item.facets.platform} data-cond={item.facets.cond} data-region={item.facets.region} data-franchise={item.facets.franchise} data-price={item.priceCents} href={item.slug ? "/shop/" + item.slug : "#"}>
              <div class="shop-thumb">
                {item.image ? (
                  <img class="shop-thumb-fg" src={item.image} alt={item.title} loading="lazy" />
                ) : (
                  <span class="shop-thumb-ph" aria-hidden="true">🎮</span>
                )}
                {item.lowStock && <span class="shop-low">Only {item.quantity} left</span>}
              </div>
              <div class="shop-body">
                {item.platform && <span class="shop-plat">{item.platform}</span>}
                <h3 class="shop-title">{item.title}</h3>
                <p class="shop-cond">{item.condition}{item.completeness ? ` · ${item.completeness}` : ""}</p>
                <div class="shop-foot">
                  <span class="shop-price">{fmt(item.priceCents)}</span>
                  <span class="shop-stock">In stock</span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <p class="shop-empty" id="shop-noresults" hidden>Nothing in this category yet.</p>
        <div class="shop-controls" id="shop-controls">
          <div class="shop-pager">
            <button type="button" id="pg-prev" class="shop-pgbtn">← Prev</button>
            <span id="pg-info" class="shop-pginfo"></span>
            <button type="button" id="pg-next" class="shop-pgbtn">Next →</button>
          </div>
          <div class="shop-viewopts">
            <label class="shop-vopt">Per page
              <select id="pg-size">
                <option value="12">12</option>
                <option value="24">24</option>
                <option value="48">48</option>
                <option value="9999">All</option>
              </select>
            </label>
            <div class="shop-colsel" role="group" aria-label="Items per row">
              <span class="shop-vlabel">Per row</span>
              <button type="button" class="shop-colbtn shop-colbtn-auto" data-cols="auto">Auto</button>
              <button type="button" class="shop-colbtn" data-cols="1">1</button>
              <button type="button" class="shop-colbtn" data-cols="2">2</button>
              <button type="button" class="shop-colbtn" data-cols="3">3</button>
              <button type="button" class="shop-colbtn c-wide" data-cols="4">4</button>
              <button type="button" class="shop-colbtn c-wide" data-cols="5">5</button>
              <button type="button" class="shop-colbtn c-wide" data-cols="6">6</button>
            </div>
          </div>
        </div>
        </Fragment>
      )}
    </div>
  </section>

  <section class="section--tight">
    <div class="container narrow shop-cta">
      <p>
        See something you want? Call <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a> or
        email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> to hold it, or visit us in {SITE.location}.
      </p>
    </div>
  </section>
</Layout>

<script>
  // Storefront: category filter + pagination + columns. Cards carry their
  // department keys in data-shopcat; everything is client-side show/hide.
  const grid = document.querySelector<HTMLElement>(".shop-grid");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".shop-cat")];
  const cards = [...document.querySelectorAll<HTMLElement>(".shop-card")];
  const noResults = document.getElementById("shop-noresults");
  const controls = document.getElementById("shop-controls");
  const pgPrev = document.getElementById("pg-prev") as HTMLButtonElement | null;
  const pgNext = document.getElementById("pg-next") as HTMLButtonElement | null;
  const pgInfo = document.getElementById("pg-info");
  const pgSize = document.getElementById("pg-size") as HTMLSelectElement | null;
  const colBtns = [...document.querySelectorAll<HTMLButtonElement>(".shop-colbtn")];

  let cat = "all", page = 1, pageSize = 24;
  // One active value per facet group ("" = no filter on that facet).
  const params = new URLSearchParams(location.search);
  const facet: Record<string, string> = {
    platform: (params.get("platform") || "").toLowerCase().trim(),
    cond: (params.get("cond") || "").toLowerCase().trim(),
    region: (params.get("region") || "").toLowerCase().trim(),
    franchise: (params.get("franchise") || "").toLowerCase().trim(),
  };
  if (params.get("dept")) cat = params.get("dept")!.toLowerCase().trim();
  let minPrice = 0, maxPrice = Infinity;

  const fchips = [...document.querySelectorAll<HTMLButtonElement>(".shop-fchip")];
  // Drop any deep-linked facet value that isn't actually offered, so a stale or
  // mismatched ?platform=/?cond= link shows everything instead of an empty grid.
  const validVals: Record<string, Set<string>> = {};
  fchips.forEach((b) => { (validVals[b.dataset.facet!] ||= new Set()).add(b.dataset.val!); });
  for (const k of Object.keys(facet)) { if (facet[k] && !validVals[k]?.has(facet[k])) facet[k] = ""; }
  const filtersPanel = document.getElementById("shop-filters");
  const filterToggle = document.getElementById("shop-filter-toggle");
  const filterClear = document.getElementById("shop-filter-clear");
  const filterCount = document.getElementById("shop-filter-count");
  const minIn = document.getElementById("shop-min") as HTMLInputElement | null;
  const maxIn = document.getElementById("shop-max") as HTMLInputElement | null;

  const savedSize = Number(localStorage.getItem("shop-size"));
  if (savedSize) pageSize = savedSize;
  if (pgSize) pgSize.value = String(pageSize);

  // "auto" = responsive default (3/4/5/6 by width). A number = a remembered
  // explicit choice that overrides at every width.
  function setCols(val: string) {
    if (val === "auto") { grid?.style.removeProperty("--shop-cols"); localStorage.removeItem("shop-cols"); }
    else { grid?.style.setProperty("--shop-cols", val); localStorage.setItem("shop-cols", val); }
    colBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.cols === val)));
  }
  setCols(localStorage.getItem("shop-cols") || "auto");

  function activeFacetCount() {
    return Object.values(facet).filter(Boolean).length + (minPrice > 0 || maxPrice < Infinity ? 1 : 0);
  }
  function syncChrome() {
    fchips.forEach((b) => b.setAttribute("aria-pressed", String(facet[b.dataset.facet!] === b.dataset.val)));
    const n = activeFacetCount();
    if (filterCount) { filterCount.hidden = n === 0; filterCount.textContent = String(n); }
    if (filterClear) filterClear.hidden = n === 0;
  }

  function applyView() {
    const matching = cards.filter((c) => {
      if (cat !== "all" && (c.dataset.dept || "") !== cat) return false;
      for (const k of ["platform", "cond", "region", "franchise"]) {
        if (facet[k] && (c.dataset[k] || "") !== facet[k]) return false;
      }
      const price = Number(c.dataset.price || 0);
      if (price < minPrice || price > maxPrice) return false;
      return true;
    });
    cards.forEach((c) => (c.hidden = true));
    const total = matching.length;
    const pages = Math.max(1, Math.ceil(total / pageSize));
    if (page > pages) page = pages;
    const start = (page - 1) * pageSize;
    matching.slice(start, start + pageSize).forEach((c) => (c.hidden = false));
    if (noResults) noResults.hidden = total > 0;
    if (controls) controls.hidden = total === 0;
    if (pgInfo) pgInfo.textContent = total ? `${start + 1}–${Math.min(start + pageSize, total)} of ${total}` : "";
    if (pgPrev) pgPrev.disabled = page <= 1;
    if (pgNext) pgNext.disabled = page >= pages;
    syncChrome();
  }

  const toGridTop = () => grid?.scrollIntoView({ behavior: "smooth", block: "start" });

  tabs.forEach((tab) => tab.addEventListener("click", () => {
    cat = tab.dataset.shopcat!;
    tabs.forEach((t) => t.setAttribute("aria-pressed", String(t === tab)));
    page = 1; applyView();
  }));
  // Filter chips: single-select per facet group (click again to clear).
  fchips.forEach((b) => b.addEventListener("click", () => {
    const g = b.dataset.facet!, v = b.dataset.val!;
    facet[g] = facet[g] === v ? "" : v;
    page = 1; applyView();
  }));
  filterToggle?.addEventListener("click", () => {
    const open = filtersPanel?.hidden;
    if (filtersPanel) filtersPanel.hidden = !open;
    filterToggle.setAttribute("aria-expanded", String(!!open));
  });
  filterClear?.addEventListener("click", () => {
    for (const k of Object.keys(facet)) facet[k] = "";
    minPrice = 0; maxPrice = Infinity;
    if (minIn) minIn.value = ""; if (maxIn) maxIn.value = "";
    page = 1; applyView();
  });
  const onPrice = () => {
    minPrice = Math.max(0, (parseFloat(minIn?.value || "") || 0) * 100);
    maxPrice = maxIn?.value ? (parseFloat(maxIn.value) || 0) * 100 : Infinity;
    page = 1; applyView();
  };
  minIn?.addEventListener("input", onPrice);
  maxIn?.addEventListener("input", onPrice);
  pgPrev?.addEventListener("click", () => { if (page > 1) { page--; applyView(); toGridTop(); } });
  pgNext?.addEventListener("click", () => { page++; applyView(); toGridTop(); });
  pgSize?.addEventListener("change", () => { pageSize = Number(pgSize.value) || 24; localStorage.setItem("shop-size", String(pageSize)); page = 1; applyView(); });
  colBtns.forEach((b) => b.addEventListener("click", () => setCols(b.dataset.cols!)));

  // Auto-open the panel if arriving with a facet pre-set from a deep link.
  if (filtersPanel && activeFacetCount() > 0) { filtersPanel.hidden = false; filterToggle?.setAttribute("aria-expanded", "true"); }
  applyView();
</script>

<style>
  .shop-hero { padding-top: clamp(2.5rem, 2rem + 3vw, 4.5rem); }
  .shop-hero h1 { margin: 0.6rem 0 1rem; }
  .shop-hero .lead { max-width: 56ch; }
  .grad {
    background: linear-gradient(120deg, var(--cyan), var(--magenta) 80%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .narrow { max-width: 760px; }

  .shop-grid {
    display: grid; gap: 0.9rem;
    grid-template-columns: repeat(var(--shop-cols, 3), minmax(0, 1fr));
  }
  @media (min-width: 600px) { .shop-grid { --shop-cols: 4; } }
  @media (min-width: 1000px) { .shop-grid { --shop-cols: 5; } }
  @media (min-width: 1400px) { .shop-grid { --shop-cols: 6; } }
  .shop-card {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius);
    transition: transform 0.15s ease, border-color 0.15s ease;
    text-decoration: none; color: inherit;
  }
  .shop-card:hover { transform: translateY(-3px); border-color: var(--cyan); }
  /* Blend: the cover sits on the card's own background with a little padding so
     a bit of the module shows around it — no blur, no crop, consistent tiles. */
  .shop-thumb {
    position: relative; aspect-ratio: 1 / 1; display: grid; place-items: center;
    background: var(--panel); overflow: hidden;
  }
  .shop-thumb-fg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: contain; padding: 0.85rem; box-sizing: border-box;
  }
  .shop-thumb-ph { font-size: 2.6rem; opacity: 0.5; }

  /* Category nav */
  .shop-cats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.4rem; }
  .shop-cat {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.9rem;
    font-size: 0.9rem; font-weight: 700; color: var(--muted); background: var(--panel);
    border: 1px solid var(--border); cursor: pointer; transition: color .15s, background .15s, border-color .15s;
  }
  .shop-cat:hover { color: var(--text); border-color: var(--muted); }
  .shop-cat[aria-pressed="true"] { color: var(--accent-ink); background: var(--cyan); border-color: var(--cyan); }
  .shop-cat-ico { font-size: 0.95rem; line-height: 1; }
  .shop-cat-n { font-family: var(--font-mono); font-size: 0.74rem; opacity: 0.7; }

  /* Filters bar + panel */
  .shop-filterbar { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
  .shop-filter-toggle {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0.9rem;
    font-size: 0.9rem; font-weight: 700; color: var(--text); background: var(--panel);
    border: 1px solid var(--border-strong); cursor: pointer;
  }
  .shop-filter-toggle:hover { border-color: var(--cyan); }
  .shop-filter-count {
    min-width: 1.3em; padding: 0 0.35em; text-align: center; font-family: var(--font-mono);
    font-size: 0.74rem; color: var(--accent-ink); background: var(--cyan);
  }
  .shop-filter-clear { font: inherit; font-size: 0.85rem; font-weight: 700; color: var(--magenta); background: none; border: none; cursor: pointer; padding: 0; }
  .shop-filter-clear:hover { text-decoration: underline; }
  .shop-filters {
    margin-bottom: 1.4rem; padding: 1rem 1.1rem; background: var(--panel);
    border: 1px solid var(--border); display: grid; gap: 1rem;
  }
  .shop-fgroup { display: grid; gap: 0.5rem; }
  .shop-fgroup-h { font-size: 0.74rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted-2); }
  .shop-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .shop-fchip {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.7rem;
    font-size: 0.84rem; font-weight: 600; color: var(--muted); background: var(--bg-2);
    border: 1px solid var(--border); cursor: pointer; transition: color .12s, background .12s, border-color .12s;
  }
  .shop-fchip:hover { color: var(--text); border-color: var(--muted); }
  .shop-fchip[aria-pressed="true"] { color: var(--accent-ink); background: var(--cyan); border-color: var(--cyan); }
  .shop-fchip-n { font-family: var(--font-mono); font-size: 0.7rem; opacity: 0.65; }
  .shop-price-range { display: flex; align-items: center; gap: 0.6rem; }
  .shop-money { display: inline-flex; align-items: center; gap: 0.2rem; font-weight: 700; color: var(--muted); }
  .shop-money input { width: 5.5rem; padding: 0.4rem 0.5rem; }
  .shop-dash { color: var(--muted-2); }
  .shop-low {
    position: absolute; top: 0.5rem; left: 0.5rem; z-index: 2; padding: 0.2rem 0.55rem;
    background: var(--magenta); color: #fff; font-size: 0.72rem; font-weight: 800;
  }
  /* "Reveal on hover" mode — badge fades in when the card is hovered. */
  .shop-grid.low-hover .shop-low { opacity: 0; transition: opacity .15s ease; }
  .shop-grid.low-hover .shop-card:hover .shop-low,
  .shop-grid.low-hover .shop-card:focus-within .shop-low { opacity: 1; }

  /* Free-shipping banner — clean white with dark-brown text + terracotta rule */
  .ship-banner {
    text-align: center; font-weight: 800; font-size: 0.92rem; letter-spacing: 0.01em;
    padding: 0.6rem 1rem; color: #3a2210;
    background: #fbf3ec; border-bottom: 3px solid var(--cyan);
  }
  .shop-body { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.7rem 0.8rem 0.85rem; }
  .shop-plat { color: var(--muted-2); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .shop-title {
    font-size: clamp(0.98rem, 0.9rem + 0.4vw, 1.22rem); font-weight: 700; line-height: 1.22; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .shop-cond { color: var(--muted); font-size: 0.8rem; margin: 0; }
  .shop-foot { display: flex; align-items: baseline; justify-content: space-between; margin-top: 0.4rem; gap: 0.4rem; }
  .shop-price { font-family: var(--font-mono); font-weight: 800; font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem); color: var(--text); }
