{
  "name": "timelag-gaming-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Time Lag Gaming — marketing site (landing page, eBay storefront link, and sell-your-games contact form).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "metadata:launchbox": "curl -s -o /tmp/lbmeta.zip https://gamesdb.launchbox-app.com/Metadata.zip && unzip -o /tmp/lbmeta.zip Metadata.xml -d /tmp && node --env-file=.env scripts/launchbox-ingest.mjs /tmp/Metadata.xml",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:setup": "supabase db reset && node --env-file=.env scripts/seed.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:export": "node --env-file=.env scripts/export-backup.mjs",
    "db:reset-inventory": "node --env-file=.env scripts/reset-inventory.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/vercel": "^8.0.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "astro": "^5.2.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.10.5",
    "supabase": "^2.102.0",
    "typescript": "^5.7.3"
  }
}
